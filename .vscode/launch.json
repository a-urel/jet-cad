{
    // The applications, on macOS and on the web (Chrome). The 2D
    // harness's measurement runs (`apps/dev_harness_2d`) are no longer
    // listed here; `git log -- .vscode/launch.json` keeps them.
    //
    // VS Code remembers the selected configuration by name: if F5 opens the
    // wrong one, pick it once from the Run and Debug dropdown.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "restaurant_demo: macOS",
            "cwd": "apps/restaurant_demo",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos"
        },
        {
            "name": "restaurant_demo: web",
            "cwd": "apps/restaurant_demo",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome"
        }
    ]
}
