# The probe's pubspec, written by tool/ci/host_probe.sh with the
# repository's URL and the commit under test (spec 14d P6). The dependency
# lines a host writes (docs/host-guide.md section 1), from pub.dev; the
# overrides take the repository packages from git at the commit under test,
# and check_host_lock.dart --ref proves they did (publishing spec D6).
name: host_probe
description: A host outside the workspace (spec 14d P6).
publish_to: none
version: 0.1.0

environment:
  sdk: ^3.6.0

dependencies:
  flutter:
    sdk: flutter
  jet_cad_2d_kit: ^0.1.1
  jet_cad_2d_kit_architecture: ^0.1.1
  jet_cad_2d_kit_restaurant: ^0.1.0
  jet_cad_2d_plan: ^0.9.0

flutter:
  uses-material-design: true
  fonts:
    - family: Roboto
      fonts:
        - asset: packages/jet_cad_2d_plan/fonts/Roboto-Regular.ttf

dependency_overrides:
  jet_cad_2d:
    git:
      url: @URL@
      path: packages/jet_cad_2d
      ref: @REF@
  jet_cad_2d_flutter:
    git:
      url: @URL@
      path: packages/jet_cad_2d_flutter
      ref: @REF@
  jet_cad_2d_kit:
    git:
      url: @URL@
      path: packages/jet_cad_2d_kit
      ref: @REF@
  jet_cad_2d_kit_architecture:
    git:
      url: @URL@
      path: packages/jet_cad_2d_kit_architecture
      ref: @REF@
  jet_cad_2d_kit_restaurant:
    git:
      url: @URL@
      path: packages/jet_cad_2d_kit_restaurant
      ref: @REF@
  jet_cad_2d_plan:
    git:
      url: @URL@
      path: packages/jet_cad_2d_plan
      ref: @REF@
