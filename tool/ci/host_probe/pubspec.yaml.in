# The probe's pubspec, written by tool/ci/host_probe.sh with the
# repository's URL and the commit under test (spec 14d P6). The dependency
# line a host writes (docs/host-guide.md section 1), from pub.dev; the
# overrides take the four repository packages from git at the commit under
# test, and check_host_lock.dart --ref proves they did (publishing spec D6).
name: host_probe
description: A host outside the workspace (spec 14d P6).
publish_to: none
version: 0.1.0

environment:
  sdk: ^3.6.0

dependencies:
  flutter:
    sdk: flutter
  jet_cad_floor_plan: ^0.7.1

flutter:
  uses-material-design: true
  fonts:
    - family: Roboto
      fonts:
        - asset: packages/jet_cad_floor_plan/fonts/Roboto-Regular.ttf
  assets:
    - assets/restaurant.jetlib

dependency_overrides:
  jet_cad_2d:
    git:
      url: @URL@
      path: packages/jet_cad_2d
      ref: @REF@
  jet_cad_2d_flutter:
    git:
      url: @URL@
      path: packages/jet_cad_2d_flutter
      ref: @REF@
  jet_cad_floor_plan:
    git:
      url: @URL@
      path: packages/jet_cad_floor_plan
      ref: @REF@
  jet_cad_restaurant_symbols:
    git:
      url: @URL@
      path: packages/jet_cad_restaurant_symbols
      ref: @REF@
