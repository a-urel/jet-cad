+        handlesOf(doc, leavesIn(index, band, BandMode.crossing)), [straddler],
+        reason: 'the root straddler is crossed by the band');
+    expect(leavesIn(index, band, BandMode.window), isEmpty,
+        reason: 'and not enclosed by it');
+  });
