+    addEntity(doc, def, EntityKind.circle, [5, 3], [2]);
+    // det = 16, so the world radius is 2 * 4 = 8 — neither 2 * 2 nor 2 * 8.
+    final placement = Transform2.translation(40, -25)
+        .multiply(Transform2.rotation(math.pi / 7))
