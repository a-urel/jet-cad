     }
-    if (changed) notifyListeners();
+    if (!setEquals(before, _keys)) notifyListeners();
   }
 
   void remove(Iterable<SelectionKey> keys) {
     var changed = false;
     for (final k in keys) {
       changed = _keys.remove(k) || changed;
     }
     if (changed) notifyListeners();
   }
 
