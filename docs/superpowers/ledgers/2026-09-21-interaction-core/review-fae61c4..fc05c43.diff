+    expect(window.bandMode, BandMode.window);
+    window.onPointerUp(ev(camera, const Offset(110, 80)), ctx);
+    expect(selection.isEmpty, isTrue);
+
+    final crossing = SelectTool();
+    crossing.onPointerDown(ev(camera, const Offset(110, 80)), ctx);
+    crossing.onPointerMove(ev(camera, const Offset(86, 120)), ctx);
+    expect(crossing.bandMode, BandMode.crossing);
