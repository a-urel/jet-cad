+    final c = h.c;
+
+    final p1 = at(tester, c, '1');
+    await rightClick(tester, p1);
+    expect(h.menus, [('1', p1)]);
+    expect(c.selectedUnits.value, {'1'});
+
+    c.select({'1', '2', '5'});
