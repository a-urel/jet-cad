+
+  testWidgets(
+      'SO4 under contextMenu a finger held 500 ms from contact reports the '
+      'table at the finger and toggles nothing; a locked table too; under '
+      'the default it still toggles (spec 14d S7, M-14d-p, M-14d-t)',
+      (tester) async {
