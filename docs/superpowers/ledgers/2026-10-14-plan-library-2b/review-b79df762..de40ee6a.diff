+    c.camera.value = zoneCamera();
+    c.fitToView();
+    await tester.pump();
+    await tester.pump();
+    expect(c.camera.value.worldToScreenMatrix.a, isNot(0.37),
+        reason: 'premise: refitted');
+    return c.camera.value;
