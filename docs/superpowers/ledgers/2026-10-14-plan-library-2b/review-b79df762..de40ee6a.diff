+/// The instance of the one unit labelled [n] in [d].
+Handle unitOf(DraftDocument d, String n) =>
+    unitIndexOf(d, catalog: catalogOf([fxKit()])).withLabel(n).single.instance;
+
+void move(PlanController c, String n, double dx, double dy) {
+  final d = c.activeDocument;
+  final node = d.tree[unitOf(d, n)]! as InstanceNode;
+  d.commands.execute(CompoundCommand([
+    TransformNodeCommand(
+        node.handle, Transform2.translation(dx, dy).multiply(node.transform))
+  ], label: 'Move'));
+}
