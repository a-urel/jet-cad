--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/service/view/theme_service_test.dart
@@ -0,0 +1,861 @@
+// Ported from jet_cad_floor_plan/test/host/theme_service_test.dart;
+// assertions unchanged.
+//
+// Ports its 13 tests (controller ruling R-15: they read the service layers
+// through the mounted view): M-H33(repaint), M-H31 through the view, the
+// animated switch, the full theme removed at runtime (two scales), the
+// group "the veil with no colour is the paper's (M-H32)", the group "the
+// bar (T-1, S-10)" with T3-d and RV5, invariant 4, and the group
+// "invariant 7 with a theme" with TO10 and TO21 themed.
+//
+// Host embedding API spec, Slice 3, T-1's status, groups, focus and chrome
+// rows and T-3 (2b spec S4 "Painting"; Task 15's theme fields) through the
+// real `PlanEditor` / `PlanServiceView`: the resolved theme reaches the
+// status, frame, chip and veil layers through the view's theme notifier,
+// which joins each layer's repaint merge and each painter's rebuild key, so
+// a theme change alone repaints (M-H33(repaint)); pans rebuild nothing
+// (M-H31); an equal theme rebuilds nothing (T-3's ==); the veil with no
+// colour is the paper's (M-H32); the bar takes `serviceBarHeight` and each
+// runtime change is measured, growing or shrinking (S-10, T3-d, RV5); an
+// animated switch between two full themes rebuilds each layer at most once
+// a frame; a theme removed at runtime restores today's pixels; the theme
+// reaches neither the design, the service record nor an export (invariant
+// 4); and `RenderPlanUnitOverlays` keeps its bars under a full theme
+// (invariant 7).
+//
+// Read back in pixels at device pixel ratio 1 under the seed of 2a's
+// canvas fixture: the groups look fixture (unit_groups_look_test.dart:
+// members 12, 3 and 7 turned and mirrored, placed out of handle order, 20
+// beside them, 0.125 px/mm off the origin), the zone fixture for the veil
+// (a page of Blueprint, or none on a dark `canvasBackground` under the
+// light theme), and the embedding fixture for the overlays. Expected
+// colours are computed here (straight alpha over the pixel without the
+// layer).
+//
+// Adaptations: FloorPlanView -> PlanEditor (the bar's tests switch modes
+// inside one widget); FloorPlanTheme -> PlanTheme (`tableColorOpacity` ->
+// `unitColourOpacity`); FloorPlanMode.selection -> PlanMode.service; the
+// table setters and types -> the unit ones; the layers' keys `table-*` ->
+// `unit-*`; the painters -> Task 15's Unit*Painter; cameraController ->
+// camera; floorPlanCanvasSeeds -> planCanvasSeeds; designJson -> save;
+// serviceLayoutJson -> serviceJson; RenderFloorPlanOverlays ->
+// RenderPlanUnitOverlays; the export dialog's PNG key -> 2a's
+// `export-format-plan.png`.
+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_plan/src/controller/plan_controller.dart';
+import 'package:jet_cad_2d_plan/src/editor/plan_editor.dart';
+import 'package:jet_cad_2d_plan/src/export/registries.dart' show PlanExport;
+import 'package:jet_cad_2d_plan/src/service/paint/unit_focus_painter.dart';
+import 'package:jet_cad_2d_plan/src/service/paint/unit_group_painter.dart';
+import 'package:jet_cad_2d_plan/src/service/paint/unit_status_painter.dart';
+import 'package:jet_cad_2d_plan/src/service/service_session.dart' show PlanMode;
+import 'package:jet_cad_2d_plan/src/service/service_state.dart';
+import 'package:jet_cad_2d_plan/src/service/view/unit_overlays.dart'
+    show PlanOverlayLayout, PlanOverlaySize;
+import 'package:jet_cad_2d_plan/src/theme/plan_theme.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../../support/canvas_fixture.dart';
+import '../../support/service_fixtures.dart'
+    show embeddingCamera, embeddingPlanJson;
+import '../../support/service_host.dart' show serviceController;
