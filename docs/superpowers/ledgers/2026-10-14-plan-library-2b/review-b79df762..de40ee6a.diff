+  // same scene without it: a faded quad is the paper at 0.6 over what it
+  // covers, everything else unchanged.
+
+  /// The zone fixture with a White page, in a controller; no view.
+  PlanController paged() {
+    final c = serviceController(json: zonePlanJson());
+    final d = c.activeDocument;
+    d.commands.execute(
+        SetComponentCommand<PageComponent>(d.rootHandle, PageComponent()));
