+      await click(tester, screenOf(tester, c, hiddenAt));
+      expect(selected(c), isEmpty, reason: '5, hidden');
+      await click(tester, screenOf(tester, c, topOf(c, 'L')));
+      expect(selected(c), isEmpty, reason: 'L, locked');
+      final r = canvasRect(tester);
