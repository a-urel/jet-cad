+        selection.dispose();
+        index.dispose();
+        camera.dispose();
+        doc.dispose();
+      });
+      void hover(double x, double y) => tool.onPointerMove(
+          ToolPointerEvent(
+              screen: Offset(view.a * x + view.e, view.d * y + view.f),
+              world: Vector2(x, y),
+              pointer: 1,
+              buttons: 0,
+              shift: false,
+              control: false,
+              meta: false,
+              alt: false,
+              pickRadiusWorld: 60),
