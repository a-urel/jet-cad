+// Ported from jet_cad_floor_plan/lib/src/service/table_status_painter.dart (2b spec S4 "Painting"): over units, placed and generated.
+// The status layer (spec 14c S6, S7, R-3, R-4, R-14): each statused unit's
+// top filled in its status colour, under the drafting, with an optional
+// caption. A group's status (table-groups spec G3) fills every visible
+// member over its own status, with one caption, under the lead. A unit
+// with neither is filled in its colour, when the plan gives it one (plan
+// colours spec PC-5), with no caption. The statuses are not document state;
+// the colours are.
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+
+import '../../theme/plan_theme.dart' show PlanTheme, kUnitColourOpacity;
+import '../../units/unit_components.dart' show UnitColour;
+import '../../units/unit_index.dart' show UnitIndex, UnitIndexCache, UnitInfo;
+import '../service_state.dart'
+    show GroupUnit, UnitGroup, UnitStatus, groupIdsByLabel, inLeadOrder;
+import '../unit_picker.dart' show CircleTop, PolygonTop, unitTopOf;
+
+/// One filled unit, prebuilt at status-change or plan-change rate (R-3):
+/// the frame reads it and creates nothing.
+final class _Fill {
+  _Fill(this.instance, this.toWorld, this.path, this.paint, this.caption,
+      this.lx, this.ly, this.half, this.size);
+
+  final Handle instance;
+
+  /// Definition space to world: the unit's, captured at rebuild (a seat's
+  /// is its row's group × its instance).
+  final Transform2 toWorld;
+  final Path path;
+  final Paint paint;
+  final ui.Paragraph? caption;
+
+  /// The unit label's anchor and half its height, in definition space:
+  /// the caption goes below the label (S7, review F-5).
+  final double lx, ly, half;
+
+  /// The top's smaller side, in definition space.
+  final double size;
+}
+
+/// The caption's height in logical pixels (S7).
+const double kStatusCaptionSize = 11;
+
+/// The gap between the unit label's bottom and the caption, in logical
+/// pixels.
+const double kStatusCaptionGap = 2;
+
+/// [colour] composited onto [paper]'s RGB (dark theme spec D6c), as
+/// `0xRRGGBB`: straight alpha, per channel `round(a * s + (1 - a) * p)`
+/// with `a` the colour's alpha over 255. The paper's own alpha is ignored:
+/// the paper is opaque.
+int over(Color colour, int paper) {
+  final argb = colour.toARGB32();
+  final a = ((argb >> 24) & 0xFF) / 255;
+  var rgb = 0;
+  for (final shift in const [16, 8, 0]) {
+    final s = (argb >> shift) & 0xFF;
+    final p = (paper >> shift) & 0xFF;
+    rgb |= (a * s + (1 - a) * p).round() << shift;
+  }
+  return rgb;
+}
+
+/// The caption colour for a status [colour] on [paper] (D6c): the ink
+/// [foregroundFor] picks for the colour over the paper, mapped to
+/// [kStatusCaptionOnLight] (black ink, today's caption) or
+/// [kStatusCaptionOnDark] (white ink). `foregroundFor` returns `0xRRGGBB`,
+/// so this mapping is the only conversion: `Color(foregroundFor(...))`
+/// would be fully transparent.
+Color statusCaptionInk(Color colour, int paper) =>
+    foregroundFor(over(colour, paper)) == 0xFFFFFF
+        ? kStatusCaptionOnDark
+        : kStatusCaptionOnLight;
+
+/// A host's text [style] for painted text (host embedding API spec T-1,
+/// T-4, S-3) with today's values where it leaves them null: [ink] as its
+/// colour when it has none (a style with a foreground paint keeps it), and
+/// [kStatusCaptionSize] as its size. Its family, weight and the rest as
+/// given. Built when a painter rebuilds, never per frame.
+TextStyle paintedTextStyle(TextStyle style, Color ink) => style.copyWith(
+    color: style.color ?? ink, fontSize: style.fontSize ?? kStatusCaptionSize);
+
+/// Paints the statuses and colours of [document]'s units through [camera]
+/// (S7; plan colours spec PC-5).
+///
+/// Each visible unit's fill is the first of a chain: its group's status
+/// (table-groups spec G3: [groupStatuses], through [unitGroups]) when the
+/// group has one, else its own [statuses] entry, else its colour (the
+/// plan's `jetcad.unit_colour`, PC-4), so a status covers a colour. The
+/// status rungs key by the unit's label; the colour rung needs none, so
+/// an unlabelled unit is filled in its colour. A locked unit is filled
+/// (spec S2); one on a hidden layer is not; a colour name this release does
+/// not know fills nothing. A group status's caption is drawn once, under
+/// the lead: the visible member with a top that [inLeadOrder] puts first
+/// (a file duplicate ties to the lower handle). A colour has no caption.
+///
+/// A colour's fill is its hue — re-toned through `darkCanvasTone` when
+/// [darkCanvas] says the canvas re-tones, as a room's tint is — at alpha
+/// `round(255 * o)`, `o` the theme's `unitColourOpacity`, else
+/// [kUnitColourOpacity] (PC-6), applied once at rebuild.
+///
+/// The design mode mounts this painter too, with no statuses and no groups
+/// (PC-5): only the colours draw there.
+///
+/// The fills are rebuilt when the statuses, the groups, the unit index
+/// ([units] gives a new one on a state, layer or lock change), the paper
+/// or the theme move; each
+/// frame is an indexed loop over them that passes the same [Path], [Paint]
+/// and [ui.Paragraph] objects and one reused matrix buffer to the canvas
+/// (the allocation bar, measured structurally by its test). The matrix is
+/// `camera . toWorld` (the unit's world transform, captured at rebuild),
+/// composed in doubles before it reaches the canvas.
+///
+/// A caption's ink follows what it sits on (dark theme spec D6c): the
+/// status colour over [paper], through [statusCaptionInk]. The host puts
+/// [paper] in [repaint] too (F-16), so a paper change repaints, and the
+/// rebuild then builds each flipped caption once.
+///
+/// The host's look, [theme] (host embedding API spec T-1, T-3), joins the
+/// rebuild key: its `statusFillOpacity` multiplies each status colour's
+/// alpha once, at rebuild, and the caption's ink is taken on that drawn
+/// colour (S-6); its `statusCaptionStyle` styles the captions, the null
+/// properties today's ([paintedTextStyle]).
+class UnitStatusPainter extends CustomPainter {
+  UnitStatusPainter({
+    required this.document,
+    required this.units,
+    required this.camera,
+    required this.statuses,
+    required this.unitGroups,
+    required this.groupStatuses,
+    required this.paper,
+    this.theme,
+    this.darkCanvas,
+    required Listenable repaint,
+  }) : super(repaint: repaint);
+
+  final DraftDocument document;
+
+  /// The document's units, as the session's cache holds them.
+  final UnitIndexCache units;
+
+  final ValueListenable<ViewportTransform> camera;
+  final ValueListenable<Map<String, UnitStatus>> statuses;
+
+  /// The host's groups and their statuses, as `PlanController`'s
+  /// `unitGroups` and `groupStatuses` hold them (ids trimmed).
+  final ValueListenable<Map<String, UnitGroup>> unitGroups;
+  final ValueListenable<Map<String, UnitStatus>> groupStatuses;
+
+  /// The paper under the statuses, ARGB: the page's background, or the
+  /// theme's surface with no page (D4, D6c).
+  final ValueListenable<int> paper;
+
+  /// The resolved look (host embedding API spec T-3); null, or a null
+  /// value, is today's. The host puts it in [repaint] too, so a theme
+  /// change repaints, and the rebuild then builds what it changed.
+  final ValueListenable<PlanTheme?>? theme;
+
+  /// Whether the canvas re-tones its colours (dark canvas K3): a unit
+  /// colour's hue is drawn through `darkCanvasTone` then, as a room's tint
+  /// is; null: never. Read at rebuild. The canvas re-tones only on its dark
+  /// paper, so a flip of it always moves [paper] too, which rebuilds.
+  final bool Function()? darkCanvas;
+
+  List<_Fill> _fills = const [];
+  UnitIndex? _indexBuilt;
+  Map<String, UnitStatus>? _builtFor;
+  Map<String, UnitGroup>? _groupsBuilt;
+  Map<String, UnitStatus>? _groupStatusesBuilt;
+  int? _paperBuilt;
+  PlanTheme? _themeBuilt;
+
+  /// The caption's least distance below the label's anchor, in logical
+  /// pixels: its size, set at rebuild (S7; T-1's `statusCaptionStyle`).
+  double _captionSize = kStatusCaptionSize;
+
+  final Map<Handle, Path?> _paths = {};
+
+  /// Keyed by the drawn colour's ARGB (the status colour, its alpha
+  /// multiplied by the theme's `statusFillOpacity`; or the unit colour at
+  /// the theme's `unitColourOpacity`).
+  final Map<int, Paint> _paints = {};
+
+  /// Keyed by (caption, drawn colour, ink, the theme's caption style): a
+  /// paper flip that flips the ink builds the new paragraph once; steady
+  /// frames build none (D6c).
+  final Map<(String, int, Color, TextStyle?), ui.Paragraph> _captions = {};
+  final Float64List _matrix = Float64List(16);
+
+  /// Every `Path`, `Paint`, `Paragraph` and matrix this painter created: a
+  /// second check of the allocation bar (S7).
+  @visibleForTesting
+  int debugAllocations = 0;
+
+  /// How many times the fills were rebuilt (table-groups spec invariant 1:
+  /// at rebuild rate only).
+  @visibleForTesting
+  int debugRebuilds = 0;
+
+  /// How many paints and captions the caches hold (review F-8).
+  @visibleForTesting
+  int get debugCached => _paints.length + _captions.length;
+
+  void _rebuild(PlanTheme? look) {
+    debugRebuilds++;
+    final map = statuses.value;
+    final groupMap = groupStatuses.value;
+    final paperArgb = paper.value;
+    final opacity = look?.statusFillOpacity;
+    final style = look?.statusCaptionStyle;
+    _captionSize = style?.fontSize ?? kStatusCaptionSize;
+    final fills = <_Fill>[];
+    // Every unit of the index, placed or generated; the colours live in
+    // the document (PC-5).
+    final index = units.current;
+    final groupOf = groupMap.isEmpty
+        ? const <String, String>{}
+        : groupIdsByLabel(unitGroups.value);
+    final tone = darkCanvas?.call() ?? false;
+    final colourAlpha =
+        (255 * (look?.unitColourOpacity ?? kUnitColourOpacity)).round();
+    // Each visible unit with a top and a fill, in draw order (the index is
+    // ascending by handle): its drawn colour, and its status when the fill
+    // is one (a status's group id when it is the group's); per statused
+    // group its members that may lead.
+    final filled = <(UnitInfo, Path, Color, UnitStatus?, String?)>[];
+    final candidates = <String, List<GroupUnit>>{};
+    for (final u in index.units) {
+      // The status rungs key by label; the colour rung needs none.
+      final label = u.text;
+      final id = label == null ? null : groupOf[label];
+      final groupStatus = id == null ? null : groupMap[id];
+      final status = label == null ? null : (groupStatus ?? map[label]);
+      final colour = status == null
+          ? document.components.get<UnitColour>(u.instance)?.swatch
+          : null;
+      if (status == null && colour == null) continue;
+      // A hidden layer's unit is not filled; a locked one is (S2).
+      if (!u.visible) continue;
+      final path = _paths.putIfAbsent(u.definition, () => _pathOf(u));
+      if (path == null) continue;
+      final Color drawn;
+      if (status != null) {
+        // The theme's opacity multiplies the host colour's alpha, once.
+        drawn = opacity == null
+            ? status.color
+            : status.color.withValues(alpha: status.color.a * opacity);
+      } else {
+        // A colour: its hue, toned on the dark canvas as a room's tint is,
+        // at the theme's opacity, once (PC-5, PC-6).
+        final rgb = tone
+            ? darkCanvasTone(colour!.rgb, paperArgb & 0xFFFFFF)
+            : colour!.rgb;
+        drawn = Color((colourAlpha << 24) | rgb);
+      }
+      filled.add((u, path, drawn, status, groupStatus == null ? null : id));
+      if (groupStatus != null) {
+        (candidates[id!] ??= []).add(GroupUnit(
+            handle: u.instance, label: label!, visible: true, locked: false));
+      }
+    }
+    // The lead of each statused group: its caption's one place.
+    final leads = <Handle>{
+      for (final list in candidates.values) inLeadOrder(list).first.handle,
+    };
+    for (final (u, path, drawn, status, id) in filled) {
+      final bounds = path.getBounds();
+      final argb = drawn.toARGB32();
+      final paint = _paints.putIfAbsent(argb, () {
+        debugAllocations++;
+        return Paint()
+          ..style = PaintingStyle.fill
+          ..color = drawn;
+      });
+      // Captions for a status only; a colour carries none.
+      final caption = status?.caption;
+      final captioned = caption != null &&
+          caption.isNotEmpty &&
+          (id == null || leads.contains(u.instance));
+      final label = _labelOf(u.label);
+      fills.add(_Fill(
+        u.instance,
+        u.toWorld,
+        path,
+        paint,
+        captioned
+            ? _captionOf(caption, argb,
+                style?.color ?? statusCaptionInk(drawn, paperArgb), style)
+            : null,
+        label?.x ?? bounds.center.dx,
+        label?.y ?? bounds.center.dy,
+        label?.half ?? 0,
+        math.min(bounds.width, bounds.height),
+      ));
+    }
+    // Draw order (ascending handle), whatever the map's order.
+    fills.sort((a, b) => a.instance.value.compareTo(b.instance.value));
+    _fills = fills;
+    // Paints and captions no fill holds are dropped (review F-8): a host
+    // whose captions change ("12 min", "13 min") does not grow the caches.
+    final paints = {for (final f in fills) f.paint};
+    final captions = {for (final f in fills) f.caption};
+    _paints.removeWhere((_, p) => !paints.contains(p));
+    _captions.removeWhere((_, p) => !captions.contains(p));
+  }
+
+  /// The anchor and half height of the unit label [label], in the
+  /// instance's space; null when there is none.
+  ({double x, double y, double half})? _labelOf(Handle? label) {
+    if (label == null) return null;
+    final e = document.entities;
+    final slot = e.slotOf(label);
+    if (slot == null) return null;
+    final payload = document.geometry.read(e.geomIndexAt(slot));
+    if (payload.coords.length < 2 || payload.scalars.isEmpty) return null;
+    return (
+      x: payload.coords[0],
+      y: payload.coords[1],
+      half: payload.scalars[0] / 2,
+    );
+  }
+
+  /// The unit's top as a local path, or null when it has none (R-8).
+  Path? _pathOf(UnitInfo u) {
+    final top = unitTopOf(document, u.definition);
+    if (top == null) return null;
+    debugAllocations++;
+    switch (top) {
+      case PolygonTop(:final xy):
+        final p = Path()..moveTo(xy[0], xy[1]);
+        for (var i = 2; i + 1 < xy.length; i += 2) {
+          p.lineTo(xy[i], xy[i + 1]);
+        }
+        return p..close();
+      case CircleTop(:final cx, :final cy, :final r):
+        return Path()
+          ..addOval(Rect.fromCircle(center: Offset(cx, cy), radius: r));
+    }
+  }
+
+  ui.Paragraph _captionOf(
+          String caption, int colour, Color ink, TextStyle? style) =>
+      _captions.putIfAbsent(
+          (caption, colour, ink, style), () => _paragraph(caption, ink, style));
+
+  /// Today's caption with no [style]; with one, the host's style with
+  /// today's values where it leaves them null (T-1, T-4).
+  ui.Paragraph _paragraph(String text, Color ink, TextStyle? style) {
+    debugAllocations++;
+    final ui.ParagraphBuilder b;
+    if (style == null) {
+      b = ui.ParagraphBuilder(ui.ParagraphStyle(
+          fontSize: kStatusCaptionSize, textAlign: TextAlign.center))
+        ..pushStyle(ui.TextStyle(color: ink, fontSize: kStatusCaptionSize));
+    } else {
+      final resolved = paintedTextStyle(style, ink);
+      b = ui.ParagraphBuilder(
+          resolved.getParagraphStyle(textAlign: TextAlign.center))
+        ..pushStyle(resolved.getTextStyle());
+    }
+    b.addText(text);
+    return b.build()..layout(const ui.ParagraphConstraints(width: 120));
+  }
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final index = units.current;
+    final map = statuses.value;
+    final groups = unitGroups.value;
+    final groupMap = groupStatuses.value;
+    final paperArgb = paper.value;
+    final look = theme?.value;
+    if (!identical(_indexBuilt, index) ||
+        !identical(_builtFor, map) ||
+        !identical(_groupsBuilt, groups) ||
+        !identical(_groupStatusesBuilt, groupMap) ||
+        _paperBuilt != paperArgb ||
+        !identical(_themeBuilt, look)) {
+      _rebuild(look);
+      _indexBuilt = index;
+      _builtFor = map;
+      _groupsBuilt = groups;
+      _groupStatusesBuilt = groupMap;
+      _paperBuilt = paperArgb;
+      _themeBuilt = look;
+    }
+    final fills = _fills;
+    if (fills.isEmpty) return;
+    final cam = camera.value.worldToScreenMatrix;
+    final m = _matrix;
+    for (var i = 0; i < fills.length; i++) {
+      final f = fills[i];
+      final t = f.toWorld;
+      // camera . toWorld, in doubles.
+      final a = cam.a * t.a + cam.c * t.b;
+      final b = cam.b * t.a + cam.d * t.b;
+      final c = cam.a * t.c + cam.c * t.d;
+      final d = cam.b * t.c + cam.d * t.d;
+      final e = cam.a * t.e + cam.c * t.f + cam.e;
+      final g = cam.b * t.e + cam.d * t.f + cam.f;
+      m[0] = a;
+      m[1] = b;
+      m[4] = c;
+      m[5] = d;
+      m[10] = 1;
+      m[12] = e;
+      m[13] = g;
+      m[15] = 1;
+      canvas
+        ..save()
+        ..transform(m)
+        ..drawPath(f.path, f.paint)
+        ..restore();
+      final caption = f.caption;
+      if (caption == null) continue;
+      // Skipped when the unit is smaller on screen than its caption.
+      final scale = math.sqrt((a * d - b * c).abs());
+      if (f.size * scale < caption.maxIntrinsicWidth) continue;
+      final sx = a * f.lx + c * f.ly + e;
+      final sy = b * f.lx + d * f.ly + g;
+      // Below the label: its half height on screen and a gap, at least
+      // one caption height from the anchor.
+      final below = math.max(_captionSize, f.half * scale + kStatusCaptionGap);
+      canvas
+        ..save()
+        ..translate(sx - caption.width / 2, sy + below)
+        ..drawParagraph(caption, Offset.zero)
+        ..restore();
+    }
+  }
+
+  @override
+  bool shouldRepaint(UnitStatusPainter oldDelegate) =>
+      !identical(oldDelegate.document, document) ||
+      !identical(oldDelegate.statuses, statuses) ||
+      !identical(oldDelegate.unitGroups, unitGroups) ||
+      !identical(oldDelegate.groupStatuses, groupStatuses) ||
+      !identical(oldDelegate.paper, paper) ||
+      !identical(oldDelegate.theme, theme) ||
+      !identical(oldDelegate.units, units);
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/service/service_record.dart b/packages/jet_cad_2d_plan/lib/src/service/service_record.dart
new file mode 100644
index 00000000..74729797
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/service/service_record.dart
@@ -0,0 +1,299 @@
+// The service record (spec 2b S3 "The service record", decision 4): the
+// moves the service copy made and the host's groups, as a small JSON a
+// host stores apart from the design, and the strict match that decides
+// which of a stored record's moves and groups still apply to the design.
+// Ported from jet_cad_floor_plan's lib/src/host/service_layout.dart (the
+// whole file), keyed by label, with groups added; today's
+// `jet_cad.service_layout` text is refused (no compatibility, spec S5).
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart' show immutable;
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+
+import '../units/unit_index.dart';
+import 'service_state.dart';
+
+/// The record's `format` value.
+const String kServiceFormat = 'jet_cad.service';
+
+/// The record's `version` value.
+const int kServiceVersion = 1;
+
+/// One moved unit: its instance, its label when it had one, its transform
+/// in the design ([from]) and in the copy ([to]).
+final class ServiceMove {
+  const ServiceMove(
+      {required this.handle,
+      required this.label,
+      required this.from,
+      required this.to});
+
+  final Handle handle;
+  final String? label;
+  final Transform2 from;
+  final Transform2 to;
+
+  @override
+  String toString() => 'ServiceMove(${handle.toHex()}, $label)';
+}
+
+/// One group as a record holds it, before any check: its id, its members
+/// and its label as written.
+final class RecordGroup {
+  const RecordGroup(
+      {required this.id, required this.members, required this.label});
+
+  final String id;
+  final List<String> members;
+  final String? label;
+}
+
+/// A decoded record.
+final class ServiceRecord {
+  const ServiceRecord({required this.moves, required this.groups});
+
+  final List<ServiceMove> moves;
+  final List<RecordGroup> groups;
+}
+
+/// Whether [a] and [b] are the same stored value: `Transform2` has no
+/// `==` on purpose, and a record compares stored transforms exactly.
+bool sameTransform(Transform2 a, Transform2 b) =>
+    a.a == b.a &&
+    a.b == b.b &&
+    a.c == b.c &&
+    a.d == b.d &&
+    a.e == b.e &&
+    a.f == b.f;
+
+/// The placed units of [copy] (as [copyUnits] lists them) whose transform
+/// differs from the same instance's in [design], ascending by handle.
+/// Generated units never move alone, so none is listed.
+List<ServiceMove> serviceMovesOf(
+    DraftDocument design, DraftDocument copy, UnitIndex copyUnits) {
+  final out = <ServiceMove>[];
+  for (final u in copyUnits.units) {
+    if (u.generated) continue;
+    final moved = copy.tree[u.instance];
+    final designed = design.tree[u.instance];
+    if (moved is! InstanceNode || designed is! InstanceNode) continue;
+    if (sameTransform(moved.transform, designed.transform)) continue;
+    out.add(ServiceMove(
+        handle: u.instance,
+        label: u.text,
+        from: designed.transform,
+        to: moved.transform));
+  }
+  return out;
+}
+
+/// [moves] and [groups] as the record's JSON, in the given orders.
+String encodeServiceRecord(
+        List<ServiceMove> moves, Map<String, UnitGroup> groups) =>
+    jsonEncode({
+      'format': kServiceFormat,
+      'version': kServiceVersion,
+      'moves': [
+        for (final m in moves)
+          {
+            'handle': m.handle.toHex(),
+            'label': m.label,
+            'from': m.from.toJson(),
+            'to': m.to.toJson(),
+          }
+      ],
+      'groups': [
+        for (final MapEntry(key: id, value: g) in groups.entries)
+          {
+            'id': id,
+            'members': [...g.members],
+            'label': g.label,
+          }
+      ],
+    });
+
+/// The record [text]. Throws a [FormatException] unless it is a version-1
+/// `jet_cad.service` record: its moves as today's layout entries (a
+/// hexadecimal handle, a string or null label, six numbers in each of
+/// `from` and `to`, no handle twice), its groups objects with a string
+/// `id`, a list of string `members` and a string or null `label`. Values
+/// are not checked for finiteness, nor groups against the validation:
+/// [matchServiceMoves] and [matchServiceGroups] drop such entries.
+ServiceRecord decodeServiceRecord(String text) {
+  Never bad(String why) => throw FormatException('Not a service record: $why');
+  final Object? json;
+  try {
+    json = jsonDecode(text);
+  } on FormatException catch (e) {
+    bad(e.message);
+  }
+  if (json is! Map<String, Object?>) bad('not an object');
+  if (json['format'] != kServiceFormat) bad('format');
+  if (json['version'] != kServiceVersion) bad('version');
+  final moves = json['moves'];
+  if (moves is! List<Object?>) bad('moves');
+  final groups = json['groups'];
+  if (groups is! List<Object?>) bad('groups');
+  Transform2 transform(Object? v, String name) {
+    if (v is! List<Object?> || v.length != 6 || v.any((x) => x is! num)) {
+      bad(name);
+    }
+    // The web writes `1` where the VM writes `1.0` (V-21).
+    final d = [for (final x in v) (x! as num).toDouble()];
+    return Transform2(d[0], d[1], d[2], d[3], d[4], d[5]);
+  }
+
+  final seen = <Handle>{};
+  final outMoves = <ServiceMove>[];
+  for (final m in moves) {
+    if (m is! Map<String, Object?>) bad('a move');
+    final hex = m['handle'];
+    if (hex is! String) bad('a handle');
+    final Handle handle;
+    try {
+      handle = Handle.parseHex(hex);
+    } on HandleRangeError {
+      bad('a handle');
+    }
+    if (!seen.add(handle)) bad('handle $hex twice');
+    final label = m['label'];
+    if (label != null && label is! String) bad('a label');
+    outMoves.add(ServiceMove(
+        handle: handle,
+        label: label as String?,
+        from: transform(m['from'], 'from'),
+        to: transform(m['to'], 'to')));
+  }
+  final outGroups = <RecordGroup>[];
+  for (final g in groups) {
+    if (g is! Map<String, Object?>) bad('a group');
+    final id = g['id'];
+    if (id is! String) bad('a group id');
+    final members = g['members'];
+    if (members is! List<Object?> || members.any((m) => m is! String)) {
+      bad('a group\'s members');
+    }
+    final label = g['label'];
+    if (label != null && label is! String) bad('a group label');
+    outGroups.add(RecordGroup(
+        id: id,
+        members: List.unmodifiable(members.cast<String>()),
+        label: label as String?));
+  }
+  return ServiceRecord(
+      moves: List.unmodifiable(outMoves), groups: List.unmodifiable(outGroups));
+}
+
+/// The moves of a record that apply to a design, and those dropped.
+typedef ServiceMoveMatch = ({
+  List<ServiceMove> applied,
+  List<ServiceMove> dropped,
+});
+
+/// Splits [moves] by the strict match against [design] (spec S3): a move
+/// applies iff its handle is a placed unit of [designUnits] that no lock
+/// covers (`isLockedUnit`), on a visible, unlocked layer (a missing layer
+/// counts as visible), carrying the same label, at exactly
+/// [ServiceMove.from], and [ServiceMove.to] only translates it (the same
+/// linear part) with every value finite.
+ServiceMoveMatch matchServiceMoves(
+    DraftDocument design, UnitIndex designUnits, List<ServiceMove> moves) {
+  final applied = <ServiceMove>[];
+  final dropped = <ServiceMove>[];
+  for (final e in moves) {
+    final unit = designUnits[e.handle];
+    final node = design.tree[e.handle];
+    final layer =
+        node is InstanceNode ? design.tables.layers[node.layer] : null;
+    final ok = unit != null &&
+        !unit.generated &&
+        !unit.locked &&
+        node is InstanceNode &&
+        (layer == null || (layer.visible && !layer.locked)) &&
+        unit.text == e.label &&
+        sameTransform(node.transform, e.from) &&
+        _finite(e.from) &&
+        _finite(e.to) &&
+        e.to.a == e.from.a &&
+        e.to.b == e.from.b &&
+        e.to.c == e.from.c &&
+        e.to.d == e.from.d;
+    (ok ? applied : dropped).add(e);
+  }
+  return (applied: applied, dropped: dropped);
+}
+
+bool _finite(Transform2 t) =>
+    t.a.isFinite &&
+    t.b.isFinite &&
+    t.c.isFinite &&
+    t.d.isFinite &&
+    t.e.isFinite &&
+    t.f.isFinite;
+
+/// The groups of a record that apply, and the ids applied and dropped.
+typedef ServiceGroupMatch = ({
+  Map<String, UnitGroup> applied,
+  List<String> appliedIds,
+  List<String> droppedIds,
+});
+
+/// Applies [groups] in record order, each whole or not at all (spec S3):
+/// a group is dropped when its trimmed id is blank or that of a group
+/// applied before it, when it has no member after trimming, when a member
+/// names no unit of [designUnits] (any unit carrying the label), or when a
+/// member is in a group applied before it. The ids are trimmed.
+ServiceGroupMatch matchServiceGroups(
+    List<RecordGroup> groups, UnitIndex designUnits) {
+  final applied = <String, UnitGroup>{};
+  final owner = <String, String>{};
+  final appliedIds = <String>[];
+  final droppedIds = <String>[];
+  for (final r in groups) {
+    final id = r.id.trim();
+    final group = UnitGroup(members: r.members.toSet(), label: r.label);
+    final ok = id.isNotEmpty &&
+        !applied.containsKey(id) &&
+        group.members.isNotEmpty &&
+        group.members.every((m) => designUnits.withLabel(m).isNotEmpty) &&
+        group.members.every((m) => !owner.containsKey(m));
+    if (!ok) {
+      droppedIds.add(id);
+      continue;
+    }
+    applied[id] = group;
+    appliedIds.add(id);
+    for (final m in group.members) {
+      owner[m] = id;
+    }
+  }
+  return (
+    applied: Map.unmodifiable(applied),
+    appliedIds: appliedIds,
+    droppedIds: droppedIds,
+  );
+}
+
+/// What `PlanController.restoreService` did (spec S3): the labels of the
+/// moves it applied and dropped, in record order (an unlabelled unit's is
+/// null, so a label may repeat and the lengths are the counts), and the
+/// ids of the groups it applied and dropped, in record order.
+@immutable
+final class ServiceRestore {
+  ServiceRestore(
+      {required List<String?> appliedMoves,
+      required List<String?> droppedMoves,
+      required List<String> appliedGroups,
+      required List<String> droppedGroups})
+      : appliedMoves = List.unmodifiable(appliedMoves),
+        droppedMoves = List.unmodifiable(droppedMoves),
+        appliedGroups = List.unmodifiable(appliedGroups),
+        droppedGroups = List.unmodifiable(droppedGroups);
+
+  final List<String?> appliedMoves, droppedMoves;
+  final List<String> appliedGroups, droppedGroups;
+
+  @override
+  String toString() => 'ServiceRestore(moves: $appliedMoves, dropped '
+      '$droppedMoves; groups: $appliedGroups, dropped $droppedGroups)';
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/service/service_session.dart b/packages/jet_cad_2d_plan/lib/src/service/service_session.dart
new file mode 100644
index 00000000..c86ece92
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/service/service_session.dart
@@ -0,0 +1,197 @@
+// The service copy and everything over it (spec 2b S3 "Mode and copy"):
+// the design's text decoded under runtime permissions, its parametric
+// system over the guarded catalog and the design's frozen set, its unit
+// label system, its lock expander over the design's lock set, its own
+// failure boundary, its index, page, selection, outlines, unit index and
+// tool controller. Today's service copy and its systems
+// (jet_cad_floor_plan's floor_plan_controller.dart:1305-1319,
+// host/service_view.dart:124-130, :242-245), built like 2a's
+// DocumentSession (controller/session.dart:29-89).
+import 'dart:async';
+
+import 'package:flutter/foundation.dart'
+    show ValueListenable, ValueNotifier, VoidCallback;
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:meta/meta.dart' show internal;
+
+import '../kits/guard.dart';
+import '../kits/locks.dart';
+import '../units/unit_index.dart';
+import '../units/unit_label_system.dart';
+import 'service_state.dart' show UnitGroup;
+import 'service_tool.dart';
+import 'unit_picker.dart' show UnitPicker;
+
+/// The controller's two modes (spec S3).
+enum PlanMode {
+  /// The editor over the plan the host loads and saves.
+  design,
+
+  /// A copy of the design under runtime permissions: units are tapped,
+  /// selected, given statuses, grouped and moved; nothing done here
+  /// reaches the design.
+  service,
+}
+
+/// [design]'s text decoded as a service copy (today's `_copyOf`): under
+/// `DraftPermissions.runtime` (transforms and components only), with
+/// [register]'s components, a component the design keeps raw (E4) kept
+/// raw. The handles are the design's.
+DraftDocument serviceCopyOf(DraftDocument design,
+        {required void Function(ComponentRegistry registry) register,
+        required TextMeasurer measurer}) =>
+    DraftDocumentCodec.decodeString(DraftDocumentCodec.encodeToString(design),
+        measurer: measurer,
+        permissions: DraftPermissions.runtime,
+        diagnostics: <Diagnostic>[],
+        keepUnreadableComponents: true,
+        registerComponents: register);
+
+/// The service copy and its systems and views (spec S3). Made when service
+/// is entered (and by a load, a new plan, a reset or a restore in
+/// service), disposed after the frame that unmounts its view.
+final class ServiceSession {
+  /// [locks] and [frozen] are the design session's own (the handles are
+  /// the same in both documents); [lock] and [damage] receive this
+  /// session with what its boundary found. [groups] are the controller's
+  /// unit groups and [moves] its `serviceMove`, both read by the service
+  /// tool at each call; without them: no group, moves allowed (a session a
+  /// test builds).
+  ServiceSession({
+    required this.document,
+    required this.measurer,
+    required ParametricCatalog catalog,
+    required CameraController camera,
+    required LockSet locks,
+    required Set<Handle> frozen,
+    required ValueListenable<Set<Handle>> locked,
+    required DiagnosticsLog log,
+    required void Function(ServiceSession session, Set<Handle> objects) lock,
+    required void Function(ServiceSession session, PartialMutationError error)
+        damage,
+    ValueListenable<Map<String, UnitGroup>>? groups,
+    bool Function()? moves,
+  })  : page = PageNotifier(document),
+        index = SpatialIndex(document) {
+    // The selection before the outlines (it prunes a dead key first), as
+    // the design's (session.dart:49-56).
+    selection = SelectionController(document);
+    outlines = OutlineCache(document, selection);
+    toolContext = ToolContext(
+        document: document,
+        index: index,
+        camera: camera,
+        selection: selection,
+        page: page);
+    // The design's stack (Task 7): parametric, unit labels, lock.
+    parametric = ParametricSystem(document, catalog, isFrozen: frozen.contains)
+      ..install();
+    labels = UnitLabelSystem(document)..install();
+    lockExpander = LockExpander(document, locks)..install();
+    boundary = FailureBoundary(
+        document: document,
+        catalog: catalog,
+        system: parametric,
+        frozen: frozen,
+        log: log,
+        lock: (objects) => lock(this, objects),
+        damage: (error) => damage(this, error));
+    // As the design's (plan_controller.dart's `_open`): a hook failure is
+    // probed, frozen and retried once.
+    lockExpander
+      ..onHookFailure = boundary.recover
+      ..onPartialMutation = boundary.partialMutation
+      ..onRefusedEdit = boundary.recoverRefused
+      ..onRetryFailed = boundary.retryFailed;
+    // Last but the tool, as the design's (session.dart): it listens to
+    // [locked], so no later step can throw and leak the listener.
+    units = UnitIndexCache(document,
+        catalog: catalog, locks: locks, locked: locked);
+    // The picker reads [units], so the tool comes after it; neither
+    // constructor, nor the tool controller's, can throw.
+    picker = UnitPicker(document, units);
+    tool = ServiceTool(
+        picker: picker,
+        groups: groups ?? _noGroups,
+        callbacks: () => host.callbacks(),
+        options: () => host.options(),
+        moves: moves ?? _always,
+        userCamera: () => host.userCamera(),
+        toGlobal: (local) => host.toGlobal(local),
+        events: () => host.events(),
+        idleKeys: () => host.idleKeys());
+    tools = ToolController(initial: tool, context: toolContext);
+  }
+
+  /// The copy.
+  final DraftDocument document;
+  final FlutterTextMeasurer measurer;
+  final PageNotifier page;
+  final SpatialIndex index;
+  late final SelectionController selection;
+  late final OutlineCache outlines;
+
+  /// The copy's units: what everything in service reads.
+  late final UnitIndexCache units;
+  late final ToolContext toolContext;
+
+  /// The service tool (2b S4), the tool controller's one tool.
+  late final ServiceTool tool;
+
+  /// The copy's picker: a locked unit and a seat are picked (spec S2, S4).
+  @internal
+  late final UnitPicker picker;
+
+  /// What the tool reads from the view that shows this session, at each
+  /// call: the view sets it while its canvas is mounted and puts
+  /// [ServiceHost.none] back when it goes (Task 16).
+  @internal
+  ServiceHost host = ServiceHost.none;
+
+  static final ValueNotifier<Map<String, UnitGroup>> _noGroups =
+      ValueNotifier(const <String, UnitGroup>{});
+  static bool _always() => true;
+
+  late final ToolController tools;
+  late final ParametricSystem parametric;
+  late final UnitLabelSystem labels;
+  late final LockExpander lockExpander;
+  late final FailureBoundary boundary;
+
+  /// The controller's subscription to the copy's changes, and its
+  /// selection listener; [detach] drops both.
+  StreamSubscription<DocChange>? history;
+  VoidCallback? onSelection;
+
+  bool get canUndo => document.commands.canUndo;
+  bool get canRedo => document.commands.canRedo;
+
+  /// Stops the controller listening, at once.
+  void detach() {
+    final h = history;
+    history = null;
+    if (h != null) unawaited(h.cancel());
+    final l = onSelection;
+    onSelection = null;
+    if (l != null) selection.removeListener(l);
+  }
+
+  /// Everything, after the frame that unmounts the view: the tool
+  /// controller before the tool, the outlines before the selection, the
+  /// systems last in first out, the index before the document.
+  void dispose() {
+    tools.dispose();
+    tool.dispose();
+    outlines.dispose();
+    selection.dispose();
+    page.dispose();
+    units.dispose();
+    lockExpander.dispose();
+    labels.dispose();
+    parametric.dispose();
+    index.dispose();
+    unawaited(document.dispose());
+    measurer.clear();
+  }
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/service/service_state.dart b/packages/jet_cad_2d_plan/lib/src/service/service_state.dart
new file mode 100644
index 00000000..c3dd0d80
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/service/service_state.dart
@@ -0,0 +1,344 @@
+// Service state (spec 2b S3 "Service state"): a unit's status, a group of
+// units, the validation of a host's groups, and the group rules the
+// controller, the service tool, the painters and the service bar share, so
+// each applies one rule. Ported from jet_cad_floor_plan's
+// lib/src/host/floor_plan_types.dart (TableStatus :128-159, TableGroup
+// :244-300) and lib/src/service/table_groups.dart (whole file), keyed by
+// label instead of number; a unit's lock is `isLockedUnit` (spec S2
+// "Locked units"), not its layer's alone.
+import 'package:flutter/foundation.dart' show immutable, setEquals;
+import 'package:flutter/widgets.dart' show Color, StringCharacters;
+import 'package:jet_cad_2d/jet_cad_2d.dart' show Handle;
+
+import '../units/unit_index.dart';
+
+/// A unit's status as the host colours it in service (spec S3): a fill
+/// under the drafting and an optional short caption. Not document state:
+/// never saved, exported, printed or undone.
+@immutable
+final class UnitStatus {
+  /// [caption] is cut to [maxCaption] characters (grapheme clusters).
+  UnitStatus({required this.color, String? caption})
+      : caption = caption?.characters.take(maxCaption).toString();
+
+  /// The longest caption, in characters.
+  static const int maxCaption = 12;
+
+  /// The fill, drawn as given: a translucent colour lets the paper show.
+  final Color color;
+
+  final String? caption;
+
+  @override
+  bool operator ==(Object other) =>
+      other is UnitStatus && other.color == color && other.caption == caption;
+
+  @override
+  int get hashCode => Object.hash(color, caption);
+
+  @override
+  String toString() => 'UnitStatus($color, $caption)';
+}
+
+/// A group of units the host merged (spec S3): in service its members are
+/// framed, labelled, selected and moved as one. Addressed by the host's
+/// group id. Not document state.
+@immutable
+final class UnitGroup {
+  /// [members] are unit labels, each trimmed, a blank one dropped. [label]
+  /// is trimmed, a blank one meaning none, then cut to [maxLabel]
+  /// characters (grapheme clusters).
+  UnitGroup({required Set<String> members, String? label})
+      : members = Set.unmodifiable(<String>{
+          for (final m in members)
+            if (m.trim().isNotEmpty) m.trim()
+        }),
+        label = switch (label?.trim()) {
+          null || '' => null,
+          final l => l.characters.take(maxLabel).toString(),
+        };
+
+  /// The longest label, in characters.
+  static const int maxLabel = 24;
+
+  /// The member labels, trimmed, none blank; unmodifiable. A label with no
+  /// live unit is kept and resolves once such a unit exists.
+  final Set<String> members;
+
+  /// The host's text for the group's chip, or null for its labels.
+  final String? label;
+
+  @override
+  bool operator ==(Object other) =>
+      other is UnitGroup &&
+      other.label == label &&
+      setEquals(other.members, members);
+
+  @override
+  int get hashCode => Object.hash(Object.hashAllUnordered(members), label);
+
+  @override
+  String toString() => 'UnitGroup($members, $label)';
+}
+
+/// [groups] with their ids trimmed, in their given order, unmodifiable.
+///
+/// Throws an [ArgumentError], before anything is returned, for an empty or
+/// blank id, for two ids that are the same after trimming, for a group
+/// with no member (a [UnitGroup] drops blank members), and for a label in
+/// two groups; the message names the label and both ids.
+Map<String, UnitGroup> validateUnitGroups(Map<String, UnitGroup> groups) {
+  final out = <String, UnitGroup>{};
+  final owner = <String, String>{};
+  for (final MapEntry(key: raw, value: group) in groups.entries) {
+    final id = raw.trim();
+    if (id.isEmpty) {
+      throw ArgumentError.value(raw, 'groups', 'A group id is blank');
+    }
+    if (out.containsKey(id)) {
+      throw ArgumentError.value(
+          raw, 'groups', 'Two group ids are "$id" after trimming');
+    }
+    if (group.members.isEmpty) {
+      throw ArgumentError.value(raw, 'groups', 'Group "$id" has no member');
+    }
+    for (final l in group.members) {
+      final other = owner[l];
+      if (other != null) {
+        throw ArgumentError.value(raw, 'groups',
+            'Unit label "$l" is in two groups, "$other" and "$id"');
+      }
+      owner[l] = id;
+    }
+    out[id] = group;
+  }
+  return Map.unmodifiable(out);
+}
+
+/// The id of the group each member label of [groups] belongs to; [groups]
+/// as [validateUnitGroups] returns them, so a label has one group.
+Map<String, String> groupIdsByLabel(Map<String, UnitGroup> groups) => {
+      for (final MapEntry(key: id, value: g) in groups.entries)
+        for (final l in g.members) l: id,
+    };
+
+/// One unit as the group rules see it.
+final class GroupUnit {
+  const GroupUnit(
+      {required this.handle,
+      required this.label,
+      required this.visible,
+      required this.locked,
+      this.generated = false});
+
+  /// The unit's instance.
+  final Handle handle;
+
+  /// Its label, trimmed, or null while it has none.
+  final String? label;
+
+  /// On a shown layer (a hidden unit counts for nothing).
+  final bool visible;
+
+  /// `isLockedUnit`: shown and tapped, never selected (spec S2).
+  final bool locked;
+
+  /// Made by its object's type: never dragged (spec S4).
+  final bool generated;
+
+  /// Visible and unlocked: what a selection may hold.
+  bool get selectable => visible && !locked;
+
+  @override
+  String toString() => 'GroupUnit(${handle.toHex()}, $label'
+      '${visible ? '' : ', hidden'}${locked ? ', locked' : ''}'
+      '${generated ? ', generated' : ''})';
+}
+
+/// [index]'s units as the group rules see them.
+List<GroupUnit> groupUnitsOf(UnitIndex index) => [
+      for (final u in index.units)
+        GroupUnit(
+            handle: u.instance,
+            label: u.text,
+            visible: u.visible,
+            locked: u.locked,
+            generated: u.generated),
+    ];
+
+/// The groups resolved against one document's units. Built at
+/// document-change or groups-change rate, never per frame or per pointer
+/// event.
+final class UnitGroupLookup {
+  /// [groups] as [validateUnitGroups] returns them; [units] in any order.
+  factory UnitGroupLookup(
+      Map<String, UnitGroup> groups, Iterable<GroupUnit> units) {
+    final byLabel = groupIdsByLabel(groups);
+    final sorted = units.toList()
+      ..sort((a, b) => a.handle.value.compareTo(b.handle.value));
+    final visible = <String, List<GroupUnit>>{};
+    for (final u in sorted) {
+      final l = u.label;
+      if (l == null || !u.visible) continue;
+      final id = byLabel[l];
+      if (id != null) (visible[id] ??= []).add(u);
+    }
+    return UnitGroupLookup._(
+      groups,
+      Map.unmodifiable(byLabel),
+      {
+        for (final MapEntry(key: id, value: list) in visible.entries)
+          id: List.unmodifiable(list),
+      },
+      {
+        for (final MapEntry(key: id, value: list) in visible.entries)
+          id: List.unmodifiable([
+            for (final u in list)
+              if (u.selectable) u
+          ]),
+      },
+      {
+        for (final MapEntry(key: id, value: list) in visible.entries)
+          if (list.any((u) => u.locked)) id,
+      },
+      {
+        for (final MapEntry(key: id, value: list) in visible.entries)
+          if (list.any((u) => u.generated)) id,
+      },
+    );
+  }
+
+  UnitGroupLookup._(this.groups, this.byLabel, this._visible, this._selectable,
+      this._locked, this._generated);
+
+  /// The groups this lookup resolves.
+  final Map<String, UnitGroup> groups;
+
+  /// The id of each member label's group; unmodifiable.
+  final Map<String, String> byLabel;
+
+  final Map<String, List<GroupUnit>> _visible;
+  final Map<String, List<GroupUnit>> _selectable;
+  final Set<String> _locked;
+  final Set<String> _generated;
+
+  /// The id of the group [label] (trimmed) belongs to, or null.
+  String? groupOf(String label) => byLabel[label.trim()];
+
+  /// The group's members on a shown layer, a locked one included,
+  /// ascending by handle; every unit carrying a member label counts (a
+  /// shared label gives several). Empty for an unknown id.
+  List<GroupUnit> visibleMembers(String id) => _visible[id] ?? const [];
+
+  /// The group's visible, unlocked members, ascending by handle: what a
+  /// tap, a drag or a selection by label may select.
+  List<GroupUnit> selectableMembers(String id) => _selectable[id] ?? const [];
+
+  /// Whether a visible member of the group is locked: the group is then
+  /// never dragged. A locked member on a hidden layer does not count.
+  bool hasLockedVisibleMember(String id) => _locked.contains(id);
+
+  /// Whether a visible member of the group is generated (a seat): the
+  /// group is then never dragged (spec S4 "A drag").
+  bool hasGeneratedVisibleMember(String id) => _generated.contains(id);
+
+  /// The Split rule, the id `PlanController.selectedGroup` holds: the group
+  /// whose selectable members' labels are exactly [selectedLabels], when
+  /// that set is not empty and no unlabelled unit is selected
+  /// ([unlabelledSelected]); else null.
+  String? splitGroup(Set<String> selectedLabels,
+      {required bool unlabelledSelected}) {
+    if (unlabelledSelected || selectedLabels.isEmpty) return null;
+    // A label is in one group at most, so only the first's can match.
+    final id = groupOf(selectedLabels.first);
+    if (id == null) return null;
+    final labels = <String>{
+      for (final u in selectableMembers(id)) u.label!,
+    };
+    final selected = <String>{for (final l in selectedLabels) l.trim()};
+    if (labels.length != selected.length || !labels.containsAll(selected)) {
+      return null;
+    }
+    return id;
+  }
+}
+
+/// The Merge rule: whether [selectedLabels] span two or more units of
+/// merging, each a group of [groups] or a selected label in no group. One
+/// unit, two units sharing one label, and exactly one group do not;
+/// unlabelled units carry no label and count for nothing.
+bool mergeQualifies(Set<String> selectedLabels, Map<String, UnitGroup> groups) {
+  final byLabel = groupIdsByLabel(groups);
+  final parts = <(bool, String)>{};
+  for (final raw in selectedLabels) {
+    final l = raw.trim();
+    if (l.isEmpty) continue;
+    final id = byLabel[l];
+    parts.add(id == null ? (false, l) : (true, id));
+    if (parts.length >= 2) return true;
+  }
+  return false;
+}
+
+/// The lead order over [labels]: numeric when every one is all ASCII
+/// digits -- (length after stripping leading zeros, then that string,
+/// then the label as written), never `int.parse`, so any length compares
+/// -- else plain string order.
+Comparator<String> unitLabelOrder(Iterable<String> labels) {
+  if (labels.isNotEmpty && labels.every(_digits.hasMatch)) return _numeric;
+  return _plain;
+}
+
+final RegExp _digits = RegExp(r'^[0-9]+$');
+
+int _plain(String a, String b) => a.compareTo(b);
+
+int _numeric(String a, String b) {
+  final sa = _stripZeros(a), sb = _stripZeros(b);
+  final byLength = sa.length.compareTo(sb.length);
+  if (byLength != 0) return byLength;
+  final byValue = sa.compareTo(sb);
+  if (byValue != 0) return byValue;
+  return a.compareTo(b);
+}
+
+String _stripZeros(String s) {
+  var i = 0;
+  while (i < s.length && s.codeUnitAt(i) == 0x30) {
+    i++;
+  }
+  return s.substring(i);
+}
+
+/// The labelled units of [members] in lead order: by [unitLabelOrder] over
+/// their labels, ties (a shared label) to the lowest handle. The first is
+/// the lead.
+List<GroupUnit> inLeadOrder(Iterable<GroupUnit> members) {
+  final list = [
+    for (final u in members)
+      if (u.label != null) u
+  ];
+  final order = unitLabelOrder([for (final u in list) u.label!]);
+  list.sort((a, b) {
+    final byLabel = order(a.label!, b.label!);
+    if (byLabel != 0) return byLabel;
+    return a.handle.value.compareTo(b.handle.value);
+  });
+  return list;
+}
+
+/// The status a unit labelled [label] shows: its group's when the group
+/// has one, else its own; none for an unlabelled unit (today's
+/// `TableStatusPainter` order, group over table).
+UnitStatus? statusOfUnit(String? label,
+    {required Map<String, UnitStatus> statuses,
+    required Map<String, UnitStatus> groupStatuses,
+    required Map<String, String> groupByLabel}) {
+  if (label == null) return null;
+  final id = groupByLabel[label];
+  if (id != null) {
+    final group = groupStatuses[id];
+    if (group != null) return group;
+  }
+  return statuses[label];
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/service/service_tool.dart b/packages/jet_cad_2d_plan/lib/src/service/service_tool.dart
new file mode 100644
index 00000000..472b4980
--- /dev/null
