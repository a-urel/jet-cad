+
+  final ServiceCallbacks Function() callbacks;
+
+  /// The view's options (spec 14d S5-S7), read at each press.
+  final ServiceOptions Function() options;
+
+  /// Whether a drag on a unit moves it (spec S4: `PlanPermissions
