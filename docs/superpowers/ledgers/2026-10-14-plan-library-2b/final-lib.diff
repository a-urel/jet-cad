diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_components.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_components.dart
new file mode 100644
index 00000000..d97b83c3
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_components.dart
@@ -0,0 +1,253 @@
+// A host's data and colour on a unit (spec 2b S2 "Per-unit data"), on the
+// unit's **instance** node, placed or generated: ported from
+// jet_cad_floor_plan's table_data_component.dart and
+// table_color_component.dart. A generated unit keeps both while it keeps
+// its handle (E5) and loses them when its row drops it.
+//
+// No Flutter import: this file is Dart over `package:jet_cad_2d`, the
+// kit's swatch and `unit_label.dart` only.
+import 'dart:convert' show jsonEncode;
+
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart'
+    show PlanSwatch, planSwatchNamed;
+
+import 'unit_label.dart' show isControlCodeUnit;
+
+/// At most this many keys on one unit (E-6).
+const int kUnitDataMaxKeys = 32;
+
+/// A key's longest length, in characters of `[a-z0-9_.-]` (E-6).
+const int kUnitDataMaxKeyLength = 64;
+
+/// A value's longest length, in UTF-16 code units (E-6).
+const int kUnitDataMaxValueLength = 1024;
+
+final RegExp _key = RegExp('^[a-z0-9_.-]{1,$kUnitDataMaxKeyLength}\$');
+
+/// Why [data] is outside the limits (E-6), or null when it is within them:
+/// at most [kUnitDataMaxKeys] keys; each key 1 to [kUnitDataMaxKeyLength]
+/// characters of `[a-z0-9_.-]`; each value at most
+/// [kUnitDataMaxValueLength] UTF-16 code units, none of them a control
+/// character ([isControlCodeUnit], the unit labels' rule: below U+0020,
+/// or U+007F to U+009F). An empty map is within them, and so is an empty
+/// value (spec point S-6). The one test the component's constructor and the
+/// controller share.
+String? unitDataProblem(Map<String, String> data) {
+  if (data.length > kUnitDataMaxKeys) {
+    return 'has ${data.length} keys; at most $kUnitDataMaxKeys';
+  }
+  for (final MapEntry(:key, :value) in data.entries) {
+    if (!_key.hasMatch(key)) {
+      return 'key "$key" is not 1 to $kUnitDataMaxKeyLength characters '
+          'of [a-z0-9_.-]';
+    }
+    if (value.length > kUnitDataMaxValueLength) {
+      return 'the value of "$key" has ${value.length} code units; at most '
+          '$kUnitDataMaxValueLength';
+    }
+    if (value.codeUnits.any(isControlCodeUnit)) {
+      return 'the value of "$key" has a control character';
+    }
+  }
+  return null;
+}
+
+/// The host's data on one unit (E-6): `{"data": {key: value}}`, keys
+/// written sorted.
+///
+/// Immutable and value-equal. Made by the constructor, always within the
+/// limits and never empty (an empty map is no component); or read by
+/// [fromJson], which **never throws**: a payload outside the limits or of
+/// another shape is [kept] verbatim, written back as read, and reads as
+/// empty [data] (spec point S-2: the engine's preserve-unknown store holds
+/// only unregistered types, and a throwing factory would refuse the whole
+/// plan). `UnitIndex.diagnostics` reports such a unit as
+/// `unit.invalid_data` (S-3).
+final class UnitData implements Component {
+  static const String componentTypeId = 'jetcad.unit_data';
+
+  /// [data], its keys sorted. Throws [ArgumentError] (not an `assert`: a
+  /// release build must refuse too) when [data] is empty or outside the
+  /// limits ([unitDataProblem]).
+  factory UnitData(Map<String, String> data) {
+    if (data.isEmpty) {
+      throw ArgumentError.value(
+          data, 'data', 'is empty: an empty map is no component');
+    }
+    if (unitDataProblem(data) case final problem?) {
+      throw ArgumentError.value(data, 'data', problem);
+    }
+    return UnitData._(_sorted(data), null);
+  }
+
+  UnitData._(this.data, this.kept)
+      : _encoded = kept == null ? null : jsonEncode(kept);
+
+  /// The unit's data, its keys in ascending order; unmodifiable. Empty
+  /// when the payload was [kept].
+  final Map<String, String> data;
+
+  /// The payload as read, when it was not data within the limits: written
+  /// back exactly as read. Unmodifiable, all the way down. Null otherwise.
+  final Map<String, Object?>? kept;
+
+  /// [kept]'s encoding, its equality.
+  final String? _encoded;
+
+  /// Whether the payload was kept verbatim (and reads as empty [data]).
+  bool get isKept => kept != null;
+
+  @override
+  String get typeId => componentTypeId;
+
+  /// [kept] as read, or `{"data": {...}}` with the keys sorted.
+  @override
+  Map<String, Object?> toJson() => kept ?? {'data': data};
+
+  /// The payload's data when it is exactly `{"data": {key: value}}`, every
+  /// value a string, within the limits and not empty (re-sorted: a
+  /// hand-edited file is canonicalised on its next save); otherwise the
+  /// payload kept verbatim. Never throws.
+  static UnitData fromJson(Map<String, Object?> json) {
+    final raw = json['data'];
+    if (json.length == 1 && raw is Map && raw.isNotEmpty) {
+      final data = <String, String>{};
+      for (final MapEntry(:key, :value) in raw.entries) {
+        if (key is! String || value is! String) return _keep(json);
+        data[key] = value;
+      }
+      if (unitDataProblem(data) == null) {
+        return UnitData._(_sorted(data), null);
+      }
+    }
+    return _keep(json);
+  }
+
+  static UnitData _keep(Map<String, Object?> json) => UnitData._(
+      const <String, String>{}, _frozen(json) as Map<String, Object?>);
+
+  static Map<String, String> _sorted(Map<String, String> data) {
+    final keys = data.keys.toList()..sort();
+    return Map.unmodifiable({for (final k in keys) k: data[k]!});
+  }
+
+  /// A deep, unmodifiable copy of a decoded JSON value, its maps' key
+  /// order kept.
+  static Object? _frozen(Object? value) => switch (value) {
+        Map() => Map<String, Object?>.unmodifiable({
+            for (final MapEntry(:key, :value) in value.entries)
+              key as String: _frozen(value),
+          }),
+        List() =>
+          List<Object?>.unmodifiable([for (final v in value) _frozen(v)]),
+        _ => value,
+      };
+
+  @override
+  bool operator ==(Object other) {
+    if (other is! UnitData) return false;
+    if (isKept || other.isKept) return other._encoded == _encoded;
+    if (other.data.length != data.length) return false;
+    for (final MapEntry(:key, :value) in data.entries) {
+      if (other.data[key] != value) return false;
+    }
+    return true;
+  }
+
+  @override
+  int get hashCode =>
+      _encoded?.hashCode ??
+      Object.hashAll([
+        for (final MapEntry(:key, :value) in data.entries) ...[key, value]
+      ]);
+
+  @override
+  String toString() => isKept ? 'UnitData(kept: $_encoded)' : 'UnitData($data)';
+}
+
+/// The colour of one unit (PC-4): `{"color": name}`.
+///
+/// Immutable and value-equal. Made by the constructor from a palette entry;
+/// or read by [fromJson], which **never throws**: a payload of another shape
+/// than `{"color": String}` is [kept] verbatim and written back as read
+/// (the engine's preserve-unknown store holds only unregistered types, and
+/// a throwing factory would refuse the whole plan), and a name this release
+/// does not know is stored as read in [name] and reads as no [swatch].
+/// `UnitIndex.diagnostics` reports both as `unit.invalid_colour`.
+final class UnitColour implements Component {
+  static const String componentTypeId = 'jetcad.unit_colour';
+
+  /// The colour [swatch], stored by its name (never its index: a palette
+  /// reordered or extended breaks no file).
+  UnitColour(PlanSwatch swatch) : this._(swatch.name, null);
+
+  UnitColour._(this.name, this.kept)
+      : _encoded = jsonEncode(kept ?? {'color': name});
+
+  /// The stored name: a palette entry's, or a name this release does not
+  /// know, as read. Null when the payload was [kept].
+  final String? name;
+
+  /// The payload as read, when it was not `{"color": String}`: written back
+  /// exactly as read. Unmodifiable, all the way down. Null otherwise.
+  final Map<String, Object?>? kept;
+
+  /// The payload's encoding, its equality.
+  final String _encoded;
+
+  /// Whether the payload was kept verbatim (and reads as no colour).
+  bool get isKept => kept != null;
+
+  /// The palette entry named [name]; null when the payload was [kept] or
+  /// the name is not one this release knows.
+  PlanSwatch? get swatch => planSwatchNamed(name);
+
+  @override
+  String get typeId => componentTypeId;
+
+  /// [kept] as read, or `{"color": name}`.
+  @override
+  Map<String, Object?> toJson() => kept ?? {'color': name};
+
+  /// The payload's colour when it is exactly `{"color": String}`, whatever
+  /// the string; otherwise the payload kept verbatim. Never throws.
+  static UnitColour fromJson(Map<String, Object?> json) {
+    final raw = json['color'];
+    if (json.length == 1 && raw is String) {
+      return UnitColour._(raw, null);
+    }
+    return UnitColour._(null, _frozen(json) as Map<String, Object?>);
+  }
+
+  /// A deep, unmodifiable copy of a decoded JSON value, its maps' key
+  /// order kept.
+  static Object? _frozen(Object? value) => switch (value) {
+        Map() => Map<String, Object?>.unmodifiable({
+            for (final MapEntry(:key, :value) in value.entries)
+              key as String: _frozen(value),
+          }),
+        List() =>
+          List<Object?>.unmodifiable([for (final v in value) _frozen(v)]),
+        _ => value,
+      };
+
+  @override
+  bool operator ==(Object other) =>
+      other is UnitColour && other._encoded == _encoded;
+
+  @override
+  int get hashCode => _encoded.hashCode;
+
+  @override
+  String toString() => 'UnitColour($_encoded)';
+}
+
+/// Registers [UnitData] and [UnitColour]. **Once per registry**: a second
+/// registration replaces the stores and drops every unit's data and
+/// colour.
+void registerUnitComponents(ComponentRegistry registry) {
+  registry.register<UnitData>(UnitData.componentTypeId, UnitData.fromJson);
+  registry.register<UnitColour>(
+      UnitColour.componentTypeId, UnitColour.fromJson);
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_detail.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_detail.dart
new file mode 100644
index 00000000..19bed6c9
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_detail.dart
@@ -0,0 +1,320 @@
+// A unit for an embedding host (spec 2b S3 "The unit API"): what the
+// controller lists (PlanUnit), with its geometry, layer, lock and the
+// host's data and colour (PlanUnitDetail), and the design's unit changes
+// (PlanUnitChange). Ported from jet_cad_floor_plan's FloorPlanTable
+// (host/floor_plan_types.dart:17-58), FloorPlanTableDetail and its builders
+// (host/table_detail.dart) and the design changes (host/design_changes.dart).
+// Never a handle (umbrella D18).
+import 'dart:math' as math;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart' show Offset, Size;
+import 'package:jet_cad_2d/jet_cad_2d.dart' show Aabb2, Handle, Transform2;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart' show PlanSwatch;
+
+/// One unit of the active plan, as a host sees it: never a handle.
+@immutable
+final class PlanUnit {
+  const PlanUnit(
+      {required this.label,
+      required this.kind,
+      required this.capacity,
+      required this.symbolKey,
+      this.visible = true,
+      this.generatedBy});
+
+  /// The unit's label, trimmed, or null while it has none.
+  final String? label;
+
+  /// Its kind (`table`, `seat`, a kit's own): its definition's.
+  final String kind;
+
+  /// How many it serves: its definition's.
+  final int capacity;
+
+  /// The library key of its symbol, or null for a hand-made one.
+  final String? symbolKey;
+
+  /// Whether its layer is shown: false for a unit on a hidden layer, which
+  /// the view neither shows nor lets anyone pick.
+  final bool visible;
+
+  /// The type id of the object that generates it (a seat's row), or null
+  /// for a placed unit.
+  final String? generatedBy;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnit &&
+      other.label == label &&
+      other.kind == kind &&
+      other.capacity == capacity &&
+      other.symbolKey == symbolKey &&
+      other.visible == visible &&
+      other.generatedBy == generatedBy;
+
+  @override
+  int get hashCode =>
+      Object.hash(label, kind, capacity, symbolKey, visible, generatedBy);
+
+  @override
+  String toString() => 'PlanUnit($label, $kind, $capacity, $symbolKey, '
+      'visible: $visible${generatedBy == null ? '' : ', generatedBy: $generatedBy'})';
+}
+
+/// One unit of the active plan with its geometry (today's
+/// `FloorPlanTableDetail`, table_detail.dart:14-124), as
+/// `PlanController.unitDetails` lists it. World coordinates are
+/// millimetres with y up. A unit's placement (its world transform: group ×
+/// instance for a generated one) is read as `R(rotation) · diag(sx, sy)`
+/// with `sx > 0`: [mirrored] means `sy < 0`. A unit the planner neither
+/// shows nor picks -- on a hidden layer, or a placement that is singular or
+/// has a corner that is not finite -- reports no geometry: [center] and
+/// [size] null, [corners] empty, [rotation] 0 and [mirrored] false.
+@immutable
+final class PlanUnitDetail {
+  const PlanUnitDetail({
+    required this.unit,
+    required this.center,
+    required this.size,
+    required this.rotation,
+    required this.mirrored,
+    required this.corners,
+    required this.layer,
+    required this.locked,
+    this.data = const <String, String>{},
+    this.colour,
+  });
+
+  final PlanUnit unit;
+
+  /// The centre of the symbol's bounding box in the world.
+  final Offset? center;
+
+  /// The symbol box's width and height in world millimetres.
+  final Size? size;
+
+  /// The unit's turn, radians, counter-clockwise (y up), in `(-π, π]`.
+  final double rotation;
+
+  /// Whether the placement mirrors (its determinant is negative).
+  final bool mirrored;
+
+  /// The symbol box's four corners in the world, counter-clockwise (y up)
+  /// whatever the mirror, starting at the image of the box's (min x, min
+  /// y) corner. Unmodifiable as the controller lists it.
+  final List<Offset> corners;
+
+  /// The name of the instance's layer (a generated unit's is its object's);
+  /// empty when the layer is missing from the plan's layers.
+  final String layer;
+
+  /// Whether the unit is locked (`isLockedUnit`: a locked layer, or a
+  /// frozen or a missing kit's object or symbol): tapped and reported,
+  /// never selected or moved.
+  final bool locked;
+
+  /// The host's data on the unit, keys ascending, unmodifiable. Empty for
+  /// a unit with none, and for one whose stored data is outside the limits
+  /// (kept as read, never refused).
+  final Map<String, String> data;
+
+  /// The unit's colour, or null for none and for a stored name this
+  /// release cannot read (kept as read).
+  final PlanSwatch? colour;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnitDetail &&
+      other.unit == unit &&
+      other.center == center &&
+      other.size == size &&
+      other.rotation == rotation &&
+      other.mirrored == mirrored &&
+      listEquals(other.corners, corners) &&
+      other.layer == layer &&
+      other.locked == locked &&
+      mapEquals(other.data, data) &&
+      other.colour == colour;
+
+  @override
+  int get hashCode => Object.hash(
+      unit,
+      center,
+      size,
+      rotation,
+      mirrored,
+      Object.hashAll(corners),
+      layer,
+      locked,
+      Object.hashAllUnordered(
+          [for (final e in data.entries) Object.hash(e.key, e.value)]),
+      colour);
+
+  @override
+  String toString() => 'PlanUnitDetail($unit, center: $center, '
+      'size: $size, rotation: $rotation, mirrored: $mirrored, '
+      'corners: $corners, layer: $layer, locked: $locked, data: $data'
+      '${colour == null ? '' : ', colour: $colour'})';
+}
+
+/// The detail of [unit], placed by [transform] over the symbol box [box],
+/// whose world corners are [corners] (`x0, y0, ..., x3, y3`, as
+/// `UnitCandidate` carries them). table_detail.dart:132-167.
+PlanUnitDetail unitDetailOf(
+    {required PlanUnit unit,
+    required Transform2 transform,
+    required Aabb2 box,
+    required Float64List corners,
+    required String layer,
+    required bool locked,
+    Map<String, String> data = const <String, String>{},
+    PlanSwatch? colour}) {
+  final m = transform;
+  var rotation = math.atan2(m.b, m.a);
+  if (rotation <= -math.pi) rotation += 2 * math.pi;
+  if (rotation == 0) rotation = 0.0;
+  final mirrored = m.determinant < 0;
+  final cx = (box.minX + box.maxX) / 2, cy = (box.minY + box.maxY) / 2;
+  Offset at(int i) => Offset(corners[2 * i], corners[2 * i + 1]);
+  return PlanUnitDetail(
+    unit: unit,
+    center: Offset(m.a * cx + m.c * cy + m.e, m.b * cx + m.d * cy + m.f),
+    size: Size((box.maxX - box.minX) * math.sqrt(m.a * m.a + m.b * m.b),
+        (box.maxY - box.minY) * math.sqrt(m.c * m.c + m.d * m.d)),
+    rotation: rotation,
+    mirrored: mirrored,
+    corners: List.unmodifiable(
+        mirrored ? [at(0), at(3), at(2), at(1)] : [at(0), at(1), at(2), at(3)]),
+    layer: layer,
+    locked: locked,
+    data: data,
+    colour: colour,
+  );
+}
+
+/// The detail of a unit that reports no geometry (table_detail.dart:
+/// 169-188).
+PlanUnitDetail unitDetailWithoutGeometry(
+        {required PlanUnit unit,
+        required String layer,
+        required bool locked,
+        Map<String, String> data = const <String, String>{},
+        PlanSwatch? colour}) =>
+    PlanUnitDetail(
+        unit: unit,
+        center: null,
+        size: null,
+        rotation: 0,
+        mirrored: false,
+        corners: const <Offset>[],
+        layer: layer,
+        locked: locked,
+        data: data,
+        colour: colour);
+
+/// One change of the design's units (today's `FloorPlanDesignChange`), as
+/// `PlanController.unitChanges` reports it.
+@immutable
+sealed class PlanUnitChange {
+  const PlanUnitChange();
+}
+
+/// A unit now in the design that was not: placed, generated by a grown
+/// row, or a delete undone (then [unit] equals the [PlanUnitRemoved.unit]
+/// the delete reported, its data included).
+final class PlanUnitAdded extends PlanUnitChange {
+  const PlanUnitAdded(this.unit);
+  final PlanUnitDetail unit;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnitAdded && other.unit == unit;
+
+  @override
+  int get hashCode => Object.hash(PlanUnitAdded, unit);
+
+  @override
+  String toString() => 'PlanUnitAdded($unit)';
+}
+
+/// A unit no longer in the design: deleted, dropped by a shrunk row, or
+/// its placement undone.
+final class PlanUnitRemoved extends PlanUnitChange {
+  const PlanUnitRemoved(this.unit);
+  final PlanUnitDetail unit;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnitRemoved && other.unit == unit;
+
+  @override
+  int get hashCode => Object.hash(PlanUnitRemoved, unit);
+
+  @override
+  String toString() => 'PlanUnitRemoved($unit)';
+}
+
+/// One unit whose detail changed: its label, kind, capacity, symbol,
+/// geometry, layer, lock, visibility, data or colour. [before] and [after]
+/// are the same unit (the same instance), whatever its label reads.
+final class PlanUnitChanged extends PlanUnitChange {
+  const PlanUnitChanged(this.before, this.after);
+  final PlanUnitDetail before;
+  final PlanUnitDetail after;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnitChanged &&
+      other.before == before &&
+      other.after == after;
+
+  @override
+  int get hashCode => Object.hash(PlanUnitChanged, before, after);
+
+  @override
+  String toString() => 'PlanUnitChanged($before, $after)';
+}
+
+/// The design was replaced whole (`load`, `newPlan`): a host reads
+/// `unitDetails` again.
+final class PlanUnitsReplaced extends PlanUnitChange {
+  const PlanUnitsReplaced();
+
+  @override
+  bool operator ==(Object other) => other is PlanUnitsReplaced;
+
+  @override
+  int get hashCode => (PlanUnitsReplaced).hashCode;
+
+  @override
+  String toString() => 'PlanUnitsReplaced()';
+}
+
+/// The changes from [before] to [after] (design_changes.dart:101-129), each
+/// list ascending by instance with [beforeInstances] and [afterInstances]
+/// naming each entry's instance index for index. O(before + after).
+List<PlanUnitChange> diffUnitDetails(
+    List<Handle> beforeInstances,
+    List<PlanUnitDetail> before,
+    List<Handle> afterInstances,
+    List<PlanUnitDetail> after) {
+  final out = <PlanUnitChange>[];
+  var i = 0, j = 0;
+  while (i < before.length || j < after.length) {
+    final a = i < before.length ? beforeInstances[i].value : null;
+    final b = j < after.length ? afterInstances[j].value : null;
+    if (b == null || (a != null && a < b)) {
+      out.add(PlanUnitRemoved(before[i++]));
+    } else if (a == null || b < a) {
+      out.add(PlanUnitAdded(after[j++]));
+    } else {
+      if (before[i] != after[j]) {
+        out.add(PlanUnitChanged(before[i], after[j]));
+      }
+      i++;
+      j++;
+    }
+  }
+  return out;
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_fit.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_fit.dart
new file mode 100644
index 00000000..796ecfee
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_fit.dart
@@ -0,0 +1,64 @@
+// Framing units (zone spec Z3; 2b S3, ported from jet_cad_floor_plan
+// host/table_fit.dart): the camera a framing sets, from the bound of the
+// units' boxes and the drawing area's size. Pure: no document, no
+// controller.
+import 'dart:ui' show Size;
+
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show ViewportTransform;
+
+import '../controller/camera_bounds.dart' show kPlanMaxScale, kPlanMinScale;
+
+/// The floor a framing shows round its units, per side, in millimetres:
+/// an aisle, and the group frame (150 mm) at any zoom (zone spec Z3).
+const double kUnitFitMarginMm = 500;
+
+/// The least span a framing shows on each axis, in millimetres: 3 m of
+/// floor round one unit, never a poster of it (zone spec Z3).
+const double kUnitFitMinSpanMm = 3000;
+
+/// The camera that frames [box], a non-empty world bound of units, in a
+/// drawing area of [viewport] (zone spec Z3): [box] grown by
+/// [kUnitFitMarginMm] per side, then about its centre to at least
+/// [kUnitFitMinSpanMm] per axis, fitted as [ViewportTransform.fit] fits
+/// (5 % margin, y flipped), its scale clamped to `[minScale, maxScale]`
+/// (by default the planner's own, `[kPlanMinScale, kPlanMaxScale]`; a
+/// controller passes its bounds, host embedding API spec G-3) about the
+/// same centre.
+///
+/// The centre is taken as `min / 2 + max / 2`, which cannot overflow where
+/// `(min + max) / 2` would (Task 1 review R-1: a unit near the double
+/// range); halving is exact, so elsewhere the two are the same number.
+ViewportTransform frameUnits(Aabb2 box, Size viewport,
+    {double minScale = kPlanMinScale, double maxScale = kPlanMaxScale}) {
+  assert(!box.isEmpty, 'frameUnits needs a non-empty box');
+  var minX = box.minX - kUnitFitMarginMm, maxX = box.maxX + kUnitFitMarginMm;
+  var minY = box.minY - kUnitFitMarginMm, maxY = box.maxY + kUnitFitMarginMm;
+  final cx = minX / 2 + maxX / 2, cy = minY / 2 + maxY / 2;
+  if (maxX - minX < kUnitFitMinSpanMm) {
+    minX = cx - kUnitFitMinSpanMm / 2;
+    maxX = cx + kUnitFitMinSpanMm / 2;
+  }
+  if (maxY - minY < kUnitFitMinSpanMm) {
+    minY = cy - kUnitFitMinSpanMm / 2;
+    maxY = cy + kUnitFitMinSpanMm / 2;
+  }
+  // The fit's scale; its translation is built here, about the safe
+  // centre, since `ViewportTransform.fit` takes `(min + max) / 2`.
+  final s = ViewportTransform.fit(Aabb2.raw(minX, minY, maxX, maxY), viewport)
+      .worldToScreenMatrix
+      .a;
+  // The clamp is dead in practice (a 316,000 px view, a 950 m box), and
+  // harmless: the same centre at the bound's scale.
+  final clamped = s.clamp(minScale, maxScale);
+  final mx = minX / 2 + maxX / 2, my = minY / 2 + maxY / 2;
+  return ViewportTransform(
+      worldToScreenMatrix: Transform2(
+          clamped,
+          0,
+          0,
+          -clamped,
+          viewport.width / 2 - clamped * mx,
+          viewport.height / 2 + clamped * my));
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_index.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_index.dart
new file mode 100644
index 00000000..8ea9c785
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_index.dart
@@ -0,0 +1,378 @@
+// The units of a plan (spec 2b S2 "A unit", "UnitIndex", "Diagnostics",
+// "Unlabelled, duplicate and bad labels"): every live symbol instance whose
+// definition carries `jetcad.unit`, placed at the root or generated by an
+// object, in one pass, with its label, its lock, its world transform and
+// its definition-space top and box. Replaces jet_cad_floor_plan's
+// TableSurvey (tables/table_index.dart:61-226); the top and box follow
+// service/table_picker.dart:92-110, :259-299.
+import 'package:flutter/foundation.dart'
+    show ValueListenable, visibleForTesting;
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart'
+    show SymbolComponent, UnitComponent, UnitLabelling, kUnitLabelTag;
+
+import '../kits/locks.dart';
+import '../symbols/symbol_box.dart' show boxOfLeaves;
+import 'unit_components.dart';
+import 'unit_label.dart';
+import 'unit_locks.dart';
+import 'unit_problems.dart';
+
+/// One unit.
+final class UnitInfo {
+  const UnitInfo({
+    required this.instance,
+    required this.definition,
+    this.owner,
+    this.ownerType,
+    this.label,
+    this.text,
+    required this.kind,
+    required this.capacity,
+    required this.labelling,
+    this.symbolKey,
+    required this.locked,
+    required this.visible,
+    required this.toWorld,
+    required this.top,
+    required this.box,
+  });
+
+  final Handle instance;
+  final Handle definition;
+
+  /// The generating object (a root-level group); null when placed.
+  final Handle? owner;
+
+  /// The owner's type id, or the missing kit's component type id of a held
+  /// group; null when placed.
+  final String? ownerType;
+
+  /// The lowest-handle `UNIT` ATTRIB; null when there is none.
+  final Handle? label;
+
+  /// [label]'s text, trimmed; null when unlabelled (no label, or an empty
+  /// one).
+  final String? text;
+
+  final String kind;
+  final int capacity;
+  final UnitLabelling labelling;
+
+  /// The definition's `jetcad.symbol` key; null for a hand-made one.
+  final String? symbolKey;
+
+  /// [isLockedUnit].
+  final bool locked;
+
+  /// The instance's layer is shown (a missing layer counts as shown).
+  final bool visible;
+
+  /// Definition space to world: the instance's transform, after its root
+  /// group's for a generated unit.
+  final Transform2 toWorld;
+
+  /// Definition space: the served top (the first leaf, a closed polyline or
+  /// a circle), else [box].
+  final Aabb2 top;
+
+  /// Definition space: the symbol's box.
+  final Aabb2 box;
+
+  bool get generated => owner != null;
+
+  @override
+  String toString() => 'UnitInfo(${instance.toHex()}, $text, $kind)';
+}
+
+/// The units of one document, and what their labels and data raise.
+final class UnitIndex {
+  UnitIndex._(this.units, this.nested, this._byInstance, this._extraLabels,
+      this._keptData, this._invalidColour);
+
+  /// How many indexes [UnitIndex.of] has built (today's
+  /// `TableSurvey.surveys`): a test counts the passes a rebuild costs.
+  @visibleForTesting
+  static int debugBuilds = 0;
+
+  /// One pass, O(nodes + entities): at document-change rate (through
+  /// [UnitIndexCache]), never per frame.
+  factory UnitIndex.of(CommandTarget document,
+      {required ParametricCatalog catalog, required LockSet locks}) {
+    final entities = document.entities;
+    final tree = document.tree;
+    final root = tree.root;
+    // One bucketing pass: the UNIT labels by owner, every other leaf by
+    // owner (a definition's leaves among them).
+    final labels = <Handle, List<(Handle, String)>>{};
+    final leaves = <Handle, List<int>>{};
+    for (final slot in entities.liveSlots) {
+      final owner = entities.ownerAt(slot);
+      if (entities.kindAt(slot) == EntityKind.attrib) {
+        if (entities.tagAt(slot) == kUnitLabelTag) {
+          (labels[owner] ??= [])
+              .add((entities.handleAt(slot), entities.textAt(slot)));
+        }
+        continue;
+      }
+      (leaves[owner] ??= []).add(slot);
+    }
+    final shapes = <Handle, (Aabb2, Aabb2)>{};
+    (Aabb2, Aabb2) shapeOf(Handle definition) =>
+        shapes.putIfAbsent(definition, () {
+          final slots = [...?leaves[definition]]..sort((a, b) =>
+              entities.handleAt(a).value.compareTo(entities.handleAt(b).value));
+          final list = [
+            for (final s in slots)
+              (
+                entities.kindAt(s),
+                document.geometry.read(entities.geomIndexAt(s))
+              ),
+          ];
+          final b = boxOfLeaves(list);
+          return (
+            unitTopOfLeaves(list),
+            b == null
+                ? Aabb2.empty()
+                : Aabb2.raw(b.left, b.front, b.right, b.back),
+          );
+        });
+
+    final units = <UnitInfo>[];
+    final nested = <Handle>[];
+    final extra = <Handle, List<Handle>>{};
+    final kept = <Handle>{};
+    final invalidColour = <Handle>{};
+    // `tree.nodes` is ascending by handle (its contract), so both lists are
+    // too.
+    for (final node in tree.nodes) {
+      if (node is! InstanceNode) continue;
+      if (tree.definition(node.definition) == null) continue;
+      final unit = document.components.get<UnitComponent>(node.definition);
+      if (unit == null) continue;
+      Handle? owner;
+      String? ownerType;
+      var toWorld = node.transform;
+      if (node.parent != root) {
+        final parent = tree[node.parent];
+        if (parent is! GroupNode || parent.parent != root) {
+          nested.add(node.handle);
+          continue;
+        }
+        final typeId = catalog.typeIdOf(document, parent.handle);
+        if (typeId == null && !locks.isLockedObject(parent.handle)) {
+          nested.add(node.handle);
+          continue;
+        }
+        owner = parent.handle;
+        ownerType = typeId ?? heldTypeOf(document, parent.handle);
+        toWorld = parent.transform.multiply(node.transform);
+      }
+      final own = labels[node.handle]
+        ?..sort((a, b) => a.$1.value.compareTo(b.$1.value));
+      if (own != null && own.length > 1) {
+        extra[node.handle] = [for (final l in own.skip(1)) l.$1];
+      }
+      final layer = document.tables.layers[node.layer];
+      final (top, box) = shapeOf(node.definition);
+      units.add(UnitInfo(
+        instance: node.handle,
+        definition: node.definition,
+        owner: owner,
+        ownerType: ownerType,
+        label: own?.first.$1,
+        // An empty label is no label (today's demo review F-7).
+        text: switch (own?.first.$2.trim()) {
+          null || '' => null,
+          final t => t,
+        },
+        kind: unit.kind,
+        capacity: unit.capacity,
+        labelling: unit.labelling,
+        symbolKey:
+            document.components.get<SymbolComponent>(node.definition)?.key,
+        locked: isLockedUnit(document, locks, node.handle),
+        visible: layer?.visible ?? true,
+        toWorld: toWorld,
+        top: top,
+        box: box,
+      ));
+      if (document.components.get<UnitData>(node.handle)?.isKept ?? false) {
+        kept.add(node.handle);
+      }
+      final colour = document.components.get<UnitColour>(node.handle);
+      if (colour != null && colour.swatch == null) {
+        invalidColour.add(node.handle);
+      }
+    }
+    return UnitIndex._(
+        List.unmodifiable(units),
+        List.unmodifiable(nested),
+        {for (final u in units) u.instance: u},
+        Map.unmodifiable(extra),
+        kept,
+        invalidColour);
+  }
+
+  /// Every unit, served or not, ascending by instance handle.
+  final List<UnitInfo> units;
+
+  /// Unit instances that are neither placed nor generated (`unit.nested`),
+  /// ascending.
+  final List<Handle> nested;
+
+  final Map<Handle, UnitInfo> _byInstance;
+  final Map<Handle, List<Handle>> _extraLabels;
+  final Set<Handle> _keptData;
+  final Set<Handle> _invalidColour;
+
+  UnitInfo? operator [](Handle instance) => _byInstance[instance];
+
+  /// The units labelled [label] (trimmed, exact `==`), ascending.
+  List<UnitInfo> withLabel(String label) {
+    final l = label.trim();
+    return [
+      for (final u in units)
+        if (u.text == l) u,
+    ];
+  }
+
+  /// The units' diagnostics (spec S2), in a stable order: duplicates by
+  /// first appearance; then per unit ascending: unlabelled or a bad label,
+  /// extra labels, invalid data, an invalid colour; then the nested ones.
+  List<Diagnostic> diagnostics() {
+    final out = <Diagnostic>[];
+    final byLabel = <String, List<Handle>>{};
+    for (final u in units) {
+      if (u.text case final t?) (byLabel[t] ??= []).add(u.instance);
+    }
+    for (final MapEntry(key: label, value: handles) in byLabel.entries) {
+      if (handles.length < 2) continue;
+      out.add(Diagnostic(
+        severity: DiagnosticSeverity.warning,
+        code: UnitProblem.duplicateLabel,
+        message: 'Label $label is used by ${handles.length} units',
+        handles: handles,
+      ));
+    }
+    for (final u in units) {
+      final h = u.instance;
+      final text = u.text;
+      if (text == null) {
+        out.add(Diagnostic(
+          severity: DiagnosticSeverity.warning,
+          code: UnitProblem.unlabelled,
+          message: 'Unit ${h.toHex()} has no label',
+          handles: [h],
+        ));
+      } else if (unitLabelError(text) case final error?) {
+        out.add(Diagnostic(
+          severity: DiagnosticSeverity.warning,
+          code: UnitProblem.badLabel,
+          message: 'Unit ${h.toHex()} is labelled "$text" ($error); it is '
+              'served by its text',
+          handles: [h],
+        ));
+      }
+      final more = _extraLabels[h];
+      if (more != null) {
+        out.add(Diagnostic(
+          severity: DiagnosticSeverity.warning,
+          code: UnitProblem.extraLabel,
+          message: 'Unit ${h.toHex()} has ${more.length + 1} labels; the '
+              'first is used',
+          handles: [h, ...more],
+        ));
+      }
+      if (_keptData.contains(h)) {
+        out.add(Diagnostic(
+          severity: DiagnosticSeverity.warning,
+          code: UnitProblem.invalidData,
+          message: 'Unit ${h.toHex()} carries host data outside the limits; '
+              'it is kept as read and reads as none',
+          handles: [h],
+        ));
+      }
+      if (_invalidColour.contains(h)) {
+        out.add(Diagnostic(
+          severity: DiagnosticSeverity.warning,
+          code: UnitProblem.invalidColour,
+          message: 'Unit ${h.toHex()} carries a colour this release cannot '
+              'read; it is kept as read and drawn as none',
+          handles: [h],
+        ));
+      }
+    }
+    for (final h in nested) {
+      out.add(Diagnostic(
+        severity: DiagnosticSeverity.info,
+        code: UnitProblem.nested,
+        message: '${h.toHex()} is neither at the root nor an object\'s and '
+            'is not a unit',
+        handles: [h],
+      ));
+    }
+    return out;
+  }
+
+  /// The label warnings a host sees (`labelWarnings`): [DuplicateLabel] in
+  /// first-appearance order, then [Unlabelled], then [BadLabel], ascending.
+  List<UnitLabelWarning> warnings() {
+    final counts = <String, int>{};
+    for (final u in units) {
+      if (u.text case final t?) counts[t] = (counts[t] ?? 0) + 1;
+    }
+    return List.unmodifiable(<UnitLabelWarning>[
+      for (final MapEntry(key: label, value: count) in counts.entries)
+        if (count > 1) DuplicateLabel(label: label, count: count),
+      for (final u in units)
+        if (u.text == null)
+          Unlabelled(
+              kind: u.kind, capacity: u.capacity, symbolKey: u.symbolKey),
+      for (final u in units)
+        if (u.text case final t?)
+          if (unitLabelProblem(t) case final p?) BadLabel(label: t, problem: p),
+    ]);
+  }
+}
+
+/// One session's [UnitIndex], rebuilt when the document's state id or its
+/// tables' revision moves, or when [locked] has notified (a freeze moves no
+/// state id, spec S2). A read with none of them moved returns the same
+/// index.
+final class UnitIndexCache {
+  UnitIndexCache(this.document,
+      {required this.catalog,
+      required this.locks,
+      required ValueListenable<Set<Handle>> locked})
+      : _locked = locked {
+    _locked.addListener(_lockedChanged);
+  }
+
+  final DraftDocument document;
+  final ParametricCatalog catalog;
+  final LockSet locks;
+  final ValueListenable<Set<Handle>> _locked;
+
+  UnitIndex? _index;
+  int? _state;
+  int? _revision;
+  bool _stale = true;
+
+  UnitIndex get current {
+    final state = document.commands.stateId;
+    final revision = document.tables.mutationRevision;
+    final index = _index;
+    if (index != null && !_stale && state == _state && revision == _revision) {
+      return index;
+    }
+    _state = state;
+    _revision = revision;
+    _stale = false;
+    return _index = UnitIndex.of(document, catalog: catalog, locks: locks);
+  }
+
+  void _lockedChanged() => _stale = true;
+
+  void dispose() => _locked.removeListener(_lockedChanged);
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_label.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_label.dart
new file mode 100644
index 00000000..0ae282da
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_label.dart
@@ -0,0 +1,203 @@
+// A unit's label (spec 2b S2 "The label"): the text rule (today's table
+// number rule, jet_cad_floor_plan/lib/src/tables/table_numbers.dart:5-46,
+// renamed), the label record and command of a placed unit
+// (table_label.dart:106-179), and how a unit's label and top are read. The
+// stamp, the height and the payload are the kit's (Task 3).
+//
+// No Flutter import: Dart over package:jet_cad_2d and the kit's model.
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart'
+    show kUnitLabelTag, kUnitLabelTextAttrs, unitLabelHeight, unitLabelPayload;
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../symbols/symbol_box.dart' show boxOfLeaves;
+
+/// A label's longest length, in UTF-16 code units.
+const int kUnitLabelMaxLength = 8;
+
+/// Why a text is not a unit label, as a value a UI words.
+enum UnitLabelProblem {
+  /// Empty, or longer than [kUnitLabelMaxLength] code units, trimmed.
+  length,
+
+  /// A control character, a line break among them.
+  control,
+}
+
+/// Whether the UTF-16 code unit [u] is a control character: below U+0020
+/// (C0, a line break among them) or U+007F to U+009F (DEL and C1). The one
+/// rule [unitLabelProblem] and the unit data limits share.
+bool isControlCodeUnit(int u) => u < 0x20 || (u >= 0x7F && u <= 0x9F);
+
+/// Why [raw], trimmed, is not a unit label, or null when it is one:
+/// non-empty, at most [kUnitLabelMaxLength] code units, no control
+/// character.
+UnitLabelProblem? unitLabelProblem(String raw) {
+  final n = raw.trim();
+  if (n.isEmpty || n.length > kUnitLabelMaxLength) {
+    return UnitLabelProblem.length;
+  }
+  if (n.codeUnits.any(isControlCodeUnit)) return UnitLabelProblem.control;
+  return null;
+}
+
+/// [unitLabelProblem] in English, or null (diagnostic messages; the UI's
+/// words are `PlanStrings.labelProblem`).
+String? unitLabelError(String raw) => switch (unitLabelProblem(raw)) {
+      null => null,
+      UnitLabelProblem.length => '1 to $kUnitLabelMaxLength characters',
+      UnitLabelProblem.control => 'No line breaks or control characters',
+    };
+
+/// The label record of a placed unit: owned by [instance], on layer 0 (so
+/// it follows the instance's layer, spec 12b S-2), BYBLOCK style, the
+/// standard text style, tag `UNIT`, text [text].
+EntityRecord unitLabelRecord(
+        {required Handle handle,
+        required Handle instance,
+        required String text}) =>
+    EntityRecord(
+      handle: handle,
+      owner: instance,
+      kind: EntityKind.attrib,
+      layer: ReservedHandles.layerZero,
+      linetype: ReservedHandles.byBlockLinetype,
+      linetypeScale: 1.0,
+      geomIndex: 0,
+      color: const ByBlockColor(),
+      lineweight: kByBlock,
+      transparency: kByBlock,
+      flags: 0,
+      text: text,
+      tag: kUnitLabelTag,
+      textStyle: ReservedHandles.standardTextStyle,
+      textAttrs: kUnitLabelTextAttrs,
+    );
+
+/// The lowest-handle leaf [owner] owns, or null. O(entities): at command
+/// or document-change rate, never per frame. With [leavesByOwner]
+/// ([DraftDocument.leavesByOwner], shared by a caller asking for many
+/// owners in one pass), only [owner]'s own leaves are visited.
+/// (`tables/table_label.dart:155-181`, `CommandTarget` for `DraftDocument`.)
+({EntityKind kind, GeometryPayload payload})? firstLeafOf(
+    CommandTarget target, Handle owner,
+    [Map<Handle, List<int>>? leavesByOwner]) {
+  final entities = target.entities;
+  int? best;
+  final slots = leavesByOwner == null
+      ? entities.liveSlots
+      : leavesByOwner[owner] ?? const <int>[];
+  for (final slot in slots) {
+    if (entities.ownerAt(slot) != owner) continue;
+    if (best == null ||
+        entities.handleAt(slot).value < entities.handleAt(best).value) {
+      best = slot;
+    }
+  }
+  if (best == null) return null;
+  return (
+    kind: entities.kindAt(best),
+    payload: target.geometry.read(entities.geomIndexAt(best)),
+  );
+}
+
+/// The top of a definition whose [leaves] are given ascending by handle
+/// (spec S2, `SymbolDefinitionRef.top`): the first leaf's box when it is a
+/// closed polyline or a circle, else the leaves' box (`boxOfLeaves`);
+/// empty for none.
+Aabb2 unitTopOfLeaves(List<(EntityKind, GeometryPayload)> leaves) {
+  if (leaves.isNotEmpty) {
+    final (kind, p) = leaves.first;
+    if (kind == EntityKind.circle) {
+      final r = p.scalars[0];
+      return Aabb2.raw(
+          p.coords[0] - r, p.coords[1] - r, p.coords[0] + r, p.coords[1] + r);
+    }
+    if (kind == EntityKind.polyline && isClosedPolyline(p)) {
+      final b = boxOfLeaves([leaves.first]);
+      if (b != null) return Aabb2.raw(b.left, b.front, b.right, b.back);
+    }
+  }
+  final b = boxOfLeaves(leaves);
+  return b == null
+      ? Aabb2.empty()
+      : Aabb2.raw(b.left, b.front, b.right, b.back);
+}
+
+/// The box a placed unit's label height reads (spec S2: today's stamp,
+/// `tables/table_label.dart:22-44`): the first leaf's box when it is a
+/// circle or a polyline, open or closed; else empty, which gives the full
+/// height. Not the unit's top ([unitTopOfLeaves], spec S2's rule for
+/// `SymbolDefinitionRef.top` and `UnitInfo.top`): today's label reads an
+/// open polyline's box and never the other leaves (controller ruling
+/// R-21; the placer, the unit API's new label and the fixtures read this).
+Aabb2 placedLabelTop(List<(EntityKind, GeometryPayload)> leaves) {
+  if (leaves.isEmpty) return Aabb2.empty();
+  final (kind, p) = leaves.first;
+  switch (kind) {
+    case EntityKind.circle:
+      final r = p.scalars[0];
+      return Aabb2.raw(
+          p.coords[0] - r, p.coords[1] - r, p.coords[0] + r, p.coords[1] + r);
+    case EntityKind.polyline:
+      final c = p.coords;
+      var minX = c[0], maxX = c[0], minY = c[1], maxY = c[1];
+      for (var i = 2; i + 1 < c.length; i += 2) {
+        if (c[i] < minX) minX = c[i];
+        if (c[i] > maxX) maxX = c[i];
+        if (c[i + 1] < minY) minY = c[i + 1];
+        if (c[i + 1] > maxY) maxY = c[i + 1];
+      }
+      return Aabb2.raw(minX, minY, maxX, maxY);
+    default:
+      return Aabb2.empty();
+  }
+}
+
+/// [placedLabelTop] of [definition]'s first leaf in [target].
+/// O(entities), at command rate.
+Aabb2 placedLabelTopOf(CommandTarget target, Handle definition) {
+  final leaf = firstLeafOf(target, definition);
+  return leaf == null
+      ? Aabb2.empty()
+      : placedLabelTop([(leaf.kind, leaf.payload)]);
+}
+
+/// The command that adds [text] as the label of [instance], an instance of
+/// [definition] placed by [placement]: anchored at the definition's base
+/// point, the height of its top, stamped upright. Allocates one handle.
+AddEntityCommand addUnitLabelCommand(
+  DraftDocument doc, {
+  required Handle instance,
+  required Handle definition,
+  required Transform2 placement,
+  required String text,
+}) {
+  final def = doc.tree.definition(definition);
+  return AddEntityCommand(
+    record: unitLabelRecord(
+        handle: doc.handleSeed.next(), instance: instance, text: text),
+    payload: unitLabelPayload(
+      anchor: def?.basePoint ?? Vector2.zero(),
+      height: unitLabelHeight(placedLabelTopOf(doc, definition)),
+      instanceToWorld: placement,
+    ),
+  );
+}
+
+/// The lowest-handle `UNIT` ATTRIB [instance] owns, or null. O(entities),
+/// at command rate.
+Handle? unitLabelOf(CommandTarget target, Handle instance) {
+  final e = target.entities;
+  Handle? best;
+  for (final slot in e.liveSlots) {
+    if (e.ownerAt(slot) != instance ||
+        e.kindAt(slot) != EntityKind.attrib ||
+        e.tagAt(slot) != kUnitLabelTag) {
+      continue;
+    }
+    final h = e.handleAt(slot);
+    if (best == null || h.value < best.value) best = h;
+  }
+  return best;
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_label_system.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_label_system.dart
new file mode 100644
index 00000000..20189df8
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_label_system.dart
@@ -0,0 +1,171 @@
+// The unit label system (spec 2b S2 "The label system"): keeps every placed
+// unit's label upright, inside the edit that turns or mirrors the unit, as
+// one undo step. Ported from jet_cad_floor_plan's
+// tables/table_label_system.dart (TableLabelSystem, TableLabelEdit) and
+// table_label.dart (restampedTableLabel): the servable check is the
+// definition's UnitComponent, the root rule is kept. A generated unit's
+// label is its type's, restamped by its regeneration (spec S1). A deleted
+// unit's data and colour are not this file's: the delete takes them
+// (`RemoveNodeCommand`, node-components D-1).
+//
+// No Flutter import: Dart over package:jet_cad_2d and the kit's model.
+import 'dart:typed_data';
+
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart'
+    show UnitComponent, kUnitLabelMaxHeight, unitLabelStamp;
+
+import 'unit_label.dart' show unitLabelOf;
+
+/// [payload] re-stamped for [placement]: anchor and height kept, rotation
+/// and width factor replaced. Null when they already match by exact `==`
+/// (stored values), so a translation writes nothing.
+GeometryPayload? restampedUnitLabel(
+    GeometryPayload payload, Transform2 placement) {
+  final s = unitLabelStamp(placement);
+  final scalars = payload.scalars;
+  if (scalars.length >= 3 &&
+      scalars[1] == s.rotation &&
+      scalars[2] == s.widthFactor) {
+    return null;
+  }
+  return GeometryPayload(
+    coords: Float64List.fromList(payload.coords),
+    scalars: Float64List.fromList([
+      scalars.isEmpty ? kUnitLabelMaxHeight : scalars[0],
+      s.rotation,
+      s.widthFactor,
+    ]),
+  );
+}
+
+/// Stacks on the dispatcher's one expander slot (spec 06 D2, 14a F-1):
+/// [install] keeps the expander it found (the parametric system's, or none)
+/// and wraps what that one returns; [dispose] puts it back.
+///
+/// **Last in, first out.** The session installs this after the parametric
+/// system and before the lock expander (parametric system → this → lock
+/// expander) and disposes in reverse; out of order, this would put a
+/// disposed system's tear-off back in the slot, so [dispose] asserts that
+/// the slot still holds its own.
+final class UnitLabelSystem {
+  UnitLabelSystem(this.document);
+
+  final DraftDocument document;
+  DraftCommand Function(DraftCommand command)? _previous;
+  bool _installed = false;
+
+  void install() {
+    if (_installed) {
+      throw StateError('the unit label system is installed already');
+    }
+    _previous = document.commands.expander;
+    document.commands.expander = _expand;
+    _installed = true;
+  }
+
+  /// Puts the expander [install] found back, only if the slot still holds
+  /// this system's own tear-off.
+  void dispose() {
+    if (!_installed) return;
+    _installed = false;
+    final mine = document.commands.expander == _expand;
+    if (mine) document.commands.expander = _previous;
+    _previous = null;
+    assert(mine, 'UnitLabelSystem disposed out of order (spec 2b S2)');
+  }
+
+  DraftCommand _expand(DraftCommand command) {
+    final inner = _previous?.call(command) ?? command;
+    // The cheap path: a plan with no unit definition has no placed unit.
+    if (document.components.withComponent<UnitComponent>().isEmpty) {
+      return inner;
+    }
+    return UnitLabelEdit._(inner);
+  }
+}
+
+/// An edit and the derived commands it makes necessary: [inner] applies,
+/// then, per touched handle in `touched`'s order, a placed unit whose label
+/// no longer matches [unitLabelStamp] for its transform is re-stamped, by
+/// exact `==` on the stored values. All or nothing; undo restores the
+/// stamps and the edit. Created only by [UnitLabelSystem], once per
+/// `execute`.
+final class UnitLabelEdit extends DraftCommand {
+  UnitLabelEdit._(this.inner);
+
+  final DraftCommand inner;
+  bool _stamped = false;
+
+  @override
+  String get label => inner.label;
+
+  /// [inner]'s own: a stamp is derived data inside the edit that causes it
+  /// and adds no authority (T12, F-2). A translation never stamps.
+  @override
+  Set<Capability> get capabilities => inner.capabilities;
+
+  /// Raised to `geometry` when a label was written, so the index does not
+  /// skip it (F-2's rule).
+  @override
+  Capability get capability =>
+      _stamped && inner.capability.index < Capability.geometry.index
+          ? Capability.geometry
+          : inner.capability;
+
+  @override
+  CommandResult apply(CommandTarget target) {
+    final r = inner.apply(target);
+    final inverses = <DraftCommand>[];
+    final written = <Handle>{};
+    var stamps = 0;
+    try {
+      for (final h in r.touched) {
+        final DraftCommand derived;
+        if (_stampFor(target, h) case final stamp?) {
+          derived = stamp;
+          stamps++;
+        } else {
+          continue;
+        }
+        final result = derived.apply(target);
+        inverses.add(result.inverse);
+        written.addAll(result.touched);
+      }
+    } catch (_) {
+      // All or nothing: the stamps written so far, then the edit itself.
+      for (final inverse in inverses.reversed) {
+        inverse.apply(target);
+      }
+      r.inverse.apply(target);
+      rethrow;
+    }
+    _stamped = stamps > 0;
+    if (inverses.isEmpty) return r;
+    // A replay with the edit's own authority: undo and redo need exactly
+    // what the edit needed, not the stamps' `geometry` (review R-5).
+    return CommandResult(
+      inverse: ParametricReplay(
+          CompoundCommand([...inverses.reversed, r.inverse], label: label),
+          inner.capabilities),
+      touched: {...r.touched, ...written},
+    );
+  }
+
+  /// The stamp [h] needs, or null: [h] is a placed unit (a live, root-level
+  /// instance of a definition carrying `jetcad.unit`) with a `UNIT` label
+  /// whose rotation or width factor differs from its transform's stamp.
+  static DraftCommand? _stampFor(CommandTarget target, Handle h) {
+    final node = target.tree[h];
+    if (node is! InstanceNode || node.parent != target.tree.root) return null;
+    if (target.components.get<UnitComponent>(node.definition) == null) {
+      return null;
+    }
+    final label = unitLabelOf(target, h);
+    if (label == null) return null;
+    final payload = target.geometry
+        .read(target.entities.geomIndexAt(target.entities.slotOf(label)!));
+    final next = restampedUnitLabel(payload, node.transform);
+    return next == null ? null : SetEntityGeometryCommand(label, next);
+  }
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_locks.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_locks.dart
