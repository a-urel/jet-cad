+  TouchPress get touchPress => TouchPress.press;
+
+  @override
+  ToolPhase get phase => switch (_gesture) {
+        _Gesture.none => ToolPhase.idle,
+        _Gesture.pressed || _Gesture.spent => ToolPhase.pressed,
+        _Gesture.dragging ||
+        _Gesture.panning ||
