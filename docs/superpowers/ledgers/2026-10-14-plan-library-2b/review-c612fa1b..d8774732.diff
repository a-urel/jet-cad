+  const PlanUnitChanged(this.before, this.after);
+  final PlanUnitDetail before;
+  final PlanUnitDetail after;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnitChanged &&
+      other.before == before &&
+      other.after == after;
+
+  @override
+  int get hashCode => Object.hash(PlanUnitChanged, before, after);
+
+  @override
+  String toString() => 'PlanUnitChanged($before, $after)';
+}
+
+/// The design was replaced whole (`load`, `newPlan`): a host reads
+/// `unitDetails` again.
+final class PlanUnitsReplaced extends PlanUnitChange {
+  const PlanUnitsReplaced();
+
+  @override
+  bool operator ==(Object other) => other is PlanUnitsReplaced;
+
+  @override
+  int get hashCode => (PlanUnitsReplaced).hashCode;
+
+  @override
+  String toString() => 'PlanUnitsReplaced()';
+}
+
+/// The changes from [before] to [after] (design_changes.dart:101-129), each
+/// list ascending by instance with [beforeInstances] and [afterInstances]
+/// naming each entry's instance index for index. O(before + after).
+List<PlanUnitChange> diffUnitDetails(
+    List<Handle> beforeInstances,
+    List<PlanUnitDetail> before,
+    List<Handle> afterInstances,
+    List<PlanUnitDetail> after) {
+  final out = <PlanUnitChange>[];
+  var i = 0, j = 0;
+  while (i < before.length || j < after.length) {
+    final a = i < before.length ? beforeInstances[i].value : null;
+    final b = j < after.length ? afterInstances[j].value : null;
+    if (b == null || (a != null && a < b)) {
+      out.add(PlanUnitRemoved(before[i++]));
+    } else if (a == null || b < a) {
+      out.add(PlanUnitAdded(after[j++]));
+    } else {
+      if (before[i] != after[j]) {
+        out.add(PlanUnitChanged(before[i], after[j]));
+      }
+      i++;
+      j++;
+    }
+  }
+  return out;
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/units/unit_fit.dart b/packages/jet_cad_2d_plan/lib/src/units/unit_fit.dart
new file mode 100644
index 00000000..796ecfee
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/units/unit_fit.dart
@@ -0,0 +1,64 @@
+// Framing units (zone spec Z3; 2b S3, ported from jet_cad_floor_plan
+// host/table_fit.dart): the camera a framing sets, from the bound of the
+// units' boxes and the drawing area's size. Pure: no document, no
+// controller.
+import 'dart:ui' show Size;
+
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show ViewportTransform;
+
+import '../controller/camera_bounds.dart' show kPlanMaxScale, kPlanMinScale;
+
+/// The floor a framing shows round its units, per side, in millimetres:
+/// an aisle, and the group frame (150 mm) at any zoom (zone spec Z3).
+const double kUnitFitMarginMm = 500;
+
+/// The least span a framing shows on each axis, in millimetres: 3 m of
+/// floor round one unit, never a poster of it (zone spec Z3).
+const double kUnitFitMinSpanMm = 3000;
+
+/// The camera that frames [box], a non-empty world bound of units, in a
+/// drawing area of [viewport] (zone spec Z3): [box] grown by
+/// [kUnitFitMarginMm] per side, then about its centre to at least
+/// [kUnitFitMinSpanMm] per axis, fitted as [ViewportTransform.fit] fits
+/// (5 % margin, y flipped), its scale clamped to `[minScale, maxScale]`
+/// (by default the planner's own, `[kPlanMinScale, kPlanMaxScale]`; a
+/// controller passes its bounds, host embedding API spec G-3) about the
+/// same centre.
+///
+/// The centre is taken as `min / 2 + max / 2`, which cannot overflow where
+/// `(min + max) / 2` would (Task 1 review R-1: a unit near the double
+/// range); halving is exact, so elsewhere the two are the same number.
+ViewportTransform frameUnits(Aabb2 box, Size viewport,
+    {double minScale = kPlanMinScale, double maxScale = kPlanMaxScale}) {
+  assert(!box.isEmpty, 'frameUnits needs a non-empty box');
+  var minX = box.minX - kUnitFitMarginMm, maxX = box.maxX + kUnitFitMarginMm;
+  var minY = box.minY - kUnitFitMarginMm, maxY = box.maxY + kUnitFitMarginMm;
+  final cx = minX / 2 + maxX / 2, cy = minY / 2 + maxY / 2;
+  if (maxX - minX < kUnitFitMinSpanMm) {
+    minX = cx - kUnitFitMinSpanMm / 2;
+    maxX = cx + kUnitFitMinSpanMm / 2;
+  }
+  if (maxY - minY < kUnitFitMinSpanMm) {
+    minY = cy - kUnitFitMinSpanMm / 2;
+    maxY = cy + kUnitFitMinSpanMm / 2;
+  }
+  // The fit's scale; its translation is built here, about the safe
+  // centre, since `ViewportTransform.fit` takes `(min + max) / 2`.
+  final s = ViewportTransform.fit(Aabb2.raw(minX, minY, maxX, maxY), viewport)
+      .worldToScreenMatrix
+      .a;
+  // The clamp is dead in practice (a 316,000 px view, a 950 m box), and
+  // harmless: the same centre at the bound's scale.
+  final clamped = s.clamp(minScale, maxScale);
+  final mx = minX / 2 + maxX / 2, my = minY / 2 + maxY / 2;
+  return ViewportTransform(
+      worldToScreenMatrix: Transform2(
+          clamped,
+          0,
+          0,
+          -clamped,
+          viewport.width / 2 - clamped * mx,
+          viewport.height / 2 + clamped * my));
+}
