+/// The canvas point of [t]'s local ([x], [y]) under [c]'s camera.
+Offset canvasAt(PlanController c, Transform2 t, double x, double y) {
+  final w = world(t, x, y);
+  final p = canvasOf(c.camera.value, w.dx, w.dy);
+  return Offset(p.x, p.y);
+}
