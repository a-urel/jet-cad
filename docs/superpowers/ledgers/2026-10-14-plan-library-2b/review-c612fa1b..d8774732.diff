+    unit: d.unit,
+    center: d.center,
+    size: d.size,
+    rotation: d.rotation,
+    mirrored: d.mirrored,
+    corners: d.corners,
+    layer: d.layer,
+    locked: d.locked,
+    data: d.data,
+    colour: color);
