+          throwsA(isA<ArgumentError>()),
+          reason: 'print $bad');
+      expect(c.pageFlows.ready.value, isTrue, reason: 'no flow ran for $bad');
+    }
+    final printer = FakePagePrinter();
+    expect(
+        () => c.print(PlanExportChoice.initial,
+            printer: printer, unitColourOpacity: 2),
+        throwsArgumentError);
+    expect(printer.calls, isEmpty, reason: 'nothing was printed');
+    // A refusal leaves the guard free: the next export runs.
+    expect(await tester.runAsync(() => c.export('plan.png', png96)), isNotNull);
