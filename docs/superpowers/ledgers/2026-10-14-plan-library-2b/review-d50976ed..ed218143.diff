+          reason: '$bad');
+    }
+    // The opacity is the alpha: round(255 * o).
+    expect({
+      for (final f in unitColourUnderlay(units.current, doc, 0.6)) f.argb >> 24
+    }, {
+      153
+    });
+    expect({
+      for (final f in unitColourUnderlay(units.current, doc, 1)) f.argb >> 24
+    }, {
+      255
+    });
+    expect({
+      for (final f in unitColourUnderlay(units.current, doc, 0)) f.argb >> 24
+    }, {
+      0
+    });
+  });
+
+  testWidgets(
+      'EX2 M-C7 M-C8 M-PC7-a the PNG through exportBytes at 96 dpi: a teal '
