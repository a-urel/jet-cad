+    if (s.color case final name?) {
+      final known = planSwatchNamed(name);
+      doc.commands.execute(SetComponentCommand<UnitColour>(
+          instance,
+          known == null
+              ? UnitColour.fromJson({'color': name})
+              : UnitColour(known)));
+    }
+  }
+  doc.commands.clearHistory();
+  return doc;
