+    Widget app(PlanTheme? theme, {PlanTheme? ambient}) => MaterialApp(
+        themeAnimationDuration: Duration.zero,
+        theme: ThemeData(extensions: [if (ambient != null) ambient]),
+        home: Scaffold(
+            body: PlanEditor(
+                controller: c,
+                theme: theme,
+                onExport: got.add,
+                printer: printer,
+                onExportDialog: dialog)));
+    await tester.binding.setSurfaceSize(const Size(1440, 900));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    await tester.pumpWidget(
+        app(const PlanTheme(unitColourOpacity: 0.6, statusFillOpacity: 0.8)));
+    await tester.pump();
+    await tester.pump();
+
+    Future<void> settled(bool Function() done) async {
+      for (var i = 0; i < 600 && !done(); i++) {
+        await tester.runAsync(
+            () => Future<void>.delayed(const Duration(milliseconds: 20)));
+        await tester.pump();
