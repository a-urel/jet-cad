+    lockedLayer: addZoneLayer(doc, lockedLayer, locked: true),
+  };
+  for (final s in only ?? specs) {
+    final instance = placeUnit(doc, s.round ? roundTable : embeddingTable,
+        transform: placementOf(s), layer: layers[s.layer]);
