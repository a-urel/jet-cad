+      !identical(oldDelegate.camera, camera) ||
+      !identical(oldDelegate.focus, focus) ||
+      !identical(oldDelegate.paper, paper) ||
+      !identical(oldDelegate.theme, theme) ||
+      !identical(oldDelegate.units, units);
+}
