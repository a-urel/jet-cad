+      await a.moveTo(one);
+      await a.removePointer();
+      await click(tester, one, ms(1000));
+      expect(log, ['A hover 1', 'A hover null'], reason: 'premise: A read');
+
+      await tester.pumpWidget(MaterialApp(home: Scaffold(body: host('B'))));
+      await click(tester, one, ms(1100));
+      final b = await tester.createGesture(kind: PointerDeviceKind.mouse);
+      await b.addPointer(location: floor);
+      await b.moveTo(one);
+      await b.removePointer();
+      await drag(tester, one, const Offset(60, 30), ms(3000));
+      await click(tester, floor, ms(5000));
+      expect(log, [
+        'A hover 1',
+        'A hover null',
+        'B double 1',
+        'B hover 1',
+        'B hover null',
+        'B moved [1]',
+        'B floor',
+      ]);
+    });
+
+    testWidgets(
+        'VE15 an onLayoutChanged that resets the layout: that drag reports '
+        'no onTablesMoved, and nothing throws (the tables it moved are '
+        'gone)', (tester) async {
+      final c = serviceController();
+      final log = <String>[];
+      await pumpService(
+          tester,
+          c,
+          PlanServiceView(
+            controller: c,
+            onLayoutChanged: () {
+              log.add('layout');
+              c.resetService();
+            },
+            onUnitsMoved: (m) => log.add('moved ${m.length}'),
+          ));
+      final one = table('1');
+      await drag(
+          tester, onTable(tester, c, one), const Offset(60, 30), ms(1000));
+      await tester.pump();
+      expect(tester.takeException(), isNull);
+      expect(log, ['layout']);
+      final (x, y) = centerOf(one);
+      final now = c.unitDetails.firstWhere((d) => d.unit.label == '1');
+      expectWorld(now.center!.dx, x, 'premise: reset, x');
+      expectWorld(now.center!.dy, y, 'premise: reset, y');
+    });
+
+    testWidgets('VE17 the moved list a host is handed is unmodifiable',
+        (tester) async {
+      final (c, heard) = await mount(tester);
+      await drag(tester, onTable(tester, c, table('1')), const Offset(60, 30),
+          ms(1000));
+      final moved = heard.moved.single;
+      expect(moved, hasLength(1), reason: 'premise');
+      expect(() => moved.add(moved.first), throwsUnsupportedError);
+      expect(moved.removeLast, throwsUnsupportedError);
+      expect(heard.moved.single, hasLength(1));
+    });
+  });
+
+  group('data (final review)', () {
+    testWidgets(
+        'VE18 F-4: the moved table\'s detail carries the data set on it in '
+        'the design, keys sorted; a table the drag did not move is not '
+        'reported; the design keeps the data', (tester) async {
+      const data = {'zeta': 'z', 'id': 'pos-1', 'alpha': 'Masa 1.ğ'};
+      // Set in design, before the view is mounted in service.
+      final (c, heard) = await mount(tester,
+          before: (c) => expect(
+              c.setUnitsData({
+                '1': data,
+                '2': {'id': 'pos-2'},
+              }),
+              isTrue));
+
+      await drag(tester, onTable(tester, c, table('1')), const Offset(60, 30),
+          ms(1000));
+      await tester.pump();
+      expect(heard.log, ['layout', 'moved [1]']);
+      final moved = heard.moved.single.single;
+      expect(moved.data, data);
+      expect(moved.data.keys, ['alpha', 'id', 'zeta']);
+      expect(moved, c.unitDetails.firstWhere((d) => d.unit.label == '1'),
+          reason: 'the controller\'s fresh detail, data and all');
+
+      c.setMode(PlanMode.design);
+      expect(c.unitDetails.firstWhere((d) => d.unit.label == '1').data, data);
+    });
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/support/service_fixtures.dart b/packages/jet_cad_2d_plan/test/support/service_fixtures.dart
