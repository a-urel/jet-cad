+/// One unit as a [PlanUnitOverlayBuilder] sees it (2b spec S4, today's
+/// G-5): what the widget may show, and nothing that moves with the camera,
+/// so pan and zoom never ask for a new widget.
+@immutable
+final class PlanUnitOverlay {
+  const PlanUnitOverlay({
+    required this.detail,
+    required this.selected,
+    required this.focused,
+    required this.status,
+    required this.detailLevel,
+  });
+
+  /// The unit, its geometry, layer and lock, as
+  /// `PlanController.unitDetails` lists it. Always labelled and with
+  /// geometry: a unit with neither gets no overlay. A seat's
+  /// `detail.unit.generatedBy` names its row's type.
+  final PlanUnitDetail detail;
+
+  /// Whether the unit's label is in `PlanController.selectedUnits`. Two
+  /// units sharing a label are both selected when it is.
+  final bool selected;
+
+  /// Whether the unit's label is in `PlanController.unitFocus`, or no focus
+  /// is set. The overlays paint above the focus veil and the group chips:
+  /// a host fades an unfocused unit's widget with this flag.
+  final bool focused;
+
+  /// The status the service mode draws on the unit: its group's
+  /// (`groupStatuses`) when its group has one, else its own
+  /// (`unitStatuses`); null for none.
+  final UnitStatus? status;
+
+  /// How many of [PlanOverlayLayout.detailBreakpoints] are at or below the
+  /// camera's scale: 0 with none.
+  final int detailLevel;
+
+  @override
+  bool operator ==(Object other) =>
+      other is PlanUnitOverlay &&
+      other.detail == detail &&
+      other.selected == selected &&
+      other.focused == focused &&
+      other.status == status &&
+      other.detailLevel == detailLevel;
+
+  @override
+  int get hashCode =>
+      Object.hash(detail, selected, focused, status, detailLevel);
+
+  @override
+  String toString() => 'PlanUnitOverlay(${detail.unit.label}, '
+      'selected: $selected, focused: $focused, status: $status, '
+      'detailLevel: $detailLevel)';
+}
+
+/// The host's widget for one unit (2b spec S4, today's G-5), or null for
+/// none.
+///
+/// Called once per labelled unit with geometry when the layer is built;
+/// again for that unit only when its [PlanUnitOverlay] changes (the plan,
+/// the selection, the focus, a status, the detail level); and again for
+/// every unit each time the host rebuilds the `PlanServiceView` (or the
+/// `PlanEditor`), whatever the function: a closure written in `build` and
+/// a method tear-off behave the same, so a builder that reads the host's
+/// own fields sees them after the host's `setState`. Never on pan or zoom.
+/// Live data inside the widget is the host's own state management.
+typedef PlanUnitOverlayBuilder = Widget? Function(
+    BuildContext context, PlanUnitOverlay unit);
+
+/// How an overlay is sized (2b spec S4, today's G-6).
+enum PlanOverlaySize {
+  /// The widget's own size at every zoom: laid out once, loosely, up to
+  /// [PlanOverlayLayout.maxNaturalSize].
+  natural,
+
+  /// The unit's bounding box on the screen, exactly: laid out again on
+  /// every camera change.
+  ///
+  /// Its cost per frame, for each overlay on the canvas: a [Size] and a
+  /// [BoxConstraints] for the new box, and a layout and a paint of the
+  /// host's widget at that size. Overlays off the canvas cost nothing.
+  /// [natural] costs one paint offset per overlay on the canvas, and no
+  /// layout.
+  box,
