+// Ported from jet_cad_floor_plan/test/host/view_events_test.dart;
+// assertions unchanged.
+//
+// Ports VE1-VE18 (all eighteen); none is left to Part B.
+//
+// Host embedding API spec E-1 to E-4 (2b spec S4 "Events") through
+// `PlanServiceView`: `onUnitsMoved`, `onUnitDoubleTap`, `onFloorTap` and
+// `onUnitHover` in service, on the shared non-degenerate fixture
+// (unit_embedding_fixture) under its panned 0.37 px/mm camera, or the same
+// scale panned over the unit a test needs. Screen points and expected world
+// points and centres are computed here by the forward transform (the
+// fixture's placements, `canvasOf`) and the camera's inverse written out,
+// never read from the code under test. Double taps are driven by gestures
+// with explicit stamps, the fake clock pumped differently from them:
+// flutter_test stamps every synthetic event `Duration.zero` otherwise.
+import 'package:flutter/gestures.dart' show PointerDeviceKind;
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
