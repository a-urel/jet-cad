+/// [paper] under the tint: the foreground [ink] at [tintAlpha] over it.
+List<double> tinted(List<int> paper, int ink) =>
+    [for (final c in paper) c + (ink - c) * tintAlpha];
+
+List<int> rgbOf(int argb) =>
+    [(argb >> 16) & 0xFF, (argb >> 8) & 0xFF, argb & 0xFF];
