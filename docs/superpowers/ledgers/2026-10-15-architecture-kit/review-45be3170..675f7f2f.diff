+      expect(holds(l, q), isTrue, reason: 'Living\'s ring corner $q');
+    }
+    for (final q in const [
+      (23500.0, 13800.0),
+      (23900.0, 13800.0),
+      (23900.0, 14200.0),
+      (23500.0, 14200.0)
+    ]) {
+      expect(holds(l, q), isTrue, reason: 'the column\'s corner $q');
+      expect(nearLabels(living, Vector2(q.$1, q.$2)), isFalse,
+          reason: 'premise: the column is not the labels');
+    }
+    expect(l.where((p) => nearLabels(living, p)), hasLength(10),
+        reason: 'two label boxes, each closed');
+
+    final kitchen = roomNamed(doc, 'Kitchen');
+    final kl = await outlineOf(kitchen);
+    const kitchenRing = [
+      (17060.0, 8250.0),
+      (21440.0, 8250.0),
+      (21440.0, 11440.0),
+      (17060.0, 11440.0)
+    ];
+    for (final q in kitchenRing) {
+      expect(holds(kl, q), isTrue, reason: 'the Kitchen\'s ring corner $q');
+    }
+    // No hole: every other point is a label box's.
+    for (final p in kl) {
+      if (kitchenRing.any((q) => holds([p], q))) continue;
+      expect(nearLabels(kitchen, p), isTrue, reason: 'the Kitchen\'s $p');
+    }
+    await shot.close();
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/shell/planner_shell_test.dart b/packages/jet_cad_2d_integration/test/shell/planner_shell_test.dart
new file mode 100644
index 00000000..98642d34
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/shell/planner_shell_test.dart
@@ -0,0 +1,309 @@
+// Ported from jet_cad_floor_plan/test/planner_shell_test.dart (3a Task 26, spec C6); assertions unchanged.
+//
+// The three sample-flat cases: a click on a wall selects it, cmd+Z undoes
+// a Delete, ctrl+Z after deleting two walls brings both back in one step.
+// The shell is the plan library's PlanEditor over sampleFlatController(),
+// at 1440 x 900 (ruling IT-R4: PlanEditor's columns would leave a 280 px
+// canvas at flutter_test's 800 x 600); the first fit is the page's, as
+// today's shell's.
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show InteractionLayer, SelectionKey;
+import 'package:jet_cad_2d_integration/jet_cad_2d_integration.dart';
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/canvas_rig.dart' show pumpPlanEditor;
+import '../support/plans.dart'
+    show kPlanHeight, kPlanOriginX, kPlanOriginY, kPlanWidth, kids;
+
+/// The sample plan's wall whose stored start is (`sx`, `sy`) and end is
+/// (`ex`, `ey`) (spec 08 D18's table).
+Handle wallFrom(
+        DraftDocument doc, double sx, double sy, double ex, double ey) =>
+    doc.components.withComponent<WallParams>().singleWhere((w) {
+      final p = doc.components.get<WallParams>(w)!;
+      return p.sx == sx && p.sy == sy && p.ex == ex && p.ey == ey;
+    });
+
+/// E1, the south exterior wall, and E4, the west one (spec 08 D18).
+Handle e1Of(DraftDocument doc) => wallFrom(doc, kPlanOriginX + 125,
+    kPlanOriginY + 125, kPlanOriginX + kPlanWidth - 125, kPlanOriginY + 125);
+Handle e4Of(DraftDocument doc) => wallFrom(doc, kPlanOriginX + 125,
+    kPlanOriginY + kPlanHeight - 125, kPlanOriginX + 125, kPlanOriginY + 125);
+
+/// [wall]'s openings, ascending.
+List<Handle> openingsOf(DraftDocument doc, Handle wall) => [
+      for (final o in doc.components.withComponent<OpeningParams>())
+        if (doc.components.get<OpeningParams>(o)!.host == wall) o
+    ]..sort((a, b) => a.value.compareTo(b.value));
+
+/// The sample plan's rooms named [names] (spec 10 D23), in that order.
+List<Handle> roomsNamed(DraftDocument doc, List<String> names) => [
+      for (final name in names)
+        doc.components.withComponent<RoomParams>().singleWhere(
+            (r) => doc.components.get<RoomParams>(r)!.name == name),
+    ];
+
+/// The dimensions measuring [wall], ascending: a dimension references the
+/// walls of its attached ends (today's DimensionType.references,
+/// jet_cad_floor_plan/lib/src/parametric/dimension.dart:150).
+List<Handle> dimensionsOn(DraftDocument doc, Handle wall) => [
+      for (final d in doc.components.withComponent<DimensionParams>())
+        if ([
+          for (final end in [
+            doc.components.get<DimensionParams>(d)!.a,
+            doc.components.get<DimensionParams>(d)!.b,
+          ])
+            if (end is AttachedEnd) end.wall
+        ].contains(wall))
+          d
+    ]..sort((a, b) => a.value.compareTo(b.value));
+
+/// Every live entity handle, ascending.
+List<Handle> liveHandles(DraftDocument doc) => [
+      for (final slot in doc.entities.liveSlots) doc.entities.handleAt(slot)
+    ]..sort((a, b) => a.value.compareTo(b.value));
+
+/// The lowest y of [wall]'s piece outlines: `y0` at a mitred south corner,
+/// `y0 + 125` at a square end on E1's centreline.
+double lowestY(DraftDocument doc, Handle wall) {
+  var y = double.infinity;
+  for (final k in kids(doc, wall)) {
+    final slot = doc.entities.slotOf(k)!;
+    if (doc.entities.kindAt(slot) != EntityKind.polyline) continue;
+    final p = doc.geometry.read(doc.entities.geomIndexAt(slot));
+    for (var i = 0; i < p.pointCount; i++) {
+      if (p.pointAt(i).y < y) y = p.pointAt(i).y;
+    }
+  }
+  return y;
+}
+
+/// The plan library's editor over the sample flat (spec 3a C3.7, C1.9),
+/// 1440 x 900 (ruling IT-R4); the controller is disposed at tear-down.
+Future<PlanController> pumpSample(WidgetTester tester) async {
+  final c = sampleFlatController();
+  addTearDown(c.dispose);
+  await pumpPlanEditor(tester, c);
+  return c;
+}
+
+void main() {
+  testWidgets('a click on a wall selects it in the running shell',
+      (tester) async {
+    final c = await pumpSample(tester);
+    await tester.pump();
+
+    // On E1's outer face, 3,000 mm along (spec 08 D18): the click selects
+    // E1's group. Not 100 mm along: at this surface the pick radius is about
+    // 366 mm, which reaches the corner where E1's and E4's centrelines end,
+    // and a vertex hit outranks an edge hit, its tie going to the greater
+    // handle, E4.
+    final world = Vector2(kPlanOriginX + 3000, kPlanOriginY);
+    final screen = c.camera.value.worldToScreen(world);
+    final viewportSize = tester.getSize(find.byType(InteractionLayer));
+    expect(screen.x, inInclusiveRange(0, viewportSize.width));
+    expect(screen.y, inInclusiveRange(0, viewportSize.height));
+
+    final topLeft = tester.getTopLeft(find.byType(InteractionLayer));
+    await tester.tapAt(topLeft + Offset(screen.x, screen.y));
+    await tester.pump();
+
+    expect(c.activeSelection.keys, [SelectionKey.root(e1Of(c.document))]);
+  });
+
+  // A5 / spec D12: the look asks the human to delete a wall and put it back,
+  // and until this binding existed the shell had no way to put it back.
+  testWidgets('cmd+Z undoes a Delete through the command log', (tester) async {
+    final c = await pumpSample(tester);
+    await tester.pump();
+
+    final doc = c.document;
+    // E1's outer face, as the test above clicks it.
+    final world = Vector2(kPlanOriginX + 3000, kPlanOriginY);
+    final screen = c.camera.value.worldToScreen(world);
+    final topLeft = tester.getTopLeft(find.byType(InteractionLayer));
+    await tester.tapAt(topLeft + Offset(screen.x, screen.y));
+    await tester.pump();
+
+    // E1 and its front door (spec 08 D18); E2 and E4 mitre with E1 at the
+    // south corners.
+    final e1 = e1Of(doc);
+    expect(c.activeSelection.keys, [SelectionKey.root(e1)]);
+    final [door] = openingsOf(doc, e1);
+    final e2 = wallFrom(
+        doc,
+        kPlanOriginX + kPlanWidth - 125,
+        kPlanOriginY + 125,
+        kPlanOriginX + kPlanWidth - 125,
+        kPlanOriginY + kPlanHeight - 125);
+    final e4 = e4Of(doc);
+    expect(lowestY(doc, e2), kPlanOriginY, reason: 'E2 mitres with E1');
+    expect(lowestY(doc, e4), kPlanOriginY, reason: 'E4 mitres with E1');
+    final removed = kids(doc, e1).length + kids(doc, door).length;
+    expect(removed, 6 + 2, reason: 'two pieces, and a leaf and an arc');
+    // Spec 10 D8, D23: E1's inner face bounds the Hall, the Kitchen and the
+    // Bath from the south; with E1 gone their faces open to the outside, so
+    // they dissolve in the same step, a tint and two labels each.
+    final rooms = roomsNamed(doc, ['Hall', 'Kitchen', 'Bath']);
+    var dissolved = 0;
+    for (final r in rooms) {
+      dissolved += kids(doc, r).length;
+    }
+    expect(dissolved, 3 * 4, reason: 'a fill, its boundary and two TEXTs');
+    // Spec 11 D17, decision 3 (Ruling 11-14, the controller's ruling): E1
+    // carries three of the sample's dimensions -- the overall width, the
+    // Hall and the Bath diagonal -- and deleting it cascades them in the
+    // same step, six children each.
+    final dims = dimensionsOn(doc, e1);
+    expect(dims, hasLength(3), reason: 'the width, the Hall, the diagonal');
+    for (final d in dims) {
+      expect(kids(doc, d), hasLength(6), reason: 'dimension $d');
+    }
+    // The startup plan is itself built through the log, so the counts below
+    // are what pin the undo to exactly one command: the Delete.
+    final liveBefore = doc.entities.liveCount;
+    final handlesBefore = liveHandles(doc);
+
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.delete);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.delete);
+    await tester.pump();
+
+    // The door goes with its host (spec 08 D4), in the same step, and the
+    // neighbours' corners square.
+    expect(doc.tree[e1], isNull);
+    expect(doc.tree[door], isNull, reason: 'the cascade');
+    for (final r in rooms) {
+      expect(doc.tree[r], isNull, reason: 'room $r dissolves (10 D8)');
+    }
+    expect(doc.commands.undoDepth, 1, reason: 'one step');
+    for (final d in dims) {
+      expect(doc.tree[d], isNull, reason: 'dimension $d cascades (11 D3)');
+    }
+    // The three dimensions' 3 × 6 children go too.
+    expect(doc.entities.liveCount, liveBefore - removed - dissolved - 3 * 6);
+    expect(lowestY(doc, e2), closeTo(kPlanOriginY + 125, 1e-9),
+        reason: 'E2\'s corner squares');
+    expect(lowestY(doc, e4), closeTo(kPlanOriginY + 125, 1e-9),
+        reason: 'E4\'s corner squares');
+    expect(c.activeSelection.isEmpty, isTrue);
+
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.metaLeft);
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.keyZ);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.keyZ);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.metaLeft);
+    await tester.pump();
+
+    expect(doc.tree[e1], isA<GroupNode>(), reason: 'the wall is back');
+    expect(doc.tree[door], isA<GroupNode>(), reason: 'its door too');
+    for (final r in rooms) {
+      expect(doc.tree[r], isA<GroupNode>(), reason: 'room $r is back');
+    }
+    for (final d in dims) {
+      expect(doc.tree[d], isA<GroupNode>(), reason: 'dimension $d is back');
+      expect(kids(doc, d), hasLength(6), reason: 'dimension $d');
+    }
+    expect(doc.entities.liveCount, liveBefore,
+        reason: 'exactly one command came off the log, not the plan under it');
+    expect(liveHandles(doc), handlesBefore, reason: 'every child handle');
+    expect(lowestY(doc, e2), kPlanOriginY);
+    expect(lowestY(doc, e4), kPlanOriginY);
+    expect(c.activeSelection.isEmpty, isTrue,
+        reason: 'undo replays the command log; it never restores the '
+            "selection controller's own state");
+  });
+
+  testWidgets('ctrl+Z after deleting two walls brings both back in one step',
+      (tester) async {
+    final c = await pumpSample(tester);
+    await tester.pump();
+
+    final topLeft = tester.getTopLeft(find.byType(InteractionLayer));
+    Offset at(Vector2 world) {
+      final s = c.camera.value.worldToScreen(world);
+      return topLeft + Offset(s.x, s.y);
+    }
+
+    // E1 and E4 (spec 08 D18), by points on their outer faces: E1's 3,000
+    // mm along, as above (its mid-edge is the front door's jamb), and E4's
+    // mid-edge. Each is past the pick radius (about 366 mm here) of every
+    // vertex of another object: the corners, the front door
+    // (x0 + 6000..7000), E4's windows (y0 + 1700..2700, y0 + 5900..7300)
+    // and P2's butt (y0 + 5000), so each tap can only mean one wall. E4's
+    // point holds while the pick radius (6 px) is under about 506 mm, its
+    // distance to P2's nearest cap vertex (x0 + 250, y0 + 4940): that is,
+    // at flutter_test's default 800 x 600 surface, not at any size.
+    final doc = c.document;
+    final e1 = e1Of(doc), e4 = e4Of(doc);
+    final objects = [e1, e4, ...openingsOf(doc, e1), ...openingsOf(doc, e4)];
+    expect(objects, hasLength(5), reason: 'a door and two windows');
+    // Spec 10 D8, D23: E1 bounds the Hall, the Kitchen and the Bath, and E4
+    // the Hall and Bedroom 1; with both gone those four faces open to the
+    // outside, and the rooms dissolve in the same step.
+    final rooms = roomsNamed(doc, ['Hall', 'Bedroom 1', 'Kitchen', 'Bath']);
+    var removed = 0;
+    for (final o in [...objects, ...rooms]) {
+      removed += kids(doc, o).length;
+    }
+    // Spec 11 D17, decision 3 (Ruling 11-14, the controller's ruling): E1
+    // carries three of the sample's dimensions (the overall width, the Hall
+    // and the Bath diagonal), six children each, which go with it; E4
+    // carries none.
+    final dims = dimensionsOn(doc, e1);
+    expect(dims, hasLength(3), reason: 'the width, the Hall, the diagonal');
+    expect(dimensionsOn(doc, e4), isEmpty, reason: 'E4 carries none');
+    for (final d in dims) {
+      expect(kids(doc, d), hasLength(6), reason: 'dimension $d');
+    }
+    await tester.tapAt(at(Vector2(kPlanOriginX + 3000, kPlanOriginY)));
+    await tester.pump();
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.tapAt(at(Vector2(kPlanOriginX, kPlanOriginY + 4500)));
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.pump();
+
+    expect(c.activeSelection.keys.toSet(),
+        {SelectionKey.root(e1), SelectionKey.root(e4)});
+    // Ruling 04-1: the history is cleared at startup, so `undoDepth` here
+    // would only count what happens from this point on; the live count
+    // after exactly one ctrl+Z is what pins it to one entry regardless.
+    final liveBefore = doc.entities.liveCount;
+    final handlesBefore = liveHandles(doc);
+
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.delete);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.delete);
+    await tester.pump();
+
+    for (final o in [...objects, ...rooms]) {
+      expect(doc.tree[o], isNull, reason: 'object $o, with its wall');
+    }
+    expect(doc.commands.undoDepth, 1, reason: 'one step');
+    for (final d in dims) {
+      expect(doc.tree[d], isNull, reason: 'dimension $d cascades (11 D3)');
+    }
+    // The three dimensions' 3 × 6 children go too.
+    expect(doc.entities.liveCount, liveBefore - removed - 3 * 6);
+
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.controlLeft);
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.keyZ);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.keyZ);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.controlLeft);
+    await tester.pump();
+
+    expect(doc.entities.liveCount, liveBefore,
+        reason: 'one ctrl+Z restores both walls, not one');
+    for (final o in [...objects, ...rooms]) {
+      expect(doc.tree[o], isA<GroupNode>(), reason: 'object $o is back');
+    }
+    for (final d in dims) {
+      expect(doc.tree[d], isA<GroupNode>(), reason: 'dimension $d is back');
+      expect(kids(doc, d), hasLength(6), reason: 'dimension $d');
+    }
+    expect(liveHandles(doc), handlesBefore, reason: 'every child handle');
+    expect(c.activeSelection.isEmpty, isTrue);
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/shortcuts/keyboard_focus_test.dart b/packages/jet_cad_2d_integration/test/shortcuts/keyboard_focus_test.dart
new file mode 100644
index 00000000..8501bbd6
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/shortcuts/keyboard_focus_test.dart
@@ -0,0 +1,258 @@
+// Ported from jet_cad_floor_plan/test/host/keyboard_focus_test.dart (3a Task 26, spec C6); assertions unchanged.
+//
+// Host embedding API spec C-7 (Slice 4 plan, Task 6; S-16, S-21): the
+// view's `shortcuts` and `autofocus` in both modes, and the controller's
+// `deleteSelection()` (C-3 as S-16 was ruled). Both modes on the embedding
+// fixture under `embeddingCamera()`; the editor's keys and the delete on
+// the editor fixture under `editorCamera()`. A host `CallbackShortcuts`
+// above the view counts every key that reaches it.
+//
+// The wall cases: "a gesture's keys stay: the Wall tool chosen by the
+// host", DS2, DS5 and R-3 RP5. The host is 2b's (plan_shortcuts_test.dart's
+// `mountUnitKeys`, its `CallbackShortcuts` form) over the editor fixture:
+// 2b's units on the sample flat (ruling IT-R2); tables are units.
+import 'dart:convert' show jsonEncode;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart' show SelectionKey;
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+
+import '../support/canvas_rig.dart';
+import '../support/editor_fixture.dart';
+import '../support/fake_page_printer.dart';
+import '../support/units.dart';
+
+/// An intent the host's own `Shortcuts` maps a key to, by name.
+class HostIntent extends Intent {
+  const HostIntent(this.name);
+  final String name;
+}
+
+/// Every letter the shell binds, F3, Escape, Delete, Backspace and the
+/// chords (Task 6 review RP1).
+final Map<String, SingleActivator> kIntentKeys = {
+  for (final l in 'VLPRBWDNGMSICATF'.split(''))
+    l: SingleActivator(LogicalKeyboardKey(
+        LogicalKeyboardKey.keyA.keyId + l.codeUnitAt(0) - 'A'.codeUnitAt(0))),
+  'f3': const SingleActivator(LogicalKeyboardKey.f3),
+  'escape': const SingleActivator(LogicalKeyboardKey.escape),
+  'delete': const SingleActivator(LogicalKeyboardKey.delete),
+  'backspace': const SingleActivator(LogicalKeyboardKey.backspace),
+  'ctrl+z': const SingleActivator(LogicalKeyboardKey.keyZ, control: true),
+  'cmd+z': const SingleActivator(LogicalKeyboardKey.keyZ, meta: true),
+  'ctrl+shift+z': const SingleActivator(LogicalKeyboardKey.keyZ,
+      control: true, shift: true),
+  'ctrl+y': const SingleActivator(LogicalKeyboardKey.keyY, control: true),
+  'ctrl+e': const SingleActivator(LogicalKeyboardKey.keyE, control: true),
+  'cmd+e': const SingleActivator(LogicalKeyboardKey.keyE, meta: true),
+  'ctrl+p': const SingleActivator(LogicalKeyboardKey.keyP, control: true),
+  'cmd+p': const SingleActivator(LogicalKeyboardKey.keyP, meta: true),
+};
+
+/// The editor over the unit fixture under [permissions], inside a host
+/// that counts every [kIntentKeys] key reaching it, through intents
+/// ([intents]) or `CallbackShortcuts`; `shortcuts` changeable at runtime.
+Future<(PlanController, Map<String, int>, ValueNotifier<bool>)> mountUnitKeys(
+    WidgetTester tester,
+    {required PlanPermissions permissions,
+    bool intents = true,
+    bool shortcuts = false}) async {
+  final c = PlanController(kits: editorKits(), json: editorPlanJson());
+  addTearDown(c.dispose);
+  c.permissions = permissions;
+  final keys = ValueNotifier(shortcuts);
+  addTearDown(keys.dispose);
+  final reached = <String, int>{for (final n in kIntentKeys.keys) n: 0};
+  void count(String name) => reached[name] = reached[name]! + 1;
+  await tester.binding.setSurfaceSize(kEditorSurface);
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  final editor = ValueListenableBuilder<bool>(
+      valueListenable: keys,
+      builder: (_, s, __) => PlanEditor(
+          controller: c,
+          onExport: (_) {},
+          onExportDialog: (_, __, ___) async => null,
+          printer: FakePagePrinter(),
+          shortcuts: s));
+  await tester.pumpWidget(MaterialApp(
+      home: Scaffold(
+          body: intents
+              ? Shortcuts(
+                  shortcuts: {
+                      for (final e in kIntentKeys.entries)
+                        e.value: HostIntent(e.key),
+                    },
+                  child: Actions(actions: {
+                    HostIntent: CallbackAction<HostIntent>(onInvoke: (x) {
+                      count(x.name);
+                      return null;
+                    }),
+                  }, child: Focus(child: editor)))
+              : CallbackShortcuts(bindings: {
+                  for (final e in kIntentKeys.entries)
+                    e.value: () => count(e.key),
+                }, child: editor))));
+  await tester.pump();
+  await tester.pump();
+  c.camera.value = editorCamera();
+  await tester.pump();
+  return (c, reached, keys);
+}
+
+/// [encoded] with the entities by handle: slot order is history, not state
+/// (06 D11), and a wall's delete regenerates its neighbours, so its undo
+/// lands their entities in other slots. Everything else, the children's
+/// order included, compares as written.
+String entitiesByHandle(PlanController c) {
+  final j = DraftDocumentCodec.encode(c.document);
+  j['entities'] = List<Map<String, Object?>>.from(j['entities']! as List)
+    ..sort((a, b) => ((a['record']! as Map)['handle']! as int)
+        .compareTo((b['record']! as Map)['handle']! as int));
+  return jsonEncode(j);
+}
+
+/// Table `1`'s data, or null.
+Map<String, String>? dataOf1(PlanController c) =>
+    c.unitDetails.where((d) => d.unit.label == '1').firstOrNull?.data;
+
+void main() {
+  group('shortcuts: false in the design mode', () {
+    testWidgets(
+        "a gesture's keys stay: the Wall tool chosen by the host, idle, lets "
+        'Escape reach the host and stays; part-way, its Escape cancels the '
+        'wall and the host hears nothing', (tester) async {
+      final (c, reached, _) = await mountUnitKeys(tester,
+          permissions: PlanPermissions.full, intents: false);
+      await focusCanvas(tester);
+      expect(c.selectTool(ArchitectureTools.wall), isTrue,
+          reason: 'the command stays callable');
+      await tester.pump();
+      await press(tester, LogicalKeyboardKey.escape);
+      expect(reached['escape'], 1, reason: "no shell's Escape");
+      expect(c.activeTool.value, ArchitectureTools.wall);
+      final at = screenOf(tester, c, editorTextAt) + const Offset(0, 80);
+      await click(tester, at);
+      expect(status(tester), contains('Wall'));
+      // Part-way: undo waits (S-4), and the Escape is the wall's.
+      expect(c.setUnitData('1', const {'pos': 'a1'}), isTrue);
+      await tester.pump();
+      c.undo();
+      expect(dataOf1(c), const {'pos': 'a1'}, reason: 'mid-shape: no undo');
+      await press(tester, LogicalKeyboardKey.escape);
+      expect(reached['escape'], 1, reason: "the gesture's own Escape");
+      c.undo();
+      await tester.pump();
+      expect(dataOf1(c), isEmpty, reason: 'the wall cancelled: undo acts');
+      await press(tester, LogicalKeyboardKey.escape);
+      expect(reached['escape'], 2, reason: 'idle again: the host');
+    });
+  });
+
+  group('deleteSelection()', () {
+    testWidgets(
+        'DS2 the call deletes as the key does: 1, 2 (with data) and a wall '
+        'selected, the same document after the call (shortcuts: false) and '
+        'after the key (shortcuts)', (tester) async {
+      Future<List<String>> deleted(bool viaCall) async {
+        final (c, _, _) = await mountUnitKeys(tester,
+            permissions: PlanPermissions.full,
+            intents: false,
+            shortcuts: !viaCall);
+        await focusCanvas(tester);
+        expect(c.setUnitData('2', const {'pos': 'b2'}), isTrue);
+        await tester.pump();
+        final d = c.document;
+        c.select({'1', '2'});
+        c.activeSelection.replace([
+          ...c.activeSelection.keys,
+          SelectionKey.root(d.components.withComponent<WallParams>().first),
+        ]);
+        await tester.pump();
+        expect(c.activeSelection.length, 3);
+        final before = entitiesByHandle(c);
+        final depth = d.commands.undoDepth;
+        if (viaCall) {
+          expect(c.deleteSelection(), isTrue);
+        } else {
+          await press(tester, LogicalKeyboardKey.delete);
+        }
+        await tester.pump();
+        expect(d.commands.undoDepth, depth + 1, reason: 'one step');
+        final json = encodedPlan(c);
+        c.undo();
+        await tester.pump();
+        expect(d.commands.undoDepth, depth);
+        final undone = encodedPlan(c);
+        expect(entitiesByHandle(c), before,
+            reason: 'the plan as it was (spec O-10: the children in their '
+                'order), by ${viaCall ? 'call' : 'key'}');
+        await tester.pumpWidget(const SizedBox());
+        await tester.pump();
+        return [json, undone];
+      }
+
+      final byCall = await deleted(true);
+      final byKey = await deleted(false);
+      expect(byCall[0], byKey[0], reason: 'the delete');
+      expect(byCall[1], byKey[1], reason: 'its undo');
+    });
+
+    testWidgets(
+        'DS5 false while a wall is part-way, the host\'s selection held; '
+        'true once the wall is cancelled', (tester) async {
+      final (c, reached, _) = await mountUnitKeys(tester,
+          permissions: PlanPermissions.full, intents: false);
+      await focusCanvas(tester);
+      expect(c.selectTool(ArchitectureTools.wall), isTrue);
+      await tester.pump();
+      await click(
+          tester, screenOf(tester, c, editorTextAt) + const Offset(0, 80));
+      c.select({'1'});
+      await tester.pump();
+      expect(c.selectedUnits.value, {'1'});
+      final before = encodedPlan(c);
+      expect(c.deleteSelection(), isFalse, reason: 'part-way');
+      expect(encodedPlan(c), before);
+      await press(tester, LogicalKeyboardKey.escape);
+      c.select({'1'});
+      await tester.pump();
+      expect(c.deleteSelection(), isTrue, reason: 'idle: the selection goes');
+      expect(unitsLabelled(c.document, '1'), isEmpty);
+    });
+  });
+
+  group("the review's killers (Task 6 review R-2, R-3)", () {
+    testWidgets(
+        'R-3 (RP5) shortcuts: true: delete: false refuses the call; the Wall '
+        "tool idle with the host's selection: the key deletes nothing, the "
+        'call deletes', (tester) async {
+      final (c, _, _) = await mountUnitKeys(tester,
+          permissions: PlanPermissions.full.copyWith(delete: false),
+          intents: false,
+          shortcuts: true);
+      await focusCanvas(tester);
+      c.select({'1'});
+      await tester.pump();
+      expect(c.deleteSelection(), isFalse, reason: 'delete: false');
+      await tester.pumpWidget(const SizedBox());
+      final (c2, _, _) = await mountUnitKeys(tester,
+          permissions: PlanPermissions.full, intents: false, shortcuts: true);
+      await focusCanvas(tester);
+      expect(c2.selectTool(ArchitectureTools.wall), isTrue);
+      await tester.pump();
+      c2.select({'1'});
+      await tester.pump();
+      final before = encodedPlan(c2);
+      await press(tester, LogicalKeyboardKey.delete);
+      expect(encodedPlan(c2), before,
+          reason: 'the key: the Wall tool has none');
+      expect(c2.deleteSelection(), isTrue, reason: 'the call deletes');
+      expect(unitsLabelled(c2.document, '1'), isEmpty);
+      expect(c2.activeTool.value, ArchitectureTools.wall);
+    });
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/support/canvas_rig.dart b/packages/jet_cad_2d_integration/test/support/canvas_rig.dart
new file mode 100644
index 00000000..0a818eed
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/support/canvas_rig.dart
@@ -0,0 +1,139 @@
+// Cameras, gestures and read-outs for the integration tests (3a Task 26),
+// beside Task 9's editor_rig.dart (re-exported: activeTool, globalOf with
+// x and y, globalAt with a point, kitCatalog, press, pumpEditor, status),
+// over the public widgets: today's PlannerView handles (its camera, its
+// selection, its tools) are the controller's camera and selection and the
+// InteractionLayer's tool controller (spec C6, ruling IT-R1). The rig's
+// helpers are never copied (R-P14): [pumpPlanEditor] and [pressKey] are
+// thin delegates under the names today's tests call.
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show GripCache, InteractionLayer, ViewportTransform;
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import 'editor_rig.dart' show press, pumpEditor;
+
+export 'editor_rig.dart'
+    show activeTool, globalAt, globalOf, kitCatalog, press, pumpEditor, status;
+
+Finder byKey(String k) => find.byKey(Key(k));
+
+/// One field whatever its scope: the object's `property-<id>` or the
+/// active tool's `setting-<id>` (today's shell keyed both alike; ruling
+/// IT-R7).
+Finder field(String id) => find.byWidgetPredicate(
+    (w) => w.key == Key('property-$id') || w.key == Key('setting-$id'));
+
+/// The section of [typeId] or the settings of [toolId] (today's
+/// `<type>-section`, shown for the object and for its tool).
+Finder section(String typeId, String toolId) => find.byWidgetPredicate(
+    (w) => w.key == Key('section-$typeId') || w.key == Key('settings-$toolId'));
+
+/// [c] in its editor in a [size] window, in [locale], two frames: the rig's
+/// [pumpEditor] and one more frame.
+Future<void> pumpPlanEditor(WidgetTester tester, PlanController c,
+    {Size size = const Size(1440, 900),
+    Locale locale = const Locale('en')}) async {
+  await pumpEditor(tester, c, locale: locale, window: size);
+  await tester.pump();
+}
+
+/// The camera on world [centre] at [scale] px/mm, y up, turned [turn]
+/// radians on the screen; set after the editor's first fit.
+Future<void> frameOn(WidgetTester tester, PlanController c, Vector2 centre,
+    {required double scale, double turn = 0}) async {
+  final size = tester.getSize(find.byType(InteractionLayer));
+  final linear =
+      Transform2.rotation(turn).multiply(Transform2.scale(scale, -scale));
+  final mid = linear.transformPoint(centre);
+  c.camera.value = ViewportTransform(
+      worldToScreenMatrix: Transform2.translation(
+              size.width / 2 - mid.x, size.height / 2 - mid.y)
+          .multiply(linear));
+  await tester.pump();
+}
+
+/// The selection's grips and box: the cache the plan hands its tools in
+/// their context (`InteractionLayer.tools.context.grips`; ruling IT-R12).
+GripCache gripsOf(WidgetTester tester) => tester
+    .widget<InteractionLayer>(find.byType(InteractionLayer))
+    .tools
+    .context
+    .grips!;
+
+/// The editor's spatial index: the one the plan hands its tools in their
+/// context (`InteractionLayer.tools.context.index`; today's `view.index`).
+/// A document drives one index (the engine's mutation hook is a single
+/// slot), so a test reads the editor's rather than making a second.
+SpatialIndex indexOf(WidgetTester tester) => tester
+    .widget<InteractionLayer>(find.byType(InteractionLayer))
+    .tools
+    .context
+    .index;
+
+/// A key press and a pump; whether a handler took it: the rig's [press]
+/// under today's name.
+Future<bool> pressKey(WidgetTester tester, LogicalKeyboardKey key) =>
+    press(tester, key);
+
+/// A mouse resting at [at], then a press and a release there.
+Future<void> mouseClick(WidgetTester tester, Offset at) async {
+  final g = await tester.createGesture(kind: ui.PointerDeviceKind.mouse);
+  await g.addPointer(location: at - const Offset(3, 3));
+  await g.moveTo(at);
+  await tester.pump();
+  await g.down(at);
+  await tester.pump();
+  await g.up();
+  await tester.pump();
+  await g.removePointer();
+  await tester.pump();
+}
+
+/// The canvas's own focus node.
+FocusNode canvasFocus(WidgetTester tester) => tester
+    .widget<Focus>(find
+        .descendant(
+            of: find.byType(InteractionLayer), matching: find.byType(Focus))
+        .first)
+    .focusNode!;
+
+/// A click a little inside the canvas's top left: the canvas takes focus.
+Future<void> focusCanvas(WidgetTester tester) async {
+  await tester.tapAt(
+      tester.getTopLeft(find.byType(InteractionLayer)) + const Offset(6, 6));
+  await tester.pump();
+  expect(FocusManager.instance.primaryFocus, same(canvasFocus(tester)),
+      reason: 'premise: the canvas focused');
+}
+
+/// Whether the canvas (or a node under it) has the focus.
+bool canvasFocused() {
+  final context = FocusManager.instance.primaryFocus?.context;
+  return context != null &&
+      context.findAncestorWidgetOfExactType<InteractionLayer>() != null;
+}
+
+/// The menu of the choice [id] opened and its value [segment] tapped (a
+/// `ChoiceProperty` is a dropdown; ruling IT-R6). Nothing when the menu
+/// does not open (a disabled choice): today's tap on a disabled segment.
+Future<void> choose(WidgetTester tester, String id, String segment) async {
+  final menu = field(id);
+  final key = (tester.widget(menu).key! as ValueKey<String>).value;
+  await tester.tap(menu);
+  await tester.pumpAndSettle();
+  final item = byKey('$key-$segment');
+  if (item.evaluate().isEmpty) return;
+  await tester.tap(item.last);
+  await tester.pumpAndSettle();
+}
+
+/// The choice [id]'s dropdown.
+DropdownButton<Object?> menuOf(WidgetTester tester, String id) =>
+    tester.widget<DropdownButton<Object?>>(field(id));
diff --git a/packages/jet_cad_2d_integration/test/support/editor_fixture.dart b/packages/jet_cad_2d_integration/test/support/editor_fixture.dart
new file mode 100644
index 00000000..6d81cd91
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/support/editor_fixture.dart
@@ -0,0 +1,258 @@
+// 2b's unit editor fixture (jet_cad_2d_plan/test/support/unit_editor_fixture.dart), ported for the integration tests (3a Task 26) with today's startup flat restored (jet_cad_floor_plan/test/host/editor_fixture.dart): the stand-in lines for the north wall, its inner face, the column and the parquet hairline are gone, the flat draws them. Same world coordinates, same camera.
+//
+// The editor's selection helpers are 2b's units_only_select_test.dart's
+// (:28-124), the selection read through `activeSelection`. The rig's
+// helpers are never copied (R-P14): [screenOf] is the rig's `globalAt`
+// and [click] canvas_rig.dart's `mouseClick`, under 2b's names.
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show InteractionLayer, SelectionKey, ViewportTransform;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart' show PlanKit;
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import 'canvas_rig.dart' show globalAt, mouseClick;
+import 'plans.dart' show planWith;
+import 'units.dart';
+
+/// The window every editor test runs in.
+const Size kEditorSurface = Size(2400, 1500);
+
+const String kEmbeddingHidden = 'Hidden';
+const String kEmbeddingLocked = 'Locked';
+
+/// One table of the fixture, as the test knows it.
+final class EditorTable {
+  const EditorTable(this.label, this.transform, {this.layer = '0'});
+
+  /// The label written, or null for an unlabelled table.
+  final String? label;
+  final Transform2 transform;
+  final String layer;
+}
+
+/// The fixture's tables in placement order (ascending by handle), as
+/// today's `editorTables` (editor_fixture.dart:75-87).
+final List<EditorTable> editorTables = [
+  EditorTable('1', embeddingPlacement(21650, 15800, 30)),
+  const EditorTable('2', Transform2(0, 1, 1, 0, 23100, 15600)),
+  EditorTable('7', embeddingPlacement(22900, 14550, 60)),
+  EditorTable(' 7 ', embeddingPlacement(25000, 15250, -150, sy: -1)),
+  EditorTable(null, embeddingPlacement(21550, 14800, 15)),
+  EditorTable('5', embeddingPlacement(24600, 13350, 45),
+      layer: kEmbeddingHidden),
+  EditorTable('L', embeddingPlacement(25200, 15500, 120, sy: -1),
+      layer: kEmbeddingLocked),
+];
+
+final Transform2 editorChairPlacement = embeddingPlacement(23800, 16100, 10);
+final Transform2 editorGroupPlacement = embeddingPlacement(21600, 13450, 20);
+final (Vector2, Vector2) editorFreeLine =
+    (Vector2(22700, 13400), Vector2(23300, 14300));
+final Vector2 editorTextAt = Vector2(21700, 14250);
+const double editorTextHeight = 200;
+const String editorTextWords = 'Bar';
+
+/// The column's south-west corner (the sample flat's column, x 23,500 -
+/// 23,900, y 13,800 - 14,200; jet_cad_floor_plan's editor_fixture.dart:109).
+final Vector2 editorColumnCorner = Vector2(23500, 13800);
+
+/// The fixture's plan: the sample flat (C1.9's build, English words),
+/// then 2b's units, group, free line, TEXT and chair, over
+/// [architectureKit] and [fxKit].
+String editorPlanJson() => planWith((doc) {
+      final zero = ReservedHandles.layerZero;
+      final hidden = addLayer(doc, kEmbeddingHidden, visible: false);
+      final locked = addLayer(doc, kEmbeddingLocked, locked: true);
+      for (final t in editorTables) {
+        final h = placeUnit(doc, embeddingTable,
+            transform: t.transform,
+            layer: switch (t.layer) {
+              kEmbeddingHidden => hidden,
+              kEmbeddingLocked => locked,
+              _ => zero,
+            });
+        if (t.label case final label?) labelUnit(doc, h, label);
+      }
+      final group = doc.handleSeed.next();
+      doc.commands.execute(AddNodeCommand(GroupNode(
+          handle: group,
+          parent: doc.rootHandle,
+          transform: editorGroupPlacement,
+          children: const [])));
+      for (final (a, b) in [
+        (Vector2(100, 100), Vector2(900, 400)),
+        (Vector2(100, 400), Vector2(900, 100)),
+      ]) {
+        doc.commands.execute(AddEntityCommand(
+            record: draftRecord(doc.handleSeed.next(), group, EntityKind.line,
+                layer: zero),
+            payload: linePayload(a, b)));
+      }
+      doc.commands.execute(addDrafted(doc, EntityKind.line,
+          linePayload(editorFreeLine.$1, editorFreeLine.$2),
+          layer: zero));
+      doc.commands.execute(addDrafted(
+          doc, EntityKind.text, textPayload(editorTextAt, editorTextHeight),
+          layer: zero, text: editorTextWords));
+      placeUnit(doc, editorChair, transform: editorChairPlacement);
+    }, kits: [architectureKit, fxKit()], first: buildSampleFlat);
+
+/// The camera every editor test runs under: 0.37 px/mm, y flipped, panned
+/// so world (21,400, 17,070) is the canvas's top left.
+ViewportTransform editorCamera() => ViewportTransform(
+    worldToScreenMatrix: Transform2(0.37, 0, 0, -0.37, -7918, 6315.9));
+
+/// The editor over [json] ([editorPlanJson] by default) under
+/// [permissions], in [kEditorSurface], under [editorCamera]. The
+/// controller is disposed at tear-down.
+Future<PlanController> mountEditor(WidgetTester tester,
+    {PlanPermissions permissions = PlanPermissions.full, String? json}) async {
+  final c = PlanController(
+      kits: [architectureKit, fxKit()], json: json ?? editorPlanJson());
+  addTearDown(c.dispose);
+  c.permissions = permissions;
+  await tester.binding.setSurfaceSize(kEditorSurface);
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  await tester
+      .pumpWidget(MaterialApp(home: Scaffold(body: PlanEditor(controller: c))));
+  await tester.pump();
+  await tester.pump();
+  c.camera.value = editorCamera();
+  await tester.pump();
+  return c;
+}
+
+/// Today's `setCaps`: the permissions changed at runtime, one pump.
+Future<void> setPermissions(
+    WidgetTester tester, PlanController c, PlanPermissions p) async {
+  c.permissions = p;
+  await tester.pump();
+}
+
+Offset canvasOrigin(WidgetTester tester) =>
+    tester.getTopLeft(find.byType(InteractionLayer));
+
+/// World [w] on the screen: the rig's [globalAt] under 2b's name.
+Offset screenOf(WidgetTester tester, PlanController c, Vector2 w) =>
+    globalAt(tester, c, w);
+
+/// The world centre of table [n]'s box, by the fixture's own transform.
+Vector2 centreOf(PlanController c, String n) {
+  final node = c.document.tree[tableOf(c, n)]! as InstanceNode;
+  return node.transform.transformPoint(Vector2(700, 100));
+}
+
+/// A mouse click at [at]: canvas_rig.dart's [mouseClick] under 2b's name.
+Future<void> click(WidgetTester tester, Offset at) => mouseClick(tester, at);
+
+/// The plan's kit set for a controller over [editorPlanJson].
+List<PlanKit> editorKits() => [architectureKit, fxKit()];
+
+/// The plan's encoding under 2b's key tests' name (plan_shortcuts_test.dart:
+/// 141-142): [encoded].
+String encodedPlan(PlanController c) => encoded(c);
+
+/// The design's encoding: byte-identical means no edit.
+String encoded(PlanController c) =>
+    DraftDocumentCodec.encodeToString(c.document);
+
+/// Table [n]'s root key.
+SelectionKey keyOf(PlanController c, String n) =>
+    SelectionKey.root(tableOf(c, n));
+
+/// Table [n]'s transform.
+Transform2 transformOf(PlanController c, String n) =>
+    (c.document.tree[tableOf(c, n)]! as InstanceNode).transform;
+
+/// [local], in table [n]'s definition space, in the world.
+Vector2 onTable(PlanController c, String n, double x, double y) =>
+    transformOf(c, n).transformPoint(Vector2(x, y));
+
+/// A point inside table [n]'s top, away from its lines (the top is the
+/// quadrilateral (300, -200), (1100, -200), (900, 400), (300, 250)).
+Vector2 topOf(PlanController c, String n) => onTable(c, n, 500, 0);
+
+/// A point inside table [n]'s box, off its top: beyond the top's slanted
+/// edge from (1100, -200) to (900, 400).
+Vector2 boxOf(PlanController c, String n) => onTable(c, n, 1050, 350);
+
+/// A point on table [n]'s top's bottom edge: where the index's own pick
+/// (no `selectUnitsOnly`) finds the table, over the parquet.
+Vector2 edgeOf(PlanController c, String n) => onTable(c, n, 700, -200);
+
+/// [line]'s first point in the world (a root-level line).
+Vector2 startOf(DraftDocument d, Handle line) {
+  final p =
+      d.geometry.read(d.entities.geomIndexAt(d.entities.slotOf(line)!)).coords;
+  return Vector2(p[0], p[1]);
+}
+
+/// Whether [h] is a live line entity (today's wall).
+bool isLine(DraftDocument d, Handle h) {
+  final slot = d.entities.slotOf(h);
+  return slot != null && d.entities.kindAt(slot) == EntityKind.line;
+}
+
+/// The selection's keys.
+Set<SelectionKey> selected(PlanController c) => {...c.activeSelection.keys};
+
+/// A mouse drag from [from] to [to] in eight steps; [before] runs after
+/// the last move and before the up.
+Future<void> drag(WidgetTester tester, Offset from, Offset to,
+    {Future<void> Function()? before}) async {
+  final g = await tester.createGesture(kind: ui.PointerDeviceKind.mouse);
+  await g.addPointer(location: from - const Offset(2, 2));
+  await g.moveTo(from);
+  await tester.pump();
+  await g.down(from);
+  await tester.pump();
+  for (var i = 1; i <= 8; i++) {
+    await g.moveTo(Offset.lerp(from, to, i / 8)!);
+    await tester.pump();
+  }
+  if (before != null) await before();
+  await g.up();
+  await tester.pump();
+  await g.removePointer();
+  await tester.pump();
+}
+
+/// A finger's tap at [at]: down, held past the touch hold-back, up.
+Future<void> fingerTap(WidgetTester tester, Offset at) async {
+  final g = await tester.startGesture(at,
+      pointer: 41, kind: ui.PointerDeviceKind.touch);
+  await tester.pump(const Duration(milliseconds: 150));
+  await g.up();
+  await tester.pump(const Duration(milliseconds: 300));
+}
+
+/// The rotation grip of table [n]: 24 px above its top's screen box.
+Offset rotationGripOf(WidgetTester tester, PlanController c, String n) {
+  final corners = [
+    for (final (x, y) in const [
+      (300, -200),
+      (1100, -200),
+      (900, 400),
+      (300, 250)
+    ])
+      screenOf(tester, c, onTable(c, n, x.toDouble(), y.toDouble())),
+  ];
+  final minX = corners.map((p) => p.dx).reduce(math.min);
+  final maxX = corners.map((p) => p.dx).reduce(math.max);
+  final minY = corners.map((p) => p.dy).reduce(math.min);
+  return Offset((minX + maxX) / 2, minY - 24);
+}
+
+/// The turn of [m], in degrees.
+double degreesOf(Transform2 m) => math.atan2(m.b, m.a) * 180 / math.pi;
+
+/// The bands' corners: the whole canvas, inset 4 px.
+Rect canvasRect(WidgetTester tester) =>
+    tester.getRect(find.byType(InteractionLayer)).deflate(4);
