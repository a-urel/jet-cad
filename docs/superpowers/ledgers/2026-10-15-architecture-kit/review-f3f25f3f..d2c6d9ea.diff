+/// [diagnostics] whose code starts with [prefix] (`room.`, `separator.`).
+List<Diagnostic> codedAs(List<Diagnostic> diagnostics, String prefix) => [
+      for (final d in diagnostics)
+        if (d.code.startsWith(prefix)) d,
+    ];
