+/// Wall [h]'s stored fills: one per piece of its band.
+int fillsOf(Plan plan, Handle h) => [
+      for (final k in kids(plan.doc, h))
+        if (kindOf(plan.doc, k) == EntityKind.fill) k,
+    ].length;
