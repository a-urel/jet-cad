+      SeparatorParams(1234.25, -678.25, 4321.75, 876.125),
+      SeparatorParams(1234.5, -678.5, 4321.75, 876.125),
+      SeparatorParams(1234.5, -678.25, 4321.5, 876.125),
+      SeparatorParams(1234.5, -678.25, 4321.75, 876.25),
+    ]) {
