+/// The face around world [seed] through the document adapter.
+TraceResult faceAt(DraftDocument doc, Vector2 seed) {
+  final inputs = RoomInputs(doc, liveOf(doc));
+  try {
+    return traceRoomAmong(seed, inputs);
+  } finally {
+    inputs.dispose();
+  }
+}
