+            kind: DimKind.horizontal, offset: 7.5, at: g);
+        for (final (ordinal, local) in [
+          (0, Vector2(1500.5, 2000.25)), // the offset: +800.25
+          (2, Vector2(3500.75, 1700.5)), // b moved, fixed
+          (1, Vector2(-400.25, -600.75)), // a moved, fixed
