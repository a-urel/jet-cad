+  await tester.pump();
+  await tester.enterText(find.byKey(Key(key)), text);
+  await tester.testTextInput.receiveAction(TextInputAction.done);
+  await tester.pump();
+  await tester.pump();
+}
+
+/// [doc]'s rooms, ascending.
