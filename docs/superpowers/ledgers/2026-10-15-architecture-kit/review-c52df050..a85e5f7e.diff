--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/l10n/overflow_test.dart
@@ -0,0 +1,61 @@
+// Spec 14d R-2, M-14d-c (V-11): German and Turkish words are longer; the
+// shell must not overflow at the top bar's 656 px floor (plan 13) and up,
+// with OSNAP off (its longest words), the Symbols tab, a selected wall's
+// panels and the service bar.
+// Ported from jet_cad_floor_plan/test/l10n/overflow_test.dart (OV-H, each
+// language; OV-de and OV-tr are 2a's) (3a Task 27, Appendix A D-24);
+// assertions unchanged but the rulings named: IP-R4 (the table is the
+// fixture kit's, a unit labelled `1` as today's placer numbered it).
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart' show SelectionKey;
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/plans.dart' show planWith;
+import '../support/units.dart' show fxKit, labelUnit, placeAt, tableSymbol;
+
+void main() {
+  heightMain();
+}
+
+/// The sample plan with a four-seat table, turned, off the origin.
+String furnishedPlan() => planWith((d) {
+      final h = placeAt(d, tableSymbol(seats: 4), Vector2(1234.5, 2345.25),
+          quarterTurns: 1);
+      labelUnit(d, h, '1');
+    }, kits: [architectureKit, fxKit()], first: buildSampleFlat);
+
+void heightMain() {
+  for (final code in ['en', 'de', 'tr']) {
+    testWidgets(
+        'OV-H-$code at 656 x 700, each root object of the sample plan and a '
+        'table selected in turn: the right panel never overflows (review '
+        '14d-1 F-2)', (tester) async {
+      final c = PlanController(
+          kits: [architectureKit, fxKit()], json: furnishedPlan());
+      addTearDown(c.dispose);
+      await tester.binding.setSurfaceSize(const Size(656, 700));
+      addTearDown(() => tester.binding.setSurfaceSize(null));
+      await tester.pumpWidget(MaterialApp(
+          locale: Locale(code),
+          supportedLocales: planSupportedLocales,
+          localizationsDelegates: planLocalizationsDelegates,
+          home: Scaffold(body: PlanEditor(controller: c))));
+      await tester.pump();
+      final doc = c.document;
+      final roots = [
+        for (final n in doc.tree.nodes)
+          if (n.parent == doc.rootHandle) n.handle
+      ];
+      expect(roots.length, greaterThan(20), reason: 'premise');
+      expect(c.units, isNotEmpty, reason: 'premise');
+      for (final h in roots) {
+        c.activeSelection.replace([SelectionKey.root(h)]);
+        await tester.pump();
+        expect(tester.takeException(), isNull, reason: '$code, $h');
+      }
+    });
+  }
+}
diff --git a/packages/jet_cad_2d_integration/test/l10n/panel_words_test.dart b/packages/jet_cad_2d_integration/test/l10n/panel_words_test.dart
new file mode 100644
index 00000000..1bca1ae1
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/l10n/panel_words_test.dart
@@ -0,0 +1,129 @@
+// Spec 14d L12, L15 (revision 2): the panels speak the host's language and
+// show and read their numbers with its separator; a change of language
+// while mounted shows the fields again in it (M-14d-s). A wall off the
+// origin with a fractional thickness; a page at a fractional scale.
+// Ported from jet_cad_floor_plan/test/l10n/panel_words_test.dart (3a Task
+// 27, Appendix A D-24); assertions unchanged but the rulings named: IP-R1
+// (`wall-thickness` is the field `thickness`) and IP-R6 (the
+// justification is a dropdown showing the chosen word: its menu is opened
+// to show the other two, and closed by choosing `Orta` again, no step).
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart' show SelectionKey;
+import 'package:jet_cad_2d_integration/jet_cad_2d_integration.dart';
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/canvas_rig.dart' show byKey, field;
+import '../support/plans.dart' show addWall, planWith;
+
+/// A plan with one wall, 112.5 thick, and its page at 1:12.5.
+(String, Handle) wallPlan() {
+  late Handle h;
+  final json = planWith((doc) {
+    h = doc.handleSeed.next();
+    doc.commands.execute(addWall(doc, h, Vector2(-1830.5, 640.25),
+        Vector2(2470.75, 1210.5), 112.5, Justification.centre));
+    final page = doc.components.get<PageComponent>(doc.rootHandle)!;
+    doc.commands.execute(SetComponentCommand<PageComponent>(
+        doc.rootHandle, page.copyWith(scaleDenominator: 12.5)));
+  });
+  return (json, h);
+}
+
+/// The editor over [c] in [locale]: the integration package's app.
+Widget app(PlanController c, Locale locale) => planEditorApp(c, locale: locale);
+
+String fieldText(WidgetTester tester, Finder f) =>
+    tester.widget<TextField>(f).controller!.text;
+
+WallParams wallOf(PlanController c, Handle h) =>
+    c.document.components.get<WallParams>(h)!;
+
+Future<(PlanController, Handle)> pumpWall(
+    WidgetTester tester, Locale locale) async {
+  final (json, h) = wallPlan();
+  final c = architectureController(json: json);
+  addTearDown(c.dispose);
+  await tester.binding.setSurfaceSize(const Size(1440, 900));
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  await tester.pumpWidget(app(c, locale));
+  await tester.pump();
+  c.activeSelection.replace([SelectionKey.root(h)]);
+  await tester.pump();
+  await tester.pump();
+  return (c, h);
+}
+
+Future<void> typeInto(WidgetTester tester, Finder f, String text) async {
+  await tester.tap(f);
+  await tester.pump();
+  await tester.enterText(f, text);
+  await tester.testTextInput.receiveAction(TextInputAction.done);
+  await tester.pump();
+  await tester.pump();
+}
+
+void main() {
+  testWidgets(
+      'PW1 in Turkish the Wall section, the Page panel and the layers speak '
+      'Turkish; numbers show and read with a comma (L12, L15, M-14d-f)',
+      (tester) async {
+    final (c, h) = await pumpWall(tester, const Locale('tr'));
+    // Ruling IP-R6: the menu shows the three justification words.
+    await tester.tap(field('justification'));
+    await tester.pumpAndSettle();
+    for (final w in [
+      'Duvar',
+      'Kalınlık',
+      'Sol',
+      'Orta',
+      'Sağ',
+      'Sayfa',
+      'Ölçek',
+      'Izgara',
+      'Katmanlar',
+      'Katman'
+    ]) {
+      expect(find.text(w), findsWidgets, reason: w);
+    }
+    await tester.tap(find.text('Orta').last);
+    await tester.pumpAndSettle();
+    expect(fieldText(tester, field('thickness')), '112,5');
+    expect(fieldText(tester, byKey('page-scale')), '12,5');
+    expect(find.textContaining('1:12,5 · '), findsOneWidget, reason: 'zoom');
+
+    await typeInto(tester, field('thickness'), '137,25');
+    expect(wallOf(c, h).thickness, 137.25);
+    expect(fieldText(tester, field('thickness')), '137,25');
+    final depth = c.document.commands.undoDepth;
+    await typeInto(tester, field('thickness'), '1.600');
+    expect(wallOf(c, h).thickness, 137.25, reason: 'a grouping is refused');
+    expect(c.document.commands.undoDepth, depth);
+    await typeInto(tester, field('thickness'), '150.5');
+    expect(wallOf(c, h).thickness, 150.5,
+        reason: 'an English keypad\'s point, once (V-12)');
+  });
+
+  testWidgets(
+      'PW2 in German the Page panel reads a comma; a switch to English while '
+      'mounted shows the fields again with a point (M-14d-s)', (tester) async {
+    final (c, h) = await pumpWall(tester, const Locale('de'));
+    expect(find.text('Dicke'), findsOneWidget);
+    expect(find.text('Maßstab'), findsOneWidget);
+    await typeInto(tester, byKey('page-scale'), '20,5');
+    final page =
+        c.document.components.get<PageComponent>(c.document.rootHandle)!;
+    expect(page.scaleDenominator, 20.5);
+    expect(fieldText(tester, byKey('page-scale')), '20,5');
+
+    await tester.pumpWidget(app(c, const Locale('en')));
+    await tester.pump();
+    expect(find.text('Thickness'), findsOneWidget);
+    expect(fieldText(tester, field('thickness')), '112.5');
+    expect(fieldText(tester, byKey('page-scale')), '20.5');
+    expect(wallOf(c, h).thickness, 112.5, reason: 'nothing committed');
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/panels/colour_row_test.dart b/packages/jet_cad_2d_integration/test/panels/colour_row_test.dart
new file mode 100644
index 00000000..979b86ec
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/panels/colour_row_test.dart
@@ -0,0 +1,522 @@
+// Plan colours spec PC-8, PC-9 and PC-10: the Selection panel's Colour row.
+// Nine swatches, None and the palette's eight hues, set the colour of every
+// selected room and table in one undo step labelled Colour; read-only while
+// the host refuses `recolor` or the permissions refuse the edit; its words
+// in Turkish; its swatches as the canvas shows the hues.
+//
+// The plan is the two-room rectangle at the corpus far origin, turned 23°,
+// every wall and the separator in its own rotated, translated group; room A
+// sits in a group of its own turned 0.61 rad, room B at the identity. The
+// hues under test are `teal` and `purple`, never the first of the palette,
+// and `magenta`, a name no release knows.
+//
+// CP7 to CP11 (Slice 2, tables) run through `FloorPlanView` on the editor
+// fixture: the startup flat's rooms beside its tables, `1` turned 30 degrees,
+// `2` mirrored at 90, `7` and ` 7 ` sharing a number, `L` on a locked layer.
+// Ported for jet_cad_2d_integration (3a Task 27, Appendix A D-21, D-39): the
+// rooms, the wall and the separator are the architecture kit's; assertions
+// unchanged but ruling IP-R7. The fixture case, CP1-CP5 and CP6b; CP6 and
+// CP7-CP12 stay 2a's and 2b's.
+import 'dart:convert' show jsonEncode;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show
+        InteractionLayer,
+        SelectionKey,
+        ViewportTransform,
+        darkCanvasTone,
+        kDarkCanvasPaper;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart' show PlanSwatch;
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart'
+    show ArchitectureTools, RoomParams, SeparatorParams, WallParams;
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/canvas_rig.dart';
+import '../support/plans.dart';
+import '../support/rooms_plan.dart';
+
+Finder swatch(String name) => find.byKey(Key('color-swatch-$name'));
+Finder get picker => find.byKey(const Key('color-picker'));
+
+/// The Semantics node of swatch [name] (the nearest above its InkWell that
+/// carries the label).
+Semantics semanticsOf(WidgetTester tester, String name) =>
+    tester.widget<Semantics>(find
+        .ancestor(
+            of: swatch(name),
+            matching: find.byWidgetPredicate(
+                (w) => w is Semantics && w.properties.label != null))
+        .first);
+
+/// The tooltip text of swatch [name].
+String tooltipOf(WidgetTester tester, String name) => tester
+    .widget<Tooltip>(
+        find.ancestor(of: swatch(name), matching: find.byType(Tooltip)).first)
+    .message!;
+
+/// The marked swatch's name, or null for none.
+String? marked(WidgetTester tester) {
+  final hits = <String>[
+    for (final n in ['none', for (final c in PlanSwatch.values) c.name])
+      if (semanticsOf(tester, n).properties.selected ?? false) n,
+  ];
+  expect(hits.length, lessThanOrEqualTo(1), reason: 'at most one mark: $hits');
+  return hits.isEmpty ? null : hits.single;
+}
+
+SelectionKey k(Handle h) => SelectionKey.root(h);
+
+/// The kit's grey tint transparency (kit-internal, R-P1).
+const int kRoomTintTransparency =
+    229; // jet_cad_floor_plan/lib/src/parametric/room.dart:125 (kit-internal)
+
+/// The editor over [Rooms.c], its pixels readable.
+final class Rig {
+  Rig._(this.tester, this.c, this.capture, this.topLeft);
+
+  final WidgetTester tester;
+  final PlanController c;
+  final GlobalKey capture;
+  final Offset topLeft;
+
+  /// Pumps the editor over [r], the camera at 0.07 px/mm (y up) centred on
+  /// the plan's middle, with [r]'s permissions and, when given, [locale]
+  /// (with the plan library's delegates) and [theme].
+  static Future<Rig> pump(WidgetTester tester, Rooms r,
+      {Locale? locale, ThemeData? theme}) async {
+    await tester.binding.setSurfaceSize(const Size(1440, 900));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final capture = GlobalKey();
+    await tester.pumpWidget(RepaintBoundary(
+        key: capture,
+        child: MaterialApp(
+            locale: locale,
+            theme: theme,
+            supportedLocales: planSupportedLocales,
+            localizationsDelegates: planLocalizationsDelegates,
+            home: Scaffold(body: PlanEditor(controller: r.c)))));
+    await tester.pump();
+    final layer = find.byType(InteractionLayer);
+    final size = tester.getSize(layer);
+    final mid = r.plan.at(4800, 2000);
+    const px = 0.07;
+    r.c.camera.value = ViewportTransform(
+        worldToScreenMatrix: Transform2(px, 0, 0, -px,
+            size.width / 2 - px * mid.x + 0.37, size.height / 2 + px * mid.y));
+    await tester.pump();
+    return Rig._(tester, r.c, capture, tester.getTopLeft(layer));
+  }
+
+  Future<void> select(List<Handle> hs) async {
+    c.activeSelection.replace([for (final h in hs) k(h)]);
+    await tester.pump();
+  }
+
+  /// The RGB of the pixel that holds world point [p], as drawn now.
+  Future<List<int>> rgb(Vector2 p) async {
+    final boundary =
+        capture.currentContext!.findRenderObject()! as RenderRepaintBoundary;
+    final (bytes, width) = (await tester.runAsync(() async {
+      final image = await boundary.toImage();
+      final data = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
+      final w = image.width;
+      image.dispose();
+      return (data!, w);
+    }))!;
+    final s = c.camera.value.worldToScreen(p);
+    final o = topLeft + Offset(s.x, s.y);
+    final i = (o.dy.floor() * width + o.dx.floor()) * 4;
+    return [bytes.getUint8(i), bytes.getUint8(i + 1), bytes.getUint8(i + 2)];
+  }
+}
+
+/// [paper] under a tint of [ink] at [alpha] (of 255).
+List<double> over(List<int> paper, int ink, int alpha) => [
+      paper[0] + (((ink >> 16) & 0xFF) - paper[0]) * alpha / 255,
+      paper[1] + (((ink >> 8) & 0xFF) - paper[1]) * alpha / 255,
+      paper[2] + ((ink & 0xFF) - paper[2]) * alpha / 255,
+    ];
+
+void expectRgb(List<int> got, List<double> want, String why) {
+  for (var i = 0; i < 3; i++) {
+    expect(got[i], closeTo(want[i], 3), reason: '$why: channel $i of $got');
+  }
+}
+
+/// [room]'s tint records: its fill and the boundary the fill names, or its
+/// closed POLYLINE.
+List<EntityRecord> tintRecords(DraftDocument doc, Handle room) {
+  final all = kids(doc, room);
+  final fills = [
+    for (final c in all)
+      if (kindOf(doc, c) == EntityKind.fill) c
+  ];
+  if (fills.isNotEmpty) {
+    final boundary = Handle(payloadOf(doc, fills.single).scalars[0].toInt());
+    return [recordOf(doc, fills.single), recordOf(doc, boundary)];
+  }
+  return [
+    for (final c in all)
+      if (kindOf(doc, c) == EntityKind.polyline) recordOf(doc, c),
+  ];
+}
+
+/// Entity [h] whole: its record as saved and its payload's numbers.
+String snapOf(DraftDocument doc, Handle h) {
+  final p = payloadOf(doc, h);
+  return jsonEncode([
+    recordOf(doc, h).toJson(),
+    p.coords.toList(),
+    p.scalars.toList(),
+  ]);
+}
+
+/// Object [h] whole: its group's children, by handle.
+Map<Handle, String> childSnaps(DraftDocument doc, Handle h) =>
+    {for (final c in kids(doc, h)) c: snapOf(doc, c)};
+
+RoomParams roomOf(DraftDocument doc, Handle h) =>
+    doc.components.get<RoomParams>(h)!;
+
+/// Sets [room]'s colour to [name] by a plain component command (the shell's
+/// system must be installed: the tint follows).
+void paint(DraftDocument doc, Handle room, String? name) =>
+    doc.commands.execute(SetComponentCommand<RoomParams>(
+        room, roomOf(doc, room).copyWith(color: name)));
+
+/// A bare-floor point and one inside each room, off its label and every
+/// stroke, in plan millimetres.
