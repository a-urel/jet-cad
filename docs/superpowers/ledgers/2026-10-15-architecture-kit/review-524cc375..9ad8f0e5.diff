+// Slice 4 Task 4 review's killers (R-1 to R-4): the symbol tool's stored
+// turn and mirror bounded by the capabilities, a runtime rulers change with
+// a tool active, the reviewer's probes RV4 to RV9, the Symbols tab, the
+// grips' snapping, the empty toolbar, a host's own tools set and a filter
+// offering nothing. Through `FloorPlanView` on the editor fixture under
+// `editorCamera()`, with `editor_tools_test.dart`'s host and helpers.
+//
+// Ported to jet_cad_2d_integration (3a Task 28, D-05; ruling IA-R5) from
+// jet_cad_floor_plan/test/host/editor_tools_review_test.dart: the
+// north-wall case (:199-231), O13a (:413-446) and O13b (:448-475), over
+// Task 26's editor fixture (`mountEditor`: the sample flat with 2b's
+// units, `PlanEditor`, `editorCamera()`); assertions unchanged. The
+// capabilities are the controller's permissions (`h.caps.value = X` →
+// `c.permissions = X` and a pump); `Caps.snapping` is `PlanEditor`'s
+// `snapping` (2a: snapping is the editor's option); `view.selection` is
+// `c.activeSelection`, `view.grips!` the canvas's grip cache
+// (`gripsOf`, IT-R12); `bath.toilet` is `architecture.bath.toilet` (C7
+// class 1). The helpers `place`, `hover` and `drag` are the source's
+// (:35-76), over the fixture's `screenOf`; `activeTool` is the rig's.
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart' show SelectionKey;
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/canvas_rig.dart'
+    show byKey, gripsOf, mouseClick, pressKey, symbolsReady;
+import '../support/editor_fixture.dart' hide drag;
+import '../support/plans.dart' show pageOf;
+
+double det(Transform2 m) => m.a * m.d - m.b * m.c;
+
+/// The instances of the design, by handle (today's `t.instancesOf`).
+Set<Handle> instancesOf(DraftDocument d) =>
+    {for (final n in d.tree.nodes.whereType<InstanceNode>()) n.handle};
+
+/// Clicks world [w] and answers the one instance it placed.
+Future<InstanceNode> place(
+    WidgetTester tester, PlanController c, Vector2 w) async {
+  final before = instancesOf(c.document);
+  await mouseClick(tester, screenOf(tester, c, w));
+  final added = instancesOf(c.document).difference(before);
+  expect(added, hasLength(1), reason: 'one placement at $w');
+  return c.document.tree[added.single]! as InstanceNode;
+}
+
+/// A mouse resting at world [w] (a hover, no press).
+Future<TestGesture> hover(
+    WidgetTester tester, PlanController c, Vector2 w) async {
+  final at = screenOf(tester, c, w);
+  final g = await tester.createGesture(kind: ui.PointerDeviceKind.mouse);
+  await g.addPointer(location: at - const Offset(3, 3));
+  await g.moveTo(at);
+  await tester.pump();
+  return g;
+}
+
+/// A mouse drag from world [from] to world [to], through a move off it.
+Future<void> drag(
+    WidgetTester tester, PlanController c, Vector2 from, Vector2 to) async {
+  final g = await tester.startGesture(screenOf(tester, c, from),
+      kind: ui.PointerDeviceKind.mouse);
+  await tester.pump();
+  await g.moveTo(screenOf(tester, c, to) + const Offset(0, 0.5));
+  await tester.pump();
+  await g.moveTo(screenOf(tester, c, to));
+  await tester.pump();
+  await g.up();
+  await tester.pump();
+}
+
+/// The page's grid snap off, outside the history: a drop is the raw point.
+void gridSnapOff(DraftDocument d) {
+  d.commands.execute(SetComponentCommand<PageComponent>(
+      d.rootHandle, pageOf(d).copyWith(snapToGrid: false)));
+  d.commands.clearHistory();
+}
+
+/// The root group carrying a component [T] that [test] accepts.
+Handle groupWith<T extends Component>(DraftDocument d, bool Function(T) test) =>
+    d.tree.nodes.whereType<GroupNode>().singleWhere((n) {
+      final p = d.components.get<T>(n.handle);
+      return p != null && test(p);
+    }).handle;
+
+/// Today's `t.openSymbols`: the Symbols tab, the libraries loaded.
+Future<void> openSymbols(WidgetTester tester, PlanController c) async {
+  await tester.tap(byKey('tab-symbols'));
+  await tester.pump();
+  expect(await symbolsReady(tester, c), isTrue,
+      reason: 'premise: the libraries loaded');
+  await tester.pump();
+}
+
+/// Today's `t.arm(tester, key)`: the gallery's cell of today's [key]
+/// under the kit (`symbol-cell-architecture.<key>@1`) tapped.
+Future<void> arm(WidgetTester tester, String key) async {
+  final cell = byKey('symbol-cell-architecture.$key@1');
+  expect(cell, findsOneWidget, reason: key);
+  await tester.tap(cell);
+  await tester.pump();
+}
+
+void main() {
+  testWidgets(
+      'a symbol against the north wall: M under full, then mirror false: '
+      'it attaches as an unmirrored one does; full: mirrored', (tester) async {
+    final c = await mountEditor(tester);
+    final d = c.document;
+    await openSymbols(tester, c);
+    await tester.enterText(byKey('symbol-search'), 'toilet');
+    await tester.pump();
+    await arm(tester, 'bath.toilet');
+    // 20 mm below the north wall's inner face (16,750), clear of 1 and 2.
+    final at = Vector2(24200, 16730);
+    final control = await place(tester, c, at);
+    final want = control.transform;
+    // Attached: its base point is not the click's, as a free one's is.
+    expect(Vector2(want.e, want.f).distanceTo(at), greaterThan(1),
+        reason: 'premise: the control attaches');
+    d.commands.undo();
+    await tester.pump();
+    await pressKey(tester, LogicalKeyboardKey.keyM);
+    c.permissions = PlanPermissions.full.copyWith(mirror: false);
+    await tester.pump();
+    final kept = await place(tester, c, at);
+    expect(kept.transform.toJson(), want.toJson());
+    d.commands.undo();
+    await tester.pump();
+    c.permissions = PlanPermissions.full;
+    await tester.pump();
+    final mirrored = await place(tester, c, at);
+    expect(det(mirrored.transform), lessThan(0));
+    expect(det(want), greaterThan(0));
+  });
+
+  testWidgets(
+      'O13a snapping false: a dimension\'s end grip dropped exactly on a '
+      'wall\'s end corner stays a fixed end; under full it attaches',
+      (tester) async {
+    for (final snapping in [false, true]) {
+      final c = await mountEditor(tester, snapping: snapping);
+      final d = c.document;
+      gridSnapOff(d);
+      // The overall depth, beyond the east wall: its north end at the
+      // flat's outer corner (26,000, 17,000).
+      final dim = groupWith<DimensionParams>(
+          d, (p) => p.offset == -300 && p.a is AttachedEnd);
+      c.activeSelection.replace([SelectionKey.root(dim)]);
+      await tester.pump();
+      expect(
+          gripsOf(tester)
+              .grips
+              .any((r) => r.grip.x == 26000 && r.grip.y == 17000),
+          isTrue,
+          reason: 'premise: the end grip');
+      await drag(tester, c, Vector2(26000, 17000), editorColumnCorner);
+      final end = d.components.get<DimensionParams>(dim)!.b;
+      if (snapping) {
+        expect(end, isA<AttachedEnd>());
+      } else {
+        expect(end, isA<FixedEnd>());
+        final p = (end as FixedEnd).point;
+        expect(p.distanceTo(editorColumnCorner), lessThan(1e-6));
+      }
+      await tester.pumpWidget(const SizedBox());
+    }
+  });
+
+  testWidgets(
+      'O13b snapping false: the east window\'s slide grip dropped 15 mm '
+      'short of its stretch\'s end stores the projection; under full it '
+      'snaps to the end', (tester) async {
+    for (final snapping in [false, true]) {
+      final c = await mountEditor(tester, snapping: snapping);
+      final d = c.document;
+      gridSnapOff(d);
+      // The east wall runs north from y 8,125; its window, 1,800 wide,
+      // centred 6,075 along it. Its north stretch ends at the inner
+      // face's corner (y 16,750): a centre of at most 7,725.
+      final win = groupWith<OpeningParams>(
+          d, (p) => p.position == 6075 && p.width == 1800);
+      c.activeSelection.replace([SelectionKey.root(win)]);
+      await tester.pump();
+      final grip = gripsOf(tester).grips.single.grip;
+      expect((grip.x, grip.y), (25875.0, 14200.0), reason: 'premise');
+      // The centre 7,710: its north jamb 15 mm short of the end, inside
+      // the 27 mm aperture (10 px at 0.37 px/mm).
+      await drag(tester, c, Vector2(grip.x, grip.y), Vector2(25878, 15835));
+      final stored = d.components.get<OpeningParams>(win)!.position;
+      expect(stored, closeTo(snapping ? 7725 : 15835 - 8125, 1e-6));
+      await tester.pumpWidget(const SizedBox());
+    }
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/attach/symbol_move_test.dart b/packages/jet_cad_2d_integration/test/attach/symbol_move_test.dart
new file mode 100644
index 00000000..0844ad48
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/attach/symbol_move_test.dart
@@ -0,0 +1,282 @@
+// Spec 09c D8: the wall-aware move's resolver, alone and through the
+// Select tool. A free 3600 mm wall at 30 degrees in a turned group near
+// (1e5, −7e4); a 1600 x 2000 bed tagged against-wall, its base point at its
+// box's centre, 1000 mm from its back; the camera at 0.1 px/mm, so the
+// 16 px capture is 160 mm: the back-centre within it, the insertion point
+// far outside.
+//
+// Ported to jet_cad_2d_integration (3a Task 28, D-01; rulings IA-R1,
+// IA-R2, IA-R3): the plan's move resolver is internal, so each case is the
+// same move dragged on the canvas through plan.select (a press on the
+// symbol's body, eight moves, the release) and its assertion is read on
+// the committed instance: MV4 pins that the drop commits the resolver's
+// answer verbatim, so the committed transform is the answer, and a plain
+// move `delta · T` where the answer was null. The symbols are the fixture
+// kit's (C7 classes 1 and 2: `fx.test.*`, the tag `against-wall` is
+// `attachTo: ['wall-face']`); the scene's attachment is the kit's provider
+// asked through the contract at the plan's own captures (IA-R1: the edge
+// capture is 100 mm, today's 60; a box centred mid-run snaps at neither).
+// Fixture changes: the plan's page has `snapToGrid: false` (today's scene
+// had no page, so no grid moved the drag); the press is the body point
+// `(0, depth / 2)` of the symbol's left edge, MV4's point for the bed, and
+// `(0, 120)` for the 600 mm unit, whose mid-edge drag would land 30 mm from
+// its own old right edge's midpoint and object-snap there (the select
+// tool's drag snaps; today's MV6 called the resolver directly).
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show InteractionLayer, ViewportTransform;
+import 'package:jet_cad_2d_kit/authoring.dart'
+    show CatalogPolyline, CatalogSymbol;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/attach_plans.dart';
+import '../support/canvas_rig.dart'
+    show focusCanvas, globalAt, pressKey, pumpPlanEditor;
+import '../support/editor_fixture.dart' show drag;
+import '../support/units.dart';
+
+CatalogSymbol rect(String key, double w, double d, List<String> attachTo) =>
+    CatalogSymbol(
+      key: key,
+      name: key,
+      category: 'Tests',
+      tags: const [],
+      attachTo: attachTo,
+      base: (w / 2, d / 2),
+      shapes: [
+        CatalogPolyline([(0, 0), (w, 0), (w, d), (0, d)], closed: true),
+      ],
+    );
+
+final List<CatalogSymbol> library = [
+  rect('fx.test.bed', 1600, 2000, ['wall-face']),
+  rect('fx.test.island', 1600, 2000, []),
+  rect('fx.test.unit', 600, 600, ['wall-face']),
+];
+CatalogSymbol symbol(String key) => library.singleWhere((s) => s.key == key);
+SymbolEntry entry(String key) => entryOf(symbol(key));
+
+/// Today's `Scene` as a pumped editor: the plan file, the controller, the
+/// face run, the box, the attachment and the instance.
+final class Scene {
+  Scene(this.c, this.run, this.box, this.attachedAt, this.off, this.instance);
+
+  final PlanController c;
+  final FaceLine run;
+  final SymbolBox box;
+  final Transform2 attachedAt;
+  final Vector2 off;
+  final Handle instance;
+
+  DraftDocument get doc => c.document;
+
+  Transform2 get transform => (doc.tree[instance]! as InstanceNode).transform;
+}
+
+Future<Scene> scene(WidgetTester tester,
+    {String key = 'fx.test.bed',
+    bool objectSnap = true,
+    bool mirrored = false,
+    bool atFace = false}) async {
+  late FaceLine run;
+  late Transform2 attachedAt;
+  late Vector2 off;
+  late Handle instance;
+  final box = boxOfEntry(entry(key))!;
+  final plan = freeWallPlan(30, Justification.centre, extra: (doc) {
+    final page = doc.components.get<PageComponent>(doc.rootHandle)!;
+    doc.commands.execute(SetComponentCommand<PageComponent>(
+        doc.rootHandle, page.copyWith(snapToGrid: false)));
+    final wall = doc.components.withComponent<WallParams>().single;
+    run = faceLineOf(doc, wall, left: true);
+    // The attachment at the run's middle, then moved 800 mm into the room
+    // and 300 along: a free bed whose back faces the wall.
+    final mid = run.a + run.t * (run.length / 2);
+    final base = entry(key).definition.basePoint;
+    attachedAt = attachOf(
+            doc,
+            entry(key),
+            mid,
+            placementTransform(at: mid, basePoint: base, mirrored: mirrored),
+            0.1,
+            mirrored: mirrored)!
+        .transform;
+    off = atFace ? Vector2.zero() : run.m * 800 + run.t * 300;
+    instance = placeUnit(doc, symbol(key),
+        transform: placementTransform(at: Vector2.zero(), basePoint: base));
+    doc.commands.execute(TransformNodeCommand(
+        instance, Transform2.translation(off.x, off.y).multiply(attachedAt)));
+  });
+  final c = PlanController(
+      kits: [architectureKit, fxKit(library: library)], json: plan.json);
+  addTearDown(c.dispose);
+  await pumpPlanEditor(tester, c);
+  c.camera.value = ViewportTransform(
+      worldToScreenMatrix: Transform2(0.1, 0, 0, -0.1, -9600, -6600));
+  await tester.pump();
+  if (!objectSnap) {
+    await focusCanvas(tester);
+    expect(await pressKey(tester, LogicalKeyboardKey.f3), isTrue,
+        reason: 'premise: F3 toggled object snap off');
+  }
+  return Scene(c, run, box, attachedAt, off, instance);
+}
+
+/// The plain move that brings the back-centre [into] mm from the face.
+Transform2 backTo(Scene s, double into) {
+  final v = s.run.m * into - s.off;
+  return Transform2.translation(v.x, v.y);
+}
+
+double faceS(Scene s, Vector2 p) => (p - s.run.a).dot(s.run.m);
+
+/// The body point a drag presses: on the symbol's left edge, its middle
+/// for the bed (MV4's `(0, 1000)`), 120 mm from its front for the unit.
+Vector2 pressOf(Scene s) => s.transform
+    .transformPoint(Vector2(0, s.box.depth == 2000 ? s.box.depth / 2 : 120));
+
+/// Today's `resolveMove(ctx, instance, delta)` on the canvas (IA-R2): the
+/// instance's body dragged from [pressOf] by [delta] through plan.select.
+Future<void> moveBy(WidgetTester tester, Scene s, Transform2 delta) async {
+  final press = pressOf(s);
+  final from = globalAt(tester, s.c, press);
+  final to = globalAt(tester, s.c, delta.transformPoint(press));
+  final canvas = tester.getRect(find.byType(InteractionLayer));
+  expect(canvas.contains(from) && canvas.contains(to), isTrue,
+      reason: 'premise: the drag is on the canvas');
+  await drag(tester, from, to);
+}
+
+List<double> partsOf(Transform2 t) => [t.a, t.b, t.c, t.d, t.e, t.f];
+
+/// The plain move `delta · before` (the resolver's null), within 1e-9.
+void expectPlain(
+    Transform2 got, Transform2 delta, Transform2 before, String reason) {
+  final want = partsOf(delta.multiply(before));
+  final parts = partsOf(got);
+  for (var i = 0; i < 6; i++) {
+    expect(parts[i], closeTo(want[i], 1e-9), reason: '$reason [$i]');
+  }
+}
+
+void main() {
+  moreTests();
+  testWidgets(
+      'MV1 the back-centre brought near the face attaches: the back on the '
+      'face, the marker its face point; the insertion point is far '
+      '(M-09c-an)', (tester) async {
+    final s = await scene(tester);
+    final delta = backTo(s, 40);
+    final insertion = delta
+        .multiply(s.transform)
+        .transformPoint(entry('fx.test.bed').definition.basePoint);
+    expect(faceS(s, insertion), greaterThan(160),
+        reason: 'premise: the insertion point is outside the capture');
+    await moveBy(tester, s, delta);
+    final r = (transform: s.transform);
+    final back = r.transform.transformPoint(s.box.backCentre);
+    expect(faceS(s, back), closeTo(0, 1e-6), reason: 'flush');
+    // Not ported (ruling IA-R3): expect((back - r.marker).length,
+    // lessThan(1e-6)); the marker is a painted overlay with no public read.
+    for (final (got, want) in [
+      (r.transform.a, s.attachedAt.a),
+      (r.transform.b, s.attachedAt.b),
+      (r.transform.c, s.attachedAt.c),
+      (r.transform.d, s.attachedAt.d),
+    ]) {
+      expect(got, closeTo(want, 1e-12), reason: 'turned to the wall');
+    }
+  });
+
+  testWidgets('MV2 far from the face, nothing', (tester) async {
+    final s = await scene(tester);
+    final before = s.transform;
+    final delta = backTo(s, 400);
+    await moveBy(tester, s, delta);
+    expectPlain(s.transform, delta, before, 'nothing: the plain move');
+  });
+
+  testWidgets(
+      'MV3 no attachment for an untagged symbol, with F3 off, before the '
+      'library is ready, or for a scaled instance (M-09c-az, M-09c-am)',
+      (tester) async {
+    // One editor per clause, mounted in turn.
+    for (final (why, key, objectSnap) in const [
+      ('untagged', 'fx.test.island', true),
+      ('F3 off', 'fx.test.bed', false),
+    ]) {
+      final s = await scene(tester, key: key, objectSnap: objectSnap);
+      final before = s.transform;
+      final delta = backTo(s, 40);
+      await moveBy(tester, s, delta);
+      expectPlain(s.transform, delta, before, why);
+    }
+    // Not ported (ruling IA-R3): the "no library" clause, scene(ready:
+    // false): the plan's resolver reads the placed definition's own
+    // SymbolComponent, never a library (premise impossible, C7).
+    final s = await scene(tester);
+    // Scaled by 1.001 about its back-centre: still at 40 mm, not orthonormal.
+    final c = s.transform.transformPoint(s.box.backCentre);
+    s.doc.commands.execute(TransformNodeCommand(
+        s.instance,
+        Transform2.translation(c.x, c.y)
+            .multiply(Transform2.scale(1.001, 1.001))
+            .multiply(Transform2.translation(-c.x, -c.y))
+            .multiply(s.transform)));
+    await tester.pump();
+    final before = s.transform;
+    final delta = backTo(s, 40);
+    await moveBy(tester, s, delta);
+    expectPlain(s.transform, delta, before, 'scaled');
+  });
+
+  testWidgets(
+      'MV4 through the Select tool: a drag towards the wall commits the '
+      'attachment verbatim, one step', (tester) async {
+    final s = await scene(tester);
+    // Press on the bed's left edge, halfway along: a point of the body.
+    final press = s.transform.transformPoint(Vector2(0, 1000));
+    expect(pressOf(s), press, reason: 'premise: MV4\'s press point');
+    final delta = backTo(s, 40);
+    final depth = s.doc.commands.undoDepth;
+    await moveBy(tester, s, delta);
+    expect(s.doc.commands.undoDepth, depth + 1);
+    final back = s.transform.transformPoint(s.box.backCentre);
+    expect(faceS(s, back), closeTo(0, 1e-6));
+  });
+}
+
+void moreTests() {
+  testWidgets('MV5 a mirrored symbol attaches mirrored (D4)', (tester) async {
+    final s = await scene(tester, mirrored: true);
+    expect(s.transform.determinant, lessThan(0), reason: 'premise');
+    await moveBy(tester, s, backTo(s, 40));
+    final r = (transform: s.transform);
+    expect(r.transform.determinant, lessThan(0));
+    expect(faceS(s, r.transform.transformPoint(s.box.backCentre)),
+        closeTo(0, 1e-6));
+  });
+
+  testWidgets(
+      'MV6 a unit dragged along its face by nearly its width does not snap '
+      'to where it was: its own instance is no neighbour (M-09c-ab)',
+      (tester) async {
+    final s = await scene(tester, key: 'fx.test.unit', atFace: true);
+    // The bands hear the placement's change event; the faces rebuild.
+    await tester.pump(Duration.zero);
+    final u0 =
+        (s.transform.transformPoint(s.box.backCentre) - s.run.a).dot(s.run.t);
+    final v = s.run.t * 570;
+    await moveBy(tester, s, Transform2.translation(v.x, v.y));
+    final r = (transform: s.transform);
+    final u =
+        (r.transform.transformPoint(s.box.backCentre) - s.run.a).dot(s.run.t);
+    expect(u - u0, closeTo(570, 1e-6),
+        reason: 'not snapped on to its own old right side');
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/attach/symbol_shell_test.dart b/packages/jet_cad_2d_integration/test/attach/symbol_shell_test.dart
new file mode 100644
index 00000000..a57750e4
--- /dev/null
+++ b/packages/jet_cad_2d_integration/test/attach/symbol_shell_test.dart
@@ -0,0 +1,193 @@
+// Spec 09c D6 (plan 09c-1 Task 7): the shell's wall faces. The walls are
+// added straight through the document's commands (no Wall or Opening tool
+// ever runs, W-5), each in its own rotated group near (1e5, −7e4) at 30°
+// (`wall_attach_fixture.dart`, plan P-2); the expected placements are
+// `attachToWall` over the wall's own runs from the raw pointer the layer
+// computes.
+//
+// Ported to jet_cad_2d_integration (3a Task 28, D-04; rulings IA-R1,
+// IA-R4, IA-R5) from apps/floor_planner/test/symbols/symbol_shell_test.dart,
+// SS16 and SS17 (:620-730): the app is `PlanEditor` over
+// `architectureController` whose plan file holds today's `addAttachWall`
+// wall (`attachPlan` of one 30° wall, its group the handle's, as today's
+// handle 7's), the camera today's `aimCamera` on `c.camera`; the symbols
+// are the kit's (`architecture.*`, C7 class 1), armed through the gallery.
+// The oracle is the kit's provider through the contract (IA-R1); the run
+// is written here (`faceLineOf`). A ghost read (`tool.ghostAttachment`) is
+// the placement a click at that pointer commits (IA-R4), read and undone:
+// attached is the back-centre on the face line, turned to it.
+import 'package:flutter/gestures.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_integration/jet_cad_2d_integration.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_kit_architecture/jet_cad_2d_kit_architecture.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/attach_plans.dart';
+import '../support/canvas_rig.dart'
+    show globalAt, pumpPlanEditor, symbolsReady, worldAt;
+import '../support/plans.dart' show polar, walls;
+import '../support/room_plans.dart' show undoKey;
+
+List<InstanceNode> instancesOf(DraftDocument doc) =>
+    doc.tree.nodes.whereType<InstanceNode>().toList();
+
+List<double> partsOf(Transform2 t) => [t.a, t.b, t.c, t.d, t.e, t.f];
+
+/// Today's `addAttachWall`: a wall at 30°, 3600 long and 150 thick,
+/// justified left, in its own rotated group near (1e5, −7e4) (no tool
+/// runs), as the plan file [c] opens, the editor pumped, the furniture
+/// loaded and the camera aimed at it. Returns the wall and its left face.
+Future<(PlanController, Handle, FaceLine)> addAttachWall(
+    WidgetTester tester) async {
+  final s = farAt(1234.5, 678.25);
+  final plan = attachPlan([(s, polar(s, 30, 3600), 150, Justification.left)]);
+  final c = architectureController(json: plan.json);
+  addTearDown(c.dispose);
+  await pumpPlanEditor(tester, c);
+  expect(await symbolsReady(tester, c), isTrue,
+      reason: 'premise: the furniture library loaded');
+  await aimCamera(tester, c, polar(s, 30, 1800));
+  final h = plan.walls.single;
+  return (c, h, faceLineOf(c.document, h, left: true));
+}
+
+/// The raw world point the layer computes for a pointer at world [p].
+Vector2 rawAt(WidgetTester tester, PlanController c, Vector2 p) =>
+    worldAt(tester, c, globalAt(tester, c, p));
+
+/// The provider's answer for [e] at the raw point [raw] (IA-R1).
+Attachment? answerAt(PlanController c, PlanSymbol e, Vector2 raw) => attachOf(
+    c.document,
+    e.entry,
+    raw,
+    placementTransform(at: raw, basePoint: e.entry.definition.basePoint),
+    c.camera.value.scale);
+
+void main() {
+  group('the wall attachment (spec 09c D6)', () {
+    testWidgets(
+        'SS16 a fresh shell where no Wall or Opening tool ran: a base unit '
+        'attaches to a 30° face, a second placed after it snaps to its '
+        'side; one undo step each (W-5)', (tester) async {
+      final (c, wall, run) = await addAttachWall(tester);
+      final doc = c.document;
+      final unit = armable(c, 'kitchen.base.600');
+      await armBySymbolsTab(tester, c, unit);
+      final box = boxOfEntry(unit.entry)!;
+      final scale = c.camera.value.scale;
+      expect(scale, closeTo(0.1, 1e-12), reason: 'capture 160 mm, edge 100');
+      final depth = doc.commands.undoDepth;
+
+      Future<void> click(Vector2 p) async {
+        final mouse = await tester.createGesture(
+            kind: PointerDeviceKind.mouse, buttons: kPrimaryButton);
+        await mouse.down(globalAt(tester, c, p));
+        await tester.pump();
+        await mouse.up();
+        await mouse.removePointer();
+        await tester.pump();
+      }
+
+      final p1 = onRun(run, 1000, 120);
+      final want1 = answerAt(c, unit, rawAt(tester, c, p1))!;
+      await click(p1);
+      final first = instancesOf(doc).single;
+      expect(partsOf(first.transform), partsOf(want1.transform));
+      expect(doc.commands.undoDepth, depth + 1);
+
+      // 60 mm (inside the 100 mm edge capture) right of the first's side.
+      final p2 = onRun(run, 1000 + 600 + 60, 90);
+      // The answer the release finds: the first unit its neighbour.
+      final want2 = answerAt(c, unit, rawAt(tester, c, p2));
+      await click(p2);
+      final second = instancesOf(doc).last;
+      expect(instancesOf(doc), hasLength(2));
+      final q2 = second.transform.transformPoint(box.backCentre);
+      expect((q2 - run.a).dot(run.t), closeTo(1600, 1e-6),
+          reason: 'its left side on the first\'s right side');
+      expect((q2 - run.a).dot(run.m), closeTo(0, 1e-6), reason: 'on the face');
+      // `tool.ghostAttachment` (IA-R4): the answer the release used.
+      expect(want2, isNotNull);
+      expect(partsOf(second.transform), partsOf(want2!.transform));
+      expect(doc.commands.undoDepth, depth + 2);
+
+      await undoKey(tester);
+      expect(instancesOf(doc).single.handle, first.handle,
+          reason: 'one undo step took the second only');
+      await undoKey(tester);
+      expect(instancesOf(doc), isEmpty);
+      expect(walls(doc), [wall]);
+    });
+
+    testWidgets(
+        'SS17 a wall on a hidden or a locked layer hosts nothing: the shell '
+        'hands its faces the openings\' host rule (M-09c-e)', (tester) async {
+      final (c, wall, run) = await addAttachWall(tester);
+      final doc = c.document;
+      final zero = doc.tables.layers[ReservedHandles.layerZero]!;
+      Handle layer(String name, {bool visible = true, bool locked = false}) {
+        final h = doc.handleSeed.next();
+        doc.commands.execute(AddLayerCommand(LayerRecord(
+          handle: h,
+          name: name,
+          color: const IndexedColor(3),
+          linetype: zero.linetype,
+          lineweight: zero.lineweight,
+          transparency: zero.transparency,
+          visible: visible,
+          locked: locked,
+        )));
+        return h;
+      }
+
+      final hidden = layer('Hidden', visible: false);
+      final locked = layer('Locked', locked: true);
+      final open = layer('Open');
+      final toilet = armable(c, 'bath.toilet');
+      await armBySymbolsTab(tester, c, toilet);
+      final box = boxOfEntry(toilet.entry)!;
+      final mouse = await tester.createGesture(kind: PointerDeviceKind.mouse);
+      await mouse.addPointer(
+          location: globalAt(tester, c, onRun(run, 900, 80)));
+      addTearDown(mouse.removePointer);
+      for (final (i, (on, hosts)) in [
+        (hidden, false),
+        (locked, false),
+        (open, true),
+      ].indexed) {
+        doc.commands
+            .execute(SetComponentCommand<ObjectLayer>(wall, ObjectLayer(on)));
+        await tester.pump();
+        final why = doc.tables.layers[on]!.name;
+        // `isUsableHost(doc, wall)` is the kit's (not exported): the
+        // wall's layer is visible and unlocked.
+        final l = doc.tables.layers[on]!;
+        expect(l.visible && !l.locked, hosts, reason: 'premise: $why');
+        final p = onRun(run, 1100 + 250.0 * i, 80);
+        await mouse.moveTo(globalAt(tester, c, p));
+        await tester.pump();
+        // `tool.ghostVisible` and `tool.ghostAttachment != null` (IA-R4):
+        // the placement a click at the resting pointer commits, undone.
+        final depth = doc.commands.undoDepth;
+        final want = answerAt(c, toilet, rawAt(tester, c, p));
+        await mouse.down(globalAt(tester, c, p));
+        await tester.pump();
+        await mouse.up();
+        await tester.pump();
+        expect(doc.commands.undoDepth, depth + 1, reason: '$why: placed');
+        final placed = instancesOf(doc).last.transform;
+        final back = placed.transformPoint(box.backCentre);
+        final attached = (back - run.a).dot(run.m).abs() < 1e-6 &&
+            (placed.c + run.m.x).abs() < 1e-12 &&
+            (placed.d + run.m.y).abs() < 1e-12;
+        expect(attached, hosts, reason: why);
+        if (hosts) expect(partsOf(placed), partsOf(want!.transform));
+        c.undo();
+        await tester.pump();
+      }
+    });
+  });
+}
diff --git a/packages/jet_cad_2d_integration/test/attach/wall_attach_end_to_end_test.dart b/packages/jet_cad_2d_integration/test/attach/wall_attach_end_to_end_test.dart
