+    final loaded = reloadWithPage(enc(doc));
+    expect(loaded.tree.accumulatedTransform(ho).scaleMagnitude,
+        closeTo(1.5, 1e-15));
+    expectScaled(loaded, 'loaded');
+  });
+}
