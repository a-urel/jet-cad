+          maxY = q.y > maxY ? q.y : maxY;
+        }
+        expect((maxX - minX, maxY - minY), (450.0, 450.0));
+        // The nearest point of an axis-aligned box to the centre.
+        final nx = c.x.clamp(minX, maxX), ny = c.y.clamp(minY, maxY);
