+/// Executes [c] and checks the differential oracle: nothing drifts.
+void run(DraftDocument doc, DraftCommand c) {
+  doc.commands.execute(c);
+  expect(driftOf(doc), isEmpty, reason: 'drift after ${c.label}');
+}
