+          for (final x in diagnosticsOf(d)) '${x.code} ${x.handles}',
+        ].join('\n');
+    expect(summary(fresh), summary(doc));
+  });
+}
diff --git a/packages/jet_cad_2d_kit_architecture/test/opening/opening_plan_test.dart b/packages/jet_cad_2d_kit_architecture/test/opening/opening_plan_test.dart
