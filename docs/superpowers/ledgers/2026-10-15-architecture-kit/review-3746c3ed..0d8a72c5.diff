+      'RT-tool the Room tool is M, needs structure, components and geometry, '
+      'sits right before the Separator tool, and makes a RoomTool over the '
+      'kit\'s shared inputs (M-RT-8, M-RT-9)', () {
+    expect(roomPlanTool.id, ArchitectureTools.room);
+    expect(roomPlanTool.letter, 'M');
+    expect(roomPlanTool.needs,
+        {Capability.structure, Capability.components, Capability.geometry});
+    expect(roomPlanTool.settings, isNull);
+    final ids = [for (final t in architectureKit.tools) t.id];
+    expect(ids.indexOf(ArchitectureTools.room),
+        ids.indexOf(ArchitectureTools.separator) - 1);
+    final plan = buildPlan(boxWalls);
+    final services =
+        FakePlanServices(document: plan.doc, catalog: testCatalog());
+    addTearDown(services.dispose);
+    final tool = roomPlanTool.create(services) as RoomTool;
+    addTearDown(tool.dispose);
+    expect(tool.inputs, same(roomInputsOf(services)));
+  });
+
+  test(
+      'RT-frozen-wall beside a frozen wall the Room tool\'s preview and the '
+      'room it makes agree: both ignore it (Review Focus 5; M-RT-6)', () {
+    // The two-room box at the corpus far origin, every wall in its own
+    // turned group, the partition frozen (spec 2a E2): in no survey, so no
+    // room reads it, and no input to the tool. The seed's face is the whole
+    // box: 7,800 × 3,800 = 29,640,000 ("29.64 m²", 0.005 from a tie).
+    final plan = buildPlan(twoRoomWalls, place: corpusGroups);
+    final doc = plan.doc;
+    final frozen = {plan.walls[4]};
+    plan.system.dispose();
+    final system =
+        ParametricSystem(doc, testCatalog(), isFrozen: frozen.contains)
+          ..install();
+    addTearDown(system.dispose);
+    final rig = roomRig(doc, frozen: frozen);
+    final seed = plan.at(1500.25, 2000.5);
+    hoverTo(rig, seed);
+    final preview = ringOf(rig.tool.debugPreview.single);
+    expectRing(
+        plan,
+        preview,
+        const [(100, 100), (7900, 100), (7900, 3900), (100, 3900)],
+        'the preview: the whole box');
+    pressAt(rig, seed);
+    final room = rooms(doc).single;
+    expect(labelStrings(doc, room), ['Room 1', '29.64 m²']);
+    expectSameRing(
+        worldTintOf(doc, room), preview, 'the room\'s tint is the preview');
+
+    // The control: nothing frozen, both see the partition: the left face,
+    // 2,850 × 3,800 = 10,830,000 ("10.83 m²").
+    final live = buildPlan(twoRoomWalls, place: corpusGroups);
+    final lrig = roomRig(live.doc);
+    final lseed = live.at(1500.25, 2000.5);
+    hoverTo(lrig, lseed);
+    final lpreview = ringOf(lrig.tool.debugPreview.single);
+    expectRing(
+        live,
+        lpreview,
+        const [(100, 100), (2950, 100), (2950, 3900), (100, 3900)],
+        'the control\'s preview: the left face');
+    pressAt(lrig, lseed);
+    final lroom = rooms(live.doc).single;
+    expect(labelStrings(live.doc, lroom), ['Room 1', '10.83 m²']);
+    expectSameRing(worldTintOf(live.doc, lroom), lpreview, 'the control');
+
+    // The first reader after a freeze (the FREEZE RULE; M-RT-12): the tool
+    // has hovered the left face and memoised it; the partition then
+    // freezes, which changes no document, and the very next hover there
+    // must not use the frozen wall: the whole box, and the room the whole
+    // box.
+    final after = buildPlan(twoRoomWalls, place: corpusGroups);
+    final afterFrozen = <Handle>{};
+    after.system.dispose();
+    final afterSystem = ParametricSystem(after.doc, testCatalog(),
+        isFrozen: afterFrozen.contains)
+      ..install();
+    addTearDown(afterSystem.dispose);
+    final arig = roomRig(after.doc, frozen: afterFrozen);
+    final inLeft = after.at(1500.25, 2000.5);
+    hoverTo(arig, inLeft);
+    expectRing(
+        after,
+        ringOf(arig.tool.debugPreview.single),
+        const [(100, 100), (2950, 100), (2950, 3900), (100, 3900)],
+        'premise: the left face, memoised');
+    final depth = after.doc.commands.undoDepth;
+    afterFrozen.add(after.walls[4]);
+    expect(after.doc.commands.undoDepth, depth,
+        reason: 'premise: the freeze changes no document');
+    hoverTo(arig, inLeft);
+    final whole = ringOf(arig.tool.debugPreview.single);
+    expectRing(
+        after,
+        whole,
+        const [(100, 100), (7900, 100), (7900, 3900), (100, 3900)],
+        'the first hover after the freeze: the whole box');
+    pressAt(arig, inLeft);
+    final aroom = rooms(after.doc).single;
+    expect(labelStrings(after.doc, aroom), ['Room 1', '29.64 m²']);
+    expectSameRing(worldTintOf(after.doc, aroom), whole,
+        'the room made after the freeze is the preview');
+
+    // The band's memo, read first after the freeze: a point in the live
+    // partition's band (x 2,950-3,050) is no room and the band is
+    // memoised; once the partition freezes, the very next hover there is
+    // in the whole box.
+    final band = buildPlan(twoRoomWalls, place: corpusGroups);
+    final bandFrozen = <Handle>{};
+    final brig = roomRig(band.doc, frozen: bandFrozen);
+    final inBand = band.at(3010.5, 2400.25);
+    hoverTo(brig, inBand);
+    expect(brig.tool.debugPreview, isEmpty,
+        reason: 'premise: in the live partition\'s band');
+    final traces = brig.tool.debugTraces;
+    hoverTo(brig, band.at(2990.25, 1700.5));
+    expect(brig.tool.debugTraces, traces,
+        reason: 'premise: the band\'s verdict memoised');
+    expect(brig.tool.debugPreview, isEmpty);
+    bandFrozen.add(band.walls[4]);
+    hoverTo(brig, inBand);
+    expectRing(
+        band,
+        ringOf(brig.tool.debugPreview.single),
+        const [(100, 100), (7900, 100), (7900, 3900), (100, 3900)],
+        'the first hover after the freeze, in the frozen band: the box');
+  });
+
+  test(
+      'RT-frozen-room a room that freezes after the tool found it in a face '
+      'no longer occupies it: the very next hover shows the face free, and '
+      'a click there makes a room (spec 3a C1.5; M-RT-13)', () {
+    // The box at the corpus far origin, every wall in its own turned group,
+    // Pantry's seed in its one face. 7,800 × 3,800 = 29,640,000 ("29.64
+    // m²", 0.005 from a tie).
+    final plan = buildPlan(boxWalls, place: corpusGroups);
+    final doc = plan.doc;
+    final frozen = <Handle>{};
+    plan.system.dispose();
+    final system =
+        ParametricSystem(doc, testCatalog(), isFrozen: frozen.contains)
+          ..install();
+    addTearDown(system.dispose);
+    final pantry = addRoom(doc, plan.at(1500.25, 2000.5), 'Pantry');
+    final rig = roomRig(doc, frozen: frozen);
+    final p = plan.at(6000.75, 1200.5);
+    hoverTo(rig, p);
+    expect(rig.tool.occupied.value, const RoomOccupied('Pantry'),
+        reason: 'premise: the face is occupied, and memoised');
+    expect(rig.tool.debugPreview, isEmpty);
+    final depth = doc.commands.undoDepth;
+    frozen.add(pantry);
+    expect(doc.commands.undoDepth, depth,
+        reason: 'premise: the freeze changes no document');
+    hoverTo(rig, p);
+    expect(rig.tool.occupied.value, isNull,
+        reason: 'the first hover after the freeze: a frozen room is no room');
+    expect(rig.tool.notice.value, isNull);
+    final preview = ringOf(rig.tool.debugPreview.single);
+    expectRing(
+        plan,
+        preview,
+        const [(100, 100), (7900, 100), (7900, 3900), (100, 3900)],
+        'the face, free');
+    pressAt(rig, p);
+    final room = rooms(doc).where((h) => h != pantry).single;
+    expect(labelStrings(doc, room), ['Room 1', '29.64 m²']);
+    expect(rig.tool.occupied.value, const RoomOccupied('Room 1'),
+        reason: 'control: the live room it made occupies the face');
+  });
+}
