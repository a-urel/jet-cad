+        };
+        for (final n in order) {
+          expect(labelStrings(doc, h[n]!), [n, '29.64 m²'],
+              reason: '$n at $place');
+        }
+        // The lower handle reports each higher room, handles [lower,
+        // higher], the lower's name first: built in the other order, the
+        // reporter and the names swap.
