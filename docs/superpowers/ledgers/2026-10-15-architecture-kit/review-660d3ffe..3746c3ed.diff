+        '{"seed":[1234.5,-987.25],"name":"Room 1","label":null,"color":null}');
+    expect(
+        jsonEncode(offset.toJson()),
+        '{"seed":[1234.5,-987.25],"name":"Room 1","label":[12.75,-3.5],'
