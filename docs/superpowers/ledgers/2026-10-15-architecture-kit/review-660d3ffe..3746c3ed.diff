+/// A tap on the Area line: outside every field, so the field's
+/// `onTapOutside` hands the focus back and its focus loss commits.
+Future<void> blur(WidgetTester tester) async {
+  await tester.tap(area);
+  await tester.pump();
+  await tester.pump();
