+  id: ArchitectureTypes.separator,
+  fromJson: SeparatorParams.fromJson,
+  parametric: const SeparatorType(),
+  grips: (s) =>
+      SeparatorGrips(inputs: roomInputsOf(s), objectSnap: () => s.objectSnap),
