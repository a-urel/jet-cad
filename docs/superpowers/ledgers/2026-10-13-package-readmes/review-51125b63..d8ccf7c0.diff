--- /dev/null
+++ b/tool/ci/check_readmes.dart
@@ -0,0 +1,37 @@
+// Package READMEs spec D8: fails when a Dart block of a package README is no
+// longer in its probe file (tool/readme_probe), which CI analyses, or a YAML
+// block no longer in the host probe's pubspec.
+//
+//   dart run tool/ci/check_readmes.dart
+import 'dart:io';
+
+import 'lib/guide.dart';
+import 'lib/readmes.dart';
+
+void main() {
+  final repo = File.fromUri(Platform.script).parent.parent.parent.path;
+  final yaml =
+      File('$repo/tool/ci/host_probe/pubspec.yaml.in').readAsStringSync();
+  const cases = {
+    'jet_cad_2d': 'engine',
+    'jet_cad_2d_flutter': 'renderer',
+    'jet_cad_floor_plan': 'planner',
+  };
+  final problems = <String>[];
+  var blocks = 0;
+  for (final MapEntry(key: package, value: probe) in cases.entries) {
+    final readme = File('$repo/packages/$package/README.md').readAsStringSync();
+    final dart =
+        File('$repo/tool/readme_probe/lib/$probe.dart').readAsStringSync();
+    blocks += fencedBlocks(readme, 'dart').length +
+        fencedBlocks(readme, 'yaml').length;
+    problems.addAll(readmeProblems(package, readme, dart: dart, yaml: yaml));
+  }
+  if (problems.isEmpty) {
+    stdout.writeln('package READMEs: all $blocks code blocks are in the '
+        'probes');
+    return;
+  }
+  problems.forEach(stderr.writeln);
+  exit(1);
+}
diff --git a/tool/ci/check_screenshots.dart b/tool/ci/check_screenshots.dart
new file mode 100644
index 00000000..8f044310
--- /dev/null
+++ b/tool/ci/check_screenshots.dart
@@ -0,0 +1,35 @@
+// Package READMEs spec D7: the renderer's and the planner's screenshots
+// against pub.dev's rules and the spec's budget, and the engine's README
+// without an image. Run from anywhere: paths come from the script's place.
+//
+//   dart run tool/ci/check_screenshots.dart
+import 'dart:io';
+
+import 'lib/screenshots.dart';
+
+void main() {
+  final repo = File.fromUri(Platform.script).parent.parent.parent.path;
+  String read(String path) => File('$repo/$path').readAsStringSync();
+  final problems = <String>[];
+  for (final package in ['jet_cad_2d_flutter', 'jet_cad_floor_plan']) {
+    final dir = 'packages/$package';
+    problems.addAll(screenshotProblems(
+      package: package,
+      pubspec: read('$dir/pubspec.yaml'),
+      readme: read('$dir/README.md'),
+      pubignore: read('$dir/.pubignore'),
+      sizeOf: (path) {
+        final f = File('$repo/$dir/$path');
+        return f.existsSync() ? f.lengthSync() : null;
+      },
+    ).map((p) => '$package: $p'));
+  }
+  problems.addAll(imagelessProblems(read('packages/jet_cad_2d/README.md'))
+      .map((p) => 'jet_cad_2d: $p'));
+  if (problems.isEmpty) {
+    stdout.writeln('screenshots: every rule holds');
+    return;
+  }
+  problems.forEach(stderr.writeln);
+  exit(1);
+}
