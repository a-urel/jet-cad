+
+import 'package:flutter/gestures.dart' show PointerDeviceKind;
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_floor_plan/jet_cad_floor_plan.dart';
+import 'package:jet_cad_restaurant_symbols/jet_cad_restaurant_symbols.dart';
+
+import 'support/shots.dart';
+
+const _package = 'jet_cad_floor_plan';
+
+/// The restaurant demo's Salon (apps/restaurant_demo/assets/plans), read
+/// from the repository: one source for the demo and the pictures.
+final String _salon = File('../../apps/restaurant_demo/assets/plans/salon.json')
+    .readAsStringSync();
+
+/// The demo's statuses (DemoHomeState.kStatuses), by table number.
+final Map<String, TableStatus> _statuses = {
+  '1': TableStatus(color: const Color(0x99FFB300)),
+  '2': TableStatus(color: const Color(0x9943A047)),
+  '4': TableStatus(color: const Color(0x99E53935), caption: 'Bill'),
+  '8': TableStatus(color: const Color(0x9943A047)),
+  '10': TableStatus(color: const Color(0x99FFB300)),
+};
+
+/// A POS-like look from public fields (the demo's own theme is app code).
+const FloorPlanTheme _pos = FloorPlanTheme(
+  groupChipRadius: 6,
+  selectionWidth: 3,
+  focusVeilOpacity: 0.75,
+  serviceBarHeight: 52,
+);
+
+/// A controller over the Salon and the loader it reads its symbols from,
+/// kept so the scene waits on the loader a host would hold (ruling R1).
+({FloorPlanController c, SymbolLibraryLoader symbols}) _controller() {
+  final symbols = SymbolLibraryLoader(
+      sources: const [furnitureSymbolSource, restaurantSymbolSource]);
+  addTearDown(symbols.dispose);
+  final controller = FloorPlanController(symbols: symbols, json: _salon);
+  addTearDown(controller.dispose);
+  return (c: controller, symbols: symbols);
+}
+
+/// The planner paints its status captions and group chips with a family
+/// only when the theme names one, else the platform's default font, which
+/// under `flutter test` is the test font's boxes. The scenes name Roboto,
+/// as a host may, in the app's theme; a view's own theme merges over it.
+const FloorPlanTheme _fonts = FloorPlanTheme(
+  statusCaptionStyle: TextStyle(fontFamily: 'Roboto'),
+  groupChipTextStyle: TextStyle(fontFamily: 'Roboto'),
+);
+
+Widget _app(FloorPlanController controller,
+        {Brightness brightness = Brightness.light,
+        FloorPlanTheme? theme,
+        FloorPlanFloorDrag floorDrag = FloorPlanFloorDrag.pan}) =>
+    MaterialApp(
+      debugShowCheckedModeBanner: false,
+      theme: ThemeData(brightness: brightness, extensions: const [_fonts]),
+      supportedLocales: floorPlanSupportedLocales,
+      localizationsDelegates: floorPlanLocalizationsDelegates,
+      home: Scaffold(
+          body: FloorPlanView(
+              controller: controller, theme: theme, floorDrag: floorDrag)),
+    );
+
+/// Waits until the libraries are read. The design view starts the loader
+/// when it mounts; the selection mode never reads the library, so a host
+/// that shares its loader starts it itself (`load` is once-only).
+Future<void> _ready(WidgetTester tester, SymbolLibraryLoader symbols) {
+  unawaited(symbols.load());
+  return settle(tester, until: () => symbols.state is SymbolLibraryReady);
+}
+
+/// Every number a scene names is a live, visible table of the Salon:
+/// `setTableStatus` and friends would ignore one that is not.
+void _expectTables(FloorPlanController c, Iterable<String> numbers) {
+  final live = {
+    for (final t in c.tables)
+      if (t.visible && t.number != null) t.number!
+  };
+  expect(live, containsAll(numbers.toSet()), reason: 'the Salon has $live');
+}
+
+void main() {
+  setUpAll(() async {
+    await loadManifestFonts();
+    await ensureFloorPlanFonts();
+  });
+
+  testWidgets('P1 design_light.png: the editor, light', (tester) async {
+    final (:c, :symbols) = _controller();
+    await pumpScene(tester, _app(c));
+    await _ready(tester, symbols);
+    expect(c.mode.value, FloorPlanMode.design);
+    await shoot(tester, package: _package, file: 'design_light.png');
+  });
+
+  testWidgets('P2 design_dark.png: the editor, dark', (tester) async {
+    final (:c, :symbols) = _controller();
+    await pumpScene(tester, _app(c, brightness: Brightness.dark));
+    await _ready(tester, symbols);
+    await shoot(tester, package: _package, file: 'design_dark.png');
+  });
+
+  testWidgets('P3 service_status.png: statuses, captions, a group',
+      (tester) async {
+    final (:c, :symbols) = _controller();
+    _expectTables(c, {..._statuses.keys, '6', '7'});
+    c.setMode(FloorPlanMode.selection);
+    c.setTableStatus(_statuses);
+    c.setTableGroups({
+      'party': TableGroup(members: {'6', '7'}, label: 'Party of 8')
+    });
+    await pumpScene(tester, _app(c));
+    await _ready(tester, symbols);
+    await shoot(tester, package: _package, file: 'service_status.png');
+  });
+
+  testWidgets('P4 service_dark_focus.png: dark, a POS theme, a zone in focus',
+      (tester) async {
+    final (:c, :symbols) = _controller();
+    const focus = {'8', '9', '10', '11'};
+    _expectTables(c, {..._statuses.keys, ...focus});
+    c.setMode(FloorPlanMode.selection);
+    c.setTableStatus(_statuses);
+    c.setTableFocus(focus);
+    await pumpScene(tester, _app(c, brightness: Brightness.dark, theme: _pos));
+    await _ready(tester, symbols);
+    await shoot(tester, package: _package, file: 'service_dark_focus.png');
+  });
+
+  testWidgets('P5 service_band.png: a crossing band mid-drag', (tester) async {
+    final (:c, :symbols) = _controller();
+    // The Salon's front row: tables 1, 2 and 3 side by side.
+    _expectTables(c, {'1', '2', '3'});
+    c.setMode(FloorPlanMode.selection);
+    await pumpScene(tester, _app(c, floorDrag: FloorPlanFloorDrag.band));
+    await _ready(tester, symbols);
+    final details = {for (final d in c.tableDetails) d.table.number: d};
+    final first = details['1']!, last = details['3']!;
+    // World millimetres, y up: from the floor right of table 3, below its
+    // middle, leftwards and up to the middle of table 1 -- right to left,
+    // so a crossing band over the three.
+    final from = c.worldToGlobal(Offset(
+        last.center!.dx + last.size!.width / 2 + 600,
+        last.center!.dy - last.size!.height / 4))!;
+    final to = c.worldToGlobal(
+        Offset(first.center!.dx, first.center!.dy + first.size!.height / 4))!;
+    final canvas = c.canvasRect.value!;
+    expect(canvas.contains(from) && canvas.contains(to), isTrue);
+    expect(c.tableAt(from - canvas.topLeft), isNull,
+        reason: 'the band starts on the floor');
+    final g = await tester.startGesture(from, kind: PointerDeviceKind.mouse);
+    await g.moveTo(Offset.lerp(from, to, 0.5)!);
+    await tester.pump();
+    await g.moveTo(to);
+    await tester.pump();
+    await shoot(tester, package: _package, file: 'service_band.png');
+    await g.up();
+    await tester.pump();
+  });
+
+  testWidgets('P6 service_colors.png: tables in plan colours', (tester) async {
+    final (:c, :symbols) = _controller();
+    const colours = {
+      '1': FloorPlanColor.blue,
+      '2': FloorPlanColor.blue,
+      '3': FloorPlanColor.teal,
+      '6': FloorPlanColor.purple,
+      '7': FloorPlanColor.purple,
+      '9': FloorPlanColor.orange,
+    };
+    _expectTables(c, colours.keys);
+    // A colour is a design edit: the selection mode refuses it.
+    expect(c.setTablesColor(colours), isTrue);
+    c.setMode(FloorPlanMode.selection);
+    await pumpScene(tester, _app(c));
+    await _ready(tester, symbols);
+    await shoot(tester, package: _package, file: 'service_colors.png');
+  });
+}
diff --git a/tool/screenshots/test/renderer_scenes_test.dart b/tool/screenshots/test/renderer_scenes_test.dart
