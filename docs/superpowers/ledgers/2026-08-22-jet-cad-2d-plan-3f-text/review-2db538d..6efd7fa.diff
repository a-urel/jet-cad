+void main() {
+  for (final (name, minTextCapPixels) in const [
+    ('1', kMinTextCapPixels),
+    ('2', 0.0),
+    ('3', kAboveAllThreshold),
+  ]) {
+    for (final backend in RenderBackend.values) {
