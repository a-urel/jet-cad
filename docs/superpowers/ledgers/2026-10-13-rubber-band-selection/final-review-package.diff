+  Widget view({
+    FloorPlanFloorDrag floorDrag = FloorPlanFloorDrag.band,
+    bool userCamera = true,
+    bool shortcuts = true,
+    FloorPlanLongPress longPress = FloorPlanLongPress.toggleSelection,
+  }) =>
