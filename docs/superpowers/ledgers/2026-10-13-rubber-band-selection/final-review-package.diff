+import 'package:jet_cad_floor_plan/src/tables/table_index.dart';
+import 'package:jet_cad_floor_plan/src/tables/table_label.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../tables/table_fixture.dart';
+
+/// Where each table stands, as offsets from the sheet's centre in world
+/// units (y up). Tables 1 (turned a quarter, mirrored), 2, 3 (locked), 4
+/// (unnumbered), 5 and 6 (group 'g'), 7 (hidden), then the planter.
+const List<(double, double, int, bool)> _places = [
+  (-4000.5, 1500.25, 1, true),
+  (-1000.25, 1500.75, 0, false),
+  (-1000.75, -2500.5, 2, false),
+  (2500.5, 1500.25, 0, false),
+  (2500.25, -2500.75, 3, false),
+  (5000.75, -2500.25, 0, false),
+  (-4000.25, -2500.5, 0, false),
+];
+
+/// The planter's offset.
+const (double, double) _planterAt = (-6500.5, 1500.25);
+
+String bandPlan() {
+  final measurer = FlutterTextMeasurer();
+  final doc = newDocument(measurer);
+  final sheet =
+      sheetWorldRect(doc.components.get<PageComponent>(doc.rootHandle)!);
+  final cx = (sheet.minX + sheet.maxX) / 2, cy = (sheet.minY + sheet.maxY) / 2;
+  for (final (dx, dy, turns, mirrored) in _places) {
+    doc.commands.execute(placeSymbol(doc, entryOf(tableSymbol()),
+        at: Vector2(cx + dx, cy + dy),
+        quarterTurns: turns,
+        mirrored: mirrored));
+  }
+  doc.commands.execute(placeSymbol(doc, entryOf(planterSymbol),
+      at: Vector2(cx + _planterAt.$1, cy + _planterAt.$2)));
+  final zero = doc.tables.layers[ReservedHandles.layerZero]!;
+  Handle layer(String name) {
+    final h = doc.handleSeed.next();
+    doc.commands.execute(AddLayerCommand(LayerRecord(
+        handle: h,
+        name: name,
+        color: const IndexedColor(1),
+        linetype: zero.linetype,
+        lineweight: zero.lineweight,
+        transparency: zero.transparency,
+        visible: true,
+        locked: false)));
+    return h;
+  }
+
+  final locked = layer('Locked'), hidden = layer('Hidden');
+  final survey = TableSurvey.of(doc);
+  doc.commands.execute(
+      SetInstanceLayerCommand(survey.withNumber('3').single.instance, locked));
+  doc.commands.execute(
+      SetInstanceLayerCommand(survey.withNumber('7').single.instance, hidden));
+  doc.commands.execute(
+      SetLayerCommand(doc.tables.layers[locked]!.copyWith(locked: true)));
+  doc.commands.execute(
+      SetLayerCommand(doc.tables.layers[hidden]!.copyWith(visible: false)));
+  doc.commands.execute(SetEntityTextCommand(
+      survey.withNumber('4').single.label!, '', kTableLabelTag));
+  final json = DraftDocumentCodec.encodeToString(doc);
+  doc.dispose();
+  measurer.clear();
+  return json;
+}
+
+InstanceNode node(FloorPlanController c, String n) {
+  final d = c.activeDocument;
+  final tables = TableSurvey.of(d).tables;
+  final t = n == '4' ? tables[3] : tables.singleWhere((t) => t.number == n);
+  return d.tree[t.instance]! as InstanceNode;
+}
+
+/// A table's top centre on the screen (its base point).
+Offset centre(WidgetTester tester, FloorPlanController c, String n) {
+  final w = node(c, n).transform.transformPoint(Vector2(900, 700));
+  return global(tester, c, w);
+}
+
+Offset global(WidgetTester tester, FloorPlanController c, Vector2 world) {
+  final s = c.cameraController.value.worldToScreen(world);
+  return tester.getTopLeft(find.byType(InteractionLayer)) + Offset(s.x, s.y);
+}
+
+/// The point [dx], [dy] (world units, y up) from the sheet's centre.
+Offset floorAt(
+    WidgetTester tester, FloorPlanController c, double dx, double dy) {
+  final sheet = sheetWorldRect(c.activeDocument.components
+      .get<PageComponent>(c.activeDocument.rootHandle)!);
+  return global(
+      tester,
+      c,
+      Vector2((sheet.minX + sheet.maxX) / 2 + dx,
+          (sheet.minY + sheet.maxY) / 2 + dy));
+}
+
+/// Screen pixels per world unit.
+double pxPerUnit(FloorPlanController c) {
+  final v = c.cameraController.value;
+  return (v.worldToScreen(Vector2(1000, 0)).x -
+              v.worldToScreen(Vector2.zero()).x)
+          .abs() /
+      1000;
+}
+
+Offset worldZero(FloorPlanController c) {
+  final s = c.cameraController.value.worldToScreen(Vector2.zero());
+  return Offset(s.x, s.y);
+}
+
+/// The band that takes tables 1 and 2 whole, left to right.
+(Offset, Offset) over12(WidgetTester tester, FloorPlanController c) => (
+      floorAt(tester, c, -5600, 3200),
+      floorAt(tester, c, 300, 300),
+    );
