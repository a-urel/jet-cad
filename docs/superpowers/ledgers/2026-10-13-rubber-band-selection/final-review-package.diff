+// Rubber-band spec RB-1 (the view's `floorDrag`), with RB-2's touch and
+// phase rules and RB-5's keys, driven through FloorPlanView and real
+// pointers (V-1). The camera is the view's own fit: y-flipped, scaled and
+// off the origin; tables are turned and one is mirrored; the plan holds a
+// group {5, 6}, a table on a locked layer (3), an unnumbered table (4), a
+// table on a hidden layer (7) and a planter.
+import 'package:flutter/gestures.dart'
+    show PointerDeviceKind, kSecondaryMouseButton;
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
