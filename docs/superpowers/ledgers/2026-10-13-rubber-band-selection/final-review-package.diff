+Future<void> drag(
+    WidgetTester tester, PointerDeviceKind kind, Offset from, Offset to) async {
+  final g = await tester.startGesture(from, kind: kind);
+  await glide(tester, g, from, to);
+  await g.up();
+  await tester.pump();
+}
