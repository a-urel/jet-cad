+    expect(made, greaterThan(0), reason: 'premise: the fills are built');
+    for (var i = 1; i <= 10; i++) {
+      c.cameraController.value = ViewportTransform(
+          worldToScreenMatrix: Transform2(0.06 + 0.002 * i, 0, 0,
+              -0.06 - 0.002 * i, -2260 - 7.5 * i, -1528 + 3.25 * i));
