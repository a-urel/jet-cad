+  testWidgets(
+      'TF9 the allocation bar on the design mount: ten camera frames '
+      'allocate and rebuild nothing; a colour change rebuilds once',
+      (tester) async {
+    final c = controllerOver();
+    await pumpPlan(tester, c);
+    final painter = designPainter(tester);
