+      );
+      final content = PdfContent.parse(bytes, inflate: zlib.decode);
+      final fills = content.paths.where((p) => p.fills).toList();
+      final strokes = content.paths.where((p) => p.strokes).toList();
+      expect(fills, hasLength(2));
