+
+  test(
+      'F-4 a plan whose object is already broken: the load\'s dry run finds '
+      'it, so it is frozen and locked before the first edit', () {
+    final sw = Switches();
+    final a = PlanController(kits: [boxKit(sw)]);
+    final broken = addObject(
