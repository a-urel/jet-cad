 abstract final class PlanLocaleScope {
   static const Locale _english = Locale('en');
 
   /// Reports [context]'s locale and its [PlanStrings] to [controller]
   /// (`reportLocale`, Task 8, with this task's `strings:`),
   /// English when no [Localizations] is above (as `PlanStrings.of` answers
   /// English there), and registers [context] as a dependent of the locale.
   ///
   /// Never notifies during a build: the report lands after the current
   /// frame (one is scheduled when none is pending), and only while
-  /// [context] is still mounted; an unchanged locale notifies nothing.
+  /// [context] is still mounted and [controller] not disposed (a host may
+  /// dispose it in the frame the report was owed in, Task 15); an
+  /// unchanged locale notifies nothing.
   static void push(BuildContext context, PlanController controller) {
     final next = Localizations.maybeLocaleOf(context) ?? _english;
     // The language class too (a host's own gives its own separator: NS7).
     final strings = PlanStrings.of(context);
     SchedulerBinding.instance
       ..addPostFrameCallback((_) {
-        if (context.mounted) controller.reportLocale(next, strings: strings);
+        if (context.mounted && !controller.isDisposed) {
+          controller.reportLocale(next, strings: strings);
+        }
       })
       ..ensureVisualUpdate();
   }
 }
diff --git a/packages/jet_cad_2d_plan/lib/src/shortcuts/chords.dart b/packages/jet_cad_2d_plan/lib/src/shortcuts/chords.dart
new file mode 100644
index 00000000..d9d14af6
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/shortcuts/chords.dart
@@ -0,0 +1,59 @@
+// The chords the plan's keyboard binds (spec 2a P2, "The keyboard"),
+// ported from jet_cad_floor_plan/lib/src/shell_commands.dart:10-61: Cmd
+// and Ctrl with each key, on every platform. PlanShortcuts binds them
+// (Task 16); the guard keeps Undo and Redo out of a focused field.
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter/widgets.dart' show SingleActivator;
+
+/// Cmd and Ctrl with [key] (and Shift when [shift]): both modifiers are
+/// bound on every platform (spec 12a D6, S-26).
+List<SingleActivator> _chord(LogicalKeyboardKey key, {bool shift = false}) => [
+      SingleActivator(key, meta: true, shift: shift),
+      SingleActivator(key, control: true, shift: shift),
+    ];
+
+/// New: Meta+N, Ctrl+N.
+final List<SingleActivator> kNewChords = _chord(LogicalKeyboardKey.keyN);
+
+/// Open: Meta+O, Ctrl+O.
+final List<SingleActivator> kOpenChords = _chord(LogicalKeyboardKey.keyO);
+
+/// Save: Meta+S, Ctrl+S.
+final List<SingleActivator> kSaveChords = _chord(LogicalKeyboardKey.keyS);
+
+/// Save As: Meta+Shift+S, Ctrl+Shift+S.
+final List<SingleActivator> kSaveAsChords =
+    _chord(LogicalKeyboardKey.keyS, shift: true);
+
+/// Export: Meta+E, Ctrl+E (spec 13 D8).
+final List<SingleActivator> kExportChords = _chord(LogicalKeyboardKey.keyE);
+
+/// Print: Meta+P, Ctrl+P (spec 13 D9). Bare P is the Polyline tool's
+/// letter; the chord is not.
+final List<SingleActivator> kPrintChords = _chord(LogicalKeyboardKey.keyP);
+
+/// Undo: Meta+Z, Ctrl+Z.
+final List<SingleActivator> kUndoChords = _chord(LogicalKeyboardKey.keyZ);
+
+/// Redo: Meta+Shift+Z, Ctrl+Shift+Z, and Ctrl+Y.
+final List<SingleActivator> kRedoChords = [
+  ..._chord(LogicalKeyboardKey.keyZ, shift: true),
+  const SingleActivator(LogicalKeyboardKey.keyY, control: true),
+];
+
+/// Every file command's chord: what the app binds a second time above the
+/// Navigator, consume-only (spec 12a D6, U-3, R-10). Export's and Print's
+/// join them (spec 13 D8, R-8): with a dialog up, Ctrl+P must not reach the
+/// browser's own print.
+final List<SingleActivator> kFileChords = [
+  ...kNewChords,
+  ...kOpenChords,
+  ...kSaveChords,
+  ...kSaveAsChords,
+  ...kExportChords,
+  ...kPrintChords,
+];
+
+/// The file commands that need the document's page (spec 13 D8, D9): the
+/// shell enables them only while it has one, besides idle.
+const Set<String> kPageCommandIds = {'export', 'print'};
diff --git a/packages/jet_cad_2d_plan/lib/src/shortcuts/plan_shortcut_guard.dart b/packages/jet_cad_2d_plan/lib/src/shortcuts/plan_shortcut_guard.dart
new file mode 100644
index 00000000..860926e2
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/shortcuts/plan_shortcut_guard.dart
@@ -0,0 +1,141 @@
+// The keys a text field inside the plan keeps (spec 2a P2, "The keyboard":
+// text fields keep their keys, and the guard is built from the letters
+// actually in use, not from today's fixed list of 16). Ported from
+// jet_cad_floor_plan/lib/src/shortcut_guard.dart: ShellShortcutGuard
+// becomes PlanShortcutGuard, whose letters come from planLetterKeys;
+// PlannerTextKeys becomes PlanTextKeys, unchanged.
+import 'package:flutter/services.dart'
+    show HardwareKeyboard, KeyEvent, KeyUpEvent, LogicalKeyboardKey;
+import 'package:flutter/widgets.dart';
+
+import '../controller/plan_controller.dart';
+import '../tools/generic_tools.dart';
+import 'chords.dart';
+
+export 'chords.dart';
+
+/// The key of an upper-case Latin [letter] (`'A'`..`'Z'`).
+LogicalKeyboardKey letterKey(String letter) => LogicalKeyboardKey(
+    LogicalKeyboardKey.keyA.keyId + letter.codeUnitAt(0) - 0x41);
+
+/// The letters [controller]'s keyboard binds, F included (spec 2a P2: F is
+/// reserved for Fill). Here the generic tools' (V L P R C A T); Task 16
+/// adds the kits' letters in load order.
+List<LogicalKeyboardKey> planLetterKeys(PlanController controller) => [
+      for (final t in genericTools) letterKey(t.letter),
+      LogicalKeyboardKey.keyF,
+    ];
+
+/// Spec 05 D9, Ruling 05-8, spec 2a P2. Ported from `ShellShortcutGuard`
+/// (`shortcut_guard.dart:27-67`).
+///
+/// **Why this exists.** A `Shortcuts` or `CallbackShortcuts` above a text
+/// field takes the field's keystrokes. PlanShortcuts' tool letters, its
+/// Undo and Redo chords and its Escape are such shortcuts.
+///
+/// **What it does.** It maps each of them, **nearer** the field, to
+/// `DoNothingAndStopPropagationTextIntent`. `EditableText` answers that
+/// intent with `DoNothingAction(consumesKey: false)`, so the key stops here
+/// and reaches the field as text.
+///
+/// **Elsewhere it is inert.** With focus anywhere other than a text field,
+/// no action is found, and the key bubbles up to the shortcuts as before.
+class PlanShortcutGuard extends StatelessWidget {
+  const PlanShortcutGuard(
+      {super.key, required this.controller, required this.child});
+
+  /// Whose letters in use are guarded.
+  final PlanController controller;
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) => Shortcuts(
+        shortcuts: <ShortcutActivator, Intent>{
+          for (final key in planLetterKeys(controller))
+            SingleActivator(key): const DoNothingAndStopPropagationTextIntent(),
+          // Undo and Redo: in a focused field they never reach the
+          // document. A SingleActivator matches its modifiers exactly, so
+          // each chord is listed. The file chords are not guarded: Cmd+S in
+          // a panel field saves.
+          for (final chord in [...kUndoChords, ...kRedoChords])
+            chord: const DoNothingAndStopPropagationTextIntent(),
+          // PlanShortcuts binds Escape too: in a panel's field it must not
+          // drop a pending shape. The text entry's own Escape binding sits
+          // nearer, so it still cancels there.
+          const SingleActivator(LogicalKeyboardKey.escape):
+              const DoNothingAndStopPropagationTextIntent(),
+        },
+        child: child,
+      );
+}
+
+/// Slice 4, Task 7 finding 1: the text fields inside the view keep their
+/// keys from a host's bindings above it, in both modes.
+///
+/// **Why this exists.** Flutter binds the text-editing keys (Backspace,
+/// Delete, the arrows, select all, copy, paste) once, in `WidgetsApp`, at
+/// the top of the tree, and a key typed into a field bubbles through every
+/// ancestor first. A host's `Shortcuts` above the view binding Delete,
+/// Backspace or a letter (a point of sale's own keys) would take a key
+/// typed into a panel's field, the Symbols search, a layer's rename, the
+/// TEXT entry, or a host field in a bar or in the inspector.
+///
+/// **What it does.** It wraps the view in:
+/// - Flutter's `DefaultTextEditingShortcuts` again, nearer than any host
+///   binding, so an editing key in a field is the field's (Enter and
+///   Space among them: they stop there for the platform's text input);
+/// - above it, a key that types a character (no Control or Meta held),
+///   Delete and Backspace, mapped to
+///   `DoNothingAndStopPropagationTextIntent`: in a field (a read-only one
+///   too, whose own editing actions refuse Delete and Backspace) the key
+///   stops here and goes to the platform's text input, as
+///   [PlanShortcutGuard] does for the shell's keys. A chord (Control or
+///   Meta held) that no field takes still reaches the host.
+///
+/// **Elsewhere it is inert.** Only a focused `EditableText` answers those
+/// intents: with the focus on the canvas or on a button no action is found
+/// and the key bubbles up to the host as before. The planner's own
+/// bindings (the shell's and the selection mode's chords, letters and
+/// Escape, [PlanShortcutGuard]) sit nearer the fields and act as before.
+class PlanTextKeys extends StatelessWidget {
+  const PlanTextKeys({super.key, required this.child});
+
+  final Widget child;
+
+  static final Map<ShortcutActivator, Intent> _stop = {
+    const _TypingActivator(): const DoNothingAndStopPropagationTextIntent(),
+    const SingleActivator(LogicalKeyboardKey.delete):
+        const DoNothingAndStopPropagationTextIntent(),
+    const SingleActivator(LogicalKeyboardKey.backspace):
+        const DoNothingAndStopPropagationTextIntent(),
+  };
+
+  @override
+  Widget build(BuildContext context) => Shortcuts(
+        debugLabel: 'PlanTextKeys',
+        shortcuts: _stop,
+        child: DefaultTextEditingShortcuts(child: child),
+      );
+}
+
+/// A key-down or repeat that types a printable character, with neither
+/// Control nor Meta held (those are chords, not typing).
+class _TypingActivator extends ShortcutActivator {
+  const _TypingActivator();
+
+  @override
+  Iterable<LogicalKeyboardKey>? get triggers => null;
+
+  @override
+  bool accepts(KeyEvent event, HardwareKeyboard state) {
+    if (event is KeyUpEvent) return false;
+    final character = event.character;
+    if (character == null || character.isEmpty) return false;
+    final unit = character.codeUnitAt(0);
+    if (unit < 0x20 || unit == 0x7f) return false;
+    return !state.isControlPressed && !state.isMetaPressed;
+  }
+
+  @override
+  String debugDescribeKeys() => 'a key that types a character';
+}
diff --git a/packages/jet_cad_2d_plan/test/canvas/canvas_camera_test.dart b/packages/jet_cad_2d_plan/test/canvas/canvas_camera_test.dart
new file mode 100644
index 00000000..17ae5138
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/canvas/canvas_camera_test.dart
@@ -0,0 +1,61 @@
+// Ported from jet_cad_floor_plan/test/host/camera_test.dart; assertions unchanged.
+//
+// CM5's second half, which Task 8 sent here because it needs a mounted
+// canvas (controller ruling R-m): a camera command made before any canvas
+// drops a centring not yet performed, and the plan's own first fit still
+// frames the page. Task 8's first half (test/controller/camera_test.dart)
+// is repeated as the premise. The fitToTables half is 2b's.
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+
+import '../support/harness.dart';
+import '../support/test_kit.dart';
+
+List<double> parts(ViewportTransform t) {
+  final m = t.worldToScreenMatrix;
+  return [m.a, m.b, m.c, m.d, m.e, m.f];
+}
+
+/// [t] panned by [d], by hand.
+List<double> panned(ViewportTransform t, Offset d) {
+  final m = t.worldToScreenMatrix;
+  return [m.a, m.b, m.c, m.d, m.e + d.dx, m.f + d.dy];
+}
+
+/// [c]'s canvas in an app at 1440 x 900, pumped as today's `mount` did.
+Future<void> mount(WidgetTester tester, PlanController c) async {
+  await tester.binding.setSurfaceSize(const Size(1440, 900));
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  await tester
+      .pumpWidget(MaterialApp(home: Scaffold(body: PlanCanvas(controller: c))));
+  await tester.pump();
+  await tester.pump();
+}
+
+/// The page fitted to [c]'s canvas as the engine fits it, unclamped (the
+/// default bounds hold it).
+ViewportTransform pageFitOf(PlanController c) => fitToPage(
+    c.document.components.get<PageComponent>(c.document.rootHandle)!,
+    c.canvasRect.value!.size);
+
+void main() {
+  testWidgets(
+      'CM5 panBy with no view acts at once and drops a request not yet '
+      'performed with its target; the plan\'s own first fit still frames '
+      'the page (Task 2 review R-1)', (tester) async {
+    final c = controllerFor(kits: [testKit()], json: slabPlanText());
+    final before = c.camera.value;
+    c.centerOn(const Offset(-2600, 1400), scale: 0.2);
+    const d = Offset(37.25, -11.5);
+    c.panBy(d);
+    expect(parts(c.camera.value), panned(before, d));
+    expect(() => c.panBy(const Offset(double.nan, 0)), throwsArgumentError);
+    expect(parts(c.camera.value), panned(before, d));
+    await mount(tester, c);
+    expect(parts(c.camera.value), parts(pageFitOf(c)),
+        reason: 'the plan\'s own fit, not centerOn\'s');
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/canvas/canvas_draw_test.dart b/packages/jet_cad_2d_plan/test/canvas/canvas_draw_test.dart
new file mode 100644
index 00000000..1f392dd4
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/canvas/canvas_draw_test.dart
@@ -0,0 +1,206 @@
+// Ported from jet_cad_floor_plan/test/planner_draw_test.dart; assertions unchanged.
+//
+// The drawing on the canvas alone: the TEXT entry's place (A7), the ink of
+// a drafted line through the canvas's own resolver and its survival across
+// rebuilds (A17), and the ink following the paper (A20-A22). A key that
+// armed a tool is the controller's selectTool here (the keyboard is Task
+// 16's); a swatch is the page edit it made (the page panel is Task 18's).
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:jet_cad_2d_plan/src/canvas/plan_canvas_view.dart';
+
+import '../support/canvas_fixture.dart';
+
+void main() {
+  testWidgets(
+      'A7 the field sits at the camera\'s point and survives a pan '
+      'with its state (M-05n, M-05u)', (tester) async {
+    final c = drawController().c;
+    await pumpDraw(tester, c);
+    c.selectTool('plan.text');
+    await tester.pump();
+    await tester.tapAt(globalOf(tester, c, 7100.5, 3050.25));
+    await tester.pump();
+    final field = find.byKey(const Key('text-entry'));
+    final placed = c.textTool;
+    final at = placed.pending.value!.point;
+    Offset corner() =>
+        tester.getBottomLeft(find.byKey(const Key('text-entry-box')));
+    final want = globalOf(tester, c, at.x, at.y);
+    expect((corner() - want).distance, lessThan(0.5));
+    await tester.enterText(field, 'abc');
+    final state = tester.state<EditableTextState>(entryEditable);
+    c.camera.value = ViewportTransform(
+        worldToScreenMatrix: Transform2.translation(40, -25)
+            .multiply(c.camera.value.worldToScreenMatrix));
+    await tester.pump();
+    expect(
+        (corner() - globalOf(tester, c, at.x, at.y)).distance, lessThan(0.5));
+    expect(identical(tester.state<EditableTextState>(entryEditable), state),
+        isTrue,
+        reason: 'Ruling 05-10: never rebuilt by the camera');
+    expect(state.widget.focusNode.hasFocus, isTrue);
+    expect(placed.controller.text, 'abc');
+  });
+
+  testWidgets(
+      'A17 a line drafted with L is ByLayer on layer 0 and resolves black '
+      "through the canvas's own resolver, which survives a rebuild "
+      '(fix/post-07)', (tester) async {
+    final seeded = drawController();
+    final c = seeded.c;
+    await pumpDraw(tester, c);
+    c.selectTool('plan.line');
+    await tester.pump();
+    await tester.tapAt(globalOf(tester, c, 7010, 3020));
+    await tester.pump();
+    await tester.tapAt(globalOf(tester, c, 7060, 3090));
+    await tester.pump();
+    c.selectTool('plan.select');
+    await tester.pump();
+    final doc = c.document;
+    final drafted =
+        ofKind(doc, EntityKind.line).where((h) => h != seeded.line).single;
+    final slot = doc.entities.slotOf(drafted)!;
+    // The fixture is the defect's own: nothing concrete to fall back on.
+    expect(doc.entities.colorAt(slot), kByLayer);
+    expect(doc.entities.layerAt(slot), ReservedHandles.layerZero);
+    expect(doc.tables.layers[ReservedHandles.layerZero]!.color,
+        const IndexedColor(7));
+
+    DraftCanvasState canvas() =>
+        tester.state<DraftCanvasState>(find.byType(DraftCanvas));
+    final painter = canvas().painter;
+    expect(painter.resolver.styleFor(slot, StyleContext.documentRoot).argb,
+        0xFF000000,
+        reason: 'ACI 7 is the foreground, black on the paper');
+
+    // A rebuild of the shell and the view must hand the canvas the same
+    // resolver: a different one makes `didUpdateWidget` rebuild the painter.
+    tester.element(find.byType(PlanCanvas)).markNeedsBuild();
+    tester.element(find.byType(PlanCanvasView)).markNeedsBuild();
+    await tester.pump();
+    expect(identical(canvas().painter, painter), isTrue,
+        reason: 'one resolver per paper foreground, not one per build');
+  });
+
+  /// Drafts one line with plan.line on [c] and returns its slot: ByLayer on
+  /// layer 0, which is ACI 7.
+  Future<int> draftLine(WidgetTester tester, PlanController c) async {
+    final doc = c.document;
+    final before = ofKind(doc, EntityKind.line).toSet();
+    c.selectTool('plan.line');
+    await tester.pump();
+    await tester.tapAt(globalOf(tester, c, 7010, 3020));
+    await tester.pump();
+    await tester.tapAt(globalOf(tester, c, 7060, 3090));
+    await tester.pump();
+    c.selectTool('plan.select');
+    await tester.pump();
+    final drafted =
+        ofKind(doc, EntityKind.line).where((h) => !before.contains(h)).single;
+    final slot = doc.entities.slotOf(drafted)!;
+    expect(doc.entities.colorAt(slot), kByLayer);
+    expect(doc.entities.layerAt(slot), ReservedHandles.layerZero);
+    return slot;
+  }
+
+  /// The slot's colour through the canvas's own painter's resolver.
+  int argbOnCanvas(WidgetTester tester, int slot) => tester
+      .state<DraftCanvasState>(find.byType(DraftCanvas))
+      .painter
+      .resolver
+      .styleFor(slot, StyleContext.documentRoot)
+      .argb;
+
+  testWidgets(
+      'A20 the foreground follows the paper: black on White, white on '
+      'Blueprint picked in the Page panel, back by undo and redo; White to '
+      'Ivory keeps the resolver (fix/post-07 F1b)', (tester) async {
+    final c = drawController().c;
+    await pumpDraw(tester, c);
+    final doc = c.document;
+    PageComponent page() => doc.components.get<PageComponent>(doc.rootHandle)!;
+    DraftCanvasState canvas() =>
+        tester.state<DraftCanvasState>(find.byType(DraftCanvas));
+    expect(page().background, 0xFFFFFFFF, reason: 'starts on White');
+    final slot = await draftLine(tester, c);
+    expect(argbOnCanvas(tester, slot), 0xFF000000, reason: 'White');
+
+    // Each page edit below is heard after the frame it is pumped in (the
+    // document's change stream is asynchronous, and the canvas alone has
+    // nothing that schedules that frame, as the shell's swatch tap and bar
+    // did): a second pump draws it.
+    doc.commands.execute(SetComponentCommand<PageComponent>(
+        doc.rootHandle, page().copyWith(background: 0xFF1F3A5F)));
+    await tester.pump();
+    await tester.pump();
+    expect(page().background, 0xFF1F3A5F);
+    expect(argbOnCanvas(tester, slot), 0xFFFFFFFF, reason: 'Blueprint');
+
+    doc.commands.undo();
+    await tester.pump();
+    await tester.pump();
+    expect(page().background, 0xFFFFFFFF);
+    expect(argbOnCanvas(tester, slot), 0xFF000000, reason: 'undo to White');
+
+    doc.commands.redo();
+    await tester.pump();
+    await tester.pump();
+    expect(page().background, 0xFF1F3A5F);
+    expect(argbOnCanvas(tester, slot), 0xFFFFFFFF, reason: 'redo Blueprint');
+
+    doc.commands.undo();
+    await tester.pump();
+    await tester.pump();
+    expect(argbOnCanvas(tester, slot), 0xFF000000, reason: 'undo again');
+
+    // White to Ivory: the page changes, the foreground does not, so the
+    // canvas keeps its painter (a new resolver would rebuild it).
+    final painter = canvas().painter;
+    doc.commands.execute(SetComponentCommand<PageComponent>(
+        doc.rootHandle, page().copyWith(background: 0xFFFAF6EC)));
+    await tester.pump();
+    await tester.pump();
+    expect(page().background, 0xFFFAF6EC);
+    expect(identical(canvas().painter, painter), isTrue,
+        reason: 'same foreground, same resolver');
+    expect(argbOnCanvas(tester, slot), 0xFF000000, reason: 'Ivory');
+  });
+
+  testWidgets(
+      'A21 a document that opens on Blueprint drafts white from the start, '
+      'and a load onto White turns it black (fix/post-07 F1b)', (tester) async {
+    final c = drawController(background: 0xFF1F3A5F).c;
+    final doc = c.document;
+    await pumpDraw(tester, c);
+    final slot = await draftLine(tester, c);
+    expect(argbOnCanvas(tester, slot), 0xFFFFFFFF, reason: 'at startup');
+
+    // Out of band, as a decode writes the registry before `notifyLoaded`.
+    doc.components.attach<PageComponent>(
+        doc.rootHandle,
+        doc.components
+            .get<PageComponent>(doc.rootHandle)!
+            .copyWith(background: 0xFFFFFFFF));
+    doc.commands.notifyLoaded();
+    await tester.pump();
+    await tester.pump(); // heard after the frame, as in A20
+    expect(argbOnCanvas(tester, slot), 0xFF000000, reason: 'after the load');
+  });
+
+  testWidgets(
+      'A22 a document without a page drafts black: no sheet is painted, so '
+      "the drafting lies on the shell's light surface (fix/post-07 F1b)",
+      (tester) async {
+    final c = pagelessController();
+    final doc = c.document;
+    expect(doc.components.get<PageComponent>(doc.rootHandle), isNull);
+    await pumpDraw(tester, c);
+    final slot = await draftLine(tester, c);
+    expect(argbOnCanvas(tester, slot), 0xFF000000);
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/canvas/canvas_layout_test.dart b/packages/jet_cad_2d_plan/test/canvas/canvas_layout_test.dart
new file mode 100644
index 00000000..7f80c7db
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/canvas/canvas_layout_test.dart
@@ -0,0 +1,90 @@
+// Ported from jet_cad_floor_plan/test/planner_shell_test.dart; assertions unchanged.
+//
+// The canvas's own cases of the shell's test: the first fit to the page at
+// the drawing area's size, the page chrome and the rulers under the
+// canvas, the fit latch across a resize, and the interaction tree. The
+// palette fixture stands in for the sample flat: its page is off the
+// origin and its extents (the two lines) are not the page, so the page fit
+// and the extents fit differ as the sample's did. The sample's size premise
+// (500 entities and more) went with the sample.
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart' show RenderCustomPaint;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+
+import '../support/canvas_fixture.dart';
+
+/// The palette fixture's canvas on White, in an app; its controller.
+Future<PlanController> pumpSample(WidgetTester tester) async {
+  final c = paletteController(paper: white).c;
+  await tester
+      .pumpWidget(MaterialApp(home: Scaffold(body: PlanCanvas(controller: c))));
+  return c;
+}
+
+void main() {
+  testWidgets('the camera is fitted to the page at the drawing area\'s size',
+      (tester) async {
+    // M-04k. The drawing area is the RulerFrame's child, not the view.
+    final c = await pumpSample(tester);
+    await tester.pump();
+    final size = tester.getSize(find.byType(DraftCanvas));
+    final page =
+        c.document.components.get<PageComponent>(c.document.rootHandle)!;
+    final expected = fitToPage(page, size);
+    expect(c.camera.value.scale, closeTo(expected.scale, 1e-9));
+    expect(c.camera.value.worldToScreenMatrix.e,
+        closeTo(expected.worldToScreenMatrix.e, 1e-6));
+    final extentsFit = ViewportTransform.fit(c.document.extents, size);
+    expect(c.camera.value.scale, isNot(closeTo(extentsFit.scale, 1e-9)));
+  });
+
+  testWidgets(
+      'the page chrome and the rulers are in the tree, under the canvas',
+      (tester) async {
+    await pumpSample(tester);
+    await tester.pump();
+    expect(find.byType(RulerFrame), findsOneWidget);
+    final chrome = find.byWidgetPredicate(
+        (w) => w is CustomPaint && w.painter is PageChromePainter);
+    expect(chrome, findsOneWidget);
+    expect(tester.getSize(chrome), tester.getSize(find.byType(DraftCanvas)));
+  });
+
+  // Ruling 01-2's latch: the fit happens once. A resize after the user has
+  // moved the camera must not re-fit and throw their view away.
+  testWidgets('a resize after the first layout does not re-fit the camera',
+      (tester) async {
+    await tester.binding.setSurfaceSize(const Size(800, 600));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final c = await pumpSample(tester);
+    await tester.pump();
+    c.camera.zoomAt(const Offset(300, 200), 1.7);
+    c.camera.panBy(const Offset(40, -25));
+    final moved = c.camera.value.worldToScreenMatrix;
+
+    await tester.binding.setSurfaceSize(const Size(1100, 750));
+    await tester.pump();
+    await tester.pump();
+
+    expect(c.camera.value.worldToScreenMatrix, same(moved));
+    expect(tester.getSize(find.byType(DraftCanvas)).width, greaterThan(500),
+        reason: 'the canvas really did get a new size');
+  });
+
+  testWidgets('the interaction tree is in place', (tester) async {
+    await pumpSample(tester);
+    await tester.pump();
+
+    expect(find.byType(InteractionLayer), findsOneWidget);
+    final overlayFinder = find.byWidgetPredicate(
+        (w) => w is CustomPaint && w.painter is SelectionOverlayPainter);
+    expect(overlayFinder, findsOneWidget);
+
+    final overlaySize =
+        tester.renderObject<RenderCustomPaint>(overlayFinder).size;
+    expect(overlaySize, tester.getSize(find.byType(DraftCanvas)));
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/canvas/canvas_palette_test.dart b/packages/jet_cad_2d_plan/test/canvas/canvas_palette_test.dart
