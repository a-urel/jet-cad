+      h.options.value = const Options(rulers: false);
+      await tester.pump();
+      await tester.pump();
+      expect(canvasOrigin(tester),
+          ruled - const Offset(kRulerThickness, kRulerThickness));
+      h.options.value = const Options();
+      await tester.pump();
+      await tester.pump();
+      expect(find.byType(RulerFrame), findsOneWidget);
+      expect(canvasOrigin(tester), ruled);
+    });
+
+    testWidgets(
+        'R-2 a polyline part-way: rulers off and on throw nothing; the '
+        'polyline is cancelled cleanly and Undo enabled after the frame; the '
+        'tool starts afresh', (tester) async {
+      final h = await mountOptions(tester);
+      final c = h.c;
+      final d = c.document;
+      await drawLine(tester, c, freeSpot(c, 0, 0), freeSpot(c, 800.5, -300.25));
+      await press(tester, LogicalKeyboardKey.keyP);
+      final first = freeSpot(c, 200.5, -900.75);
+      await click(tester, screenOf(tester, c, first));
+      expect(undoEnabled(tester), isFalse, reason: 'premise: mid-shape');
+      final depth = d.commands.undoDepth;
+      for (final rulers in [false, true]) {
+        h.options.value = Options(rulers: rulers);
+        await tester.pump();
+        expect(tester.takeException(), isNull, reason: 'rulers $rulers');
+        await tester.pump();
+        expect(tester.takeException(), isNull, reason: 'rulers $rulers');
+        expect(undoEnabled(tester), isTrue, reason: 'rulers $rulers');
+        expect(c.activeTool.value, PlanToolIds.polyline);
+        expect(statusText(tester), 'Polyline');
+        // A fresh start: one click is a first point, nothing added.
+        await click(tester, screenOf(tester, c, first));
+        expect(d.commands.undoDepth, depth, reason: 'rulers $rulers');
+        expect(undoEnabled(tester), isFalse);
+      }
+      await click(tester, screenOf(tester, c, freeSpot(c, 1000.25, -900.75)));
+      await press(tester, LogicalKeyboardKey.enter);
+      expect(d.commands.undoDepth, depth + 1);
+    });
+  });
+
+  testWidgets(
+      'K3 (final review F-6, mutant S26) after a load, selectTool and '
+      'deleteSelection reach the new plan: the old one\'s withdrawal leaves '
+      'its registrations', (tester) async {
+    final h = await mountOptions(tester);
+    final c = h.c;
+    c.load(c.save());
+    await tester.pump();
+    await tester.pump();
+    expect(c.selectTool(PlanToolIds.line), isTrue);
+    await tester.pump();
+    expect(c.activeTool.value, PlanToolIds.line);
+    expect(c.selectTool(PlanToolIds.select), isTrue);
+    await tester.pump();
+    final first = marksOf(c).first;
+    c.selection.replace([SelectionKey.root(first)]);
+    await tester.pump();
+    final n = marksOf(c).length;
+    expect(c.deleteSelection(), isTrue);
+    await tester.pump();
+    expect(marksOf(c).length, n - 1);
+    expect(marksOf(c), isNot(contains(first)));
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/editor/editor_separator_test.dart b/packages/jet_cad_2d_plan/test/editor/editor_separator_test.dart
new file mode 100644
index 00000000..5a0da6f1
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/editor/editor_separator_test.dart
@@ -0,0 +1,163 @@
+// Spec Q0 N1, N2, R-4 through a view (2a spec P2: newPlan's "default: the
+// locale's, as today"): what Task 8 could not port without one (controller
+// ruling R-m). Ported from jet_cad_floor_plan/test/host/
+// new_plan_separator_test.dart: NS2 whole (a view handed another controller
+// reports its language to it), and NS1 and NS6 re-run as the source runs
+// them, through a PlanEditor, with the Page panel's `panelShows` assertions
+// Task 8 left out. NS3, NS4, NS8 and NS9 assert nothing of the panel (NS3's
+// room label is sub-project 3's); the service layout's lines are 2b's.
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_plan/src/controller/plan_controller.dart';
+import 'package:jet_cad_2d_plan/src/editor/plan_editor.dart';
+import 'package:jet_cad_2d_plan/src/l10n/localizations.dart';
+
+/// [c] shown in a [PlanEditor] under [locale]; the same tree shape for
+/// every call, so a second call with another controller is a swap.
+Future<void> show(WidgetTester tester, PlanController c, Locale locale) async {
+  await tester.pumpWidget(MaterialApp(
+      locale: locale,
+      supportedLocales: planSupportedLocales,
+      localizationsDelegates: planLocalizationsDelegates,
+      home: Scaffold(body: PlanEditor(controller: c))));
+  await tester.pump();
+}
+
+/// [doc]'s page separator.
+DecimalSeparator separatorOf(DraftDocument doc) =>
+    doc.components.get<PageComponent>(doc.rootHandle)!.decimalSeparator;
+
+/// What the Page panel's control shows selected.
+Set<DecimalSeparator> panelShows(WidgetTester tester) => tester
+    .widget<SegmentedButton<DecimalSeparator>>(
+        find.byKey(const Key('page-decimal-separator')))
+    .selected;
+
+/// A design edit before any view: a layer added, one command.
+void addLayer(PlanController c) {
+  final doc = c.document;
+  final zero = doc.tables.layers[ReservedHandles.layerZero]!;
+  doc.commands.execute(AddLayerCommand(LayerRecord(
+      handle: doc.handleSeed.next(),
+      name: 'Bar',
+      color: const IndexedColor(5),
+      linetype: zero.linetype,
+      lineweight: zero.lineweight,
+      transparency: zero.transparency,
+      visible: true,
+      locked: false)));
+}
+
+void main() {
+  testWidgets(
+      'NS6 the constructor\'s empty plan shown first in English is settled '
+      'at point: a later Turkish view leaves it point, with no undo step '
+      'and clean (Task 4 review)', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(1440, 900));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final c = PlanController(kits: const []);
+    addTearDown(c.dispose);
+    final made = c.document;
+    await show(tester, c, const Locale('en'));
+    expect(separatorOf(made), DecimalSeparator.point);
+    await show(tester, c, const Locale('tr'));
+    await tester.pump();
+    expect(identical(c.document, made), isTrue);
+    expect(separatorOf(made), DecimalSeparator.point,
+        reason: 'settled by the first language, already point (N2)');
+    expect(panelShows(tester), {DecimalSeparator.point});
+    expect(made.commands.undoDepth, 0);
+    expect(c.canUndo.value, isFalse);
+    expect(c.dirty.value, isFalse);
+  });
+
+  testWidgets(
+      'NS1 the constructor\'s empty plan, shown in Turkish, prints comma as '
+      'if made so: no undo step, clean; a switch to English keeps it; '
+      'newPlan() in English is point and stays point when the view turns '
+      'Turkish; newPlan() in Turkish is comma', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(1440, 900));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final c = PlanController(kits: const []);
+    addTearDown(c.dispose);
+    final made = c.document;
+    expect(separatorOf(made), DecimalSeparator.point,
+        reason: 'premise: unsettled, the engine\'s default');
+
+    await show(tester, c, const Locale('tr'));
+    expect(identical(c.document, made), isTrue,
+        reason: 'the plan is settled in place, not replaced');
+    expect(separatorOf(made), DecimalSeparator.comma);
+    expect(panelShows(tester), {DecimalSeparator.comma},
+        reason: 'the shell is built over the settled page');
+    expect(made.commands.undoDepth, 0);
+    expect(made.commands.canRedo, isFalse);
+    expect(c.canUndo.value, isFalse);
+    expect(c.dirty.value, isFalse);
+    // The change is heard a microtask later: still no step and clean.
+    await tester.pump();
+    expect(c.canUndo.value, isFalse);
+    expect(c.dirty.value, isFalse);
+    // The settled state is the save point: an edit is dirty, its Undo is
+    // clean again.
+    addLayer(c);
+    await tester.pump();
+    expect(c.dirty.value, isTrue, reason: 'premise: an edit');
+    c.undo();
+    await tester.pump();
+    expect(c.dirty.value, isFalse, reason: 'the save point moved with it');
+
+    // English now: the settled plan is not converted (N2).
+    await show(tester, c, const Locale('en'));
+    expect(separatorOf(c.document), DecimalSeparator.comma);
+
+    // newPlan() takes the last language reported: English, point, settled
+    // at once.
+    c.newPlan();
+    await tester.pump();
+    final english = c.document;
+    expect(identical(english, made), isFalse, reason: 'premise: a new plan');
+    expect(separatorOf(english), DecimalSeparator.point);
+    await show(tester, c, const Locale('tr'));
+    expect(identical(c.document, english), isTrue);
+    expect(separatorOf(english), DecimalSeparator.point,
+        reason: 'settled when made: a later language does not change it');
+    expect(panelShows(tester), {DecimalSeparator.point});
+
+    // And in Turkish, comma, with no undo step and clean.
+    c.newPlan();
+    await tester.pump();
+    await tester.pump();
+    expect(separatorOf(c.document), DecimalSeparator.comma);
+    expect(panelShows(tester), {DecimalSeparator.comma});
+    expect(c.document.commands.undoDepth, 0);
+    expect(c.canUndo.value, isFalse);
+    expect(c.dirty.value, isFalse);
+  });
+
+  testWidgets(
+      'NS2 a view handed another controller reports its language to it: the '
+      'second empty plan, shown by the same view in German, is comma',
+      (tester) async {
+    await tester.binding.setSurfaceSize(const Size(1440, 900));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final a = PlanController(kits: const []);
+    final b = PlanController(kits: const []);
+    addTearDown(a.dispose);
+    addTearDown(b.dispose);
+    await show(tester, a, const Locale('de'));
+    expect(separatorOf(a.document), DecimalSeparator.comma);
+    final view = tester.state(find.byType(PlanEditor));
+    expect(separatorOf(b.document), DecimalSeparator.point,
+        reason: 'premise: b is unsettled');
+
+    await show(tester, b, const Locale('de'));
+    expect(identical(tester.state(find.byType(PlanEditor)), view), isTrue,
+        reason: 'premise: the same view, its controller swapped');
+    expect(separatorOf(b.document), DecimalSeparator.comma);
+    expect(b.document.commands.undoDepth, 0);
+    expect(b.dirty.value, isFalse);
+    expect(panelShows(tester), {DecimalSeparator.comma});
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/editor/editor_theme_test.dart b/packages/jet_cad_2d_plan/test/editor/editor_theme_test.dart
new file mode 100644
index 00000000..d41866e0
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/editor/editor_theme_test.dart
@@ -0,0 +1,282 @@
+// Spec P5 "Theme" through PlanEditor (host embedding API spec T-1, T-2,
+// S-5, S-11, T-3): the editor resolves the ambient PlanTheme with its own
+// `theme:` over it, field by field, validated. Ported, assertions
+// unchanged, from jet_cad_floor_plan/test/host/floor_plan_theme_test.dart:
+// "validation (S-5), through the view" (the width cases; the opacity, bar,
+// margin, radius, padding and font cases are 2b's fields), "resolution
+// (T-2, S-11)" (the design mode: P-6, M-H30, the ambient switch; "a bare
+// PlannerShell reads the ambient extension" and R-4 are a PlanCanvas alone,
+// which reads PlanTheme.of with no scope above), "T1-c: the scope notifies
+// by value" (through PlanEditor(theme:), a dependent in the bar's leading
+// slot in place of a table overlay) and "FloorPlanTheme through the barrel
+// alone". S-12 is ED-7 (plan_editor_test.dart).
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart' as barrel;
+import 'package:jet_cad_2d_plan/src/canvas/plan_canvas.dart';
+import 'package:jet_cad_2d_plan/src/controller/plan_controller.dart';
+import 'package:jet_cad_2d_plan/src/editor/plan_editor.dart';
+import 'package:jet_cad_2d_plan/src/editor/plan_editor_bar.dart';
+import 'package:jet_cad_2d_plan/src/panels/plan_layer_panel.dart';
+import 'package:jet_cad_2d_plan/src/theme/plan_theme.dart';
+
+import '../support/editor_host.dart';
+import '../support/mark_kit.dart';
+
+const Color seed = Color(0xFF2266CC);
+final ThemeData lightTheme = ThemeData(colorSchemeSeed: seed);
+final ThemeData darkTheme =
+    ThemeData(colorSchemeSeed: seed, brightness: Brightness.dark);
+
+/// A full theme, every field off today's value.
+const PlanTheme fullA = PlanTheme(
+  selectionOnLight: Color(0xFFD81B60),
+  selectionOnDark: Color(0xFFFFD54F),
+  selectionWidth: 4,
+  canvasBackground: Color(0xFF263238),
+);
+
+/// A second full theme, every field different from [fullA]'s and today's.
+const PlanTheme fullB = PlanTheme(
+  selectionOnLight: Color(0xFF5E35B1),
+  selectionOnDark: Color(0xFFC0CA33),
+  selectionWidth: 2.5,
+  canvasBackground: Color(0xFFEFEBE9),
+);
+
+ThemeData lightWith(PlanTheme t) => lightTheme.copyWith(extensions: [t]);
+ThemeData darkWith(PlanTheme t) => darkTheme.copyWith(extensions: [t]);
+
+/// The theme resolved inside the editor (its Layers section reads it).
+PlanTheme? resolvedIn(WidgetTester tester) =>
+    PlanThemeScope.of(tester.element(find.byType(PlanLayerPanel)));
+
+/// Pumps [view] at 1440 x 900 under [theme] (zero theme animation) and
+/// lets the first frames land.
+Future<void> pumpUnder(WidgetTester tester, Widget view,
+    {ThemeData? theme,
+    ThemeData? dark,
+    ThemeMode mode = ThemeMode.light}) async {
+  await tester.binding.setSurfaceSize(const Size(1440, 900));
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  await tester.pumpWidget(MaterialApp(
+      theme: theme ?? lightTheme,
+      darkTheme: dark ?? darkTheme,
+      themeMode: mode,
+      themeAnimationDuration: Duration.zero,
+      home: Scaffold(body: view)));
+  await tester.pump();
+}
+
+/// A dependent of the resolved theme: logs each dependency change.
+class ThemeReader extends StatefulWidget {
+  const ThemeReader({super.key, required this.log});
+  final List<PlanTheme?> log;
+  @override
+  State<ThemeReader> createState() => _ThemeReaderState();
+}
+
+class _ThemeReaderState extends State<ThemeReader> {
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    widget.log.add(PlanThemeScope.of(context));
+  }
+
+  @override
+  Widget build(BuildContext context) => const SizedBox(width: 10, height: 10);
+}
+
+PlanController plan() => editorController(json: editorPlanJson());
+
+void main() {
+  group('validation (S-5), through the view', () {
+    testWidgets(
+        'the width: accepted and refused, naming the field; an ambient '
+        'theme out of range is refused the same way', (tester) async {
+      final c = plan();
+      Future<Object?> pumpWith({PlanTheme? view, PlanTheme? ambient}) async {
+        await pumpUnder(tester, PlanEditor(controller: c, theme: view),
+            theme: ambient == null ? lightTheme : lightWith(ambient));
+        return tester.takeException();
+      }
+
+      final accepted = <(String, PlanTheme)>[
+        ('selectionWidth', const PlanTheme(selectionWidth: 0.5)),
+        ('all', fullA),
+      ];
+      final refused = <(String, PlanTheme)>[
+        for (final v in [0.0, -1.0, double.infinity, double.nan])
+          ('selectionWidth', PlanTheme(selectionWidth: v)),
+      ];
+      for (final (name, theme) in accepted) {
+        expect(await pumpWith(view: theme), isNull, reason: '$name: $theme');
+        expect(find.byType(PlanEditor), findsOneWidget,
+            reason: '$name: $theme');
+        expect(resolvedIn(tester), theme);
+        expect(await pumpWith(ambient: theme), isNull,
+            reason: 'ambient $name: $theme');
+      }
+      for (final (name, theme) in refused) {
+        for (final ambient in [false, true]) {
+          final e = ambient
+              ? await pumpWith(ambient: theme)
+              : await pumpWith(view: theme);
+          expect(e, isA<ArgumentError>().having((e) => e.name, 'name', name),
+              reason: '${ambient ? 'ambient ' : ''}$name: $theme');
+        }
+      }
+      // The constructor itself never throws: each refused theme was built.
+      expect(refused, hasLength(4));
+    });
+  });
+
+  group('resolution (T-2, S-11)', () {
+    testWidgets(
+        'P-6: no theme anywhere resolves to null; ambient only is the '
+        'ambient itself; view only the view itself', (tester) async {
+      final c = plan();
+      await pumpUnder(tester, PlanEditor(controller: c));
+      expect(resolvedIn(tester), isNull);
+
+      await pumpUnder(tester, PlanEditor(controller: c),
+          theme: lightWith(fullA));
+      expect(identical(resolvedIn(tester), fullA), isTrue);
+
+      await pumpUnder(tester, PlanEditor(controller: c, theme: fullB));
+      expect(identical(resolvedIn(tester), fullB), isTrue);
+    });
+
+    testWidgets(
+        'M-H30: one field in the ambient theme and another in the view\'s '
+        'resolve to both; one field in both takes the view\'s', (tester) async {
+      final c = plan();
+      await pumpUnder(
+          tester,
+          PlanEditor(
+              controller: c,
+              theme: const PlanTheme(selectionOnLight: Color(0xFFD81B60))),
+          theme:
+              lightWith(const PlanTheme(canvasBackground: Color(0xFF00897B))));
+      expect(
+          resolvedIn(tester),
+          const PlanTheme(
+              canvasBackground: Color(0xFF00897B),
+              selectionOnLight: Color(0xFFD81B60)));
+
+      await pumpUnder(tester,
+          PlanEditor(controller: c, theme: const PlanTheme(selectionWidth: 5)),
+          theme: lightWith(const PlanTheme(
+              selectionWidth: 3, canvasBackground: Color(0xFF00897B))));
+      expect(
+          resolvedIn(tester),
+          const PlanTheme(
+              selectionWidth: 5, canvasBackground: Color(0xFF00897B)));
+    });
+
+    testWidgets(
+        'an ambient switch (light with A to dark with B, zero animation) '
+        'reaches the editor after one pump', (tester) async {
+      final c = plan();
+      final view = PlanEditor(controller: c);
+      await pumpUnder(tester, view,
+          theme: lightWith(fullA), dark: darkWith(fullB));
+      expect(resolvedIn(tester), fullA);
+      await pumpUnder(tester, view,
+          theme: lightWith(fullA), dark: darkWith(fullB), mode: ThemeMode.dark);
+      expect(resolvedIn(tester), fullB);
+    });
+
+    testWidgets('a bare PlanCanvas reads the ambient extension',
+        (tester) async {
+      final c = plan();
+      await tester.pumpWidget(MaterialApp(
+          theme: lightWith(fullA),
+          themeAnimationDuration: Duration.zero,
+          home: PlanCanvas(controller: c)));
+      await tester.pump();
+      expect(
+          identical(PlanThemeScope.of(tester.element(find.byType(PlanCanvas))),
+              fullA),
+          isTrue);
+      await tester.pumpWidget(MaterialApp(
+          themeAnimationDuration: Duration.zero,
+          home: PlanCanvas(controller: c)));
+      await tester.pump();
+      expect(
+          PlanThemeScope.of(tester.element(find.byType(PlanCanvas))), isNull);
+    });
+
+    testWidgets(
+        'R-4: a bare PlanCanvas refuses an ambient theme out of range, '
+        'naming the field', (tester) async {
+      // A controller per app: each bare canvas is a host's own (the source's
+      // bare shells each had a document of their own).
+      for (final (bad, name) in [
+        (const PlanTheme(selectionWidth: -3), 'selectionWidth'),
+      ]) {
+        await tester.pumpWidget(MaterialApp(
+            key: UniqueKey(),
+            theme: lightWith(fullA.merge(bad)),
+            themeAnimationDuration: Duration.zero,
+            home: PlanCanvas(controller: plan())));
+        expect(tester.takeException(),
+            isA<ArgumentError>().having((e) => e.name, 'name', name),
+            reason: name);
+      }
+      // In range: accepted.
+      await tester.pumpWidget(MaterialApp(
+          key: UniqueKey(),
+          theme: lightWith(fullA),
+          themeAnimationDuration: Duration.zero,
+          home: PlanCanvas(controller: plan())));
+      await tester.pump();
+      expect(tester.takeException(), isNull);
+      expect(PlanThemeScope.of(tester.element(find.byType(PlanCanvas))), fullA);
+    });
+  });
+
+  group('T1-c: the scope notifies by value', () {
+    testWidgets(
+        'a host rebuild with an equal, non-identical view theme notifies no '
+        'dependent; a different one does', (tester) async {
+      final c = plan();
+      final log = <PlanTheme?>[];
+      final reader = ThemeReader(log: log);
+      PlanEditor viewWith(PlanTheme theme) => PlanEditor(
+          controller: c, theme: theme, bar: PlanEditorBar(leading: [reader]));
+      await pumpUnder(tester, viewWith(fullA.copyWith()));
+      expect(find.byType(ThemeReader), findsOneWidget);
+      expect(log, [fullA]);
+
+      await pumpUnder(tester, viewWith(fullA.copyWith()));
+      expect(log, [fullA], reason: 'an equal theme notifies nobody');
+
+      await pumpUnder(tester, viewWith(fullB.copyWith()));
+      expect(log, [fullA, fullB]);
+    });
+  });
+
+  testWidgets(
+      'PlanTheme through the barrel alone: in ThemeData(extensions:) and '
+      'PlanEditor(theme:)', (tester) async {
+    final c = barrel.PlanController(kits: [markKit()], json: editorPlanJson());
+    addTearDown(c.dispose);
+    const barrel.PlanTheme ambient = barrel.PlanTheme(
+        canvasBackground: Color(0xFF263238),
+        selectionOnLight: Color(0xFF5E35B1));
+    await tester.pumpWidget(MaterialApp(
+        theme: ThemeData(extensions: const [ambient]),
+        home: barrel.PlanEditor(
+            controller: c,
+            theme: const barrel.PlanTheme(
+                selectionOnLight: Color(0xFFD81B60), selectionWidth: 3))));
+    await tester.pump();
+    expect(
+        resolvedIn(tester),
+        const barrel.PlanTheme(
+            canvasBackground: Color(0xFF263238),
+            selectionOnLight: Color(0xFFD81B60),
+            selectionWidth: 3));
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/editor/editor_view_test.dart b/packages/jet_cad_2d_plan/test/editor/editor_view_test.dart
new file mode 100644
index 00000000..07f0cb0b
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/editor/editor_view_test.dart
@@ -0,0 +1,152 @@
+// 2a spec P2 (PlanEditor is today's design-mode view). Ported, assertions
+// unchanged, from jet_cad_floor_plan/test/host/view_test.dart (V1's and
+// V2's design halves), test/planner_shell_test.dart ("a bare shell opens on
+// the empty document and its default page", the zoom text, the three
+// chrome slots, the status text) and test/planner_draw_test.dart (A16,
+// A27: the bar's read-outs, which Task 16 sent here), each over a
+// PlanEditor.
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart' show LogicalKeyboardKey;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show PolylineTool, SelectionKey, kLogicalPixelsPerMm;
