+    }
+    _status?.dispose();
+    _commandSources?.dispose();
+    _idleFlag = _exportFlag = _printFlag = _undoFlag = _redoFlag = null;
+    _status = _commandSources = null;
+  }
+
+  /// No tool is part-way through a shape (planner_shell.dart:714-718): a
