+          reason: 'premise: the marks and the line');
+      for (final h in roots) {
+        c.selection.replace([SelectionKey.root(h)]);
+        await tester.pump();
+        expect(tester.takeException(), isNull, reason: '$code, $h');
+      }
+    });
