+            shortcuts: kOpenChords,
+            enabled: _idleFlag!,
+            run: _file((w) => w.onOpen)),
+      if (w.onSave != null)
+        _BarCommand(
+            id: 'save',
+            label: s.save,
+            icon: Icons.save_outlined,
+            shortcuts: kSaveChords,
+            enabled: _idleFlag!,
+            run: _file((w) => w.onSave)),
+      if (w.onSaveAs != null)
