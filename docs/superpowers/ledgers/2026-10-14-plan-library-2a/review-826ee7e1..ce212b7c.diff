+  }
+
+  List<_BarCommand> _editCommands(PlanStrings s) =>
+      widget.controller.permissions.undo
+          ? [
+              _BarCommand(
+                  id: 'undo',
+                  label: s.undo,
+                  icon: Icons.undo,
+                  shortcuts: kUndoChords,
+                  enabled: _undoFlag!,
+                  run: () async => widget.controller.undo()),
+              _BarCommand(
+                  id: 'redo',
+                  label: s.redo,
+                  icon: Icons.redo,
+                  shortcuts: kRedoChords,
+                  enabled: _redoFlag!,
+                  run: () async => widget.controller.redo()),
