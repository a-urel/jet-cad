+            id: 'save-as',
+            label: s.saveAs,
+            icon: Icons.save_as_outlined,
+            shortcuts: kSaveAsChords,
+            enabled: _idleFlag!,
+            run: _file((w) => w.onSaveAs)),
+      if (_flows.canExport && permissions.export)
+        _BarCommand(
+            id: 'export',
+            label: s.exportEllipsis,
+            icon: Icons.ios_share_outlined,
+            shortcuts: kExportChords,
+            enabled: _exportFlag!,
