+      expect(c.document.commands.permissions, same(DraftPermissions.readOnly));
+    });
+
+    test(
+        'PM-20 deleteSelection: false with nothing selected and under '
+        'delete: false; true under full, one undo step (T5-c)', () {
+      final c = make();
