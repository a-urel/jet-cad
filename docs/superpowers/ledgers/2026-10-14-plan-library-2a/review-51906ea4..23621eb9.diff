+
+  /// A copy with the given fields replaced; a null argument keeps the
+  /// field (so `copyWith(tools: null)` keeps the set: start from [full] for
+  /// every tool). A given [tools] is copied, unmodifiable.
+  PlanPermissions copyWith({
+    Set<String>? tools,
+    bool? move,
+    bool? rotate,
+    bool? mirror,
+    bool? reshape,
+    bool? delete,
+    bool? changeLayer,
+    bool? recolor,
