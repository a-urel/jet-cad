+    await tester.pump();
+    expect(c.page.value, isNull, reason: 'premise: no page');
+    await sendActivator(tester, kHostKeys['ctrl+e']!);
+    await sendActivator(tester, kHostKeys['ctrl+p']!);
+    expect([d.exports, d.prints], [1, 1]);
