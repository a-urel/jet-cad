+          SymbolBox(left: cx - r, right: cx + r, front: cy - r, back: cy + r));
+    });
+  });
+
+  group('library entries', () {
+    test('the off-centre fixtures: back and left from an arc', () {
+      final lib = SymbolLibrary.decode(bytesOf(buildValidLibrary()));
