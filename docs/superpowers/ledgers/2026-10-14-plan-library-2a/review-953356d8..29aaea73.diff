+      // the box is in the definition's coordinates, whatever the instance.
+      for (var i = 0; i < keys.length; i++) {
+        doc.commands.execute(placeSymbol(doc, entryIn(lib, keys[i]),
+            at: Vector2(1e5 + 250.0 * i, -7e4 - 125.0 * i),
