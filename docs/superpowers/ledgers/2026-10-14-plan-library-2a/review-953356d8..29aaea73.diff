+        expect([
+          m[0],
+          m[1],
+          m[4],
+          m[5],
+          m[12],
+          m[13]
+        ], [
+          p.a,
+          p.b,
+          p.c,
+          p.d,
+          p.e - origin.x,
+          p.f - origin.y
+        ], reason: 'mirrored=$mirrored');
+        // Independently: mirror the local x, turn by 30°, base point to far.
+        final s = mirrored ? -1.0 : 1.0;
+        final (cos, sin) = r30;
+        for (final (x, y) in leafPoints(e)) {
+          final u = (x - b.x) * s, v = y - b.y;
+          expectPoint(
+              apply(m, x, y),
+              (
+                far.x + cos * u - sin * v - origin.x,
+                far.y + sin * u + cos * v - origin.y
+              ),
+              1e-9,
+              'mirrored=$mirrored ($x, $y)');
+        }
+      }
+    });
+
+    test(
+        'equal placements recompute once; a change of one ulp in any one of '
+        'the six doubles recomputes once, and the storage follows', () {
+      final b = entry('ghost.bath.toilet').definition.basePoint;
+      for (final mirrored in [false, true]) {
+        final p = placementTransform(
+            at: far, basePoint: b, rotation: r30, mirrored: mirrored);
+        final g = GhostMatrix()..update(placement: p);
+        expect(g.computations, 1);
+        // Equal doubles in another object: nothing recomputed, nothing kept.
+        for (var k = 0; k < 3; k++) {
+          g.update(placement: Transform2.fromJson(p.toJson()));
+        }
+        expect(g.computations, 1, reason: 'mirrored=$mirrored equal');
+        expect(identical(g.placement, p), isTrue);
+        var expected = 1;
+        for (var i = 0; i < 6; i++) {
+          final v = p.toJson();
+          v[i] = nextUp(v[i]);
+          final q = Transform2.fromJson(v);
+          g.update(placement: q);
+          expect(g.computations, ++expected,
+              reason: 'mirrored=$mirrored component $i changed');
+          expect(identical(g.placement, q), isTrue);
+          final m = g.forOrigin(origin);
+          expect([
+            m[0],
+            m[1],
+            m[4],
+            m[5],
+            m[12],
+            m[13]
+          ], [
+            q.a,
+            q.b,
+            q.c,
+            q.d,
+            q.e - origin.x,
+            q.f - origin.y
+          ], reason: 'mirrored=$mirrored component $i storage');
+          g.update(placement: p);
+          expect(g.computations, ++expected,
+              reason: 'mirrored=$mirrored component $i back');
+        }
+      }
+    });
+
+    test('-0.0 and 0.0 compare equal: no recompute (stated, not a mutant)', () {
+      final g = GhostMatrix()
+        ..update(placement: const Transform2(0.0, 1.0, -1.0, 0.0, 5, 7));
+      g.update(placement: const Transform2(-0.0, 1.0, -1.0, -0.0, 5, 7));
+      expect(g.computations, 1);
+    });
+  });
+
+  group('the path', () {
+    test('a closed polyline\'s contour is closed, a line\'s is not', () {
+      final e = entry('ghost.dining.table');
+      final metrics = ghostPathFor(e).computeMetrics().toList();
+      expect(metrics.length, e.leaves.length);
+      var closed = 0, open = 0;
+      for (var i = 0; i < e.leaves.length; i++) {
+        final leaf = e.leaves[i];
+        final isClosed = leaf.record.kind == EntityKind.polyline &&
+            isClosedPolyline(leaf.payload);
+        expect(metrics[i].isClosed, isClosed,
+            reason: '${leaf.record.kind.name} leaf $i');
+        if (isClosed) {
+          closed++;
+        } else if (leaf.record.kind == EntityKind.line) {
+          open++;
+        }
+      }
+      expect(closed, 8, reason: 'closed polylines');
+      expect(open, 6, reason: 'lines');
+    });
+
+    test('is cached: the same object on a second call, one per entry', () {
+      final chair = entry('ghost.office.chair');
+      final toilet = entry('ghost.bath.toilet');
+      final p = ghostPathFor(chair);
+      expect(identical(ghostPathFor(chair), p), isTrue);
+      expect(identical(ghostPathFor(toilet), p), isFalse);
+      expect(identical(ghostPathFor(toilet), ghostPathFor(toilet)), isTrue);
+    });
+
+    test(
+        'has one contour per leaf, and its bounds are the leaves\' local '
+        'bounds (every entry with no arc)', () {
+      var checked = 0;
+      for (final e in library.entries) {
+        final path = ghostPathFor(e);
+        expect(path.computeMetrics().length, e.leaves.length,
+            reason: '${e.symbol.key} contours');
+        if (e.leaves.any((l) => l.record.kind == EntityKind.arc)) continue;
+        var l = double.infinity, t = double.infinity;
+        var r = double.negativeInfinity, btm = double.negativeInfinity;
+        for (final leaf in e.leaves) {
+          final c = leaf.payload.coords;
+          final rad = leaf.record.kind == EntityKind.circle
+              ? leaf.payload.scalars[0]
+              : 0;
+          for (var i = 0; i + 1 < c.length; i += 2) {
+            l = math.min(l, c[i] - rad);
+            r = math.max(r, c[i] + rad);
+            t = math.min(t, c[i + 1] - rad);
+            btm = math.max(btm, c[i + 1] + rad);
+          }
+        }
+        final bounds = path.getBounds();
+        // Path coordinates are float32.
+        expect(bounds.left, closeTo(l, 1e-3), reason: e.symbol.key);
+        expect(bounds.top, closeTo(t, 1e-3), reason: e.symbol.key);
+        expect(bounds.right, closeTo(r, 1e-3), reason: e.symbol.key);
+        expect(bounds.bottom, closeTo(btm, 1e-3), reason: e.symbol.key);
+        checked++;
+      }
+      expect(checked, greaterThan(20));
+    });
+
+    test(
+        'an arc runs from the payload start to start + sweep, through the '
+        'engine\'s mid point', () {
+      var arcs = 0;
+      for (final key in ['ghost.office.chair', 'ghost.bath.toilet']) {
+        final e = entry(key);
+        final metrics = ghostPathFor(e).computeMetrics().toList();
+        for (var i = 0; i < e.leaves.length; i++) {
+          final leaf = e.leaves[i];
+          if (leaf.record.kind != EntityKind.arc) continue;
+          final grips = leafGrips(leaf.record.kind, leaf.payload);
+          final metric = metrics[i];
+          (double, double) pos(double d) =>
+              offsetOf(metric.getTangentForOffset(d)!.position);
+          final start = (grips[1].x, grips[1].y);
+          final end = (grips[2].x, grips[2].y);
+          final mid = (grips[3].x, grips[3].y);
+          expectPoint(pos(0), start, 1e-2, '$key leaf $i start');
+          expectPoint(pos(metric.length), end, 1e-2, '$key leaf $i end');
+          // Arc length metrics are approximate on conics.
+          expectPoint(pos(metric.length / 2), mid, 0.5, '$key leaf $i mid');
+          final r = leaf.payload.scalars[0];
+          final sweep = leaf.payload.scalars[2];
+          expect(metric.length, closeTo(r * sweep.abs(), 0.5));
+          arcs++;
+        }
+      }
+      expect(arcs, 3);
+    });
+
+    test(
+        'drawn under the matrix, an arc lands where its placement puts it '
+        '(mirrored and turned, far from the origin)', () {
+      final e = entry('ghost.office.chair');
+      final b = e.definition.basePoint;
+      final i = e.leaves.indexWhere((l) => l.record.kind == EntityKind.arc);
+      final leaf = e.leaves[i];
+      final grips = leafGrips(leaf.record.kind, leaf.payload);
+      for (var q = 0; q < 4; q++) {
+        for (final mirrored in [false, true]) {
+          final g = GhostMatrix()
+            ..update(
+                placement: placementTransform(
+                    at: at, basePoint: b, quarterTurns: q, mirrored: mirrored));
+          final world = ghostPathFor(e).transform(g.forOrigin(origin));
+          final metric = world.computeMetrics().toList()[i];
+          final why = 'q=$q mirrored=$mirrored';
+          for (final (d, grip) in [
+            (0.0, grips[1]),
+            (metric.length, grips[2]),
+            (metric.length / 2, grips[3]),
+          ]) {
+            expectPoint(
+                offsetOf(metric.getTangentForOffset(d)!.position),
+                expectedWorld(e, q, mirrored, grip.x, grip.y, at, origin),
+                d == 0 || d == metric.length ? 1e-2 : 0.5,
+                '$why at $d');
+          }
+        }
+      }
+    });
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/tools/move_resolver_test.dart b/packages/jet_cad_2d_plan/test/tools/move_resolver_test.dart
new file mode 100644
index 00000000..189122c2
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/tools/move_resolver_test.dart
@@ -0,0 +1,183 @@
+// Spec P3 "Attachment" (Task 14): plan.select's move resolver asks the
+// registry for a root-level symbol instance whose jetcad.symbol attaches
+// somewhere; the query is the plain-moved transform, anchored on the moved
+// footprint's back-centre, the node excluded. A turned, mirrored placement
+// far from the origin; a camera at 0.1 px/mm.
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_kit/authoring.dart' show Catalog, encodeLibrary;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_plan/src/attach/attachment_registry.dart';
+import 'package:jet_cad_2d_plan/src/symbols/symbol_box.dart';
+import 'package:jet_cad_2d_plan/src/symbols/symbol_placer.dart';
+import 'package:jet_cad_2d_plan/src/tools/move_resolver.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/attach_fixtures.dart';
+import '../support/symbol_fixtures.dart';
+
+final class _ServicesStub implements PlanServices {
+  @override
+  dynamic noSuchMethod(Invocation invocation) =>
+      throw StateError('a provider factory read the services');
+}
+
+final SymbolLibrary lib =
+    SymbolLibrary.decode(encodeLibrary(Catalog(kit: 'demo', symbols: [
+  box('demo.shelf.wall', 'Wall shelf', 'Storage', ['shelf'],
+      attachTo: ['test-edge'], base: (950, 410)),
+  box('demo.table.free', 'Table', 'Dining', ['table'], base: (950, 410)),
+])));
+
+SymbolEntry entry(String key) =>
+    lib.entries.singleWhere((e) => e.symbol.key == key);
+
+final class Scene {
+  Scene({String key = 'demo.shelf.wall', bool objectSnap = true}) {
+    doc = DraftDocument.empty();
+    registerKitComponents(doc.components);
+    doc.header.units = DrawingUnits.millimeters;
+    doc.commands.execute(placeSymbol(doc, entry(key),
+        at: Vector2(100000.25, -70000.75), quarterTurns: 1, mirrored: true));
+    instance = doc.tree.nodes.whereType<InstanceNode>().single.handle;
+    index = SpatialIndex(doc);
+    selection = SelectionController(doc);
+    camera = CameraController(ViewportTransform(
+        worldToScreenMatrix: Transform2(0.1, 0, 0, -0.1, -9600, -6600)));
+    snap = SnapSettings(objectSnap: objectSnap);
+    ctx = ToolContext(
+        document: doc,
+        index: index,
+        camera: camera,
+        selection: selection,
+        snap: snap);
+    registry = PlanAttachmentRegistry(report: reported.add);
+    edge = RecordingProvider('test-edge', (q) => answer?.call(q));
+    registry.add('demo', (_) => edge, _ServicesStub());
+    resolver = PlanMoveResolver(
+        attachments: () {
+          asked++;
+          return registry;
+        },
+        canRotate: () => rotate);
+    addTearDown(() {
+      registry.dispose();
+      snap.dispose();
+      selection.dispose();
+      index.dispose();
+      camera.dispose();
+    });
+  }
+
+  late final DraftDocument doc;
+  late final Handle instance;
+  late final SpatialIndex index;
+  late final SelectionController selection;
+  late final CameraController camera;
+  late final SnapSettings snap;
+  late final ToolContext ctx;
+  late final PlanAttachmentRegistry registry;
+  late final RecordingProvider edge;
+  late final PlanMoveResolver resolver;
+  final List<KitDiagnostic> reported = [];
+  Attachment? Function(AttachmentQuery q)? answer;
+  bool rotate = true;
+
+  /// How many times the resolver read the registry to ask it.
+  int asked = 0;
+
+  Transform2 get transform => (doc.tree[instance]! as InstanceNode).transform;
+}
+
+List<double> partsOf(Transform2 t) => [t.a, t.b, t.c, t.d, t.e, t.f];
+
+final Transform2 delta = Transform2.translation(310.5, -125.25);
+
+void main() {
+  test(
+      'MV-1 the query: the plain move, its back-centre, the node excluded, '
+      'its mirror, mayRotate; the answer is the move', () {
+    final s = Scene();
+    final placed = attachment(Transform2.translation(99000.5, -69000.25),
+        Vector2(99010.25, -69020.5), 'face');
+    s.answer = (_) => placed;
+    final r = s.resolver.resolveMove(s.ctx, s.instance, delta)!;
+    expect(partsOf(r.transform), partsOf(placed.transform));
+    expect(r.marker, placed.marker);
+    final q = s.edge.queries.single;
+    final moved = delta.multiply(s.transform);
+    expect(partsOf(q.current), partsOf(moved));
+    final box = boxOfEntry(entry('demo.shelf.wall'))!;
+    // M-MV1a: the raw transform's back-centre (no delta).
+    expect(q.pointer, moved.transformPoint(box.backCentre));
+    // M-MV1b: the node not excluded.
+    expect(q.exclude, {s.instance});
+    expect(q.mirrored, isTrue, reason: 'placed mirrored');
+    expect(q.mayRotate, isTrue);
+    expect(q.capture, closeTo(16 / 0.1, 1e-9));
+    expect(q.edgeCapture, closeTo(kSnapAperturePixels / 0.1, 1e-9));
+    expect([q.footprint.minX, q.footprint.maxY], [box.left, box.back]);
+    s.rotate = false;
+    s.resolver.resolveMove(s.ctx, s.instance, delta);
+    expect(s.edge.queries.last.mayRotate, isFalse);
+  });
+
+  test(
+      'MV-2 nothing is asked for a symbol that attaches to nothing, a '
+      'non-symbol, with object snap off, or for a scaled instance', () {
+    final free = Scene(key: 'demo.table.free');
+    // M-MV2a: the attachTo test dropped.
+    expect(free.resolver.resolveMove(free.ctx, free.instance, delta), isNull);
+    expect(free.edge.queries, isEmpty);
+    expect(free.asked, 0, reason: 'no attachTo: the registry is not asked');
+
+    final off = Scene(objectSnap: false);
+    off.answer = (_) => attachment(Transform2.identity(), Vector2(1, 1), 't');
+    // M-MV2b: the object snap test dropped.
+    expect(off.resolver.resolveMove(off.ctx, off.instance, delta), isNull);
+    expect(off.edge.queries, isEmpty);
+
+    final scaled = Scene();
+    scaled.doc.commands.execute(TransformNodeCommand(
+        scaled.instance, Transform2.scale(2, 2).multiply(scaled.transform)));
+    expect(scaled.resolver.resolveMove(scaled.ctx, scaled.instance, delta),
+        isNull);
+    expect(scaled.edge.queries, isEmpty);
+
+    final line = addDrafted(scaled.doc, EntityKind.line,
+        linePayload(Vector2(100500, -70500), Vector2(101500, -70100)),
+        layer: ReservedHandles.layerZero);
+    scaled.doc.commands.execute(line);
+    expect(scaled.resolver.resolveMove(scaled.ctx, line.record.handle, delta),
+        isNull);
+  });
+
+  test(
+      'MV-3 within one drag a query keeps the last answer; after the '
+      'document changes it starts afresh', () {
+    final s = Scene();
+    final a = attachment(Transform2.translation(99000.5, -69000.25),
+        Vector2(99010.25, -69020.5), 'face');
+    s.answer = (_) => a;
+    s.resolver.resolveMove(s.ctx, s.instance, delta);
+    s.resolver.resolveMove(s.ctx, s.instance, delta);
+    // M-MV3a: keep always null.
+    expect(s.edge.queries.last.keep, same(a));
+    s.doc.commands.execute(TransformNodeCommand(s.instance, a.transform));
+    s.resolver.resolveMove(s.ctx, s.instance, delta);
+    // M-MV3b: the stateId reset dropped.
+    expect(s.edge.queries.last.keep, isNull);
+  });
+
+  test('MV-4 the footprint is the definition\'s live leaves', () {
+    final s = Scene();
+    final node = s.doc.tree[s.instance]! as InstanceNode;
+    final box = boxOfDefinition(s.doc, node.definition)!;
+    s.answer = (_) => null;
+    s.resolver.resolveMove(s.ctx, s.instance, delta);
+    final f = s.edge.queries.single.footprint;
+    expect([f.minX, f.minY, f.maxX, f.maxY],
+        [box.left, box.front, box.right, box.back]);
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/tools/plan_symbol_tool_test.dart b/packages/jet_cad_2d_plan/test/tools/plan_symbol_tool_test.dart
new file mode 100644
index 00000000..9cafa709
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/tools/plan_symbol_tool_test.dart
@@ -0,0 +1,1576 @@
+// Spec 09b D6, F-5, F-6, F-12, F-14, F-16 (ported to the plan library,
+// Task 14): plan.symbol's pointer, snap, ghost, keys and permission check,
+// driven directly with `ToolPointerEvent`s and `KeyEvent`s; spec 09c D12:
+// the ghost follows a camera change (a wheel zoom, a pan). Ported from
+// jet_cad_floor_plan's symbol_place_tool_test.dart, assertions unchanged;
+// its wall attachment moves to sub-project 3 with the wall-face provider.
+// Spec P3 "Attachment" (Task 14): the attachment through the registry.
+//
+// Fixtures (plan P-3): entries of the plan library's fixture library
+// (every base point is off the origin); a camera at 0.05 px/mm with y up,
+// centred far from the origin, so the snap aperture is 10 / 0.05 = 200 mm,
+// not 10 mm; a page whose grid (25 mm, origin off every round number) moves
+// every raw point; one line whose start E is the object snap target. The
+// ghost is painted with a rebase origin far from zero.
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart' show ValueNotifier;
+import 'package:flutter/gestures.dart' show kPrimaryButton, kSecondaryButton;
+import 'package:flutter/services.dart'
+    show
+        HardwareKeyboard,
+        KeyDownEvent,
+        KeyEvent,
+        KeyRepeatEvent,
+        KeyUpEvent,
+        LogicalKeyboardKey,
+        MouseCursor,
+        PhysicalKeyboardKey,
+        SystemMouseCursors;
+import 'package:flutter/widgets.dart'
+    show
+        Align,
+        Alignment,
+        Directionality,
+        KeyEventResult,
+        SizedBox,
+        TextDirection;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_kit/authoring.dart' show Catalog, encodeLibrary;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:jet_cad_2d_plan/src/attach/attachment_registry.dart';
+import 'package:jet_cad_2d_plan/src/symbols/symbol_box.dart';
+import 'package:jet_cad_2d_plan/src/symbols/symbol_ghost.dart';
+import 'package:jet_cad_2d_plan/src/symbols/symbol_placer.dart';
+import 'package:jet_cad_2d_plan/src/tools/plan_symbol_tool.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/attach_fixtures.dart';
+import '../support/symbol_fixtures.dart';
+import '../support/test_kit.dart' show TestEdge;
+
+final SymbolLibrary library =
+    SymbolLibrary.decode(bytesOf(buildValidLibrary()));
+
+PlanSymbol entry(String key) => PlanSymbol(
+    kitId: 'fixture',
+    names: KitNames.empty,
+    entry: library.entries.singleWhere((e) => e.symbol.key == key));
+
+/// Today's office chair: a symbol whose base point is off its leaves and
+/// far (beyond the 200 mm aperture) from every snap point of its own
+/// leaves, so a later placement near an earlier one lands on the grid, as
+/// the asset's chair did. (Not the fixture sofa: its line's midpoint sits
+/// 60 mm from its base point and catches the third placement of "keys
+/// compose".)
+final PlanSymbol chair = entry('fixture.armchair.single');
+
+/// Today's toilet: the second symbol a re-arm swaps to.
+final PlanSymbol toilet = entry('fixture.nightstand.single');
+
+/// The camera's pixels per mm: the aperture is 200 mm.
+const double scale = 0.05;
+
+/// The line's start: the object snap target, off the grid.
+final Vector2 e0 = Vector2(73250.5, -41810.25);
+
+/// The page grid: 25 mm from an origin off every round number.
+const double gridStep = 25;
+const double gridOriginX = 70000.3, gridOriginY = -40000.7;
+
+Vector2 gridOf(Vector2 p) => Vector2(
+    gridOriginX + ((p.x - gridOriginX) / gridStep).roundToDouble() * gridStep,
+    gridOriginY + ((p.y - gridOriginY) / gridStep).roundToDouble() * gridStep);
+
+/// Far from [e0] (more than the aperture) and from each other.
+final Vector2 pA = Vector2(80123.4, -35211.7);
+final Vector2 pMid = Vector2(80741.15, -36013.35);
+final Vector2 pB = Vector2(81377.9, -36904.2);
+final Vector2 pC = Vector2(76402.6, -45518.85);
+
+/// The rebase origin the overlay paints with.
+final Vector2 origin = Vector2(70000, -40000);
+
+final class Rig {
+  /// [objectSnap] non-null: a `SnapSettings` with it in the context (null:
+  /// none, object snap on). [step] null: the page has no fixed grid step,
+  /// so the drag uses the zoom-adaptive one. [attachments], [canRotate]
+  /// and [canMirror] are handed to the tool.
+  Rig(
+      {bool page = true,
+      bool? objectSnap,
+      double? step = gridStep,
+      AttachmentRegistry? attachments,
+      bool Function()? canRotate,
+      bool Function()? canMirror}) {
+    document = DraftDocument.empty(measurer: const InsertionPointMeasurer());
+    PageComponent.register(document.components);
+    registerKitComponents(document.components);
+    document.header.units = DrawingUnits.millimeters;
+    if (page) {
+      document.commands.execute(SetComponentCommand<PageComponent>(
+          document.rootHandle,
+          PageComponent(
+              originX: gridOriginX, originY: gridOriginY, gridStepMm: step)));
+    }
+    document.commands.execute(addDrafted(
+        document, EntityKind.line, linePayload(e0, e0 + Vector2(1200, 700)),
+        layer: ReservedHandles.layerZero));
+    document.commands.clearHistory();
+    index = SpatialIndex(document);
+    final linear = Transform2.scale(scale, -scale);
+    final mid = linear.transformPoint(Vector2(76000, -41000));
+    camera = CountingCamera(ViewportTransform(
+        worldToScreenMatrix:
+            Transform2.translation(400 - mid.x, 300 - mid.y).multiply(linear)));
+    selection = SelectionController(document);
+    pages = PageNotifier(document);
+    snap = objectSnap == null ? null : SnapSettings(objectSnap: objectSnap);
+    ctx = ToolContext(
+        document: document,
+        index: index,
+        camera: camera,
+        selection: selection,
+        page: pages,
+        snap: snap);
+    armed = CountingNotifier(chair);
+    tool = PlanSymbolTool(armed,
+        attachments: attachments, canRotate: canRotate, canMirror: canMirror);
+    tool.addListener(() => notifications.add(tool.isMidShape));
+    addTearDown(() {
+      if (!disposed) tool.dispose();
+      armed.dispose();
+      pages.dispose();
+      snap?.dispose();
+      selection.dispose();
+      camera.dispose();
+      index.dispose();
+    });
+  }
+
+  late final DraftDocument document;
+  late final SpatialIndex index;
+  late final CountingCamera camera;
+  late final SelectionController selection;
+  late final PageNotifier pages;
+  late final SnapSettings? snap;
+  late final ToolContext ctx;
+  late final CountingNotifier armed;
+  late final PlanSymbolTool tool;
+  bool disposed = false;
+
+  /// `isMidShape` at each notification.
+  final List<bool> notifications = [];
+
+  ToolPointerEvent at(Vector2 world, {int buttons = 0, int pointer = 7}) {
+    final s = camera.value.worldToScreen(world);
+    return ToolPointerEvent(
+        screen: ui.Offset(s.x, s.y),
+        world: world,
+        pointer: pointer,
+        buttons: buttons,
+        shift: false,
+        control: false,
+        meta: false,
+        alt: false,
+        pickRadiusWorld: kPickRadiusPixels / scale);
+  }
+
+  void hover(Vector2 w) => tool.onPointerMove(at(w), ctx);
+  void down(Vector2 w, {int pointer = 7}) =>
+      tool.onPointerDown(at(w, buttons: kPrimaryButton, pointer: pointer), ctx);
+  void drag(Vector2 w, {int pointer = 7}) =>
+      tool.onPointerMove(at(w, buttons: kPrimaryButton, pointer: pointer), ctx);
+  void up(Vector2 w, {int pointer = 7}) =>
+      tool.onPointerUp(at(w, pointer: pointer), ctx);
+
+  List<InstanceNode> get instances =>
+      document.tree.nodes.whereType<InstanceNode>().toList();
+
+  /// Where an instance put its symbol's base point: its `at`.
+  Vector2 placedAt(InstanceNode n) => n.transform
+      .transformPoint(document.tree.definition(n.definition)!.basePoint);
+
+  List<Handle> get symbolDefinitions => [
+        for (final h in document.components.withComponent<SymbolComponent>())
+          if (document.tree.definition(h) != null) h
+      ];
+}
+
+/// The armed notifier, counting its listeners.
+final class CountingNotifier extends ValueNotifier<PlanSymbol?> {
+  CountingNotifier(super.value);
+
+  int listeners = 0;
+
+  @override
+  void addListener(ui.VoidCallback listener) {
+    listeners++;
+    super.addListener(listener);
+  }
+
+  @override
+  void removeListener(ui.VoidCallback listener) {
+    listeners--;
+    super.removeListener(listener);
+  }
+}
+
+/// The camera, counting its listeners (spec 09c D12: the tool listens while
+/// the ghost is shown, and only then).
+final class CountingCamera extends CameraController {
+  CountingCamera(super.initial);
+
