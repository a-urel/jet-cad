+    test('memoised per entry: the same object on every call', () {
+      final lib = SymbolLibrary.decode(bytesOf(buildValidLibrary()));
+      final toilet = entryIn(lib, 'fixture.sofa.three');
+      final tub = entryIn(lib, 'fixture.armchair.single');
