+/// The local box of a symbol: `left = minX`, `right = maxX`,
+/// `front = minY`, `back = maxY` in the definition's coordinates.
+final class SymbolBox {
+  final double left, right, front, back;
+
+  const SymbolBox({
+    required this.left,
+    required this.right,
+    required this.front,
+    required this.back,
+  });
+
+  /// `W = right − left`.
+  double get width => right - left;
+
+  /// `D = back − front`.
+  double get depth => back - front;
+
+  /// The middle of the back edge, `((left + right) / 2, back)`: the point
+  /// that lands on a wall's face (spec D4).
+  Vector2 get backCentre => Vector2((left + right) / 2, back);
+
+  @override
+  bool operator ==(Object other) =>
+      other is SymbolBox &&
+      other.left == left &&
+      other.right == right &&
+      other.front == front &&
+      other.back == back;
+
+  @override
+  int get hashCode => Object.hash(left, right, front, back);
+
+  @override
+  String toString() =>
+      'SymbolBox(left: $left, right: $right, front: $front, back: $back)';
+}
+
+/// The axis directions an arc's sweep can pass, `k · π/2` for k = 0..3, and
+/// the unit offset of the circle's extreme in each: exact, so an extreme is
+/// `c ± r` with no rounding.
+const List<double> _axisAngles = [0, 0.5 * math.pi, math.pi, 1.5 * math.pi];
+const List<double> _axisX = [1, 0, -1, 0];
+const List<double> _axisY = [0, 1, 0, -1];
+
+/// The local box of [leaves] (each a kind and its payload, in the
+/// definition's coordinates), or null when none of them draws.
+///
+/// A line's and a polyline's vertices; a circle's centre ± r; an arc's two
+/// end points plus each axis extreme its sweep passes (its **true** extents,
+/// spec D2), whichever way it turns. Any other kind (a point, a text, a
+/// fill, an attribute: the library holds none, spec 09 D5) and a malformed
+/// payload are skipped, as the ghost path skips them.
+SymbolBox? boxOfLeaves(Iterable<(EntityKind, GeometryPayload)> leaves) {
+  var minX = double.infinity, maxX = double.negativeInfinity;
+  var minY = double.infinity, maxY = double.negativeInfinity;
+  void add(double x, double y) {
+    if (x < minX) minX = x;
+    if (x > maxX) maxX = x;
+    if (y < minY) minY = y;
+    if (y > maxY) maxY = y;
+  }
+
+  for (final (kind, p) in leaves) {
+    final c = p.coords;
+    switch (kind) {
+      case EntityKind.line:
+      case EntityKind.polyline:
+        for (var i = 0; i + 1 < c.length; i += 2) {
+          add(c[i], c[i + 1]);
+        }
+      case EntityKind.circle:
+        if (c.length < 2 || p.scalars.isEmpty) continue;
+        final r = p.scalars[0];
+        add(c[0] - r, c[1] - r);
+        add(c[0] + r, c[1] + r);
+      case EntityKind.arc:
+        if (c.length < 2 || p.scalars.length < 3) continue;
+        final r = p.scalars[0], start = p.scalars[1], sweep = p.scalars[2];
+        final end = start + sweep;
+        add(c[0] + r * math.cos(start), c[1] + r * math.sin(start));
+        add(c[0] + r * math.cos(end), c[1] + r * math.sin(end));
+        for (var k = 0; k < 4; k++) {
+          if (angleInSweep(_axisAngles[k], start, sweep)) {
+            add(c[0] + r * _axisX[k], c[1] + r * _axisY[k]);
+          }
+        }
+      case EntityKind.point:
+      case EntityKind.text:
+      case EntityKind.attrib:
+      case EntityKind.fill:
+        continue;
+    }
+  }
+  if (minX > maxX) return null;
+  return SymbolBox(left: minX, right: maxX, front: minY, back: maxY);
+}
+
+final Expando<_Memo> _entryBoxes = Expando<_Memo>('symbolBox');
+
+/// Holds a memoised box, null included (an entry with no drawn leaf).
+final class _Memo {
+  final SymbolBox? box;
+  const _Memo(this.box);
+}
+
+/// The local box of [entry], computed on the first call and the same object
+/// on every later call for the same entry (spec D2: once per entry).
+SymbolBox? boxOfEntry(SymbolEntry entry) =>
+    (_entryBoxes[entry] ??= _Memo(boxOfLeaves(
+            [for (final l in entry.leaves) (l.record.kind, l.payload)])))
+        .box;
+
+/// The local box of the definition [definition] in [doc], from its **live**
+/// leaves (the entities it owns); null when [definition] names no definition
+/// or none of its leaves draws.
+///
+/// Not memoised: O(entities) per call. The per-document memo cleared on a
+/// document change belongs to the caller (`WallFaces`, spec D3, D4).
+SymbolBox? boxOfDefinition(DraftDocument doc, Handle definition) {
+  if (doc.tree.definition(definition) == null) return null;
+  final entities = doc.entities;
+  return boxOfLeaves([
+    for (final slot in entities.liveSlots)
+      if (entities.ownerAt(slot) == definition)
+        (
+          entities.kindAt(slot),
+          doc.geometry.read(entities.geomIndexAt(slot)),
+        ),
+  ]);
+}
+
+/// [box] as the engine's box, the shape `AttachmentQuery.footprint` takes:
+/// x from left to right, y from front to back, in the definition's
+/// coordinates.
+Aabb2 footprintOf(SymbolBox box) =>
+    Aabb2.raw(box.left, box.front, box.right, box.back);
diff --git a/packages/jet_cad_2d_plan/lib/src/symbols/symbol_ghost.dart b/packages/jet_cad_2d_plan/lib/src/symbols/symbol_ghost.dart
new file mode 100644
index 00000000..54851d03
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/symbols/symbol_ghost.dart
@@ -0,0 +1,149 @@
+// The symbol placement ghost (spec 09b D6 "The ghost", F-14, R-3): the
+// symbol's leaves as one cached `ui.Path` in the symbol's local frame, and
+// the matrix that carries that frame to `world − origin` for a tool's
+// `paintWorldOverlay`.
+//
+// `dart:ui` only, no widget: the placement tool (plan Task 6) owns the
+// painting. Nothing here allocates per paint: the path is built once per
+// entry, the placement transform is computed by the tool on events (spec 09c
+// D5), and its linear part is written only when it changes; a paint writes
+// two doubles of a reused `Float64List(16)`.
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart' show visibleForTesting;
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart' show SymbolEntry;
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+final Expando<ui.Path> _ghostPaths = Expando<ui.Path>('ghostPath');
+
+/// The outline of [entry]'s leaves in the symbol's **local** frame (the
+/// definition's coordinates, base point not subtracted), built on the first
+/// call and the same object on every later call for the same entry.
+///
+/// A line is a segment, a polyline its segments (closed when
+/// [isClosedPolyline]), a circle `addOval` and an arc `addArc` with the
+/// payload's start and sweep unchanged (`[r, start, sweep]`): the path's
+/// angles are the engine's `c + r·(cos θ, sin θ)`, and a matrix with a
+/// y-flip or a mirror carries them as it carries every other point (F-14).
+/// Points, texts and fills draw nothing.
+ui.Path ghostPathFor(SymbolEntry entry) =>
+    _ghostPaths[entry] ??= _buildGhostPath(entry);
+
+ui.Path _buildGhostPath(SymbolEntry entry) {
+  final path = ui.Path();
+  for (final leaf in entry.leaves) {
+    final p = leaf.payload;
+    final c = p.coords;
+    switch (leaf.record.kind) {
+      case EntityKind.line:
+      case EntityKind.polyline:
+        if (c.length < 4) continue;
+        path.moveTo(c[0], c[1]);
+        for (var i = 2; i + 1 < c.length; i += 2) {
+          path.lineTo(c[i], c[i + 1]);
+        }
+        if (leaf.record.kind == EntityKind.polyline && isClosedPolyline(p)) {
+          path.close();
+        }
+      case EntityKind.circle:
+        if (c.length < 2 || p.scalars.isEmpty) continue;
+        path.addOval(ui.Rect.fromCircle(
+            center: ui.Offset(c[0], c[1]), radius: p.scalars[0]));
+      case EntityKind.arc:
+        if (c.length < 2 || p.scalars.length < 3) continue;
+        path.addArc(
+            ui.Rect.fromCircle(
+                center: ui.Offset(c[0], c[1]), radius: p.scalars[0]),
+            p.scalars[1],
+            p.scalars[2]);
+      case EntityKind.point:
+      case EntityKind.text:
+      case EntityKind.attrib:
+      case EntityKind.fill:
+        continue;
+    }
+  }
+  return path;
+}
+
+/// A column-major 4×4 identity, the storage [writeGhostMatrix] expects.
+Float64List identityGhostMatrix() => Float64List(16)
+  ..[0] = 1
+  ..[5] = 1
+  ..[10] = 1
+  ..[15] = 1;
+
+/// Writes `translate(−origin) ∘ p` into [m], an identity-initialised
+/// column-major 4×4 (`canvas.transform`'s layout): the linear part of [p] in
+/// `[0] [1] [4] [5]`, its translation less [origin] in `[12] [13]`. Composed
+/// in doubles; the other ten entries are left as they are.
+void writeGhostMatrix(Float64List m, Transform2 p, Vector2 origin) {
+  _writeLinear(m, p);
+  _writeTranslation(m, p, origin);
+}
+
+void _writeLinear(Float64List m, Transform2 p) {
+  m[0] = p.a;
+  m[1] = p.b;
+  m[4] = p.c;
+  m[5] = p.d;
+}
+
+void _writeTranslation(Float64List m, Transform2 p, Vector2 origin) {
+  m[12] = p.e - origin.x;
+  m[13] = p.f - origin.y;
+}
+
+/// The ghost's reused matrix (spec 09b D6, 09c D5): the placement transform
+/// `P` is handed in by the tool, which computes it on pointer, key, camera
+/// and re-arm events (spec 09c D12); its linear part is written only
+/// when one of its six doubles differs from the last ([update]); a paint
+/// ([forOrigin]) writes only the translation less the rebase origin.
+final class GhostMatrix {
+  /// The column-major storage handed to `canvas.transform`, reused for the
+  /// holder's life.
+  final Float64List storage = identityGhostMatrix();
+
+  Transform2? _p;
+  int _computations = 0;
+
+  /// How many times a new `P` was taken: a test's count (spec D6).
+  @visibleForTesting
+  int get computations => _computations;
+
+  /// The current placement transform, or null before the first [update].
+  Transform2? get placement => _p;
+
+  /// Sets the placement; takes [placement] and rewrites the linear part only
+  /// when one of its six doubles differs from the last call's (stored
+  /// values, compared exactly with `==`, so `-0.0` equals `0.0`). An equal
+  /// placement keeps the earlier object.
+  void update({required Transform2 placement}) {
+    final p = _p;
+    if (p != null &&
+        placement.a == p.a &&
+        placement.b == p.b &&
+        placement.c == p.c &&
+        placement.d == p.d &&
+        placement.e == p.e &&
+        placement.f == p.f) {
+      return;
+    }
+    _p = placement;
+    _computations++;
+    _writeLinear(storage, placement);
+  }
+
+  /// [storage] with its translation set for [origin] (`world − origin`, the
+  /// frame `paintWorldOverlay` paints in). Call [update] first.
+  Float64List forOrigin(Vector2 origin) {
+    final p = _p;
+    if (p == null) {
+      throw StateError('GhostMatrix.forOrigin before update');
+    }
+    _writeTranslation(storage, p, origin);
+    return storage;
+  }
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/tools/move_resolver.dart b/packages/jet_cad_2d_plan/lib/src/tools/move_resolver.dart
new file mode 100644
index 00000000..3fe23eb6
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/tools/move_resolver.dart
@@ -0,0 +1,103 @@
+// Spec P3 "Attachment" (Task 14): plan.select's move resolver, ported from
+// jet_cad_floor_plan's symbol_move.dart (spec 09c D8) over the registry.
+// A root-level symbol instance whose jetcad.symbol names attachment kinds,
+// dragged by its body with object snap on, attaches as a placement does,
+// anchored on its plain-moved back-centre.
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart'
+    show MoveResolver, ToolContext;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart'
+    show Attachment, AttachmentQuery, AttachmentRegistry, SymbolComponent;
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../symbols/symbol_box.dart';
+import 'plan_symbol_tool.dart' show kAttachPixels;
+
+/// Whether [g]'s linear part is orthonormal (spec 09c W-8, S-10; ported
+/// from wall_attach.dart:402-407): a mirror is, a scale is not.
+bool isOrthonormal(Transform2 g) {
+  final tol = Tolerance.standard.linear;
+  return (g.a * g.a + g.b * g.b - 1).abs() <= tol &&
+      (g.c * g.c + g.d * g.d - 1).abs() <= tol &&
+      (g.a * g.c + g.b * g.d).abs() <= tol;
+}
+
+/// plan.select's [MoveResolver] over the current document's attachment
+/// registry (spec P3; today's `SymbolMoveResolver`, spec 09c D8).
+final class PlanMoveResolver implements MoveResolver {
+  PlanMoveResolver({required this.attachments, this.canRotate});
+
+  /// The current document's registry, read at each call.
+  final AttachmentRegistry Function() attachments;
+
+  /// Whether a move may turn the symbol (the permissions' rotate), read at
+  /// each call; null allows.
+  final bool Function()? canRotate;
+
+  /// The document of the last call, weakly: the resolver lives as long as
+  /// its controller and must not keep a replaced plan alive.
+  WeakReference<DraftDocument>? _document;
+  int _state = -1;
+  Handle? _node;
+  Attachment? _last;
+  final Map<Handle, SymbolBox?> _boxes = <Handle, SymbolBox?>{};
+
+  /// For a root-level instance of a live definition whose `SymbolComponent`
+  /// names attachment kinds, with object snap on and an orthonormal
+  /// transform (a scaled instance never attaches, so its scale is never
+  /// dropped): the registry's answer for the plain move `delta · T`; else
+  /// null.
+  @override
+  ({Transform2 transform, Vector2 marker})? resolveMove(
+      ToolContext ctx, Handle node, Transform2 delta) {
+    final doc = ctx.document;
+    if (!(ctx.snap?.objectSnap ?? true)) return null;
+    final n = doc.tree[node];
+    if (n is! InstanceNode || n.parent != doc.rootHandle) return null;
+    if (doc.tree.definition(n.definition) == null) return null;
+    final symbol = doc.components.get<SymbolComponent>(n.definition);
+    if (symbol == null || symbol.attachTo.isEmpty) return null;
+    final t = n.transform;
+    if (!isOrthonormal(t)) return null;
+    _sync(doc, node);
+    final box = _boxes.putIfAbsent(
+        n.definition, () => boxOfDefinition(doc, n.definition));
+    if (box == null) return null;
+    final moved = delta.multiply(t);
+    final scale = ctx.camera.value.scale;
+    final a = attachments().attach(
+        symbol.attachTo,
+        AttachmentQuery(
+          footprint: footprintOf(box),
+          current: moved,
+          pointer: moved.transformPoint(box.backCentre),
+          capture: kAttachPixels / scale,
+          edgeCapture: kSnapAperturePixels / scale,
+          mirrored: t.a * t.d - t.b * t.c < 0,
+          mayRotate: canRotate?.call() ?? true,
+          exclude: {node},
+          keep: _last,
+        ));
+    _last = a;
+    if (a == null) return null;
+    return (transform: a.transform, marker: a.marker);
+  }
+
+  /// One drag is one document state and one node: outside it the boxes
+  /// and the keep start afresh.
+  void _sync(DraftDocument doc, Handle node) {
+    final state = doc.commands.stateId;
+    if (identical(doc, _document?.target) && state == _state) {
+      if (node != _node) {
+        _node = node;
+        _last = null;
+      }
+      return;
+    }
+    _document = WeakReference(doc);
+    _state = state;
+    _node = node;
+    _last = null;
+    _boxes.clear();
+  }
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/tools/plan_symbol_tool.dart b/packages/jet_cad_2d_plan/lib/src/tools/plan_symbol_tool.dart
new file mode 100644
index 00000000..21daff9f
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/tools/plan_symbol_tool.dart
@@ -0,0 +1,508 @@
+// Spec P3 "Attachment" (Task 14): plan.symbol, ported from
+// jet_cad_floor_plan's symbol_place_tool.dart (spec 09b D6, F-5, F-6,
+// F-12, F-14, F-16; 09c D5, D6, D12). A ghost of the armed symbol's
+// outline follows the pointer, snapping like the drawing tools; press,
+// drag, release places it at the release point; one undo step per
+// placement; the tool stays armed. A symbol whose jetcad.symbol names
+// attachment kinds attaches through the registry, while object snap is on.
+import 'dart:typed_data';
+import 'dart:ui' as ui;
+
+import 'package:flutter/foundation.dart'
+    show ValueListenable, visibleForTesting;
+import 'package:flutter/gestures.dart' show kPrimaryButton;
+import 'package:flutter/services.dart'
+    show
+        HardwareKeyboard,
+        KeyDownEvent,
+        KeyEvent,
+        KeyUpEvent,
+        LogicalKeyboardKey,
+        MouseCursor,
+        SystemMouseCursors;
+import 'package:flutter/widgets.dart' show KeyEventResult;
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart'
+    show Attachment, AttachmentQuery, AttachmentRegistry;
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../attach/attachment_painter.dart';
+import '../symbols/plan_symbol.dart';
+import '../symbols/symbol_box.dart';
+import '../symbols/symbol_ghost.dart';
+import '../symbols/symbol_placer.dart';
+import 'generic_tools.dart' show PlanToolIds;
+
+/// The half-size of the ghost's base-point cross, in screen pixels.
+const double kGhostCrossPixels = 6.0;
+
+/// How near, in screen pixels, the raw pointer may be for an attachment
+/// (today's kWallAttachPixels, spec 09c D4, D6): larger than the snap
+/// aperture, since the pointer is often the symbol's centre.
+const double kAttachPixels = 16.0;
+
+/// Places the [armed] symbol on release (spec 09b D6; see the header).
+///
+/// - Nothing armed is idle: every pointer event is ignored, every key
+///   bubbles, the cursor defers.
+/// - A hover (mouse) moves the ghost; a primary press starts a placement
+///   and shows the ghost at the press (touch has no hover, F-6); a move
+///   while pressed follows; the release places at the **snapped release
+///   point**. [cancel] drops the press and hides the ghost.
+/// - It listens to [armed]: a re-arm drops the press, looks up the new
+///   ghost path and notifies; the turns and the mirror are kept.
+/// - R, Shift+R and M turn and mirror the next placement while
+///   [canRotate] / [canMirror] allow (null allows); a refused turn or
+///   mirror is not used (the stored one returns with the flag).
+/// - Spec 09c D12: while the ghost is shown it listens to the camera, and
+///   a camera change re-resolves the ghost from the last pointer's screen
+///   point.
+/// - Attachment (spec P3): for a symbol whose component's `attachTo` is not
+///   empty, with object snap on and [attachments] given, each recompute
+///   asks `attachments.attach(attachTo, query)` with the symbol's
+///   footprint, the free placement as `current`, the raw pointer, the
+///   captures `kAttachPixels / scale` and `kSnapAperturePixels / scale`,
+///   the mirror, `mayRotate` ([canRotate]) and the last answer as `keep`.
+///   Attached, the ghost and the release use the answer's transform
+///   verbatim and the marker is drawn at its marker; M mirrors in place.
+class PlanSymbolTool extends Tool {
+  PlanSymbolTool(this.armed,
+      {this.attachments, this.canRotate, this.canMirror}) {
+    armed.addListener(_onArmed);
+    _syncPath();
+  }
+
+  /// The armed symbol; the controller's, read here.
+  final ValueListenable<PlanSymbol?> armed;
+
+  /// The document's attachment registry, or null: nothing attaches.
+  final AttachmentRegistry? attachments;
+
+  /// Whether `R` and `Shift+R` turn the next placement (the permissions'
+  /// `rotate`), read at each use; null allows.
+  final bool Function()? canRotate;
+
+  /// Whether `M` mirrors the next placement (the permissions' `mirror`),
+  /// read at each use; null allows.
+  final bool Function()? canMirror;
+
+  final DragPoint _at = DragPoint();
+  final SnapResult _scratch = SnapResult();
+  final GhostMatrix _matrix = GhostMatrix();
+  // Coloured from the overlay's paper set where they are drawn (dark theme
+  // spec D5): the ghost `preview`, the marker `snap`.
+  final ui.Paint _ghostPaint = ui.Paint()..style = ui.PaintingStyle.stroke;
+  final ui.Paint _markerPaint = ui.Paint()
+    ..style = ui.PaintingStyle.stroke
+    ..strokeWidth = kSnapMarkerStrokePixels;
+
+  ui.Path? _path;
+  bool _ghostVisible = false;
+  bool _pressed = false;
+  int _pressPointer = -1;
+  int _quarterTurns = 0;
+  bool _mirrored = false;
+
+  /// The ghost's placement transform, computed on pointer, key, arm and
+  /// camera events, never in a paint (spec 09c D5, W-15).
+  Transform2? _placement;
+
+  /// The attachment of the last recompute, or null (free placement).
+  Attachment? _attached;
+
+  /// The inputs of the last attachment query, kept so a key (`M`) can ask
+  /// again for the same pointer: the raw world point, whether object snap
+  /// was on, the camera scale. [_hasRaw] is false until the first
+  /// recompute with a context.
+  final Vector2 _raw = Vector2.zero();
+  bool _rawObjectSnap = true;
+  double _rawScale = 1;
+  bool _hasRaw = false;
+
+  /// Spec 09c D12: the last pointer event's screen point and context.
+  ui.Offset _lastScreen = ui.Offset.zero;
+  ToolContext? _context;
+
+  /// The context whose camera this tool listens to; non-null exactly while
+  /// [ghostVisible] (after a pointer event brought a context).
+  ToolContext? _listening;
+
+  /// What a placement commits (spec D6: the definition copy, its leaves and
+  /// its jetcad.symbol).
+  static const Set<Capability> needs = PlanToolIds.symbolNeeds;
+
+  @override
+  String get name => 'Symbol';
+
+  @override
+  ToolPhase get phase => _pressed ? ToolPhase.pressed : ToolPhase.idle;
+
+  /// A down only classifies a press and `cancel` executes nothing, so a
+  /// finger reaches this tool after the hold-back (spec 14t R-1).
+  @override
+  TouchPress get touchPress => TouchPress.press;
+
+  /// True while a press is down.
+  @override
+  bool get isMidShape => _pressed;
+
+  @override
+  MouseCursor get cursor =>
+      armed.value == null ? MouseCursor.defer : SystemMouseCursors.precise;
+
+  /// Whether the ghost (and its marker) is painted.
+  bool get ghostVisible => _ghostVisible && armed.value != null;
+
+  /// The resolved (snapped) point the ghost's base point sits on while it
+  /// places freely. Read only; reused.
+  Vector2 get ghostAt => _at.point;
+
+  /// The ghost's cached local path, or null while idle.
+  @visibleForTesting
+  ui.Path? get ghostPath => _path;
+
+  /// The ghost's placement transform as last computed on an event, or null
+  /// while idle or before the first pointer event.
+  @visibleForTesting
+  Transform2? get ghostPlacement => _placement;
+
+  /// The ghost's reused matrix.
+  @visibleForTesting
+  GhostMatrix get ghostMatrix => _matrix;
+
+  /// The attachment the ghost (and a release) uses, or null.
+  @visibleForTesting
+  Attachment? get ghostAttachment => _attached;
+
+  /// The rotation, in counter-clockwise quarter turns, of the next
+  /// placement as stored; a placement uses it only while [canRotate]
+  /// allows.
+  int get quarterTurns => _quarterTurns;
+
+  /// Whether the next placement is mirrored, as stored; a placement uses it
+  /// only while [canMirror] allows.
+  bool get mirrored => _mirrored;
+
+  int get _turns => (canRotate?.call() ?? true) ? _quarterTurns : 0;
+  bool get _mirror => _mirrored && (canMirror?.call() ?? true);
+
+  /// The permissions may have changed: the ghost and its attachment are
+  /// computed again with the turn and the mirror now allowed.
+  void gatesChanged() {
+    if (armed.value == null) return;
+    final ctx = _listening ?? _context;
+    if (ctx != null) _syncAttachment(ctx);
+    _syncPlacement();
+    notifyListeners();
+  }
+
+  void _syncPath() {
+    final symbol = armed.value;
+    _path = symbol == null ? null : ghostPathFor(symbol.entry);
+  }
+
+  void _onArmed() {
+    _syncPath();
+    _syncCamera();
+    // The previous symbol's answer is no keep for this one.
+    _attached = null;
+    final ctx = _listening;
+    if (ctx != null) {
+      _update(ctx, _worldUnderPointer(ctx));
+    } else {
+      _syncPlacement();
+    }
+    _pressed = false;
+    _pressPointer = -1;
+    notifyListeners();
+  }
+
+  /// The free placement: the resolved point, the turns, the mirror.
+  Transform2? _free() {
+    final symbol = armed.value;
+    return symbol == null
+        ? null
+        : placementTransform(
+            at: _at.point,
+            basePoint: symbol.entry.definition.basePoint,
+            quarterTurns: _turns,
+            mirrored: _mirror);
+  }
+
+  void _syncPlacement() => _placement = _attached?.transform ?? _free();
+
+  void _syncAttachment(ToolContext ctx) {
+    final previous = _attached;
+    _attached = null;
+    final registry = attachments;
+    final symbol = armed.value;
+    if (registry == null || symbol == null || !_hasRaw || !_rawObjectSnap) {
+      return;
+    }
+    final kinds = symbol.component.attachTo;
+    if (kinds.isEmpty) return;
+    final box = boxOfEntry(symbol.entry);
+    if (box == null) return;
+    _attached = registry.attach(
+        kinds,
+        AttachmentQuery(
+          footprint: footprintOf(box),
+          current: _free()!,
+          pointer: _raw.clone(),
+          capture: kAttachPixels / _rawScale,
+          edgeCapture: kSnapAperturePixels / _rawScale,
+          mirrored: _mirror,
+          mayRotate: canRotate?.call() ?? true,
+          exclude: const {},
+          keep: previous,
+        ));
+  }
+
+  /// F-5: object snap at `kSnapAperturePixels / scale`, else the grid, else
+  /// the raw point. No ortho base: a symbol has no previous point.
+  void _resolve(ToolContext ctx, Vector2 raw) {
+    final cam = ctx.camera.value;
+    final page = ctx.page?.value;
+    resolveDragPoint(
+      raw: raw,
+      orthoBase: null,
+      index: ctx.index,
+      apertureWorld: kSnapAperturePixels / cam.scale,
+      objectSnap: ctx.snap?.objectSnap ?? true,
+      page: page,
+      gridStepMm: dragGridStepMm(page, cam.scale),
+      scratch: _scratch,
+      out: _at,
+    );
+  }
+
+  /// The tool's one recompute path: the raw point resolved, then the
+  /// attachment, then the placement.
+  void _update(ToolContext ctx, Vector2 raw) {
+    _resolve(ctx, raw);
+    _raw.setFrom(raw);
+    _rawObjectSnap = ctx.snap?.objectSnap ?? true;
+    _rawScale = ctx.camera.value.scale;
+    _hasRaw = true;
+    _syncAttachment(ctx);
+    _syncPlacement();
+  }
+
+  /// A pointer event's screen point and context, for [_onCamera].
+  void _track(ToolPointerEvent e, ToolContext ctx) {
+    _lastScreen = e.screen;
+    _context = ctx;
+  }
+
+  Vector2 _worldUnderPointer(ToolContext ctx) =>
+      ctx.camera.value.screenToWorld(Vector2(_lastScreen.dx, _lastScreen.dy));
+
+  /// Spec 09c D12: listens to the camera exactly while [ghostVisible].
+  void _syncCamera() {
+    final want = ghostVisible ? _context : null;
+    if (identical(want, _listening)) return;
+    _listening?.camera.removeListener(_onCamera);
+    _listening = want;
+    want?.camera.addListener(_onCamera);
+  }
+
+  void _onCamera() {
+    final ctx = _listening;
+    if (ctx == null) return;
+    _update(ctx, _worldUnderPointer(ctx));
+    notifyListeners();
+  }
+
+  @override
+  void onPointerDown(ToolPointerEvent e, ToolContext ctx) {
+    if (armed.value == null) return;
+    if (e.buttons & kPrimaryButton == 0) return;
+    _pressed = true;
+    _pressPointer = e.pointer;
+    _track(e, ctx);
+    _update(ctx, e.world);
+    _ghostVisible = true;
+    _syncCamera();
+    notifyListeners();
+  }
+
+  @override
+  void onPointerMove(ToolPointerEvent e, ToolContext ctx) {
+    if (armed.value == null) return;
+    final pressedMove = e.buttons & kPrimaryButton != 0;
+    // A cancelled press's remaining moves (F-6), or another pointer's.
+    if (pressedMove && (!_pressed || e.pointer != _pressPointer)) return;
+    _track(e, ctx);
+    _update(ctx, e.world);
+    _ghostVisible = true;
+    _syncCamera();
+    notifyListeners();
+  }
+
+  @override
+  void onPointerUp(ToolPointerEvent e, ToolContext ctx) {
+    if (!_pressed || e.pointer != _pressPointer) return;
+    _pressed = false;
+    _pressPointer = -1;
+    final symbol = armed.value;
+    if (symbol != null) {
+      _track(e, ctx);
+      _update(ctx, e.world);
+      _ghostVisible = true;
+      _syncCamera();
+      _place(ctx, symbol);
+    }
+    notifyListeners();
+  }
+
+  @override
+  void onPointerExit(ToolContext ctx) {
+    if (!_ghostVisible) return;
+    _ghostVisible = false;
+    _syncCamera();
+    notifyListeners();
+  }
+
+  /// Spec D6 Keys, F-12. Idle (nothing armed) every key bubbles.
+  ///
+  /// - `R` turns the next placement one quarter turn counter-clockwise,
+  ///   `Shift+R` clockwise, `M` toggles the mirror; only with no Ctrl, Meta
+  ///   or Alt held (Cmd/Ctrl+R is a browser reload, Ctrl+M passes through).
+  ///   One step per key-down; a repeat is consumed with no effect. They work
+  ///   armed idle and mid-press; the ghost repaints.
+  /// - Mid-press: `Esc` cancels the press (its remaining moves and its up
+  ///   place nothing, Ruling R-B6-1); F and F3 with no modifier bubble (the
+  ///   drawing tools' rule, `placement_tool.dart`); every other key-down and
+  ///   repeat is swallowed, so undo never lands mid-placement.
+  /// - Armed, not pressed: every key but R and M bubbles (the shell's
+  ///   letters, undo and `Esc` work).
+  /// - A key-up always bubbles.
+  @override
+  KeyEventResult onKey(KeyEvent event, ToolContext ctx) {
+    if (armed.value == null || event is KeyUpEvent) {
+      return KeyEventResult.ignored;
+    }
+    final key = event.logicalKey;
+    final modifier = _hasModifier();
+    if (!modifier &&
+        ((key == LogicalKeyboardKey.keyR && (canRotate?.call() ?? true)) ||
+            (key == LogicalKeyboardKey.keyM && (canMirror?.call() ?? true)))) {
+      if (event is KeyDownEvent) {
+        if (key == LogicalKeyboardKey.keyR) {
+          final step = HardwareKeyboard.instance.isShiftPressed ? -1 : 1;
+          _quarterTurns = (_quarterTurns + step) % 4;
+        } else {
+          _mirrored = !_mirrored;
+        }
+        // Spec 09c D6, decision 5: the same pointer asks the registry again
+        // with the new mirror (an attached `M` mirrors in place); the
+        // attached transform ignores the turns, which apply off the face.
+        _syncAttachment(ctx);
+        _syncPlacement();
+        notifyListeners();
+      }
+      return KeyEventResult.handled;
+    }
+    if (!_pressed) return KeyEventResult.ignored;
+    if (event is KeyDownEvent) {
+      if (key == LogicalKeyboardKey.escape) {
+        cancel(ctx);
+        return KeyEventResult.handled;
+      }
+      if ((key == LogicalKeyboardKey.f3 || key == LogicalKeyboardKey.keyF) &&
+          !modifier) {
+        return KeyEventResult.ignored;
+      }
+    }
+    return KeyEventResult.handled;
+  }
+
+  static bool _hasModifier() {
+    final hw = HardwareKeyboard.instance;
+    return hw.isControlPressed || hw.isMetaPressed || hw.isAltPressed;
+  }
+
+  /// Every cancel path: the press is dropped (its up places nothing) and the
+  /// ghost hides; the document is never touched. Idempotent: an idle,
+  /// hidden tool returns before notifying.
+  @override
+  void cancel(ToolContext ctx) {
+    if (!_pressed && !_ghostVisible) return;
+    _pressed = false;
+    _pressPointer = -1;
+    _ghostVisible = false;
+    _syncCamera();
+    notifyListeners();
+  }
+
+  /// The one commit path: one command, one undo step; the permissions are
+  /// checked before placeSymbol allocates a handle (Ruling 05-3, F-16). An
+  /// attached placement commits the attachment's transform verbatim.
+  void _place(ToolContext ctx, PlanSymbol symbol) {
+    if (!needs.every(ctx.document.commands.permissions.allows)) return;
+    ctx.execute(placeSymbol(ctx.document, symbol.entry,
+        at: _at.point,
+        quarterTurns: _turns,
+        mirrored: _mirror,
+        transform: _attached?.transform));
+  }
+
+  /// The snap marker, in screen space; attached, the nearest glyph at the
+  /// attachment's marker.
+  @override
+  void paintOverlay(ui.Canvas canvas, ViewportTransform camera,
+      ui.Size viewport, PaperPalette paper) {
+    if (!ghostVisible) return;
+    _markerPaint.color = paper.snap;
+    final attached = _attached;
+    if (attached != null) {
+      paintAttachmentMarker(canvas, camera, attached.marker, _markerPaint);
+      return;
+    }
+    final m = camera.worldToScreenMatrix;
+    final p = _at.point;
+    final at =
+        ui.Offset(m.a * p.x + m.c * p.y + m.e, m.b * p.x + m.d * p.y + m.f);
+    drawSnapMarker(canvas, at, _at.objectKind,
+        grid: _at.grid, paint: _markerPaint);
+  }
+
+  /// Spec D6: the cached local path under `translate(−origin) ∘ P`, then a
+  /// cross at the local base point. Allocates no path, transform, matrix or
+  /// paint: `P` is the transform stored on the last event (09c D5, W-15),
+  /// and the matrix rewrites its linear part only when `P` changed.
+  @override
+  void paintWorldOverlay(
+      ui.Canvas canvas, Vector2 origin, double scale, PaperPalette paper) {
+    final entry = armed.value?.entry;
+    final path = _path;
+    final placement = _placement;
+    if (!_ghostVisible || entry == null || path == null || placement == null) {
+      return;
+    }
+    final base = entry.definition.basePoint;
+    _matrix.update(placement: placement);
+    final Float64List m = _matrix.forOrigin(origin);
+    _ghostPaint.color = paper.preview;
+    _ghostPaint.strokeWidth = kPreviewStrokePixels / scale;
+    final k = kGhostCrossPixels / scale;
+    canvas.save();
+    canvas.transform(m);
+    canvas.drawPath(path, _ghostPaint);
+    canvas.drawLine(ui.Offset(base.x - k, base.y),
+        ui.Offset(base.x + k, base.y), _ghostPaint);
+    canvas.drawLine(ui.Offset(base.x, base.y - k),
+        ui.Offset(base.x, base.y + k), _ghostPaint);
+    canvas.restore();
+  }
+
+  @override
+  void dispose() {
+    armed.removeListener(_onArmed);
+    _listening?.camera.removeListener(_onCamera);
+    _listening = null;
+    _context = null;
+    super.dispose();
+  }
+}
diff --git a/packages/jet_cad_2d_plan/test/attach/attachment_registry_test.dart b/packages/jet_cad_2d_plan/test/attach/attachment_registry_test.dart
new file mode 100644
index 00000000..4dc68f10
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/attach/attachment_registry_test.dart
@@ -0,0 +1,145 @@
+// Spec P3 "Attachment" (Task 14): the registry asks the providers of every
+// kind the symbol attaches to; the marker nearest the pointer wins; a
+// keep goes back to the provider that made it; a throwing provider is no
+// attachment and one diagnostic. Fixtures off the origin.
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_plan/src/attach/attachment_registry.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/attach_fixtures.dart';
+
+final Vector2 p = Vector2(41250.5, -17320.25);
+
+final class _NoServices implements PlanServices {
+  @override
+  dynamic noSuchMethod(Invocation invocation) =>
+      throw StateError('a provider factory read the services');
+}
+
+final class Rig {
+  final List<KitDiagnostic> reported = [];
+  late final PlanAttachmentRegistry registry =
+      PlanAttachmentRegistry(report: reported.add);
+  final PlanServices services = _NoServices();
+
+  void add(String kit, AttachmentProvider provider) =>
+      registry.add(kit, (_) => provider, services);
+}
+
+Attachment at(double dx, double dy, Object token) => attachment(
+    Transform2.translation(p.x + dx, p.y + dy), p + Vector2(dx, dy), token);
+
+void main() {
+  test('AT-1 kinds: every provider\'s kind, once', () {
+    final r = Rig()
+      ..add('alpha', RecordingProvider('wall-face', (_) => null))
+      ..add('beta', RecordingProvider('wall-face', (_) => null))
+      ..add('beta', RecordingProvider('room-corner', (_) => null));
+    expect(r.registry.kinds, {'wall-face', 'room-corner'});
+    expect(() => r.registry.kinds.add('x'), throwsUnsupportedError);
+  });
+
+  test(
+      'AT-2 the marker nearest the pointer wins across kinds and providers; '
+      'a tie goes to the earlier', () {
+    final r = Rig();
+    final far = RecordingProvider('wall-face', (_) => at(300, 0, 'far'));
+    final near = RecordingProvider('room-corner', (_) => at(0, -120, 'near'));
+    final same = RecordingProvider('room-corner', (_) => at(120, 0, 'tie'));
+    r
+      ..add('alpha', far)
+      ..add('beta', near)
+      ..add('beta', same);
+    // M-AT2a: the first non-null answer wins.
+    expect(r.registry.attach(['wall-face', 'room-corner'], queryAt(p))!.token,
+        'near');
+    expect(far.queries, hasLength(1));
+    expect(same.queries, hasLength(1));
+    // 'near' (0, -120) and 'tie' (120, 0) are equally far: the earlier
+    // provider wins. M-AT2b: `<` written `<=` (the later wins).
+    expect(r.registry.attach(['room-corner', 'wall-face'], queryAt(p))!.token,
+        'near');
+  });
+
+  test('AT-3 only the asked kinds\' providers are asked; none is null', () {
+    final r = Rig();
+    final wall = RecordingProvider('wall-face', (_) => at(10, 0, 'w'));
+    final corner = RecordingProvider('room-corner', (_) => at(5, 0, 'c'));
+    r
+      ..add('alpha', wall)
+      ..add('alpha', corner);
+    // M-AT3: every provider asked whatever the kinds.
+    expect(r.registry.attach(['wall-face'], queryAt(p))!.token, 'w');
+    expect(corner.queries, isEmpty);
+    expect(r.registry.attach(['ceiling'], queryAt(p)), isNull);
+    expect(r.registry.attach(const [], queryAt(p)), isNull);
+  });
+
+  test(
+      'AT-4 a keep goes only to the provider that made it; the others are '
+      'asked without one', () {
+    final r = Rig();
+    final a = RecordingProvider('wall-face', (_) => at(10, 0, 'a'));
+    final b = RecordingProvider('wall-face', (_) => at(400, 0, 'b'));
+    r
+      ..add('alpha', a)
+      ..add('beta', b);
+    final first = r.registry.attach(['wall-face'], queryAt(p))!;
+    expect(first.token, 'a');
+    r.registry.attach(['wall-face'], queryAt(p, keep: first));
+    // M-AT4: the query passed on unchanged.
+    expect(a.queries.last.keep, same(first));
+    expect(b.queries.last.keep, isNull);
+    // Every other field reaches the provider asked without the keep.
+    final q = b.queries.last;
+    expect(q.pointer, p);
+    expect(q.capture, 160);
+    expect(q.edgeCapture, 100);
+    expect(q.footprint.maxX, 1750);
+    // A keep no provider of this registry made reaches none.
+    final foreign = at(1, 1, 'foreign');
+    r.registry.attach(['wall-face'], queryAt(p, keep: foreign));
+    expect(a.queries.last.keep, isNull);
+    expect(b.queries.last.keep, isNull);
+  });
+
+  test(
+      'AT-5 a throwing provider is no attachment and a hookFailed; the '
+      'others still answer', () {
+    final r = Rig();
+    final broken = ThrowingProvider('wall-face');
+    r
+      ..add('alpha', broken)
+      ..add('beta', RecordingProvider('wall-face', (_) => at(50, 0, 'ok')));
+    // M-AT5: `_ask` calling the provider bare (the error escapes).
+    expect(r.registry.attach(['wall-face'], queryAt(p))!.token, 'ok');
+    expect(broken.calls, 1);
+    expect([for (final d in r.reported) (d.kitId, d.subject, d.code)],
+        [('alpha', 'wall-face', KitDiagnosticCode.hookFailed)]);
+    expect(r.reported.single.error, isA<StateError>());
+  });
+
+  test('AT-6 dispose disposes the Disposable providers and empties it', () {
+    final r = Rig();
+    final d = DisposableProvider('wall-face', (_) => null);
+    r
+      ..add('alpha', d)
+      ..add('alpha', RecordingProvider('room-corner', (_) => null));
+    r.registry.dispose();
+    // M-AT6: dispose leaves the providers alone.
+    expect(d.disposals, 1);
+    expect(r.registry.kinds, isEmpty);
+  });
+
+  test('AT-7 a factory that throws adds nothing and reports hookFailed', () {
+    final r = Rig();
+    r.registry.add('alpha', (_) => throw ArgumentError('no faces'), r.services);
+    r.add('beta', RecordingProvider('room-corner', (_) => null));
+    // M-AT7: `add` without its try/catch.
+    expect(r.registry.kinds, {'room-corner'});
+    expect([for (final d in r.reported) (d.kitId, d.subject, d.code)],
+        [('alpha', 'attachments', KitDiagnosticCode.hookFailed)]);
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/controller/attachment_controller_test.dart b/packages/jet_cad_2d_plan/test/controller/attachment_controller_test.dart
new file mode 100644
index 00000000..b41eb18c
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/controller/attachment_controller_test.dart
@@ -0,0 +1,225 @@
+// Spec P1 "Lifetimes", P3 "Attachment", P4 diagnostics (Task 14), through
+// the controller: the providers run once per document and go with it; a
+// throwing factory or provider is a diagnostic; an attachTo kind no
+// provider offers is a diagnostic; plan.symbol is armed by the gallery's
+// symbol and attaches through a kit's provider; plan.select's move
+// resolver asks the same registry.
+import 'dart:typed_data';
+
+import 'package:flutter/services.dart'
+    show KeyDownEvent, LogicalKeyboardKey, PhysicalKeyboardKey;
+import 'package:flutter/widgets.dart' show KeyEventResult;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_kit/authoring.dart' show Catalog, encodeLibrary;
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:jet_cad_2d_plan/src/tools/plan_symbol_tool.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../support/attach_fixtures.dart';
+import '../support/symbol_fixtures.dart';
+import '../support/tool_events.dart';
+
+Uint8List shelfBytes() => encodeLibrary(Catalog(kit: 'demo', symbols: [
+      box('demo.shelf.wall', 'Wall shelf', 'Storage', ['shelf'],
+          attachTo: ['test-edge'], base: (950, 410)),
+      box('demo.lamp.corner', 'Corner lamp', 'Lighting', ['lamp'],
+          attachTo: ['room-corner'], base: (402.75, 233.5)),
+    ]));
+
+List<(String, String?, KitDiagnosticCode)> problemsOf(PlanController c) => [
+      for (final d in c.diagnostics.value) (d.kitId, d.subject, d.code),
+    ];
+
+KeyDownEvent keyDown(
+        LogicalKeyboardKey logical, PhysicalKeyboardKey physical) =>
+    KeyDownEvent(
+        physicalKey: physical, logicalKey: logical, timeStamp: Duration.zero);
+
+/// The sign of [t]'s linear part's determinant: negative when mirrored.
+double det(Transform2 t) => t.a * t.d - t.b * t.c;
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test(
+      'AT-14 the providers run once per document: a new plan makes new '
+      'ones, disposes the old, and the services see the current registry',
+      () async {
+    final made = <DisposableProvider>[];
+    PlanServices? seen;
+    final c = PlanController(kits: [
+      PlanKit(id: 'demo', version: '1.0.0', attachments: [
+        (services) {
+          seen = services;
+          final p = DisposableProvider('test-edge', (_) => null);
+          made.add(p);
+          return p;
+        },
+      ]),
+    ]);
+    addTearDown(c.dispose);
+    expect(made, hasLength(1));
+    expect(seen!.attachments.kinds, {'test-edge'});
+    c.newPlan();
+    // M-AT14: the per-document registry not disposed on a swap.
+    expect(made, hasLength(2));
+    expect(made.first.disposals, 1);
+    expect(made.last.disposals, 0);
+    expect(seen!.attachments.kinds, {'test-edge'});
+  });
+
+  test('AT-15 a throwing factory is a hookFailed; the plan still opens',
+      () async {
+    final c = PlanController(kits: [
+      PlanKit(id: 'demo', version: '1.0.0', attachments: [
+        (_) => throw StateError('no faces'),
+      ]),
+    ]);
+    addTearDown(c.dispose);
+    expect(problemsOf(c),
+        contains(('demo', 'attachments', KitDiagnosticCode.hookFailed)));
+  });
+
+  test(
+      'AT-16 an attachTo kind no provider offers is one '
+      'attachmentKindUnoffered per kit and kind; an offered one is none',
+      () async {
+    final c = PlanController(kits: [
+      PlanKit(id: 'demo', version: '1.0.0', symbols: [
+        SymbolLibrarySource(label: 'demo', read: () async => shelfBytes()),
+      ], attachments: [
+        (_) => RecordingProvider('test-edge', (_) => null)
+      ]),
+    ]);
+    addTearDown(c.dispose);
+    await settle();
+    // M-AT16: `_reportUnofferedKinds` not called after the load.
+    expect(
+        problemsOf(c)
+            .where((p) => p.$3 == KitDiagnosticCode.attachmentKindUnoffered),
+        [('demo', 'room-corner', KitDiagnosticCode.attachmentKindUnoffered)]);
+    c.newPlan();
+    expect(
+        problemsOf(c)
