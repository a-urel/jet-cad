+    (IndexedColor(30), 35, 90, EntityFlags.unpickable, 0.75),
+    (IndexedColor(5), 13, 45, EntityFlags.unpickable, 3.0),
+    (TrueColor(0x101010), 9, 3, EntityFlags.invisible, 0.5),
+  ];
