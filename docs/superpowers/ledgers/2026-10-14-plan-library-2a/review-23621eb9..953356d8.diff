+/// [e] re-issued at another [version] (same key, same leaves).
+SymbolEntry withVersion(SymbolEntry e, int version) => SymbolEntry(
+      symbol: SymbolComponent(
+          key: e.symbol.key,
+          version: version,
+          name: e.symbol.name,
+          category: e.symbol.category,
+          tags: e.symbol.tags),
+      unit: e.unit,
+      definition: e.definition,
+      leaves: e.leaves,
+    );
