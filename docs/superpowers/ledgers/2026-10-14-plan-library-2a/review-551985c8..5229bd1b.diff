diff --git a/packages/jet_cad_2d_plan/test/fonts/fonts_register_test.dart b/packages/jet_cad_2d_plan/test/fonts/fonts_register_test.dart
new file mode 100644
index 00000000..aeed38f0
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/fonts/fonts_register_test.dart
@@ -0,0 +1,62 @@
+// Spec 14 V-11, review F-3: family `Roboto` measures in the test font until
+// `ensurePlanFonts` registers the bundled face, then measures as those
+// bytes do. Alone in its file, so its process has registered nothing
+// before it measures (a registered face cannot be taken back). Ported from
+// jet_cad_floor_plan (2a Task 9).
+import 'dart:io';
+
+import 'package:flutter/foundation.dart' show FlutterError;
+import 'package:flutter/painting.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_plan/src/fonts/plan_fonts.dart';
+
+class _MapBundle extends CachingAssetBundle {
+  _MapBundle(this.assets);
+
+  final Map<String, Uint8List> assets;
+
+  @override
+  Future<ByteData> load(String key) async {
+    final bytes = assets[key];
+    if (bytes == null) throw FlutterError('no asset $key');
+    return ByteData.sublistView(bytes);
+  }
+}
+
+/// The laid-out width of [text] in [family] at 20 px.
+double _width(String text, String family) {
+  final painter = TextPainter(
+    text: TextSpan(
+        text: text, style: TextStyle(fontFamily: family, fontSize: 20)),
+    textDirection: TextDirection.ltr,
+  )..layout();
+  final width = painter.width;
+  painter.dispose();
+  return width;
+}
+
+void main() {
+  testWidgets(
+      'FR1 Roboto measures in the test font before the registration and in '
+      'the bundled face after it (M-14b1-2)', (tester) async {
+    const sample = 'Masa 12 · Teras İçi';
+    expect(kPlanFontFamily, 'Roboto');
+    final before = _width(sample, kPlanFontFamily);
+    expect(before, _width(sample, 'NoSuchFamily'),
+        reason: 'premise: nothing named Roboto is registered yet');
+
+    final bytes = File('lib/fonts/Roboto-Regular.ttf').readAsBytesSync();
+    await tester.runAsync(() async {
+      // A probe family over the same bytes: what Roboto must measure as.
+      final probe = FontLoader('JetCadRobotoProbe')
+        ..addFont(Future.value(ByteData.sublistView(bytes)));
+      await probe.load();
+      await ensurePlanFonts(_MapBundle(
+          {'packages/jet_cad_2d_plan/lib/fonts/Roboto-Regular.ttf': bytes}));
+    });
+    final after = _width(sample, kPlanFontFamily);
+    expect(after, isNot(before));
+    expect(after, _width(sample, 'JetCadRobotoProbe'));
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/fonts/plan_assets_test.dart b/packages/jet_cad_2d_plan/test/fonts/plan_assets_test.dart
new file mode 100644
index 00000000..d7e41692
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/fonts/plan_assets_test.dart
@@ -0,0 +1,121 @@
+// Spec P5 "Fonts": the plan's font and its licence are the package's
+// assets, read under its `packages/` keys (ported from jet_cad_floor_plan's
+// package_assets_test PA1, PA5), the font is the vendored face byte for
+// byte, and registerFontLicences registers the licence under `Roboto`.
+// PA6 and PA8 (ensurePlanFonts' retry and its one registration) are
+// ported from the same file's V-11 group.
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_plan/src/fonts/plan_fonts.dart';
+
+class _MapBundle extends CachingAssetBundle {
+  _MapBundle(this.assets);
+
+  final Map<String, Uint8List> assets;
+
+  @override
+  Future<ByteData> load(String key) async {
+    final bytes = assets[key];
+    if (bytes == null) throw FlutterError('no asset $key');
+    return ByteData.sublistView(bytes);
+  }
+}
+
+void main() {
+  // Written out, not read from the constants: a key that drifted back to
+  // another package's must turn these red.
+  const fontKey = 'packages/jet_cad_2d_plan/lib/fonts/Roboto-Regular.ttf';
+  const licenceKey = 'packages/jet_cad_2d_plan/assets/fonts/Roboto_LICENSE.txt';
+
+  test('PA1 the constants name the package keys', () {
+    expect(kPlanFontAsset, fontKey);
+    expect(kPlanFontLicenceAsset, licenceKey);
+    expect(kPlanFontFamily, 'Roboto');
+  });
+
+  test('PA5 the pubspec declares the two font assets', () {
+    final pubspec = File('pubspec.yaml').readAsStringSync();
+    for (final asset in const [
+      'lib/fonts/Roboto-Regular.ttf',
+      'assets/fonts/Roboto_LICENSE.txt',
+    ]) {
+      expect(
+          RegExp('^\\s*-\\s+${RegExp.escape(asset)}\\s*\$', multiLine: true)
+              .hasMatch(pubspec),
+          isTrue,
+          reason: asset);
+      expect(File(asset).existsSync(), isTrue, reason: asset);
+    }
+  });
+
+  test('W-F1 the font is the vendored face, byte for byte', () {
+    // M-W-F1: any other file at lib/fonts/Roboto-Regular.ttf.
+    final ours = File('lib/fonts/Roboto-Regular.ttf').readAsBytesSync();
+    final vendored =
+        File('../jet_cad_2d_flutter/test/golden/fonts/Roboto-Regular.ttf')
+            .readAsBytesSync();
+    expect(ours, orderedEquals(vendored));
+    expect(
+        File('assets/fonts/Roboto_LICENSE.txt').readAsStringSync(),
+        File('../jet_cad_2d_flutter/test/golden/fonts/Roboto_LICENSE.txt')
+            .readAsStringSync());
+  });
+
+  test(
+      'W-F2 registerFontLicences adds one entry for Roboto, its text read '
+      'from the given bundle under the package key', () async {
+    LicenseRegistry.reset();
+    addTearDown(LicenseRegistry.reset);
+    registerFontLicences(
+        _MapBundle({licenceKey: utf8.encode('Licence text 7')}));
+    final entries = await LicenseRegistry.licenses.toList();
+    // M-W-F2a: the package named 'roboto' finds nothing here.
+    final roboto = [
+      for (final e in entries)
+        if (e.packages.contains('Roboto')) e
+    ];
+    expect(roboto, hasLength(1));
+    // M-W-F2b: `rootBundle` in place of the given bundle reads the real
+    // licence (or nothing) instead.
+    expect([for (final p in roboto.single.paragraphs) p.text].join('\n'),
+        'Licence text 7');
+  });
+
+  group('V-11 ensurePlanFonts (ported PA6, PA8)', () {
+    // The registration is process-wide: each test starts from none (review
+    // F-3), and every call that reads a bundle runs in real async time.
+    setUp(resetPlanFontsForTest);
+    tearDown(resetPlanFontsForTest);
+
+    Uint8List font() => File('lib/fonts/Roboto-Regular.ttf').readAsBytesSync();
+
+    testWidgets(
+        'PA6 a bundle without the font fails the registration, and the next '
+        'call tries again', (tester) async {
+      await tester.runAsync(() async {
+        await expectLater(
+            ensurePlanFonts(_MapBundle(const {})), throwsA(anything));
+      });
+      // Not held: this call registers from a bundle that has the bytes.
+      final bytes = font();
+      await tester
+          .runAsync(() => ensurePlanFonts(_MapBundle({fontKey: bytes})));
+    });
+
+    testWidgets('PA8 a second call returns the first call\'s future',
+        (tester) async {
+      final bundle = _MapBundle({fontKey: font()});
+      await tester.runAsync(() async {
+        final first = ensurePlanFonts(bundle);
+        expect(ensurePlanFonts(bundle), same(first));
+        expect(ensurePlanFonts(), same(first),
+            reason: 'a later call, whatever its bundle, gets the first');
+        await first;
+      });
+    });
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/l10n/document_separator_test.dart b/packages/jet_cad_2d_plan/test/l10n/document_separator_test.dart
new file mode 100644
index 00000000..7f369790
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/l10n/document_separator_test.dart
@@ -0,0 +1,93 @@
+// Spec Q0 N1 (M-Q0-e): a new plan takes the separator of the language
+// class, not of its language code, and a host's own class settles the
+// controller's empty plan by its separator (controller ruling on NS7:
+// PlanLocaleScope.push reports PlanStrings.of(context) with the locale).
+// Ported from jet_cad_floor_plan's new_plan_separator_test.dart NS7a and
+// NS7 (2a Task 9); the view is a widget that pushes the locale as every
+// widget of the plan library does.
+import 'package:flutter/foundation.dart' show SynchronousFuture;
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:jet_cad_2d_plan/src/l10n/document_separator.dart';
+import 'package:jet_cad_2d_plan/src/l10n/locale_scope.dart';
+
+/// A host's own language (the final review's F-1): English words, French
+/// numbers, so only the class -- not a built-in language of its locale --
+/// can give `,`.
+class _Fr extends PlanStringsEn {
+  const _Fr();
+  @override
+  String get languageCode => 'fr';
+  @override
+  String get decimalSeparator => ',';
+}
+
+class _FrDelegate extends LocalizationsDelegate<PlanStrings> {
+  const _FrDelegate();
+  @override
+  bool isSupported(Locale locale) => true;
+  @override
+  Future<PlanStrings> load(Locale locale) => SynchronousFuture(const _Fr());
+  @override
+  bool shouldReload(_FrDelegate old) => false;
+}
+
+/// A widget of the plan library's shape: it pushes the locale from
+/// didChangeDependencies.
+class _Shows extends StatefulWidget {
+  const _Shows({required this.controller});
+  final PlanController controller;
+  @override
+  State<_Shows> createState() => _ShowsState();
+}
+
+class _ShowsState extends State<_Shows> {
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    PlanLocaleScope.push(context, widget.controller);
+  }
+
+  @override
+  Widget build(BuildContext context) => const SizedBox();
+}
+
+void main() {
+  test(
+      'NS7a documentSeparatorFor reads the class\'s separator, not its '
+      'language code', () {
+    expect(documentSeparatorFor(const _Fr()), DecimalSeparator.comma);
+    expect(documentSeparatorFor(const PlanStringsEn()), DecimalSeparator.point);
+  });
+
+  testWidgets(
+      'NS7 a host\'s own language class settles the empty plan by its '
+      'separator (V-5): French, which no built-in language covers, gives '
+      'comma', (tester) async {
+    await tester.binding.setSurfaceSize(const Size(1440, 900));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final c = PlanController(kits: const []);
+    addTearDown(c.dispose);
+    await tester.pumpWidget(MaterialApp(
+        locale: const Locale('fr'),
+        supportedLocales: const [Locale('fr')],
+        localizationsDelegates: [
+          const _FrDelegate(),
+          ...planLocalizationsDelegates
+              .where((d) => d != PlanLocalizations.delegate),
+        ],
+        home: Scaffold(body: _Shows(controller: c))));
+    await tester.pump();
+    expect(PlanStrings.forLocale(const Locale('fr')).decimalSeparator, '.',
+        reason: 'premise: the built-in language for fr would give point');
+    expect(
+        c.document.components
+            .get<PageComponent>(c.document.rootHandle)!
+            .decimalSeparator,
+        DecimalSeparator.comma);
+    expect(c.document.commands.undoDepth, 0);
+    expect(c.dirty.value, isFalse);
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/l10n/l10n_test.dart b/packages/jet_cad_2d_plan/test/l10n/l10n_test.dart
new file mode 100644
index 00000000..b9265d2b
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/l10n/l10n_test.dart
@@ -0,0 +1,178 @@
+// Spec 14d L2, L11, L12, L15 (revision 2): the language lookup in each of
+// V-4's host set-ups, the panels' numbers, and the search's fold.
+// Ported from jet_cad_floor_plan (2a Task 9).
+import 'package:flutter/foundation.dart' show SynchronousFuture;
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:jet_cad_2d_plan/src/l10n/number_text.dart';
+import 'package:jet_cad_2d_plan/src/l10n/search_fold.dart';
+
+/// The words a widget under [app] sees.
+Future<PlanStrings> wordsUnder(
+    WidgetTester tester, Widget Function(Widget probe) app) async {
+  late PlanStrings seen;
+  await tester.pumpWidget(app(Builder(builder: (context) {
+    seen = PlanStrings.of(context);
+    return const SizedBox();
+  })));
+  return seen;
+}
+
+class _Custom extends PlanStringsTr {
+  const _Custom();
+}
+
+class _CustomDelegate extends LocalizationsDelegate<PlanStrings> {
+  const _CustomDelegate();
+  @override
+  bool isSupported(Locale locale) => true;
+  @override
+  Future<PlanStrings> load(Locale locale) => SynchronousFuture(const _Custom());
+  @override
+  bool shouldReload(_CustomDelegate old) => false;
+}
+
+void main() {
+  testWidgets(
+      'LB1 a host listing the locales and the delegates gets German and '
+      'Turkish; an unlisted language resolves to English (M-14d-b)',
+      (tester) async {
+    for (final (locale, type) in [
+      (const Locale('de'), PlanStringsDe),
+      (const Locale('tr', 'TR'), PlanStringsTr),
+      (const Locale('en', 'GB'), PlanStringsEn),
+      (const Locale('fr'), PlanStringsEn),
+    ]) {
+      final words = await wordsUnder(
+          tester,
+          (probe) => MaterialApp(
+              locale: locale,
+              supportedLocales: planSupportedLocales,
+              localizationsDelegates: planLocalizationsDelegates,
+              home: probe));
+      expect(words.runtimeType, type, reason: '$locale');
+    }
+  });
+
+  testWidgets(
+      'LB2 without the planner\'s delegate the resolved locale still '
+      'chooses (M-14d-b)', (tester) async {
+    for (final (locale, type) in [
+      (const Locale('de'), PlanStringsDe),
+      (const Locale('tr'), PlanStringsTr),
+    ]) {
+      final words = await wordsUnder(
+          tester,
+          (probe) => MaterialApp(
+              locale: locale,
+              supportedLocales: planSupportedLocales,
+              localizationsDelegates: planLocalizationsDelegates
+                  .where((d) => d != PlanLocalizations.delegate),
+              home: probe));
+      expect(words.runtimeType, type, reason: '$locale');
+    }
+  });
+
+  testWidgets(
+      'LB3 a default MaterialApp on a Turkish device resolves to en_US, so '
+      'English (documented, V-4); no Localizations at all is English too',
+      (tester) async {
+    tester.platformDispatcher.localesTestValue = const [Locale('tr', 'TR')];
+    addTearDown(tester.platformDispatcher.clearLocalesTestValue);
+    final words = await wordsUnder(tester, (probe) => MaterialApp(home: probe));
+    expect(words, isA<PlanStringsEn>());
+    final bare = await wordsUnder(
+        tester,
+        (probe) =>
+            Directionality(textDirection: TextDirection.ltr, child: probe));
+    expect(bare, isA<PlanStringsEn>());
+  });
+
+  testWidgets('LB4 a host\'s own delegate wins', (tester) async {
+    final words = await wordsUnder(
+        tester,
+        (probe) => MaterialApp(
+            locale: const Locale('tr'),
+            supportedLocales: planSupportedLocales,
+            localizationsDelegates: [
+              const _CustomDelegate(),
+              ...planLocalizationsDelegates
+                  .where((d) => d != PlanLocalizations.delegate),
+            ],
+            home: probe));
+    expect(words, isA<_Custom>());
+  });
+
+  test('LB5 the built-in languages by code', () {
+    expect(PlanStrings.forLocale(const Locale('de')).languageCode, 'de');
+    expect(PlanStrings.forLocale(const Locale('tr')).languageCode, 'tr');
+    expect(PlanStrings.forLocale(null).languageCode, 'en');
+    expect(const PlanStringsEn().decimalSeparator, '.');
+    expect(const PlanStringsDe().decimalSeparator, ',');
+    expect(const PlanStringsTr().decimalSeparator, ',');
+    // The Page panel's caption (spec Q0 P1; the final review's F-8).
+    expect(const PlanStringsEn().pageDecimalSeparator, 'Decimal separator');
+    expect(const PlanStringsDe().pageDecimalSeparator, 'Dezimaltrennzeichen');
+    expect(const PlanStringsTr().pageDecimalSeparator, 'Ondalık ayırıcı');
+  });
+
+  group('NT the panels\' numbers (L12, L15 as amended, M-14d-f)', () {
+    const en = PlanStringsEn(), de = PlanStringsDe();
+    const tr = PlanStringsTr();
+
+    test('shown with the language\'s separator, never grouped', () {
+      expect(formatPanelNumber(1.5, en), '1.5');
+      expect(formatPanelNumber(1.5, de), '1,5');
+      expect(formatPanelNumber(-2400.125, tr), '-2400,125');
+      expect(formatPanelNumber(1600, de), '1600');
+      expect(formatPanelNumber(-0.0, tr), '-0,0');
+    });
+
+    test('a shown value reads back exactly', () {
+      for (final v in [1.5, -2400.125, 1600.0, 0.1, -0.0, 1e20, 1e300]) {
+        for (final s in [en, de, tr]) {
+          final back = parsePanelNumber(formatPanelNumber(v, s), s)!;
+          expect(back, v, reason: '$v in ${s.languageCode}');
+          expect(back.isNegative, v.isNegative);
+        }
+      }
+    });
+
+    test('the language\'s separator; the other once, unless a grouping', () {
+      final cases = <(String, PlanStrings, double?)>[
+        ('1,5', de, 1.5),
+        (' 1,5 ', tr, 1.5),
+        ('1.5', de, 1.5), // an English keypad on a German UI (V-12)
+        ('1.600', de, null),
+        ('1.234,5', de, null),
+        ('1,2,3', tr, null),
+        ('1.5', en, 1.5),
+        ('1,5', en, 1.5),
+        ('1,600', en, null),
+        ('1,234.5', en, null),
+        ('-0,25', tr, -0.25),
+        ('1e3', de, 1000),
+        ('abc', tr, null),
+      ];
+      for (final (text, s, want) in cases) {
+        expect(parsePanelNumber(text, s), want,
+            reason: '"$text" in ${s.languageCode}');
+      }
+    });
+  });
+
+  test('SF the fold meets either language\'s letters (L11, M-14d-j)', () {
+    expect(searchFold('Köşe kabin'), 'kose kabin');
+    expect(searchFold('ISIK'), searchFold('ışık'));
+    expect(searchFold('İSTANBUL'), 'istanbul');
+    // The web lower-cases `İ` to `i` and a combining dot (the full Unicode
+    // mapping); the VM to `i` alone. Both fold alike.
+    expect(searchFold('i\u0307stanbul'), 'istanbul');
+    expect(searchFold('Kâğıt'), 'kagit');
+    expect(searchFold('Straße'), 'strasse');
+    expect(searchFold('Çay ocağı'), 'cay ocagi');
+    expect(searchFold('Höhe ÜBER'), 'hohe uber');
+    expect(searchFold('booth'), 'booth');
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/l10n/locale_scope_test.dart b/packages/jet_cad_2d_plan/test/l10n/locale_scope_test.dart
new file mode 100644
index 00000000..65932c81
--- /dev/null
+++ b/packages/jet_cad_2d_plan/test/l10n/locale_scope_test.dart
@@ -0,0 +1,173 @@
+// Spec P5 "Words": the widgets push the app's locale into
+// controller.locale, and a kit's KitWords read it live, so a kit's words
+// follow a change of language while mounted; English stands in for a
+// language the kit lacks. A new plan takes the pushed language's decimal
+// separator (today's rule, spec Q0 N1).
+import 'package:flutter/material.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_flutter/jet_cad_2d_flutter.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:jet_cad_2d_plan/jet_cad_2d_plan.dart';
+import 'package:jet_cad_2d_plan/src/l10n/locale_scope.dart';
+
+/// The services the probe tool's factory was given, per test.
+PlanServices? captured;
+
+/// A tool that does nothing: only its factory matters here.
+class _IdleTool extends Tool {
+  @override
+  String get name => 'probe';
+  @override
+  ToolPhase get phase => ToolPhase.idle;
+  @override
+  void onPointerDown(ToolPointerEvent e, ToolContext ctx) {}
+  @override
+  void onPointerMove(ToolPointerEvent e, ToolContext ctx) {}
+  @override
+  void onPointerUp(ToolPointerEvent e, ToolContext ctx) {}
+  @override
+  void onPointerExit(ToolContext ctx) {}
+  @override
+  KeyEventResult onKey(KeyEvent event, ToolContext ctx) =>
+      KeyEventResult.ignored;
+  @override
+  void cancel(ToolContext ctx) {}
+  @override
+  void paintOverlay(Canvas canvas, ViewportTransform camera, Size viewport,
+      PaperPalette paper) {}
+}
+
+/// A kit with one tool, English and Turkish words, no German.
+PlanKit probeKit() => PlanKit(
+      id: 'wkit',
+      version: '1.0.0',
+      tools: [
+        PlanTool(
+            id: 'wkit.probe',
+            icon: Icons.circle_outlined,
+            create: (services) {
+              captured = services;
+              return _IdleTool();
+            }),
+      ],
+      names: const KitNames({
+        'en': {'tool:wkit.probe': 'Probe'},
+        'tr': {'tool:wkit.probe': 'Sonda'},
+      }),
+    );
+
+/// A widget of the plan library's shape: it pushes the locale from
+/// didChangeDependencies, as every widget of Tasks 13 and 15-20 does.
+class _Pusher extends StatefulWidget {
+  const _Pusher({required this.controller});
+  final PlanController controller;
+  @override
+  State<_Pusher> createState() => _PusherState();
+}
+
+class _PusherState extends State<_Pusher> {
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    PlanLocaleScope.push(context, widget.controller);
+  }
+
+  @override
+  Widget build(BuildContext context) => const SizedBox();
+}
+
+Widget appIn(Locale locale, PlanController c) => MaterialApp(
+    locale: locale,
+    supportedLocales: planSupportedLocales,
+    localizationsDelegates: planLocalizationsDelegates,
+    home: _Pusher(controller: c));
+
+void main() {
+  setUp(() => captured = null);
+
+  testWidgets(
+      'W-L1 the app\'s locale reaches controller.locale and a kit\'s words '
+      'follow it while mounted; a language the kit lacks reads English',
+      (tester) async {
+    final c = PlanController(kits: [probeKit()]);
+    addTearDown(c.dispose);
+    c.selectTool('wkit.probe');
+    expect(captured, isNotNull, reason: 'premise: the tool\'s factory ran');
+    final words = captured!.words;
+
+    await tester.pumpWidget(appIn(const Locale('tr'), c));
+    // M-W-L1a: `push` writing nothing (its body removed) leaves 'en'.
+    expect(c.locale.value, const Locale('tr'));
+    // M-W-L1b: Task 8's services built with the locale read once
+    // (`final l = locale.value; KitNamesWords(names, () => l)`) keep the
+    // construction's English here.
+    expect(words.word('tool:wkit.probe'), 'Sonda');
+    expect(words.locale, const Locale('tr'));
+
+    await tester.pumpWidget(appIn(const Locale('de'), c));
+    expect(c.locale.value, const Locale('de'));
+    expect(words.word('tool:wkit.probe'), 'Probe',
+        reason: 'no German word: the English one');
+
+    await tester.pumpWidget(appIn(const Locale('tr'), c));
+    expect(words.word('tool:wkit.probe'), 'Sonda', reason: 'back again, live');
+  });
+
+  testWidgets(
+      'W-L4 a change of language while mounted reaches the listeners after '
+      'the build, never inside it', (tester) async {
+    final c = PlanController(kits: [probeKit()]);
+    addTearDown(c.dispose);
+    await tester.pumpWidget(appIn(const Locale('en'), c));
+    final phases = <SchedulerPhase>[];
+    c.locale.addListener(
+        () => phases.add(SchedulerBinding.instance.schedulerPhase));
+    await tester.pumpWidget(appIn(const Locale('tr'), c));
+    // M-W-L4: `push` calling `controller.reportLocale(…)` at once
+    // notifies inside the frame's build (persistentCallbacks).
+    expect(phases, [SchedulerPhase.postFrameCallbacks]);
+    expect(c.locale.value, const Locale('tr'));
+    await tester.pumpWidget(appIn(const Locale('tr'), c));
+    expect(phases, hasLength(1), reason: 'an unchanged locale writes nothing');
+  });
+
+  testWidgets('W-L2 with no Localizations above, the pushed locale is English',
+      (tester) async {
+    final c = PlanController(kits: [probeKit()]);
+    addTearDown(c.dispose);
+    c.reportLocale(const Locale('tr'));
+    await tester.pumpWidget(Directionality(
+        textDirection: TextDirection.ltr, child: _Pusher(controller: c)));
+    // M-W-L2: `push` returning early when `maybeLocaleOf` is null keeps
+    // 'tr'.
+    expect(c.locale.value, const Locale('en'));
+  });
+
+  test(
+      'W-L3 a new plan takes the separator of the locale\'s built-in '
+      'language: a comma for German and Turkish, a point otherwise', () {
+    final c = PlanController(kits: const []);
+    addTearDown(c.dispose);
+    DecimalSeparator separatorAfterNewPlanIn(Locale locale) {
+      c.reportLocale(locale);
+      c.newPlan();
+      final d = c.document;
+      return d.components.get<PageComponent>(d.rootHandle)!.decimalSeparator;
+    }
+
+    // M-W-L3: `documentSeparatorFor` answering `point` always turns the
+    // first two red.
+    expect(separatorAfterNewPlanIn(const Locale('de')), DecimalSeparator.comma);
+    expect(separatorAfterNewPlanIn(const Locale('tr')), DecimalSeparator.comma);
+    expect(separatorAfterNewPlanIn(const Locale('fr')), DecimalSeparator.point);
+    expect(separatorAfterNewPlanIn(const Locale('en')), DecimalSeparator.point);
+    // An explicit separator wins over the locale.
+    c.reportLocale(const Locale('de'));
+    c.newPlan(decimalSeparator: '.');
+    final d = c.document;
+    expect(d.components.get<PageComponent>(d.rootHandle)!.decimalSeparator,
+        DecimalSeparator.point);
+  });
+}
diff --git a/packages/jet_cad_2d_plan/test/l10n/numbered_names_test.dart b/packages/jet_cad_2d_plan/test/l10n/numbered_names_test.dart
