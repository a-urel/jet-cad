@@ -0,0 +1,48 @@
+// The plan library's localizations (spec P5 "Words"; ported from
+// jet_cad_floor_plan's localizations.dart, spec 14d L2): its delegate, the
+// locales it speaks, and the delegates a host's MaterialApp lists for them.
+import 'package:flutter/foundation.dart' show SynchronousFuture;
+import 'package:flutter/widgets.dart';
+import 'package:flutter_localizations/flutter_localizations.dart';
+
+import 'strings.dart';
+
+/// The locales the plan library speaks: English, German, Turkish.
+const List<Locale> planSupportedLocales = [
+  Locale('en'),
+  Locale('de'),
+  Locale('tr'),
+];
+
+/// The plan library's delegate and Flutter's three, for a host's
+/// `MaterialApp.localizationsDelegates` (a host that lists `de` or `tr` in
+/// `supportedLocales` needs Flutter's, or Material widgets throw).
+const List<LocalizationsDelegate<Object>> planLocalizationsDelegates = [
+  PlanLocalizations.delegate,
+  GlobalMaterialLocalizations.delegate,
+  GlobalWidgetsLocalizations.delegate,
+  GlobalCupertinoLocalizations.delegate,
+];
+
+/// The plan library's [LocalizationsDelegate]: the built-in language of the
+/// resolved locale, English for any other. Optional: without it,
+/// [PlanStrings.of] picks the same language from the locale.
+abstract final class PlanLocalizations {
+  static const LocalizationsDelegate<PlanStrings> delegate =
+      _PlanStringsDelegate();
+}
+
+final class _PlanStringsDelegate extends LocalizationsDelegate<PlanStrings> {
+  const _PlanStringsDelegate();
+
+  /// Every locale: an unknown one is answered in English.
+  @override
+  bool isSupported(Locale locale) => true;
+
+  @override
+  Future<PlanStrings> load(Locale locale) =>
+      SynchronousFuture(PlanStrings.forLocale(locale));
+
+  @override
+  bool shouldReload(_PlanStringsDelegate old) => false;
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/l10n/number_text.dart b/packages/jet_cad_2d_plan/lib/src/l10n/number_text.dart
new file mode 100644
index 00000000..a229edad
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/l10n/number_text.dart
@@ -0,0 +1,36 @@
+// The panels' numbers in a language (spec 14d L12, L15, revision 2): the
+// language's decimal separator, never a grouping; the parser strict about
+// the separator, but tolerant of the other one where a device's keyboard
+// offers only that one and nothing can be misread (V-12).
+// Ported from jet_cad_floor_plan (2a Task 9).
+import 'panel_number.dart';
+import 'strings.dart';
+
+/// [v] as [panelNumberText] shows it, with [strings]' decimal separator.
+String formatPanelNumber(double v, PlanStrings strings) {
+  final text = panelNumberText(v);
+  final sep = strings.decimalSeparator;
+  return sep == '.' ? text : text.replaceAll('.', sep);
+}
+
+final RegExp _threeDigits = RegExp(r'^[0-9]{3}$');
+
+/// [text] read as a number in [strings]' language, or null (V-12): the
+/// language's separator; or the other one, when it occurs once, the
+/// language's does not occur, and it is not followed by exactly three
+/// digits -- `1.5` is 1.5 in German, `1.600` is refused, as `1,600` is in
+/// English. Otherwise as `double.tryParse` reads it.
+double? parsePanelNumber(String text, PlanStrings strings) {
+  final own = strings.decimalSeparator;
+  final other = own == '.' ? ',' : '.';
+  var t = text.trim();
+  if (t.contains(other)) {
+    final parts = t.split(other);
+    if (parts.length != 2 || t.contains(own)) return null;
+    if (_threeDigits.hasMatch(parts[1])) return null;
+    t = '${parts[0]}.${parts[1]}';
+  } else if (own != '.') {
+    t = t.replaceAll(own, '.');
+  }
+  return double.tryParse(t);
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/l10n/numbered_names.dart b/packages/jet_cad_2d_plan/lib/src/l10n/numbered_names.dart
new file mode 100644
index 00000000..55f61334
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/l10n/numbered_names.dart
@@ -0,0 +1,34 @@
+// Names the planner writes once and counts (spec 14d L7): a new layer's
+// `Layer n`, in the language of the moment, the lowest free `n` counted
+// over the names of every built-in language, so a plan edited in two
+// languages never gets `Layer 3` and `Katman 3`.
+// Ported from jet_cad_floor_plan (2a Task 9).
+import 'strings.dart';
+import 'strings_de.dart';
+import 'strings_en.dart';
+import 'strings_tr.dart';
+
+final RegExp _numbered = RegExp(r'^(.*) ([1-9][0-9]*)$');
+
+/// The `n` of [name] when [name] is [pattern]`(n)` in [current] or in a
+/// built-in language, compared by [fold]; otherwise null.
+int? numberedNameIndex(String name,
+    String Function(PlanStrings s, int n) pattern, PlanStrings current,
+    {String Function(String s) fold = _same}) {
+  final m = _numbered.firstMatch(name);
+  if (m == null) return null;
+  final n = int.tryParse(m[2]!);
+  if (n == null) return null;
+  final folded = fold(name);
+  for (final s in <PlanStrings>[
+    current,
+    const PlanStringsEn(),
+    const PlanStringsDe(),
+    const PlanStringsTr(),
+  ]) {
+    if (fold(pattern(s, n)) == folded) return n;
+  }
+  return null;
+}
+
+String _same(String s) => s;
diff --git a/packages/jet_cad_2d_plan/lib/src/l10n/panel_number.dart b/packages/jet_cad_2d_plan/lib/src/l10n/panel_number.dart
new file mode 100644
index 00000000..cc69f1df
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/l10n/panel_number.dart
@@ -0,0 +1,20 @@
+// The panels' number text. Ported from jet_cad_floor_plan (2a Task 9).
+
+/// [v] as the shell shows a stored number: in a Selection panel field, in
+/// the Page panel's scale field and in the status line's scale. The text is
+/// one the fields' parser (`double.tryParse`) reads back as exactly [v],
+/// sign of zero included, so a commit of a shown value writes nothing. A
+/// whole number below 2^53 in magnitude shows without ".0" ("200");
+/// anything else is Dart's shortest round-trip form ("0.1",
+/// "100000000000000000000.0", "1e+300", "-0.0").
+///
+/// Not `v.round()` (fix/post-11): on the VM it saturates at 2^63 - 1, so
+/// 1e20 showed "9223372036854775807". In the Selection panel the focus loss
+/// after Enter wrote a second, silent undo step storing 9.22e18; in the
+/// Page panel a later Enter on the unchanged text did; the status line
+/// read "1:9223372036854775807".
+String panelNumberText(double v) => v.abs() < 9007199254740992 && // 2^53
+        v == v.truncateToDouble() &&
+        !(v == 0 && v.isNegative)
+    ? v.toInt().toString()
+    : v.toString();
diff --git a/packages/jet_cad_2d_plan/lib/src/l10n/search_fold.dart b/packages/jet_cad_2d_plan/lib/src/l10n/search_fold.dart
new file mode 100644
index 00000000..ec8c217e
--- /dev/null
+++ b/packages/jet_cad_2d_plan/lib/src/l10n/search_fold.dart
@@ -0,0 +1,32 @@
+// The symbol search's fold (spec 14d L11, revision 2): both the query and
+// the names are folded, so `kose` finds `Köşe`, `ISIK` finds `ışık`, and
+// either language's letters meet. Search only: never applied to a stored
+// value.
+// Ported from jet_cad_floor_plan (2a Task 9).
+
+const Map<String, String> _fold = {
+  'ı': 'i',
+  '\u0307': '', // the combining dot `İ` lower-cases into
+  'ä': 'a',
+  'ö': 'o',
+  'ü': 'u',
+  'ß': 'ss',
+  'ğ': 'g',
+  'ş': 's',
+  'ç': 'c',
+  'â': 'a',
+  'î': 'i',
+  'û': 'u',
+};
+
+/// [s] lower-cased and folded: `İ`, `I` and `ı` meet at `i`; the German
+/// and Turkish letters meet their plain ones.
+String searchFold(String s) {
+  final lower = s.toLowerCase();
+  final out = StringBuffer();
+  for (final rune in lower.runes) {
+    final c = String.fromCharCode(rune);
+    out.write(_fold[c] ?? c);
+  }
+  return out.toString();
+}
diff --git a/packages/jet_cad_2d_plan/lib/src/l10n/strings.dart b/packages/jet_cad_2d_plan/lib/src/l10n/strings.dart
