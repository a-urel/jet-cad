+          transform: Transform2.translation(at.x, at.y),
+          children: const [])),
+      SetComponentCommand<DiscParams>(h, params),
+      SetComponentCommand<ObjectLayer>(h, ObjectLayer(drawingLayer(doc))),
+    ], label: 'Add disc');
