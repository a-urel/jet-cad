+        0xFF000000 | darkCanvasTone(0x00897B, kDarkCanvasPaper));
+    expect(fillOf('purple').toARGB32(),
+        0xFF000000 | darkCanvasTone(0x8E24AA, kDarkCanvasPaper));
+    expect(fillOf('teal').toARGB32(), isNot(0xFF00897B));
