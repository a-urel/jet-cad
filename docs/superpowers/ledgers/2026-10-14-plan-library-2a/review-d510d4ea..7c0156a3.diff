+        reason: 'premise: refused in German');
+    locale.value = const Locale('en');
+    await tester.pump();
+    await tester.pump();
+    expect(errorOf(tester, field), 'A layer named 0 already exists.');
+    await tester.pump(const Duration(seconds: 1));
+  });
+}
