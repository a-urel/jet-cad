+      final a = leaf.pointAt(0), b = leaf.pointAt(1);
+      for (final t in const [0.0, 0.25, 0.5, 0.75, 1.0]) {
+        samples.add(Vector2(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t));
