index 00000000..b263d464
--- /dev/null
+++ b/packages/jet_cad_2d_kit/test/model/merge_test.dart
@@ -0,0 +1,67 @@
+// Spec K3: several libraries as one. Ported from jet_cad_floor_plan's
+// symbol_sources_test LS1 and SymbolLibrary.merge.
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+
+import '../support/library_fixtures.dart';
+
+/// The fixture library moved under the kit "other": every key and name
+/// renamed in the text, so both libraries decode.
+SymbolLibrary otherLibrary() {
+  final text = utf8
+      .decode(bytesOf(buildValidLibrary()))
+      .replaceAll('"kit":"sample"', '"kit":"other"')
+      .replaceAll('"sample.', '"other.')
+      .replaceAll('"Living Room"', '"Lobby"');
+  return SymbolLibrary.decode(Uint8List.fromList(utf8.encode(text)));
+}
+
+SymbolLibrary sampleLibrary() =>
+    SymbolLibrary.decode(bytesOf(buildValidLibrary()));
+
+void main() {
+  test('M1 entries in order, kits and categories in first appearance', () {
+    final merged = SymbolLibrary.merge([otherLibrary(), sampleLibrary()]);
+    // M-M1: concatenate in reverse.
+    expect([
+      for (final e in merged.entries) e.id
+    ], [
+      'other.sofa.three@3',
+      'other.table.high-top@2',
+      'other.chair.arm@1',
+      'sample.sofa.three@3',
+      'sample.table.high-top@2',
+      'sample.chair.arm@1',
+    ]);
+    expect(merged.kits, ['other', 'sample']);
+    expect(merged.categories, ['Lobby', 'Bar', 'Living Room']);
+  });
+
+  test('M2 a key@version in two libraries names both, by position and kit', () {
+    // M-M2: drop the check; the merge succeeds with six entries.
+    expect(
+        () => SymbolLibrary.merge(
+            [sampleLibrary(), otherLibrary(), sampleLibrary()]),
+        throwsA(isA<SymbolLibraryError>()
+            .having((e) => e.rule, 'rule', 6)
+            .having(
+                (e) => e.message, 'message', contains('sample.sofa.three@3'))
+            .having(
+                (e) => e.message, 'message', contains('library 1 (kit sample)'))
+            .having((e) => e.message, 'message',
+                contains('library 3 (kit sample)'))));
+  });
+
+  test('M3 no library merges to none; one merges to its own entries', () {
+    final none = SymbolLibrary.merge(const []);
+    expect(none.entries, isEmpty);
+    expect(none.kits, isEmpty);
+    final one = SymbolLibrary.merge([sampleLibrary()]);
+    expect([for (final e in one.entries) e.id],
+        [for (final e in sampleLibrary().entries) e.id]);
+    expect(one.kits, ['sample']);
+  });
+}
diff --git a/packages/jet_cad_2d_kit/test/model/register_test.dart b/packages/jet_cad_2d_kit/test/model/register_test.dart
new file mode 100644
index 00000000..55444b49
--- /dev/null
+++ b/packages/jet_cad_2d_kit/test/model/register_test.dart
@@ -0,0 +1,122 @@
+// Spec K2: registerKitComponents registers the four contract components and
+// nothing else; a document carrying them saves and loads typed and
+// byte-identical, and without the registration it is preserved verbatim
+// (ported from jet_cad_floor_plan's symbol_component_test SC7-SC8).
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+SymbolComponent highTop() => SymbolComponent(
+      key: 'sample.table.high-top',
+      version: 2,
+      name: 'High-top table',
+      category: 'Bar',
+      tags: const ['table', 'bar', 'high'],
+      attachTo: const ['wall-face'],
+    );
+
+/// A document off the origin carrying all four components: the manifest and
+/// the library on the root, the symbol and the unit on a definition.
+({DraftDocument doc, Handle def}) withEveryComponent() {
+  final doc = DraftDocument.empty();
+  registerKitComponents(doc.components);
+  doc.header.units = DrawingUnits.millimeters;
+  final def = doc.handleSeed.next();
+  doc.commands.execute(CompoundCommand([
+    AddDefinitionCommand(Definition(
+        handle: def,
+        name: 'sample.table.high-top@2',
+        basePoint: Vector2(1250, 860),
+        children: const [])),
+    SetComponentCommand<SymbolComponent>(def, highTop()),
+    SetComponentCommand<UnitComponent>(
+        def, UnitComponent(kind: UnitKinds.table, capacity: 4)),
+    SetComponentCommand<ManifestComponent>(
+        doc.rootHandle,
+        ManifestComponent(
+            kits: const {'sample': '0.3.1', 'architecture': '0.1.0'})),
+    SetComponentCommand<LibraryComponent>(
+        doc.rootHandle, LibraryComponent(kit: 'sample')),
+    AddEntityCommand(
+      record: EntityRecord(
+        handle: doc.handleSeed.next(),
+        owner: def,
+        kind: EntityKind.line,
+        layer: ReservedHandles.layerZero,
+        linetype: ReservedHandles.byBlockLinetype,
+        linetypeScale: 1.0,
+        geomIndex: 0,
+        color: const ByBlockColor(),
+        lineweight: kByBlock,
+        transparency: kByBlock,
+        flags: 0,
+      ),
+      payload: linePayload(Vector2(950, 560), Vector2(1550, 1160)),
+    ),
+  ], label: 'Every kit component'));
+  doc.commands.clearHistory();
+  return (doc: doc, def: def);
+}
+
+void main() {
+  test('R1 the four components, and nothing else', () {
+    final registry = ComponentRegistry();
+    registerKitComponents(registry);
+    expect(registry.isRegistered<SymbolComponent>(), isTrue);
+    expect(registry.isRegistered<UnitComponent>(), isTrue);
+    expect(registry.isRegistered<LibraryComponent>(), isTrue);
+    expect(registry.isRegistered<ManifestComponent>(), isTrue);
+    // M-R1: call registry.registerBuiltIns() inside registerKitComponents.
+    expect(registry.isRegistered<OriginComponent>(), isFalse);
+    expect(registry.isRegistered<PageComponent>(), isFalse);
+  });
+
+  test('R2 saved and loaded typed, re-encoded byte-identically', () {
+    final r = withEveryComponent();
+    addTearDown(r.doc.dispose);
+    final saved = DraftDocumentCodec.encodeToString(r.doc);
+    final loaded = DraftDocumentCodec.decodeString(saved,
+        registerComponents: registerKitComponents);
+    addTearDown(loaded.dispose);
+    expect(loaded.components.get<SymbolComponent>(r.def), highTop());
+    expect(loaded.components.get<UnitComponent>(r.def),
+        UnitComponent(kind: UnitKinds.table, capacity: 4));
+    expect(loaded.components.get<LibraryComponent>(loaded.rootHandle),
+        LibraryComponent(kit: 'sample'));
+    expect(
+        loaded.components.get<ManifestComponent>(loaded.rootHandle),
+        ManifestComponent(
+            kits: const {'architecture': '0.1.0', 'sample': '0.3.1'}));
+    expect(DraftDocumentCodec.encodeToString(loaded), saved);
+  });
+
+  test('R3 without the registration every component is kept verbatim', () {
+    final r = withEveryComponent();
+    addTearDown(r.doc.dispose);
+    final saved = DraftDocumentCodec.encodeToString(r.doc);
+    final bare = DraftDocumentCodec.decodeString(saved);
+    addTearDown(bare.dispose);
+    expect(bare.components.get<SymbolComponent>(r.def), isNull);
+    expect(bare.components.unknownOf(r.def), hasLength(2));
+    expect(bare.components.unknownOf(bare.rootHandle), hasLength(2));
+    expect(DraftDocumentCodec.encodeToString(bare), saved);
+  });
+
+  test('R4 the components as the file holds them', () {
+    final r = withEveryComponent();
+    addTearDown(r.doc.dispose);
+    final saved = DraftDocumentCodec.encodeToString(r.doc);
+    final root = r.doc.rootHandle.value;
+    expect(
+        saved,
+        contains('"jetcad.unit":{"${r.def.value}":'
+            '{"capacity":4,"kind":"table","labelling":"numbered"}}'));
+    expect(
+        saved,
+        contains('"jetcad.manifest":{"$root":{"format":1,'
+            '"kits":{"architecture":"0.1.0","sample":"0.3.1"}}}'));
+    expect(saved,
+        contains('"jetcad.library":{"$root":{"format":1,"kit":"sample"}}'));
+  });
+}
diff --git a/packages/jet_cad_2d_kit/test/model/symbol_component_test.dart b/packages/jet_cad_2d_kit/test/model/symbol_component_test.dart
new file mode 100644
index 00000000..e56dc0c5
--- /dev/null
+++ b/packages/jet_cad_2d_kit/test/model/symbol_component_test.dart
@@ -0,0 +1,219 @@
+// Spec K2: the symbol identity. Every field refused in the constructor
+// (ArgumentError, never an assert), every field in equality, a pinned JSON
+// text, fromJson refusals one field at a time (ported from
+// jet_cad_floor_plan's symbol_component_test SC1-SC6).
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+
+/// Every field away from its default: version 3, three unsorted tags, two
+/// attachment kinds, a family.
+SymbolComponent sofa({
+  String key = 'sample.sofa.three',
+  int version = 3,
+  String name = 'Three-seat sofa',
+  String category = 'Living Room',
+  List<String> tags = const ['sofa', 'seating', 'couch'],
+  List<String> attachTo = const ['wall-face', 'room-corner'],
+  String? family = 'sofa-long',
+  bool noFamily = false,
+}) =>
+    SymbolComponent(
+      key: key,
+      version: version,
+      name: name,
+      category: category,
+      tags: tags,
+      attachTo: attachTo,
+      family: noFamily ? null : family,
+    );
+
+Matcher refusedOn(String field) =>
+    throwsA(isA<ArgumentError>().having((e) => e.name, 'name', field));
+
+const Map<String, Object?> full = {
+  'attachTo': ['wall-face', 'room-corner'],
+  'category': 'Living Room',
+  'family': 'sofa-long',
+  'key': 'sample.sofa.three',
+  'name': 'Three-seat sofa',
+  'tags': ['sofa', 'seating', 'couch'],
+  'version': 3,
+};
+
+void main() {
+  group('value semantics', () {
+    test('C1 equality sees every field, each differing once', () {
+      expect(sofa(), sofa());
+      expect(sofa().hashCode, sofa().hashCode);
+      expect(sofa(), isNot(sofa(key: 'sample.sofa.four')));
+      expect(sofa(), isNot(sofa(version: 4)));
+      expect(sofa(), isNot(sofa(name: 'Four-seat sofa')));
+      expect(sofa(), isNot(sofa(category: 'Office')));
+      expect(sofa(), isNot(sofa(tags: const ['sofa', 'seating'])));
+      // M-C1 (the spec's own): drop attachTo from == and this goes red.
+      expect(sofa(), isNot(sofa(attachTo: const ['wall-face'])));
+      expect(sofa(), isNot(sofa(family: 'sofa-short')));
+      expect(sofa(), isNot(sofa(noFamily: true)));
+    });
+
+    test('C2 tag and attachment order matter', () {
+      expect(sofa(), isNot(sofa(tags: const ['couch', 'sofa', 'seating'])));
+      expect(sofa(), isNot(sofa(attachTo: const ['room-corner', 'wall-face'])));
+    });
+
+    test('C3 tags and attachTo are unmodifiable copies', () {
+      final tags = ['sofa', 'seating', 'couch'];
+      final kinds = ['wall-face'];
+      final s = sofa(tags: tags, attachTo: kinds);
+      tags[0] = 'mutated';
+      kinds[0] = 'mutated';
+      expect(s.tags, ['sofa', 'seating', 'couch']);
+      expect(s.attachTo, ['wall-face']);
+      expect(() => s.tags.add('x'), throwsUnsupportedError);
+      expect(() => s.attachTo.add('x'), throwsUnsupportedError);
+    });
+
+    test('C4 id is key@version and typeId is jetcad.symbol', () {
+      expect(sofa().id, 'sample.sofa.three@3');
+      expect(sofa().typeId, 'jetcad.symbol');
+      expect(SymbolComponent.componentTypeId, 'jetcad.symbol');
+    });
+  });
+
+  group('constructor refusals, named by field', () {
+    final cases = <String, (String, SymbolComponent Function())>{
+      'a key of two segments': ('key', () => sofa(key: 'sample.sofa')),
+      'an upper-case key': ('key', () => sofa(key: 'sample.Sofa.three')),
+      'a key with a space': ('key', () => sofa(key: 'sample.sofa three.x')),
+      'a key whose kit id has a hyphen': (
+        'key',
+        () => sofa(key: 'my-kit.sofa.three')
+      ),
+      'version 0': ('version', () => sofa(version: 0)),
+      'version -2': ('version', () => sofa(version: -2)),
+      'an empty name': ('name', () => sofa(name: '')),
+      'a blank name': ('name', () => sofa(name: '   ')),
+      'an empty category': ('category', () => sofa(category: '')),
+      'an upper-case tag': (
+        'tags',
+        () => sofa(tags: const ['sofa', 'Seating'])
+      ),
+      'an empty tag': ('tags', () => sofa(tags: const ['sofa', ''])),
+      'a tag with outer white space': (
+        'tags',
+        () => sofa(tags: const ['sofa', ' couch'])
+      ),
+      'a repeated tag': ('tags', () => sofa(tags: const ['sofa', 'x', 'sofa'])),
+      'an upper-case target kind': (
+        'attachTo',
+        () => sofa(attachTo: const ['Wall-face'])
+      ),
+      'a target kind with a space': (
+        'attachTo',
+        () => sofa(attachTo: const ['wall face'])
+      ),
+      'a repeated target kind': (
+        'attachTo',
+        () => sofa(attachTo: const ['wall-face', 'wall-face'])
+      ),
+      'an upper-case family': ('family', () => sofa(family: 'Sofa-long')),
+      'an empty family': ('family', () => sofa(family: '')),
+      'a family with a double hyphen': (
+        'family',
+        () => sofa(family: 'sofa--long')
+      ),
+    };
+    // M-C5: delete any one check of the constructor; its case goes red.
+    for (final MapEntry(key: what, value: (field, make)) in cases.entries) {
+      test('C5 $what is refused on "$field"', () {
+        expect(make, refusedOn(field));
+      });
+    }
+
+    test('C6 the allowed edges are accepted', () {
+      expect(sofa(version: 1).version, 1);
+      // Review Focus 2. M-C6: an ASCII-only tag pattern refuses these.
+      expect(sofa(tags: const ['bar stool', 'çocuk', 'ışık']).tags,
+          ['bar stool', 'çocuk', 'ışık']);
+      expect(sofa(tags: const []).tags, isEmpty);
+      expect(sofa(attachTo: const []).attachTo, isEmpty);
+      expect(sofa(noFamily: true).family, isNull);
+      expect(sofa(key: 'sample.table.high-top.x2').key,
+          'sample.table.high-top.x2');
+    });
+  });
+
+  group('JSON', () {
+    test('C7 the key order and the text are pinned', () {
+      expect(sofa().toJson().keys.toList(),
+          ['attachTo', 'category', 'family', 'key', 'name', 'tags', 'version']);
+      // M-C7: write the keys in declaration order; the text differs.
+      expect(
+          jsonEncode(sofa().toJson()),
+          '{"attachTo":["wall-face","room-corner"],"category":"Living Room",'
+          '"family":"sofa-long","key":"sample.sofa.three",'
+          '"name":"Three-seat sofa","tags":["sofa","seating","couch"],'
+          '"version":3}');
+      expect(jsonEncode(sofa(noFamily: true).toJson()),
+          contains('"family":null,'));
+    });
+
+    test('C8 fromJson reads back what toJson wrote', () {
+      for (final s in [sofa(), sofa(noFamily: true, attachTo: const [])]) {
+        final back = SymbolComponent.fromJson(
+            (jsonDecode(jsonEncode(s.toJson())) as Map)
+                .cast<String, Object?>());
+        expect(back, s);
+      }
+      expect(SymbolComponent.fromJson(full), sofa());
+    });
+
+    // M-C9: a default in place of any one missing field turns its case red.
+    for (final field in full.keys) {
+      test('C9 fromJson refuses a map without "$field"', () {
+        final json = {...full}..remove(field);
+        expect(
+            () => SymbolComponent.fromJson(json),
+            throwsA(isA<FormatException>()
+                .having((e) => e.message, 'message', contains('"$field"'))));
+      });
+    }
+
+    final mistyped = <String, Object?>{
+      'version': '3',
+      'tags': 'sofa',
+      'attachTo': null,
+      'family': 4,
+      'key': 7,
+    };
+    // M-C10: an `as` cast in place of the type check throws a TypeError.
+    for (final MapEntry(key: field, value: value) in mistyped.entries) {
+      test('C10 fromJson refuses "$field": $value with a FormatException', () {
+        expect(() => SymbolComponent.fromJson({...full, field: value}),
+            throwsFormatException);
+      });
+    }
+    test('C10 a tag that is not a string is a FormatException', () {
+      expect(
+          () => SymbolComponent.fromJson({
+                ...full,
+                'tags': ['sofa', 3],
+              }),
+          throwsFormatException);
+    });
+
+    test("C11 a pattern refusal on read is the constructor's ArgumentError",
+        () {
+      expect(
+          () => SymbolComponent.fromJson({...full, 'key': 'Sample.sofa.three'}),
+          refusedOn('key'));
+    });
+
+    test('C12 a field this build does not know is ignored', () {
+      // Review Focus 3. M-C12: refuse unknown keys; this goes red.
+      expect(SymbolComponent.fromJson({...full, 'newerField': 1}), sofa());
+    });
+  });
+}
diff --git a/packages/jet_cad_2d_kit/test/model/symbol_library_test.dart b/packages/jet_cad_2d_kit/test/model/symbol_library_test.dart
new file mode 100644
index 00000000..b8719719
--- /dev/null
+++ b/packages/jet_cad_2d_kit/test/model/symbol_library_test.dart
@@ -0,0 +1,583 @@
+// Spec K3: the library validator. Every rule has one-fault cases, each a
+// single edit of a valid library's codec JSON (so a case can only go red
+// through its own rule), and positive controls proving no rule is
+// over-strict. Each refusal pins its rule number.
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:jet_cad_2d_kit/jet_cad_2d_kit.dart';
+
+import '../support/library_fixtures.dart';
+
+/// Stands for a non-finite number: JSON has none, but `jsonDecode` reads
+/// `1e999` as infinity, so the sentinel is replaced in the text.
+const double kSentinel = 7777.125;
+const Map<String, String> kInfinity = {'7777.125': '1e999'};
+const Map<String, String> kNegInfinity = {'7777.125': '-1e999'};
+
+String hex(int handle) => Handle(handle).toHex();
+
+/// Decoding [bytes] throws a [SymbolLibraryError] of [rule] whose message
+/// holds every one of [parts].
+void expectRefused(Uint8List bytes, int rule, List<String> parts) {
+  try {
+    SymbolLibrary.decode(bytes);
+  } on SymbolLibraryError catch (e) {
+    expect(e.rule, rule, reason: 'message: ${e.message}');
+    for (final p in parts) {
+      expect(e.message, contains(p), reason: 'message: ${e.message}');
+    }
+    return;
+  }
+  fail('the library was accepted; expected rule $rule naming $parts');
+}
+
+int ownerOf(Object? entity) =>
+    ((entity! as Map)['record']! as Map)['owner']! as int;
+
+int handleOf(Object? entity) =>
+    ((entity! as Map)['record']! as Map)['handle']! as int;
+
+void main() {
+  group('a valid library', () {
+    test('V0a every entry equals what was built, in definition order', () {
+      final lib = SymbolLibrary.decode(bytesOf(buildValidLibrary()));
+      expect(lib.kits, ['sample']);
+      // M-V0a: sort the entries by key instead of definition order. (Entries
+      // in component order would survive: withComponent ascends by handle,
+      // the same order as the definitions.)
+      expect([
+        for (final e in lib.entries) e.id
+      ], [
+        'sample.sofa.three@3',
+        'sample.table.high-top@2',
+        'sample.chair.arm@1',
+      ]);
+      final built = buildValidLibrary();
+      addTearDown(built.dispose);
+      final want = {
+        sofaDef: (sofaSymbol(), null, 900.0, 400.0),
+        tableDef: (tableSymbol(), tableUnit(), 1250.0, 860.0),
+        armchairDef: (armchairSymbol(), null, 510.0, 35.0),
+      };
+      for (final e in lib.entries) {
+        final (symbol, unit, bx, by) = want[e.definition.handle]!;
+        expect(e.symbol, symbol);
+        // M-V0a2: an entry without its unit.
+        expect(e.unit, unit);
+        expect(e.definition.name, symbol.id);
+        expect(e.definition.basePoint.x, bx);
+        expect(e.definition.basePoint.y, by);
+        expect(e.definition, built.tree.definition(e.definition.handle));
