diff --git a/packages/jet_cad_2d_kit/lib/src/authoring/builder.dart b/packages/jet_cad_2d_kit/lib/src/authoring/builder.dart
new file mode 100644
index 00000000..8e107dcc
--- /dev/null
+++ b/packages/jet_cad_2d_kit/lib/src/authoring/builder.dart
@@ -0,0 +1,133 @@
+// The library builder (spec K6): a catalog in, a library document out, one
+// definition per symbol named key@version, in one compound command. Ported
+// from jet_cad_floor_plan's build_library.dart.
+//
+// The document is DraftDocument.empty, the kit components and millimetre
+// units, nothing else (not prepareDocument: its DASHED linetype is not in
+// K3's list).
+//
+// Pure Dart: no Flutter, no dart:io.
+import 'dart:async';
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:jet_cad_2d/jet_cad_2d.dart';
+import 'package:vector_math/vector_math_64.dart' show Vector2;
+
+import '../model/library_component.dart';
+import '../model/register.dart';
+import '../model/symbol_component.dart';
+import '../model/symbol_library.dart';
+import '../model/unit_component.dart';
+import 'catalog.dart';
+
+/// The library document of [catalog]. Deterministic: handles ascend in
+/// catalog order (a definition, its leaves, the next definition). Every leaf
+/// is on layer 0 with BYBLOCK linetype, colour, lineweight and transparency
+/// and no flag (K3 rule 14). The caller disposes the document.
+///
+/// Throws a component's [ArgumentError] for a value spec K2 refuses.
+DraftDocument buildLibraryDocument(Catalog catalog) {
+  // Every component is constructed, and so validated, before the document
+  // exists: a value K2 refuses throws here and leaves nothing to dispose.
+  final library = LibraryComponent(kit: catalog.kit);
+  final symbols = [
+    for (final s in catalog.symbols)
+      SymbolComponent(
+        key: s.key,
+        version: s.version,
+        name: s.name,
+        category: s.category,
+        tags: s.tags,
+        attachTo: s.attachTo,
+        family: s.family,
+      ),
+  ];
+  final units = [
+    for (final s in catalog.symbols)
+      if (s.unit case final unit?)
+        UnitComponent(
+            kind: unit.kind, capacity: unit.capacity, labelling: unit.labelling)
+      else
+        null,
+  ];
+  final doc = DraftDocument.empty();
+  registerKitComponents(doc.components);
+  doc.header.units = DrawingUnits.millimeters;
+  final commands = <DraftCommand>[
+    SetComponentCommand<LibraryComponent>(doc.rootHandle, library),
+  ];
+  for (var i = 0; i < catalog.symbols.length; i++) {
+    final s = catalog.symbols[i];
+    final def = doc.handleSeed.next();
+    commands
+      ..add(AddDefinitionCommand(Definition(
+        handle: def,
+        name: s.id,
+        basePoint: Vector2(s.base.$1, s.base.$2),
+        children: const [],
+      )))
+      ..add(SetComponentCommand<SymbolComponent>(def, symbols[i]));
+    final unit = units[i];
+    if (unit != null) {
+      commands.add(SetComponentCommand<UnitComponent>(def, unit));
+    }
+    for (final shape in s.shapes) {
+      commands.add(AddEntityCommand(
+        record: EntityRecord(
+          handle: doc.handleSeed.next(),
+          owner: def,
+          kind: _kindOf(shape),
+          layer: ReservedHandles.layerZero,
+          linetype: ReservedHandles.byBlockLinetype,
+          linetypeScale: 1.0,
+          geomIndex: 0,
+          color: const ByBlockColor(),
+          lineweight: kByBlock,
+          transparency: kByBlock,
+          flags: 0,
+        ),
+        payload: _payloadOf(shape),
+      ));
+    }
+  }
+  doc.commands.execute(CompoundCommand(commands, label: 'Symbol library'));
+  doc.commands.clearHistory();
+  return doc;
+}
+
+/// The `.jetlib` bytes of [catalog]: the codec's JSON of
+/// [buildLibraryDocument], UTF-8. The same catalog gives the same bytes.
+///
+/// Decodes its own output: throws the [SymbolLibraryError] of a catalog the
+/// format refuses, so a generator never writes such a library.
+Uint8List encodeLibrary(Catalog catalog) {
+  final doc = buildLibraryDocument(catalog);
+  try {
+    final bytes =
+        Uint8List.fromList(utf8.encode(DraftDocumentCodec.encodeToString(doc)));
+    SymbolLibrary.decode(bytes);
+    return bytes;
+  } finally {
+    unawaited(doc.dispose());
+  }
+}
+
+EntityKind _kindOf(CatalogShape shape) => switch (shape) {
+      CatalogLine() => EntityKind.line,
+      CatalogPolyline() => EntityKind.polyline,
+      CatalogCircle() => EntityKind.circle,
+      CatalogArc() => EntityKind.arc,
+    };
+
+Vector2 _v(CatalogPoint p) => Vector2(p.$1, p.$2);
+
+GeometryPayload _payloadOf(CatalogShape shape) => switch (shape) {
+      CatalogLine(:final from, :final to) => linePayload(_v(from), _v(to)),
+      CatalogPolyline(:final points, :final closed) =>
+        polylinePayload([for (final p in points) _v(p)], closed: closed),
+      CatalogCircle(:final center, :final radius) =>
+        circlePayload(_v(center), radius),
+      CatalogArc(:final center, :final radius, :final start, :final sweep) =>
+        arcPayload(_v(center), radius, start, sweep),
+    };
diff --git a/packages/jet_cad_2d_kit/lib/src/authoring/catalog.dart b/packages/jet_cad_2d_kit/lib/src/authoring/catalog.dart
new file mode 100644
index 00000000..df260219
--- /dev/null
+++ b/packages/jet_cad_2d_kit/lib/src/authoring/catalog.dart
@@ -0,0 +1,99 @@
+// The catalog language (spec K6): a kit's symbols as plain data, in
+// millimetres, each in its own frame. Geometry only: lines, polylines,
+// circles and arcs. Replaces jet_cad_floor_plan's FurnitureSymbol and
+// FurnitureShape.
+//
+// Pure Dart: no Flutter, no dart:io.
+import '../model/unit_component.dart';
+
+/// A point, (x, y) in millimetres.
+typedef CatalogPoint = (double, double);
+
+/// One drawn shape of a symbol.
+sealed class CatalogShape {
+  const CatalogShape();
+}
+
+final class CatalogLine extends CatalogShape {
+  const CatalogLine(this.from, this.to);
+
+  final CatalogPoint from;
+  final CatalogPoint to;
+}
+
+/// A polyline through [points]; [closed] repeats the first point.
+final class CatalogPolyline extends CatalogShape {
+  const CatalogPolyline(this.points, {this.closed = false});
+
+  final List<CatalogPoint> points;
+  final bool closed;
+}
+
+final class CatalogCircle extends CatalogShape {
+  const CatalogCircle(this.center, this.radius);
+
+  final CatalogPoint center;
+  final double radius;
+}
+
+/// A counter-clockwise arc from [start] through [sweep], both in radians.
+final class CatalogArc extends CatalogShape {
+  const CatalogArc(this.center, this.radius, this.start, this.sweep);
+
+  final CatalogPoint center;
+  final double radius;
+  final double start;
+  final double sweep;
+}
+
+/// A symbol's service unit (umbrella A6).
+final class CatalogUnit {
+  const CatalogUnit({
+    required this.kind,
+    required this.capacity,
+    this.labelling = UnitLabelling.numbered,
+  });
+
+  final String kind;
+  final int capacity;
+  final UnitLabelling labelling;
+}
+
+/// One symbol of a kit's library. A unit draws its outline first (K3 rule
+/// 11): a closed polyline or a circle.
+final class CatalogSymbol {
+  const CatalogSymbol({
+    required this.key,
+    this.version = 1,
+    required this.name,
+    required this.category,
+    this.tags = const [],
+    this.attachTo = const [],
+    this.family,
+    this.unit,
+    required this.base,
+    required this.shapes,
+  });
+
+  final String key;
+  final int version;
+  final String name;
+  final String category;
+  final List<String> tags;
+  final List<String> attachTo;
+  final String? family;
+  final CatalogUnit? unit;
+  final CatalogPoint base;
+  final List<CatalogShape> shapes;
+
+  /// `key@version`.
+  String get id => '$key@$version';
+}
+
+/// A kit's symbols, in library order.
+final class Catalog {
+  const Catalog({required this.kit, required this.symbols});
+
+  final String kit;
+  final List<CatalogSymbol> symbols;
+}
diff --git a/packages/jet_cad_2d_kit/lib/src/authoring/conformance.dart b/packages/jet_cad_2d_kit/lib/src/authoring/conformance.dart
new file mode 100644
index 00000000..98a64124
--- /dev/null
+++ b/packages/jet_cad_2d_kit/lib/src/authoring/conformance.dart
@@ -0,0 +1,188 @@
+// The conformance test (spec K7, umbrella A16): a kit's own test calls it
+// and expects an empty list. It holds the kit to its committed library, its
+// committed geometry snapshot and its words.
+//
+// Pure Dart: no Flutter, no dart:io.
+import 'dart:typed_data';
+
+import 'package:jet_cad_2d/jet_cad_2d.dart' show listEquals;
+
+import '../model/kit_ids.dart';
+import '../model/kit_names.dart';
+import '../model/kit_problem.dart';
+import '../model/symbol_library.dart';
+import 'builder.dart';
+import 'catalog.dart';
+import 'snapshot.dart';
+
+/// The problems of a kit: its [catalog], its [committedLibrary] bytes, its
+/// [committedSnapshot] text, its [names] and its declared non-English
+/// [locales]. [sameAsEnglish] lists, per locale, the word ids whose right
+/// word is the English one. Empty when the kit conforms.
+///
+/// Throws [ArgumentError] when [locales] lists English: English is always
+/// required, by stored text or by words.
+List<KitProblem> conformance({
+  required Catalog catalog,
+  required Uint8List committedLibrary,
+  required String committedSnapshot,
+  required KitNames names,
+  required List<String> locales,
+  Map<String, Set<String>> sameAsEnglish = const {},
+}) {
+  if (locales.contains(KitNames.english)) {
+    throw ArgumentError.value(locales, 'locales',
+        "lists the kit's other locales; English is always required");
+  }
+  final problems = _catalogProblems(catalog);
+  if (problems.isNotEmpty) return problems;
+  final Uint8List built;
+  try {
+    built = encodeLibrary(catalog);
+  } catch (e) {
+    return [
+      KitProblem(
+          KitProblemCode.catalogInvalid, 'the catalog does not build: $e'),
+    ];
+  }
+  if (!listEquals(built, committedLibrary)) {
+    problems.add(const KitProblem(KitProblemCode.builtDiffers,
+        "the committed library is not the catalog's: run the kit's generator"));
+  }
+  try {
+    final library = SymbolLibrary.decode(committedLibrary);
+    if (library.kits.single != catalog.kit) {
+      problems.add(KitProblem(
+          KitProblemCode.libraryKitMismatch,
+          'the committed library holds the kit "${library.kits.single}", not '
+          '"${catalog.kit}"'));
+    }
+  } on SymbolLibraryError catch (e) {
+    problems.add(KitProblem(KitProblemCode.libraryInvalid,
+        'the committed library is refused, rule ${e.rule}: ${e.message}'));
+  }
+  problems
+    ..addAll(_snapshotProblems(catalog, committedSnapshot))
+    ..addAll(_wordProblems(catalog, names, locales, sameAsEnglish));
+  return problems;
+}
+
+/// Checks 3 and 6, on the catalog itself: keys under the kit, lower case.
+List<KitProblem> _catalogProblems(Catalog catalog) {
+  final problems = <KitProblem>[];
+  void lower(CatalogSymbol s, String what, String value) {
+    if (value != value.toLowerCase()) {
+      problems.add(KitProblem(KitProblemCode.notLowerCase,
+          '${s.id}: the $what "$value" is not lower case'));
+    }
+  }
+
+  for (final s in catalog.symbols) {
+    lower(s, 'key', s.key);
+    for (final tag in s.tags) {
+      lower(s, 'tag', tag);
+    }
+    for (final kind in s.attachTo) {
+      lower(s, 'target kind', kind);
+    }
+    final family = s.family;
+    if (family != null) lower(s, 'family', family);
+    final unit = s.unit;
+    if (unit != null) lower(s, 'unit kind', unit.kind);
+    if (kitOfKey(s.key) != catalog.kit) {
+      problems.add(KitProblem(KitProblemCode.keyOutsideKit,
+          '${s.id} is not under the kit "${catalog.kit}"'));
+    }
+  }
+  return problems;
+}
+
+/// Check 4: every committed entry is in the current snapshot and equal to
+/// it; every current entry is committed.
+List<KitProblem> _snapshotProblems(Catalog catalog, String text) {
+  final Map<String, String> committed;
+  try {
+    committed = parseSnapshot(text);
+  } on FormatException catch (e) {
+    return [
+      KitProblem(KitProblemCode.snapshotUnreadable,
+          'the committed snapshot is not readable: ${e.message}'),
+    ];
+  }
+  final current = geometrySnapshot(catalog);
+  final problems = <KitProblem>[];
+  for (final MapEntry(key: id, value: was) in committed.entries) {
+    final now = current[id];
+    if (now == null) {
+      problems.add(KitProblem(KitProblemCode.keyRemoved,
+          '$id is committed but not in the catalog: a key is never removed'));
+    } else if (now != was) {
+      problems.add(KitProblem(
+          KitProblemCode.snapshotChanged,
+          '$id changed its geometry or its unit; a published key@N never '
+          'does: add the change at a new version.\n'
+          '  committed: $was\n'
+          '  current:   $now'));
+    }
+  }
+  for (final id in current.keys) {
+    if (!committed.containsKey(id)) {
+      problems.add(KitProblem(KitProblemCode.snapshotMissing,
+          "$id is not in the committed snapshot: run the kit's generator"));
+    }
+  }
+  return problems;
+}
+
+/// Check 5: every declared locale complete, no word the catalog lacks, no
+/// undeclared locale.
+List<KitProblem> _wordProblems(Catalog catalog, KitNames names,
+    List<String> locales, Map<String, Set<String>> sameAsEnglish) {
+  // The English of each word id: a key's newest version's name, a
+  // category's own text.
+  final newest = <String, int>{};
+  final english = <String, String>{};
+  for (final s in catalog.symbols) {
+    if (s.version >= (newest[s.key] ?? 0)) {
+      newest[s.key] = s.version;
+      english[KitNames.symbolWord(s.key)] = s.name;
+    }
+  }
+  for (final s in catalog.symbols) {
+    english[KitNames.categoryWord(catalog.kit, s.category)] = s.category;
+  }
+
+  final problems = <KitProblem>[];
+  for (final locale in names.words.keys) {
+    if (locale != KitNames.english && !locales.contains(locale)) {
+      problems.add(KitProblem(KitProblemCode.localeUndeclared,
+          '$locale has words but is not declared: a declared locale is complete'));
+    }
+  }
+  for (final MapEntry(key: locale, value: words) in names.words.entries) {
+    for (final id in words.keys) {
+      final ours = id.startsWith('symbol:') || id.startsWith('category:');
+      if (ours && !english.containsKey(id)) {
+        problems.add(KitProblem(KitProblemCode.wordOrphan,
+            '$locale: "$id" names nothing in the catalog'));
+      }
+    }
+  }
+  for (final locale in locales) {
+    final words = names.words[locale] ?? const <String, String>{};
+    final allowed = sameAsEnglish[locale] ?? const <String>{};
+    for (final MapEntry(key: id, value: en) in english.entries) {
+      final word = words[id];
+      if (word == null) {
+        problems.add(KitProblem(
+            KitProblemCode.wordMissing, '$locale: no word for "$id"'));
+      } else if (word == en && !allowed.contains(id)) {
+        problems.add(KitProblem(
+            KitProblemCode.wordUntranslated,
+            '$locale: "$id" is its English, "$en"; list it in sameAsEnglish '
+            'if that is the right word'));
+      }
+    }
+  }
+  return problems;
+}
diff --git a/packages/jet_cad_2d_kit/lib/src/authoring/shapes.dart b/packages/jet_cad_2d_kit/lib/src/authoring/shapes.dart
new file mode 100644
index 00000000..28a6a2e1
--- /dev/null
+++ b/packages/jet_cad_2d_kit/lib/src/authoring/shapes.dart
@@ -0,0 +1,101 @@
+// The shared shape helpers (spec K6): the chair, chairs around a round top,
+// the stool, rectangles, as today's furniture and restaurant catalogs copy
+// them. Ported from jet_cad_restaurant_symbols' shapes.dart. A helper is a
+// convenience for kit authors, not the runtime contract: changing one never
+// changes a published key@N (K7 holds every kit to its committed geometry).
+//
+// Pure Dart: no Flutter, no dart:io.
+import 'dart:math' as math;
+
+import 'catalog.dart';
+
+/// A chair's side, in millimetres.
+const double chairSize = 450;
+
+/// How deep a chair sits under its table's edge.
+const double chairTuck = 100;
+
+/// A bar stool's seat radius (Ø 380).
+const double stoolRadius = 190;
+
+/// How far a stool's seat reaches under its top's edge.
+const double stoolTuck = 40;
+
+/// The back line's distance in from a chair's outer edge.
+const double _chairBack = 60;
+
+/// A bar stool's footrest ring radius (Ø 300).
+const double _footrestRadius = 150;
+
+/// [v] rounded to 1e-6 mm, with -0 made 0: the dust of a rotation (1e-13
+/// off a whole millimetre) never reaches a library. A sub-micrometre value
+/// is never meaningful in a symbol.
+double cleanCoordinate(double v) {
+  final r = (v * 1e6).roundToDouble() / 1e6;
+  return r == 0 ? 0 : r;
+}
+
+CatalogPoint _p(double x, double y) => (cleanCoordinate(x), cleanCoordinate(y));
+
+/// A closed axis-aligned rectangle from ([x], [y]), [w] wide and [h] tall.
+CatalogShape rect(double x, double y, double w, double h) =>
+    CatalogPolyline([_p(x, y), _p(x + w, y), _p(x + w, y + h), _p(x, y + h)],
+        closed: true);
+
+/// [rect] of a [w] x [h] outline at ([x], [y]), inset by [d] on every side.
+CatalogShape inset(double x, double y, double w, double h, double d) =>
+    rect(x + d, y + d, w - 2 * d, h - 2 * d);
+
+/// A closed polyline through [points].
+CatalogShape poly(List<CatalogPoint> points) =>
+    CatalogPolyline([for (final (x, y) in points) _p(x, y)], closed: true);
+
+/// A chair facing a table: its seat (a closed 450 x 450 square) centred at
+/// ([cx], [cy]) and its back line, the table in direction [facing] (radians
+/// from +x). The back line is 60 in from the edge away from the table.
+List<CatalogShape> chairAt(double cx, double cy, double facing) {
+  const h = chairSize / 2;
+  // The chair's frame: u towards the table, v across it.
+  final ux = math.cos(facing), uy = math.sin(facing);
+  final vx = -uy, vy = ux;
+  CatalogPoint at(double u, double v) =>
+      _p(cx + u * ux + v * vx, cy + u * uy + v * vy);
+  return [
+    poly([at(-h, -h), at(h, -h), at(h, h), at(-h, h)]),
+    CatalogLine(at(-h + _chairBack, -h), at(-h + _chairBack, h)),
+  ];
+}
+
+/// The angle of the [i]th of [count] places around a round top, the first
+/// straight below it.
+double _around(int i, int count) => -math.pi / 2 + 2 * math.pi * i / count;
+
+/// [count] chairs around a round top of radius [r] centred at ([cx], [cy]),
+/// at equal angles from the bottom, each tucked [chairTuck] under the edge.
+List<CatalogShape> chairsAround(double cx, double cy, double r, int count) {
+  final d = r + chairSize / 2 - chairTuck;
+  return [
+    for (var i = 0; i < count; i++)
+      ...chairAt(
+          cleanCoordinate(cx + d * math.cos(_around(i, count))),
+          cleanCoordinate(cy + d * math.sin(_around(i, count))),
+          _around(i, count) + math.pi),
+  ];
+}
+
+/// A bar stool at ([cx], [cy]): its seat (Ø 380), then a Ø 300 footrest.
+List<CatalogShape> stoolAt(double cx, double cy) => [
+      CatalogCircle(_p(cx, cy), stoolRadius),
+      CatalogCircle(_p(cx, cy), _footrestRadius),
+    ];
+
+/// [count] stools around a round top of radius [r] centred at ([cx], [cy]),
+/// at equal angles from the bottom, each reaching [stoolTuck] under the edge.
+List<CatalogShape> stoolsAround(double cx, double cy, double r, int count) {
+  final d = r + stoolRadius - stoolTuck;
+  return [
+    for (var i = 0; i < count; i++)
+      ...stoolAt(cx + d * math.cos(_around(i, count)),
+          cy + d * math.sin(_around(i, count))),
+  ];
+}
diff --git a/packages/jet_cad_2d_kit/lib/src/authoring/snapshot.dart b/packages/jet_cad_2d_kit/lib/src/authoring/snapshot.dart
new file mode 100644
index 00000000..bfe2e904
--- /dev/null
+++ b/packages/jet_cad_2d_kit/lib/src/authoring/snapshot.dart
@@ -0,0 +1,92 @@
+// The geometry snapshot (spec K7): per key@version, a canonical JSON text of
+// its base point, shapes and unit. A kit commits it; the conformance test
+// holds every published key@N to it, and the generator only ever adds to it.
+//
+// Pure Dart: no Flutter, no dart:io.
+import 'dart:collection';
+import 'dart:convert';
+
+import 'catalog.dart';
+
+/// Each symbol of [catalog] by `key@version`, sorted, as a canonical JSON
+/// text: keys sorted, numbers in Dart's shortest round-trip form, -0 as 0.
+SplayTreeMap<String, String> geometrySnapshot(Catalog catalog) =>
+    SplayTreeMap.of({
+      for (final s in catalog.symbols) s.id: jsonEncode(_entry(s)),
+    });
+
+Map<String, Object?> _entry(CatalogSymbol s) => {
+      'base': _point(s.base),
+      'shapes': [for (final shape in s.shapes) _shape(shape)],
+      'unit': switch (s.unit) {
+        null => null,
+        final CatalogUnit u => {
+            'capacity': u.capacity,
+            'kind': u.kind,
+            'labelling': u.labelling.name,
+          },
+      },
+    };
+
+Map<String, Object?> _shape(CatalogShape shape) => switch (shape) {
+      CatalogLine(:final from, :final to) => {
+          'from': _point(from),
+          'kind': 'line',
+          'to': _point(to),
+        },
+      CatalogPolyline(:final points, :final closed) => {
+          'closed': closed,
+          'kind': 'polyline',
+          'points': [for (final p in points) _point(p)],
+        },
+      CatalogCircle(:final center, :final radius) => {
+          'center': _point(center),
+          'kind': 'circle',
+          'radius': _number(radius),
+        },
+      CatalogArc(:final center, :final radius, :final start, :final sweep) => {
+          'center': _point(center),
+          'kind': 'arc',
+          'radius': _number(radius),
+          'start': _number(start),
+          'sweep': _number(sweep),
+        },
+    };
+
+List<double> _point(CatalogPoint p) => [_number(p.$1), _number(p.$2)];
+
+/// -0.0 is the same geometry as 0.0, and is written so.
+double _number(double v) => v == 0 ? 0.0 : v;
+
+/// A committed snapshot's text, each entry re-encoded canonically. Throws
+/// [FormatException] when [text] is not a JSON object of objects.
+SplayTreeMap<String, String> parseSnapshot(String text) {
+  final Object? json = jsonDecode(text);
+  if (json is! Map<String, Object?>) {
+    throw const FormatException('a geometry snapshot is a JSON object');
+  }
+  final snapshot = SplayTreeMap<String, String>();
+  for (final MapEntry(:key, :value) in json.entries) {
+    if (value is! Map) {
+      throw FormatException('the snapshot entry "$key" is not an object');
+    }
+    snapshot[key] = jsonEncode(value);
+  }
+  return snapshot;
+}
+
+/// [snapshot] as its file: one entry per line, sorted by key.
+String encodeSnapshot(Map<String, String> snapshot) {
+  final keys = snapshot.keys.toList()..sort();
+  if (keys.isEmpty) return '{}\n';
+  final lines = [for (final k in keys) '  ${jsonEncode(k)}: ${snapshot[k]}'];
+  return '{\n${lines.join(',\n')}\n}\n';
+}
+
+/// The generator's merge: every entry of [committed] as it is, plus the
+/// entries of [current] it lacks. Never rewrites an existing entry, so a
+/// changed geometry shows as a failing conformance test, never as a quietly
+/// regenerated file.
+SplayTreeMap<String, String> updateSnapshot(
+        Map<String, String> committed, Map<String, String> current) =>
+    SplayTreeMap.of({...current, ...committed});
diff --git a/packages/jet_cad_2d_kit/lib/src/kit/bundled_library.dart b/packages/jet_cad_2d_kit/lib/src/kit/bundled_library.dart
