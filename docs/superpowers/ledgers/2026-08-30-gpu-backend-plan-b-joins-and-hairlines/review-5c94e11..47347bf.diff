+      instanceCount = collector.instanceCount;
+      skippedOps = collector.skippedOps;
+      backend =
+          geometry == null ? null : GpuDrawBackend(geometry, collectionCamera);
+      uploadMs = stopwatch.elapsedMicroseconds / 1000.0;
+    });
