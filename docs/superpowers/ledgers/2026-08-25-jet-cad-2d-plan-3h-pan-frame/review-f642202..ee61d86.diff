+    for (var i = 0; i < reports.length; i++) {
+      final report = reports[i];
+      expect(report.differingPixels, lessThanOrEqualTo(60),
+          reason: '${kFallbackOffsets[i]}: $report');
+      expect(report.differingPixels / report.liveInk, lessThan(0.01),
+          reason: '${kFallbackOffsets[i]}: $report');
+    }
