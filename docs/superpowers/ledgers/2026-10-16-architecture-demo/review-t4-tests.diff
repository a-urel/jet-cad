+
+  testWidgets(
+      'DC4 each file button and each file chord, Cmd and Ctrl, runs its own '
+      'flow; the tool stays Select (spec 12a D6)', (tester) async {
+    final rig = await pumpApp(tester);
+    final c = rig.controller;
+    final files = rig.files;
