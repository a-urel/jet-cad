+    expect(byKey('export-dialog'), findsOneWidget, reason: 'premise: up');
+    expect(done, isFalse);
+    await tester.sendKeyEvent(LogicalKeyboardKey.escape);
+    await tester.pumpAndSettle();
+    expect(byKey('export-dialog'), findsNothing);
+    expect(done, isTrue);
+    expect(got, isNull);
+  });
 }
