+    total.stop();
+    if (_disposed) {
+      nextBackend?.dispose();
+      return;
+    }
+    lastWalkMicros = next.walkMicros;
+    lastClassifyMicros = next.classifyMicros;
+    lastUploadMicros = upload.elapsedMicroseconds;
+    lastTotalMicros = total.elapsedMicroseconds;
+    lastTrigger = trigger;
+    _collection = next;
+    final old = _backend;
+    _backend = nextBackend;
+    old?.dispose();
+    if (nextBackend == null) {
+      _uploadFailed = true;
+      _pending = null;
+    }
