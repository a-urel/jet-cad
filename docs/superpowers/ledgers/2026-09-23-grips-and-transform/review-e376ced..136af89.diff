+    final delta = worldOf(rig, to) - worldOf(rig, from);
+    expect(a1.transform.e, closeTo(a0.transform.e + delta.x, 1e-9));
+    expect(a1.transform.f, closeTo(a0.transform.f + delta.y, 1e-9));
+  });
