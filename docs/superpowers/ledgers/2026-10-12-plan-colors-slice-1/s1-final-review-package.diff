+/// stroke, in plan millimetres.
+Vector2 bareAt(Rooms r) => r.plan.at(9800, 2000);
+Vector2 insideA(Rooms r) => r.plan.at(800, 3300);
+Vector2 insideB(Rooms r) => r.plan.at(3900, 3300);
